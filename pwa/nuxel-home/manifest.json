{
  "name": "Nuxel Home",
  "short_name": "Nuxel",
  "description": "Nuxel Phone Launcher - PWA-first phone OS",
  "start_url": "./index.html",
  "display": "fullscreen",
  "orientation": "portrait-primary",
  "scope": "./",
  "background_color": "#1a1a2e",
  "theme_color": "#1a1a2e",
  "categories": [
    "launcher",
    "productivity",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "splash_pages": null,
  "prefer_related_applications": false,
  "related_applications": [],
  "serviceworker": {
    "src": "sw.js",
    "scope": "./",
    "use_cache": true
  },
  "screenshots": [],
  "features": [
    "Cross-Origin Isolation"
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "nuxel": {
    "capabilities": [
      "phone:status",
      "notifications:receive"
    ],
    "app_type": "home",
    "native_fallback": false,
    "bridge_version": "1",
    "pwa_version": "0.7.1-beta",
    "cache_version": "v49-v071-release",
    "registry_version": 6,
    "single_source_of_truth": "pwa/nuxel-home (index.html, css/, js/, manifest.json, sw.js)",
    "apps_in_registry": [
      "nuxel-dialer",
      "nuxel-messages",
      "nuxel-contacts",
      "org.nuxel.Mail",
      "org.nuxel.Calendar",
      "org.nuxel.Notes",
      "org.nuxel.Files",
      "nuxel-camera",
      "nuxel-settings",
      "org.nuxel.Terminal",
      "org.nuxel.LiveConsole",
      "org.nuxel.Browser",
      "org.nuxel.Calculator",
      "org.nuxel.Clock",
      "org.nuxel.Photos",
      "org.nuxel.Weather",
      "org.nuxel.Maps",
      "org.nuxel.Nuxtore",
      "org.nuxel.Recorder",
      "org.nuxel.SnekByte",
      "org.gnome.Snapshot",
      "org.nuxel.USBSSHConsole",
      "org.nuxel.WiFiSSHConsole"
    ],
    "settings_documents": [
      "/etc/nuxel/boot/verbose-boot.json",
      "/etc/nuxel/boot/animation-handoff.json",
      "/etc/nuxel/display/statusbar-safezones.json",
      "/etc/nuxel/input/buttons.json"
    ],
    "display": {
      "panel": "1440x3040",
      "viewport_css_px": "360x760",
      "safe_zones": 10,
      "safe_zone_profile": "s10plus"
    },
    "host_version": "0.7.1-beta"
  },
  "id": "/pwa/nuxel-home/",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "scope_extensions": [],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Terminal",
      "short_name": "Terminal",
      "url": "./index.html#app=org.nuxel.Terminal",
      "description": "Open the Nuxel terminal (Bixby button default action)"
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "./index.html#app=nuxel-settings",
      "description": "Open Nuxel settings (display safe zones, buttons, verbose boot)"
    },
    {
      "name": "Serial Live Console",
      "short_name": "Serial",
      "url": "./index.html#app=org.nuxel.LiveConsole",
      "description": "Open the USB serial recovery console status"
    },
    {
      "name": "USB SSH Console",
      "short_name": "USB SSH",
      "url": "./index.html#app=org.nuxel.USBSSHConsole",
      "description": "Open the USB-network SSH console (honest kernel-blocker state)"
    },
    {
      "name": "Wi-Fi SSH Console",
      "short_name": "Wi-Fi SSH",
      "url": "./index.html#app=org.nuxel.WiFiSSHConsole",
      "description": "Open the Wi-Fi SSH console status"
    }
  ]
}
