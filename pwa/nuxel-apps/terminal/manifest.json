{
  "name": "Nuxel Terminal",
  "short_name": "Terminal",
  "description": "Nuxel Terminal \u2014 a real local PTY on the device, driven by the launcher host (no remote shell)",
  "start_url": "/pwa/nuxel-apps/terminal/index.html",
  "scope": "/pwa/nuxel-apps/terminal/",
  "display": "fullscreen",
  "orientation": "portrait-primary",
  "background_color": "#05080f",
  "theme_color": "#05080f",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "system",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "nuxel": {
    "bridge_version": "1",
    "capabilities": [
      "shell:local-pty"
    ],
    "app_type": "terminal",
    "offline_first": true,
    "network": "none",
    "storage": [
      "localStorage"
    ],
    "host_verbs": [
      "term.open",
      "term.input",
      "term.close"
    ],
    "remote_access": "none",
    "facilities": [
      "local-pty via tools/s10plus/a33/nuxel-pwa-host.c (launcher host, not the bridge)"
    ]
  }
}
