{
  "name": "Nuxel SnekByte",
  "short_name": "SnekByte",
  "description": "Port of the original SnekByte snake game with WoNQ mode, parity-verified against the Python original",
  "start_url": "/pwa/nuxel-apps/snekbyte/index.html",
  "scope": "/pwa/nuxel-apps/snekbyte/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#2E7D32",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml"}
  ],
  "nuxel": { "bridge_version": 1,
    "app_id": "org.nuxel.SnekByte",
    "capabilities": ["input:keyboard", "input:touch"],
    "app_type": "games",
    "offline_first": true,
    "network": "none",
    "storage": ["localStorage (settings + high score only)"],
    "features": ["original rules port", "WoNQ mode", "five speed levels", "keyboard, swipe and on-screen controls", "parity-proven against the Python original"]
  }
}
