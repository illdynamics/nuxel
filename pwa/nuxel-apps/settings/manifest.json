{
  "name": "Nuxel Settings",
  "short_name": "Settings",
  "description": "Nuxel system settings (display, status bar, sound, network, input, location and maps diagnostics)",
  "start_url": "./index.html",
  "display": "fullscreen",
  "orientation": "portrait-primary",
  "scope": "./",
  "background_color": "#0a1628",
  "theme_color": "#0a1628",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "../../nuxel-home/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../../nuxel-home/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "nuxel": {
    "bridge_version": "1",
    "capabilities": [
      "location:read",
      "location:manage"
    ],
    "app_type": "settings",
    "app_id": "nuxel-settings",
    "offline_first": true,
    "network": "none",
    "storage": [
      "none (settings live in /etc/nuxel/*.json through the launcher host)"
    ],
    "settings_documents": [
      "statusbar-safezones",
      "buttons",
      "verbose-boot",
      "animation-handoff",
      "audio",
      "display",
      "power",
      "privacy",
      "network",
      "keyboard",
      "system"
    ],
    "registry_id": "nuxel-settings",
    "facilities": [
      "launcher host config get/set (the settings documents are the same files nuxelctl writes; the settings app never writes a file itself)"
    ]
  }
}
