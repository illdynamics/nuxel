  "icons": [
    {
      "src": "../../../assets/nuxel-applications-icon-pack/04-02_permissions.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "nuxel": {
    "bridge_version": "1",
    "pwa_version": "0.8.0-beta",
    "capabilities": [
      "system:inspect"
    ],
    "app_type": "settings",
    "app_id": "org.nuxel.Permissions",
    "offline_first": true,
    "network": "none",
    "registry_id": "org.nuxel.Permissions"
  }
