{
  "name": "Nuxel Camera",
  "short_name": "Camera",
  "description": "Take photos and record videos",
  "start_url": "/pwa/nuxel-apps/camera-gallery/index.html",
  "display": "fullscreen",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "scope": "/pwa/nuxel-apps/camera/",
  "nuxel": {
    "bridge_version": "1",
    "capabilities": [
      "camera:capture",
      "camera:preview",
      "camera:read"
    ],
    "app_type": "camera",
    "offline_first": true,
    "network": "optional (external services only when configured by the user)",
    "storage": [
      "bridge storage"
    ],
    "bridge_verbs": [
      "camera.capture",
      "camera.list-captures"
    ],
    "hardware_dependency": "camera (owner test: proof area 15)"
  }
}
