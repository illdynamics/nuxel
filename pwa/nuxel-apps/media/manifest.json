{
  "name": "Nuxel Media",
  "short_name": "Media",
  "description": "Audio and video playback with an honest output-route readout",
  "start_url": "/pwa/nuxel-apps/media/index.html",
  "scope": "/pwa/nuxel-apps/media/",
  "display": "standalone",
  "background_color": "#120a1e",
  "theme_color": "#6A1B9A",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml"}
  ],
  "nuxel": { "bridge_version": 1,
    "app_id": "org.nuxel.Media",
    "capabilities": ["audio:playback", "media:library"],
    "app_type": "media",
    "offline_first": true,
    "network": "none",
    "storage": ["localStorage", "bridge media library (best effort)"],
    "features": ["audio playback", "video playback", "playlist queue", "seek", "volume via the real mixer", "honest output route", "offline sample library"]
  }
}
