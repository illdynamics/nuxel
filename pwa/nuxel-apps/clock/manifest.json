{
  "name": "Nuxel Clock",
  "short_name": "Clock",
  "description": "Clock, world clocks, alarms, stopwatch and timer; ties into the Nuxel time/RTC service",
  "start_url": "/pwa/nuxel-apps/clock/index.html",
  "scope": "/pwa/nuxel-apps/clock/",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "nuxel": {
    "bridge_version": "1",
    "capabilities": [
      "notifications:send",
      "storage:persistent"
    ],
    "app_type": "clock",
    "offline_first": true,
    "network": "none",
    "storage": [
      "localStorage"
    ],
    "consumes": [
      "/etc/nuxel/time.conf (read-only, via the bridge clock.status verb)"
    ],
    "facilities": [
      "system time/RTC via nuxelctl time (read-only), alarms are local"
    ]
  }
}
