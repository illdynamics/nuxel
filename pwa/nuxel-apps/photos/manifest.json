{
  "name": "Nuxel Photos",
  "short_name": "Photos",
  "description": "Gallery over the shared camera store: albums, search, viewer, index export (no fabricated imagery)",
  "start_url": "/pwa/nuxel-apps/photos/index.html",
  "scope": "/pwa/nuxel-apps/photos/",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#101418",
  "theme_color": "#101418",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "media"
  ],
  "icons": [
    {
      "src": "icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "nuxel": {
    "bridge_version": "1",
    "capabilities": [
      "storage:persistent"
    ],
    "app_type": "photos",
    "offline_first": true,
    "network": "none",
    "storage": [
      "localStorage"
    ],
    "data_source": "camera.list-captures via the Nuxel bridge",
    "facilities": [
      "read-only access to the shared camera-gallery store"
    ]
  }
}
