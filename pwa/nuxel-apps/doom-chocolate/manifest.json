  "theme_color": "#120b06",
  "categories": [
    "games"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "nuxel": {
    "app_id": "org.nuxel.Doom.Chocolate",
    "app_type": "games",
    "offline_first": true,
    "network": "none",
    "capabilities": [],
    "bridge_version": "1",
    "source": "Native Doom engine comparison launcher; no commercial WAD bundled",
    "features": [
      "Native aarch64 Chocolate Doom 3.1.1",
      "Real WAD maps at full screen",
      "Keyboard and Bluetooth gamepad input",
      "Same Freedoom/imported WAD catalogue"
    ]
  },
  "version": "1.0.0"
}
