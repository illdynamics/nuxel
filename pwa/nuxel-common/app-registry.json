  "capability_gaps": [
    {
      "capability": "storage:read",
      "declared_by": [
        "pwa/nuxel-apps/mail/manifest.json",
        "pwa/nuxel-apps/calendar/manifest.json"
      ],
      "status": "not-in-capabilities.py-enum",
      "bridge_enum_equivalent": "storage:persistent",
      "owner_group": "bg-06-core-phone-apps",
      "note": "The apps ask for a read/write storage pair; the bridge enum defines storage:persistent only. Not fatal for the registry (the ids are a manifest contract, not an enforcement claim) but an app must not advertise a capability the host cannot arbitrate - the owning group either adds the enum entry or moves the manifests to storage:persistent."
    },
    {
      "capability": "storage:write",
      "declared_by": [
        "pwa/nuxel-apps/mail/manifest.json",
        "pwa/nuxel-apps/calendar/manifest.json"
      ],
      "status": "not-in-capabilities.py-enum",
      "bridge_enum_equivalent": "storage:persistent",
      "owner_group": "bg-06-core-phone-apps",
      "note": "See storage:read."
    },
    {
      "capability": "shell:local-pty",
      "declared_by": [
        "pwa/nuxel-apps/terminal/manifest.json"
      ],
      "status": "not-in-capabilities.py-enum",
      "bridge_enum_equivalent": null,
      "owner_group": "bg-06-core-phone-apps",
      "note": "The Terminal's PTY is opened by the native PWA host (tools/s10plus/a3x/nuxel-pwa-host.c), NOT through the bridge capability model, so no bridge enum entry exists. Recorded so the gap is visible instead of implied."
    }
  ],
  "launcher_manifest_notes": [
    "pwa/nuxel-home/manifest.json (owned by the Priority 2 group) declares nuxel.bridge_version 0.4.0-alpha, which is the HOST version, not the protocol pin '1'. Reported as a WARN by the verifier: the launcher is a system surface, not a third-party app, so it is not part of apps[] and the mismatch cannot reject a PWA, but the two fields should not be conflated."
  ]
