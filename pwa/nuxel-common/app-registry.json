{
  "schema": "nuxel.app-registry/1",
  "registry_version": 7,
  "bridge_version": "1",
  "bridge_version_pin": "pwa/nuxel-common/bridge-version.json",
  "url_base": "http://127.0.0.1:8000",
  "consumers": {
    "pwa_launcher": "pwa/nuxel-home/js/apps.js",
    "native_shell": "shell/nuxel-home-native/nuxel_home/app_registry.json",
    "http_bridge": "services/nuxel-bridge/src/api.py (GET /api/v1/apps/registry)",
    "installed_copy": "/etc/nuxel/app-registry/app_registry.json (rootfs builder, briq-04b)",
    "verifier": "tools/s10plus/a33/verify-app-registry.py"
  },
  "contract": {
    "one_registry": "This file is the canonical launcher registry. The PWA launcher (apps.js), the native shell (app_registry.json) and the HTTP bridge all serve the SAME app set; verify-app-registry.py fails on any drift between them.",
    "capability_source": "services/nuxel-bridge/src/capabilities.py (Capability enum) \u2014 an app may not declare a capability the bridge does not know.",
    "manifest_rule": "every pwa entry must resolve to a real index.html AND a manifest.json carrying nuxel.capabilities (list) and nuxel.bridge_version equal to the pin."
  },
