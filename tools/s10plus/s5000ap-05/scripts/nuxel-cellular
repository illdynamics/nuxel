#!/usr/bin/python3
"""NM generic device handler: associate the existing native CID1 interface.
Never creates a modem, issues modem commands, or fabricates a carrier address.
"""
import json
import os
from pathlib import Path
import sys

if os.environ.get('CONNECTION_UUID') != '8ba40bd5-cc4c-4a12-96c5-757170a1d106':
    sys.exit(1)
if len(sys.argv) != 3 or sys.argv[1] != 'rmnet0':
    sys.exit(1)
if sys.argv[2] == 'device-add':
    data = json.loads(Path('/run/nuxel-radio/cellular-link.json').read_text())
    if data.get('engine') != 'NetworkManager' or data['config']['iface'] != 'rmnet0' or data['config']['cid'] != 1:
        sys.exit(1)
    print('IFINDEX=' + Path('/sys/class/net/rmnet0/ifindex').read_text().strip())
elif sys.argv[2] != 'device-delete':
    sys.exit(1)
