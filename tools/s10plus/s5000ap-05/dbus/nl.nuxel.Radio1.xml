<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0
 Native Nuxel Radio1 methods match the implementation vtable.
 State-changing methods and SMS content require actual bus sender credentials
 of root or the nuxel account. This service does not use polkit.
 SendSms returns a durable local message ID, not a delivery acknowledgement.
 GetSms.state distinguishes queued, sending, submitted, delivered, failed,
 unknown, receiving and received. Only TP-ST=0 establishes network delivery.
 No phone number or message body is broadcast in signals or journal entries.
 GetIpInfo reports CP-assigned addresses; GetDataSessionState.ip_configured
 separately reports Linux configuration. Never infer internet from Registered.
-->
<node name="/nl/nuxel/Radio1">
  <interface name="nl.nuxel.Radio1">
    <property name="Version" type="u" access="read" />
    <property name="ApiRevision" type="s" access="read" />
    <property name="DaemonState" type="s" access="read" />
    <property name="DevicePresent" type="b" access="read" />
    <property name="CpState" type="s" access="read" />
    <property name="RadioState" type="s" access="read" />
    <method name="SetRadioEnabled">
      <arg name="in0" type="b" direction="in" />
    </method>
    <method name="SelectNetworkAutomatic" />
    <property name="SimPresent" type="b" access="read" />
    <property name="SimPinRequired" type="b" access="read" />
    <method name="GetSimState">
      <arg name="out0" type="s" direction="out" />
    </method>
    <property name="Registered" type="b" access="read" />
    <method name="RefreshStatus">
      <arg name="out0" type="b" direction="out" />
    </method>
    <method name="GetDataSessionState">
      <arg name="out0" type="a{ss}" direction="out" />
    </method>
    <method name="GetIpInfo">
      <arg name="out0" type="a{ss}" direction="out" />
    </method>
    <method name="GetPdpProfiles">
      <arg name="out0" type="a(yysyy)" direction="out" />
    </method>
    <method name="Dial">
      <arg name="in0" type="s" direction="in" />
      <arg name="out0" type="b" direction="out" />
    </method>
    <method name="AnswerCall">
      <arg name="out0" type="b" direction="out" />
    </method>
    <method name="HangupCall">
      <arg name="out0" type="b" direction="out" />
    </method>
    <method name="GetCalls">
      <arg name="out0" type="a(ussb)" direction="out" />
    </method>
    <method name="GetVoiceStatus">
      <arg name="out0" type="a{ss}" direction="out" />
    </method>
    <method name="SendSms">
      <arg name="in0" type="s" direction="in" />
      <arg name="in1" type="s" direction="in" />
      <arg name="out0" type="u" direction="out" />
    </method>
    <method name="ListSms">
      <arg name="out0" type="au" direction="out" />
    </method>
    <method name="GetSms">
      <arg name="in0" type="u" direction="in" />
      <arg name="out0" type="a{ss}" direction="out" />
    </method>
    <method name="GetSmsStatus">
      <arg name="out0" type="a{ss}" direction="out" />
    </method>
    <method name="GetSignalInfo">
      <arg name="out0" type="i" direction="out" />
      <arg name="out1" type="i" direction="out" />
      <arg name="out2" type="i" direction="out" />
      <arg name="out3" type="b" direction="out" />
    </method>
    <method name="GetAvailableOperators">
      <arg name="out0" type="a(ss)" direction="out" />
    </method>
    <method name="GetPacketStats">
      <arg name="out0" type="t" direction="out" />
      <arg name="out1" type="t" direction="out" />
      <arg name="out2" type="b" direction="out" />
    </method>
    <method name="CreateBearer">
      <arg name="in0" type="s" direction="in" />
      <arg name="out0" type="u" direction="out" />
    </method>
    <method name="DeleteBearer">
      <arg name="in0" type="u" direction="in" />
    </method>
    <method name="StartDataSession">
      <arg name="in0" type="s" direction="in" />
      <arg name="in1" type="u" direction="in" />
      <arg name="out0" type="b" direction="out" />
    </method>
    <method name="StopDataSession">
      <arg name="out0" type="b" direction="out" />
    </method>
    <method name="GetCapabilities">
      <arg name="out0" type="a{ss}" direction="out" />
    </method>
    <method name="GetDiagnostics">
      <arg name="out0" type="a{st}" direction="out" />
    </method>
    <signal name="StateChanged">
      <arg name="value0" type="s" />
      <arg name="value1" type="s" />
    </signal>
    <signal name="CpReset" />
    <signal name="SmsReceived">
      <arg name="value0" type="u" />
    </signal>
    <signal name="SmsStateChanged">
      <arg name="value0" type="u" />
      <arg name="value1" type="s" />
    </signal>
    <signal name="IncomingCall">
      <arg name="value0" type="u" />
    </signal>
    <signal name="CallStateChanged">
      <arg name="value0" type="u" />
      <arg name="value1" type="s" />
    </signal>
  </interface>
</node>
