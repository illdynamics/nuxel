+/* ============================================================================
+ * zwp_text_input_v1 -> zwp_text_input_v3 / input-method-v2 compatibility
+ *
+ * Chromium/Electron builds before the v3 migration still bind the removed
+ * zwp_text_input_v1 manager.  They never see v3, so Stevia never gets an
+ * activate request and the on-screen keyboard cannot be raised.  This adapter
+ * exposes v1 only when the Nuxel setting is enabled and translates the small,
+ * well-defined v1 subset onto the SAME input-method-v2 relay Stevia already
+ * serves for v3.  v3 clients and the normal keyboard path are untouched.
+ * ========================================================================== */
+
+#define NUXEL_TEXT_INPUT_V1_MARKER "/run/nuxel-text-input-v1.enabled"
+#define NUXEL_TEXT_INPUT_V1_POLL_MS 500
+
+typedef struct {
+  struct wl_display *display;
+  struct wl_global *global;
+  struct wl_event_source *timer;
+  bool enabled;
+  struct wl_list inputs; /* PhocTextInputV1.manager_link */
+} PhocTextInputManagerV1;
+
+static PhocTextInputManagerV1 *text_input_manager_v1;
+
+static void
+text_input_v1_state_clear (PhocTextInputV1State *state)
+{
+  g_clear_pointer (&state->text, g_free);
+  g_clear_pointer (&state->preferred_language, g_free);
+  memset (state, 0, sizeof (*state));
+}
+
+static void
+text_input_v1_state_copy (PhocTextInputV1State *dst, const PhocTextInputV1State *src)
+{
+  text_input_v1_state_clear (dst);
+  dst->text = g_strdup (src->text);
+  dst->cursor = src->cursor;
+  dst->anchor = src->anchor;
+  dst->has_surrounding = src->has_surrounding;
+  dst->hint = src->hint;
+  dst->purpose = src->purpose;
+  dst->has_content_type = src->has_content_type;
+  memcpy (dst->cursor_rect, src->cursor_rect, sizeof (dst->cursor_rect));
+  dst->has_cursor_rectangle = src->has_cursor_rectangle;
+  dst->preferred_language = g_strdup (src->preferred_language);
+}
+
+static PhocTextInputV1 *
+relay_get_focused_v1 (PhocInputMethodRelay *relay)
+{
+  if (!relay || !text_input_manager_v1 || !text_input_manager_v1->enabled)
+    return NULL;
+
+  PhocTextInputV1 *v1;
+  wl_list_for_each (v1, &relay->text_inputs_v1, link) {
+    if (v1->focused_surface)
+      return v1;
+  }
+  return NULL;
+}
+
+static void
+text_input_v1_send_im_done (PhocTextInputV1 *v1)
+{
+  PhocInputMethodRelay *relay = v1 ? v1->relay : NULL;
+  struct wlr_input_method_v2 *input_method = relay ? relay->input_method : NULL;
+
+  if (!input_method || !v1->current_enabled || !v1->focused_surface)
+    return;
+
+  if (v1->current.has_surrounding) {
+    wlr_input_method_v2_send_surrounding_text (input_method,
+                                               v1->current.text ? v1->current.text : "",
+                                               v1->current.cursor,
+                                               v1->current.anchor);
+  }
+  wlr_input_method_v2_send_text_change_cause (input_method,
+                                              ZWP_TEXT_INPUT_V3_CHANGE_CAUSE_OTHER);
+  if (v1->current.has_content_type) {
+    wlr_input_method_v2_send_content_type (input_method,
+                                           v1->current.hint,
+                                           v1->current.purpose);
+  }
+  wlr_input_method_v2_send_done (input_method);
+}
+
+static void
+text_input_v1_handle_im_commit (PhocTextInputV1 *v1,
+                                struct wlr_input_method_v2 *context)
+{
+  if (!v1 || !context || !v1->current_enabled || !v1->focused_surface)
+    return;
+
+  if (context->current.preedit.text) {
+    if (context->current.preedit.cursor_begin >= 0)
+      zwp_text_input_v1_send_preedit_cursor (v1->resource,
+                                             context->current.preedit.cursor_begin);
+    zwp_text_input_v1_send_preedit_string (v1->resource,
+                                           v1->serial,
+                                           context->current.preedit.text,
+                                           "");
+  }
+  if (context->current.commit_text)
+    zwp_text_input_v1_send_commit_string (v1->resource,
+                                          v1->serial,
+                                          context->current.commit_text);
+  if (context->current.delete.before_length
+      || context->current.delete.after_length) {
+    uint32_t before = context->current.delete.before_length;
+    uint32_t after = context->current.delete.after_length;
+    uint32_t length = before + after;
+    if (length < before)
+      length = G_MAXUINT32;
+    zwp_text_input_v1_send_delete_surrounding_text (v1->resource,
+                                                    -(int32_t)before,
+                                                    length);
+  }
+}
+
+static void
+text_input_v1_submit_preedit (PhocInputMethodRelay *relay, PhocTextInputV1 *v1)
+{
+  struct wlr_input_method_v2_preedit_string *preedit;
+
+  if (!relay || !v1 || !relay->input_method)
+    return;
+
+  preedit = &relay->input_method->current.preedit;
+  if (gm_str_is_null_or_empty (preedit->text))
+    return;
+
+  zwp_text_input_v1_send_commit_string (v1->resource, v1->serial, preedit->text);
+  g_clear_pointer (&preedit->text, g_free);
+  wlr_input_method_v2_send_text_change_cause (relay->input_method,
+                                              ZWP_TEXT_INPUT_V3_CHANGE_CAUSE_OTHER);
+  wlr_input_method_v2_send_done (relay->input_method);
+}
+
+static void
+text_input_v1_focused_surface_destroy (struct wl_listener *listener, void *data)
+{
+  PhocTextInputV1 *v1 = wl_container_of (listener, v1, focused_surface_destroy);
+
+  (void)data;
+
+  if (v1->relay && v1->relay->input_method && v1->current_enabled)
+    wlr_input_method_v2_send_deactivate (v1->relay->input_method);
+  v1->current_enabled = false;
+  v1->focused_surface = NULL;
+  wl_list_remove (&v1->focused_surface_destroy.link);
+  wl_list_init (&v1->focused_surface_destroy.link);
+  zwp_text_input_v1_send_input_panel_state (v1->resource, 0);
+}
+
+static void
+text_input_v1_unset_focus (PhocInputMethodRelay *relay, PhocTextInputV1 *v1)
+{
+  if (!v1)
+    return;
+  if (!relay) {
+    v1->current_enabled = false;
+    return;
+  }
+
+  if (relay->input_method && v1->current_enabled && v1->focused_surface) {
+    wlr_input_method_v2_send_deactivate (relay->input_method);
+    text_input_v1_send_im_done (v1);
+  }
+  v1->current_enabled = false;
+  if (v1->focused_surface) {
+    zwp_text_input_v1_send_input_panel_state (v1->resource, 0);
+    zwp_text_input_v1_send_leave (v1->resource);
+    wl_list_remove (&v1->focused_surface_destroy.link);
+    wl_list_init (&v1->focused_surface_destroy.link);
+    v1->focused_surface = NULL;
+  }
+}
+
+static void
+text_input_v1_activate (PhocTextInputV1 *v1, struct wlr_surface *surface)
+{
+  if (!v1 || !surface)
+    return;
+  if (!text_input_manager_v1 || !text_input_manager_v1->enabled)
+    return;
+
+  if (v1->focused_surface && v1->focused_surface != surface)
+    text_input_v1_unset_focus (v1->relay, v1);
+
+  if (!v1->focused_surface) {
+    v1->focused_surface = surface;
+    v1->focused_surface_destroy.notify = text_input_v1_focused_surface_destroy;
+    wl_signal_add (&surface->events.destroy, &v1->focused_surface_destroy);
+    v1->current_enabled = true;
+    zwp_text_input_v1_send_enter (v1->resource, surface->resource);
+
+    /* Make the v1 input the only focused text input on this seat. */
+    phoc_input_method_relay_set_focus (v1->relay, surface);
+
+    if (v1->relay->input_method) {
+      wlr_input_method_v2_send_activate (v1->relay->input_method);
+      text_input_v1_send_im_done (v1);
+      show_osk_for_focused_v1 (v1);
+    }
+  } else if (v1->current_enabled && v1->relay->input_method) {
+    text_input_v1_send_im_done (v1);
+    show_osk_for_focused_v1 (v1);
+  }
+
+  zwp_text_input_v1_send_input_panel_state (v1->resource,
+                                            v1->relay->input_method ? 1 : 0);
+}
+
+static void
+text_input_v1_resource_destroy (struct wl_resource *resource)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  wl_resource_set_user_data (resource, NULL);
+
+  if (v1->focused_surface) {
+    if (v1->relay && v1->relay->input_method && v1->current_enabled)
+      wlr_input_method_v2_send_deactivate (v1->relay->input_method);
+    v1->current_enabled = false;
+    wl_list_remove (&v1->focused_surface_destroy.link);
+    v1->focused_surface = NULL;
+  }
+  if (v1->relay)
+    wl_list_remove (&v1->link);
+  wl_list_remove (&v1->manager_link);
+  text_input_v1_state_clear (&v1->pending);
+  text_input_v1_state_clear (&v1->current);
+  g_free (v1);
+}
+
+static void
+text_input_v1_activate_request (struct wl_client *client,
+                                struct wl_resource *resource,
+                                struct wl_resource *seat_resource,
+                                struct wl_resource *surface_resource)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+  struct wlr_seat_client *seat_client;
+  struct wlr_surface *surface;
+
+  if (!v1)
+    return;
+  seat_client = wlr_seat_client_from_resource (seat_resource);
+  surface = wlr_surface_from_resource (surface_resource);
+  if (!seat_client || !surface) {
+    wl_resource_post_error (resource, WL_DISPLAY_ERROR_INVALID_OBJECT,
+                            "activate requires a valid seat and surface");
+    return;
+  }
+  if (wl_resource_get_client (surface_resource) != client) {
+    wl_resource_post_error (resource, WL_DISPLAY_ERROR_INVALID_OBJECT,
+                            "activate surface does not belong to this client");
+    return;
+  }
+
+  PhocSeat *seat = PHOC_SEAT (seat_client->seat->data);
+  if (!seat) {
+    wl_resource_post_error (resource, WL_DISPLAY_ERROR_INVALID_OBJECT,
+                            "activate seat has no Phoc seat");
+    return;
+  }
+  if (v1->relay != &seat->im_relay) {
+    if (v1->relay)
+      text_input_v1_unset_focus (v1->relay, v1);
+    if (v1->relay)
+      wl_list_remove (&v1->link);
+    v1->relay = &seat->im_relay;
+    wl_list_insert (&v1->relay->text_inputs_v1, &v1->link);
+  }
+
+  text_input_v1_activate (v1, surface);
+}
+
+static void
+text_input_v1_deactivate_request (struct wl_client *client,
+                                  struct wl_resource *resource,
+                                  struct wl_resource *seat_resource)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+  struct wlr_seat_client *seat_client;
+
+  if (!v1 || !v1->relay)
+    return;
+  seat_client = wlr_seat_client_from_resource (seat_resource);
+  if (seat_client && seat_client->seat != v1->relay->seat->seat)
+    return;
+
+  text_input_v1_unset_focus (v1->relay, v1);
+  hide_osk ();
+}
+
+static void
+text_input_v1_show_input_panel_request (struct wl_client *client,
+                                        struct wl_resource *resource)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1 || !v1->focused_surface || !v1->current_enabled)
+    return;
+  show_osk_for_focused_v1 (v1);
+  zwp_text_input_v1_send_input_panel_state (v1->resource, 1);
+}
+
+static void
+text_input_v1_hide_input_panel_request (struct wl_client *client,
+                                        struct wl_resource *resource)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  hide_osk ();
+  zwp_text_input_v1_send_input_panel_state (v1->resource, 0);
+}
+
+static void
+text_input_v1_reset_request (struct wl_client *client, struct wl_resource *resource)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  text_input_v1_state_clear (&v1->pending);
+  text_input_v1_state_clear (&v1->current);
+  v1->serial = 0;
+}
+
+static void
+text_input_v1_set_surrounding_text_request (struct wl_client *client,
+                                            struct wl_resource *resource,
+                                            const char *text,
+                                            uint32_t cursor,
+                                            uint32_t anchor)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  g_free (v1->pending.text);
+  v1->pending.text = g_strdup (text ? text : "");
+  v1->pending.cursor = cursor;
+  v1->pending.anchor = anchor;
+  v1->pending.has_surrounding = true;
+}
+
+static void
+text_input_v1_set_content_type_request (struct wl_client *client,
+                                        struct wl_resource *resource,
+                                        uint32_t hint,
+                                        uint32_t purpose)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  v1->pending.hint = hint;
+  v1->pending.purpose = purpose;
+  v1->pending.has_content_type = true;
+}
+
+static void
+text_input_v1_set_cursor_rectangle_request (struct wl_client *client,
+                                            struct wl_resource *resource,
+                                            int32_t x,
+                                            int32_t y,
+                                            int32_t width,
+                                            int32_t height)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  v1->pending.cursor_rect[0] = x;
+  v1->pending.cursor_rect[1] = y;
+  v1->pending.cursor_rect[2] = width;
+  v1->pending.cursor_rect[3] = height;
+  v1->pending.has_cursor_rectangle = true;
+}
+
+static void
+text_input_v1_set_preferred_language_request (struct wl_client *client,
+                                              struct wl_resource *resource,
+                                              const char *language)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  g_free (v1->pending.preferred_language);
+  v1->pending.preferred_language = g_strdup (language);
+}
+
+static void
+text_input_v1_commit_state_request (struct wl_client *client,
+                                    struct wl_resource *resource,
+                                    uint32_t serial)
+{
+  PhocTextInputV1 *v1 = wl_resource_get_user_data (resource);
+
+  if (!v1)
+    return;
+  v1->serial = serial;
+  text_input_v1_state_copy (&v1->current, &v1->pending);
+  if (v1->current_enabled && v1->focused_surface)
+    text_input_v1_send_im_done (v1);
+}
+
+static void
+text_input_v1_invoke_action_request (struct wl_client *client,
+                                     struct wl_resource *resource,
+                                     uint32_t button,
+                                     uint32_t index)
+{
+  /* input-method-v2 has no equivalent action request.  Ignoring is safer than
+   * inventing a key or mutating the surrounding text. */
+}
+
+static const struct zwp_text_input_v1_interface text_input_v1_impl = {
+  .activate = text_input_v1_activate_request,
+  .deactivate = text_input_v1_deactivate_request,
+  .show_input_panel = text_input_v1_show_input_panel_request,
+  .hide_input_panel = text_input_v1_hide_input_panel_request,
+  .reset = text_input_v1_reset_request,
+  .set_surrounding_text = text_input_v1_set_surrounding_text_request,
+  .set_content_type = text_input_v1_set_content_type_request,
+  .set_cursor_rectangle = text_input_v1_set_cursor_rectangle_request,
+  .set_preferred_language = text_input_v1_set_preferred_language_request,
+  .commit_state = text_input_v1_commit_state_request,
+  .invoke_action = text_input_v1_invoke_action_request,
+};
+
+static void
+text_input_manager_v1_get_text_input (struct wl_client *client,
+                                      struct wl_resource *manager_resource,
+                                      uint32_t id)
+{
+  PhocTextInputManagerV1 *manager = wl_resource_get_user_data (manager_resource);
+  struct wl_resource *resource;
+  PhocTextInputV1 *v1;
+
+  if (!manager) {
+    wl_resource_post_error (manager_resource, WL_DISPLAY_ERROR_INVALID_OBJECT,
+                            "text input manager has no state");
+    return;
+  }
+
+  resource = wl_resource_create (client, &zwp_text_input_v1_interface,
+                                 wl_resource_get_version (manager_resource), id);
+  if (!resource) {
+    wl_client_post_no_memory (client);
+    return;
+  }
+
+  v1 = g_new0 (PhocTextInputV1, 1);
+  v1->resource = resource;
+  wl_list_init (&v1->link);
+  wl_list_init (&v1->focused_surface_destroy.link);
+  wl_list_insert (&manager->inputs, &v1->manager_link);
+  wl_resource_set_implementation (resource, &text_input_v1_impl, v1,
+                                  text_input_v1_resource_destroy);
+}
+
+static const struct zwp_text_input_manager_v1_interface text_input_manager_v1_impl = {
+  .create_text_input = text_input_manager_v1_get_text_input,
+};
+
+static void
+text_input_manager_v1_bind (struct wl_client *client, void *data,
+                           uint32_t version, uint32_t id)
+{
+  struct wl_resource *resource = wl_resource_create (
+    client, &zwp_text_input_manager_v1_interface, version, id);
+
+  if (!resource) {
+    wl_client_post_no_memory (client);
+    return;
+  }
+  wl_resource_set_implementation (resource, &text_input_manager_v1_impl, data, NULL);
+}
+
+static const char *
+text_input_v1_marker_path (void)
+{
+  const char *path = g_getenv ("NUXEL_TEXT_INPUT_V1_MARKER");
+
+  return path && *path ? path : NUXEL_TEXT_INPUT_V1_MARKER;
+}
+
+static bool
+text_input_v1_marker_enabled (void)
+{
+  g_autofree char *contents = NULL;
+
+  if (!g_file_get_contents (text_input_v1_marker_path (), &contents, NULL, NULL))
+    return false;
+  g_strstrip (contents);
+  if (!contents || !*contents)
+    return false;
+  return contents[0] == '1' || contents[0] == 't' || contents[0] == 'T'
+         || contents[0] == 'y' || contents[0] == 'Y';
+}
+
+static void
+text_input_manager_v1_set_enabled (PhocTextInputManagerV1 *manager, bool enabled)
+{
+  if (!manager || manager->enabled == enabled)
+    return;
+  manager->enabled = enabled;
+
+  if (enabled) {
+    if (!manager->global) {
+      manager->global = wl_global_create (manager->display,
+                                          &zwp_text_input_manager_v1_interface,
+                                          1, manager, text_input_manager_v1_bind);
+    }
+    g_message ("zwp_text_input_v1 compatibility enabled");
+    return;
+  }
+
+  bool had_focus = false;
+  PhocTextInputV1 *v1;
+  wl_list_for_each (v1, &manager->inputs, manager_link) {
+    if (v1->focused_surface)
+      had_focus = true;
+    if (v1->relay)
+      text_input_v1_unset_focus (v1->relay, v1);
+    zwp_text_input_v1_send_input_panel_state (v1->resource, 0);
+  }
+  if (had_focus)
+    hide_osk ();
+
+  if (manager->global) {
+    wl_global_remove (manager->global);
+    wl_global_destroy (manager->global);
+    manager->global = NULL;
+  }
+  g_message ("zwp_text_input_v1 compatibility disabled");
+}
+
+static int
+text_input_manager_v1_poll (void *data)
+{
+  PhocTextInputManagerV1 *manager = data;
+
+  text_input_manager_v1_set_enabled (manager, text_input_v1_marker_enabled ());
+  if (manager->timer)
+    wl_event_source_timer_update (manager->timer, NUXEL_TEXT_INPUT_V1_POLL_MS);
+  return 0;
+}
+
+static void
+text_input_manager_v1_init (struct wl_display *display)
+{
+  if (text_input_manager_v1 || !display) {
+    return;
+  }
+
+  PhocTextInputManagerV1 *manager = g_new0 (PhocTextInputManagerV1, 1);
+  manager->display = display;
+  wl_list_init (&manager->inputs);
+  text_input_manager_v1 = manager;
+  text_input_manager_v1_set_enabled (manager, text_input_v1_marker_enabled ());
+
+  struct wl_event_loop *loop = wl_display_get_event_loop (display);
+  manager->timer = wl_event_loop_add_timer (loop, text_input_manager_v1_poll, manager);
+  if (manager->timer)
+    wl_event_source_timer_update (manager->timer, NUXEL_TEXT_INPUT_V1_POLL_MS);
 }
