--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -137,6 +137,69 @@ union kbase_ioctl_mem_import {
 #define KBASE_MEM_FLAGS_RW   (0x204full | BASE_MEM_COHERENT_LOCAL)
 #define KBASE_MEM_FLAGS_EXEC 0x17ull
 
+/* Exportable buffers for native Wayland WSI.
+ *
+ * kbase can IMPORT a dma-buf but has no GEM handle namespace and cannot EXPORT
+ * one (panfrost_init_screen_caps documents DRM_PRIME_CAP_IMPORT only).  Native
+ * Wayland needs an fd it can hand to the compositor.  udmabuf is the kernel's
+ * supported bridge: a sealed memfd's pages become a dma-buf that can be
+ * imported by kbase, rendered into, and then attached as a wl_buffer.  Only
+ * memory this process allocated and sealed is used; no arbitrary pages are
+ * exposed.
+ */
+struct nuxel_udmabuf_create {
+   uint32_t memfd;
+   uint32_t flags;
+   uint64_t offset;
+   uint64_t size;
+};
+#define NUXEL_UDMABUF_CREATE _IOW('u', 0x42, struct nuxel_udmabuf_create)
+
+static int
+kbase_kmod_create_exportable_bo(struct pan_kmod_dev *dev, uint64_t size)
+{
+   const uint64_t aligned = (size + 4095) & ~UINT64_C(4095);
+   int memfd = memfd_create("nuxel-kbase-wsi",
+                            MFD_CLOEXEC | MFD_ALLOW_SEALING);
+   if (memfd < 0) {
+      mesa_loge("kbase: memfd_create failed (err=%d)", errno);
+      return -1;
+   }
+   if (ftruncate(memfd, aligned) != 0) {
+      mesa_loge("kbase: ftruncate(%" PRIu64 ") failed (err=%d)", aligned, errno);
+      close(memfd);
+      return -1;
+   }
+   if (fcntl(memfd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL) != 0) {
+      mesa_loge("kbase: sealing exportable memfd failed (err=%d)", errno);
+      close(memfd);
+      return -1;
+   }
+
+   int udmabuf = open("/dev/udmabuf", O_RDWR | O_CLOEXEC);
+   if (udmabuf < 0) {
+      mesa_loge("kbase: /dev/udmabuf unavailable (err=%d)", errno);
+      close(memfd);
+      return -1;
+   }
+   struct nuxel_udmabuf_create create = {
+      .memfd = (uint32_t)memfd,
+      .flags = 0,
+      .offset = 0,
+      .size = aligned,
+   };
+   int dmabuf_fd = ioctl(udmabuf, NUXEL_UDMABUF_CREATE, &create);
+   if (dmabuf_fd < 0) {
+      mesa_loge("kbase: UDMABUF_CREATE failed (err=%d)", errno);
+      close(udmabuf);
+      close(memfd);
+      return -1;
+   }
+   close(udmabuf);
+   close(memfd);
+   return dmabuf_fd;
+}
