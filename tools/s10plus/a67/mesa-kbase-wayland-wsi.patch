+/* MESA_KBASE_NODE: bring up Wayland EGL on the vendor kbase node.
+ *
+ * The ordinary Wayland WSI opens a DRM render node.  A Samsung kbase device
+ * has only /dev/mali0, so there is no render node to open and no wl_drm
+ * authentication to do.  The compositor speaks linux-dmabuf, and kbase can
+ * import a dma-buf; the panfrost backend exports Wayland buffers through a
+ * sealed memfd + udmabuf.  This is opt-in and never replaces the DRM path.
+ */
+static bool
+wayland_kbase_probe(struct dri2_egl_display *dri2_dpy)
+{
+   const char *node = getenv("MESA_KBASE_NODE");
+   if (!node)
+      return false;
+
+   dri2_dpy->fd_render_gpu = loader_open_device(node);
+   if (dri2_dpy->fd_render_gpu < 0) {
+      _eglLog(_EGL_WARNING, "wayland-egl: cannot open %s", node);
+      return false;
+   }
+   dri2_dpy->fd_display_gpu = dri2_dpy->fd_render_gpu;
+
+   dri2_dpy->driver_name = loader_get_driver_for_fd(dri2_dpy->fd_render_gpu);
+   if (!dri2_dpy->driver_name) {
+      const char *override = getenv("MESA_LOADER_DRIVER_OVERRIDE");
+      dri2_dpy->driver_name = strdup(override ? override : "panfrost");
+   }
+   if (!dri2_dpy->driver_name) {
+      close(dri2_dpy->fd_render_gpu);
+      dri2_dpy->fd_render_gpu = -1;
+      dri2_dpy->fd_display_gpu = -1;
+      return false;
+   }
+   return true;
+}
+
