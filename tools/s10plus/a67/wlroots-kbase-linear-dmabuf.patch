+/* kbase has no DRM device to describe in dma-buf feedback, but the GLES2
+ * renderer can still import dma-bufs.  v3 carries the format table in the
+ * legacy format/modifier events, which is exactly what a client needs. */
+struct wlr_linux_dmabuf_v1 *wlr_linux_dmabuf_v1_create_with_formats(
+		struct wl_display *display, uint32_t version,
+		const struct wlr_drm_format_set *formats) {
+	struct wlr_linux_dmabuf_v1 *linux_dmabuf =
+		calloc(1, sizeof(*linux_dmabuf));
+	if (linux_dmabuf == NULL) {
+		wlr_log(WLR_ERROR, "could not create kbase dmabuf manager");
+		return NULL;
+	}
+	linux_dmabuf->main_device_fd = -1;
+	wl_list_init(&linux_dmabuf->surfaces);
+	wl_signal_init(&linux_dmabuf->events.destroy);
+
+	linux_dmabuf->global = wl_global_create(display,
+		&zwp_linux_dmabuf_v1_interface, version, linux_dmabuf,
+		linux_dmabuf_bind);
+	if (linux_dmabuf->global == NULL) {
+		wlr_log(WLR_ERROR, "could not create linux dmabuf v1 wl global");
+		free(linux_dmabuf);
+		return NULL;
+	}
+
+	/* Nuxel: /dev/mali0 has no DRM render node and the kbase BO path
+	 * exports ONLY linear, page-backed udmabuf memory.  Advertising the
+	 * renderer's ARM tiled/SPARSE modifiers here made Mesa select e.g.
+	 * AB24 + 0x0800000000000062 for a buffer that is physically linear,
+	 * so the compositor's import either failed or blocked forever.
+	 * Advertise only pairs we can actually allocate and import. */
+	struct wlr_drm_format_set linear_formats = {0};
+	for (size_t i = 0; i < formats->len; i++) {
+		const struct wlr_drm_format *fmt = &formats->formats[i];
+		if (!wlr_drm_format_set_has(formats, fmt->format,
+				DRM_FORMAT_MOD_LINEAR)) {
+			continue;
+		}
+		if (!wlr_drm_format_set_add(&linear_formats, fmt->format,
+				DRM_FORMAT_MOD_LINEAR)) {
+			wlr_drm_format_set_finish(&linear_formats);
+			wl_global_destroy(linux_dmabuf->global);
+			free(linux_dmabuf);
+			return NULL;
+		}
+	}
+	if (linear_formats.len == 0) {
+		wlr_log(WLR_ERROR, "kbase dmabuf: no linear RGB formats from renderer");
+		wl_global_destroy(linux_dmabuf->global);
+		free(linux_dmabuf);
+		return NULL;
+	}
+	linux_dmabuf->default_formats = linear_formats;
+	wlr_log(WLR_INFO, "kbase dmabuf: %zu linear formats advertised", linear_formats.len);
+
+	linux_dmabuf->display_destroy.notify = handle_display_destroy;
+	wl_display_add_destroy_listener(display, &linux_dmabuf->display_destroy);
+
+	wlr_linux_dmabuf_v1_set_check_dmabuf_callback(linux_dmabuf,
+		check_import_dmabuf, linux_dmabuf);
+	wlr_buffer_register_resource_interface(&buffer_resource_interface);
+	return linux_dmabuf;
+}
