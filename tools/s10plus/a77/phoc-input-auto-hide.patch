+/**
+ * phoc_input_device_is_hw_keyboard:
+ * @self: The PhocInputDevice
+ *
+ * Returns: %TRUE if this device should count as an external keyboard for the
+ * on-screen-keyboard auto-hide policy.  The Nuxel libinput shim groups USB
+ * interfaces by product: a mouse's macro-keyboard endpoints are marked
+ * NUXEL_INPUT_AUX_KEYBOARD, while a real keyboard's interface is marked
+ * NUXEL_INPUT_HW_KEYBOARD.  Devices without those properties (Bluetooth,
+ * built-in, fixture) fall back to the capability test.
+ */
+gboolean
+phoc_input_device_is_hw_keyboard (PhocInputDevice *self)
+{
+  g_assert (PHOC_IS_INPUT_DEVICE (self));
+
+  /* Wayland virtual keyboards (Stevia, test clients) are not libinput devices
+   * and have no udev handle at all. */
+  if (!phoc_input_device_get_is_libinput (self))
+    return FALSE;
+
+  if (phoc_input_device_has_udev_property (self, "NUXEL_INPUT_AUX_KEYBOARD"))
+    return FALSE;
+  if (phoc_input_device_has_udev_property (self, "NUXEL_INPUT_HW_KEYBOARD"))
+    return TRUE;
+
+  return phoc_input_device_get_is_keyboard (self);
 }
 
