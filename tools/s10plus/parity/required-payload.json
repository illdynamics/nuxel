  "live_generations": {
    "A34": {
      "kind": "native build outputs",
      "manifest": "tools/s10plus/a34/build-a34.sh",
      "targets": [
        "/usr/lib/nuxel/nuxel-wl-fb",
        "/usr/local/bin/nuxel-wl-snapshot",
        "/usr/lib/nuxel/nuxel-button-manager"
      ]
    },
    "A37": {
      "kind": "live deploy manifest/evidence",
      "manifest": "tools/beta/live/deploy-manifest.json",
      "evidence": "docs/beta-finalization/live/evidence/deploy-20261019T151728+0200",
      "targets": [
        "/usr/share/nuxel/**",
        "/usr/lib/nuxel/nuxel-button-manager",
        "/usr/libexec/nuxel/nuxel-mp3-play"
      ]
    },
    "A39": {
      "kind": "Home PWA payload",
      "manifest": "tools/s10plus/a39/package-live.sh",
      "targets": [
        "/usr/share/nuxel/pwa/nuxel-home/**",
        "/usr/share/nuxel/assets/nuxel-bottom-bar*"
      ]
    },
    "A40": {
      "kind": "metrics/launcher payload",
      "manifest": "tools/s10plus/a40/package-live.sh",
      "targets": [
        "/usr/lib/nuxel/nuxel-metricsd",
        "/etc/systemd/system/nuxel-metrics.service",
        "/etc/systemd/system/nuxel-metrics.socket",
        "/usr/share/nuxel/pwa/nuxel-home/**"
      ]
    },
    "A43": {
      "kind": "release live-userspace payload",
      "manifest": "tools/s10plus/a43/package-live.py",
      "targets": [
        "/usr/share/nuxel/pwa/nuxel-home/**",
        "/usr/share/nuxel/pwa/nuxel-apps/settings/**",
        "/usr/bin/nuxel-bridge",
        "/usr/bin/nuxel-http-bridge"
      ]
    },
    "A44": {
      "kind": "icon delivery payload",
      "manifest": "tools/s10plus/a44/deploy-live.py",
      "targets": [
        "/usr/share/nuxel/nuxel-home/index.html",
        "/usr/share/nuxel/nuxel-home/icon-registry.json",
        "/usr/share/nuxel/nuxel-home/js/apps.js",
        "/usr/share/nuxel/nuxel-home/js/qs.js",
        "/usr/share/nuxel/pwa/nuxel-common/app-registry.json"
      ]
    }
  },
  "normalization": {
    "live_root": "/home/nuxel/nuxel",
    "image_root": "/usr/share/nuxel",
    "equivalent_services": [
      {
        "capability": "local PWA web endpoint",
        "live": "nuxel-wayland.service child python3 -m http.server 127.0.0.1:8000",
        "image": "nuxel-web.service (or nuxel-wayland fallback)",
        "why": "same loopback URL and docroot; the image prefers the hardened nuxel-web server"
      },
      {
        "capability": "display/UI",
        "live": "nuxel-wayland.service + nuxel-wl-fb.service + nuxel-pwa-host",
        "image": "nuxel-wayland.service + nuxel-wl-fb.service + nuxel-pwa-host",
        "why": "same three owners"
      },
      {
        "capability": "Wi-Fi metadata",
        "live": "nuxel-network-udev-seed.service enabled (oneshot inactive after boot)",
        "image": "nuxel-network-udev-seed.service enabled",
        "why": "RequiredBy=NetworkManager.service; active state is expected to be inactive/dead after the oneshot"
      }
    ],
    "not_required_on_fresh_image": [
      {
        "unit": "nuxel-bootmode-oneshot.service",
        "why": "live boot-flag consumer; enabled live but boots with no /var/lib/nuxel/boot and is not part of the stable launcher payload"
      },
      {
        "unit": "nuxel-animation.service",
        "why": "guarded and skipped whenever nuxel-wl-fb is installed; animation is owned by the initramfs"
      },
      {
        "unit": "nuxel-firstlight.service",
        "why": "diagnostic hardware probe; must not become a second /dev/fb0 owner on a launcher image"
      },
      {
        "unit": "nuxel-ui.service",
        "why": "deprecated A27 fbdev UI; initramfs installs it only as a guarded fallback"
      },
      {
        "unit": "nuxel-haptics-bridge.service",
        "why": "superseded by nuxel-haptics.service; disabled live"
      },
      {
        "unit": "nuxel-camera-portal.service",
        "why": "VM/portal surface, disabled live and not a phone boot unit"
      },
      {
        "unit": "nuxel-permd.service",
        "why": "native-shell permission broker, disabled live and unrelated to the PWA launcher"
      },
      {
        "unit": "nuxel-power-mode.service",
        "why": "optional hardware policy, disabled live"
      },
      {
        "unit": "nuxel-microsd-automount.service",
        "why": "static helper unit, not enabled live"
      },
      {
        "unit": "nuxel-rtc-check.timer",
        "why": "optional RTC diagnostic, disabled live"
      },
      {
        "unit": "nuxel-verbose-boot.service",
        "why": "diagnostic boot mode, disabled live"
      }
    ]
  }
}
