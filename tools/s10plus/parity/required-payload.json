{
  "schema": "nuxel.image-payload-parity/1",
  "release": "v0.6.3-beta",
  "description": "Normalized required userspace payload for a fresh S10+ Fedora 43 aarch64 image. The inventory is derived from the A34/A37/A39/A40/A43/A44 live payloads plus the services that are enabled or active on the handset.",
  "source_trees": [
    {
      "id": "pwa",
      "source": "pwa",
      "target": "/usr/share/nuxel/pwa",
      "required": true
    },
    {
      "id": "assets",
      "source": "assets",
      "target": "/usr/share/nuxel/assets",
      "required": true
    },
    {
      "id": "configs-nuxel",
      "source": "configs/nuxel",
      "target": "/etc/nuxel",
      "required": true,
      "exclude": [
        "app-registry/app_registry.json",
        "input/button-fsm.json",
        "buttons/reboot-gate.json",
        "keyboard/keyboard.json",
        "haptics/settings.json"
      ],
      "tree_digest": false
    }
  ],
