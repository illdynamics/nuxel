#!/usr/bin/env python3
"""nuxelctl — the Nuxel live-console control tool (A32).

Everything the graphical Nuxel Settings app can configure is configurable here,
through the SAME files and the SAME service channels - there is exactly one
settings system, not a UI path and a console path:

    /etc/nuxel/display/statusbar-safezones.json   status-bar zone editor (mission 9)
    /etc/nuxel/input/buttons.json                 hardware-button mapping (mission 13)

and live actions are delivered over the running services' own control FIFOs
(/run/nuxel-wl-fb.cmd for the display bridge, /run/nuxel-buttons.cmd for the
hardware-button manager), so a console command and a finger tap do the same thing.

Usage:
    nuxelctl status
    nuxelctl statusbar show
    nuxelctl statusbar zones 9,10            # block zones 9 and 10 (current orientation)
    nuxelctl statusbar preset right_camera|center_camera|left_camera|none|custom
    nuxelctl statusbar orientation portrait|landscape_left|landscape_right
    nuxelctl statusbar padding 8
    nuxelctl display off|on|toggle
    nuxelctl volume up|down|mute
    nuxelctl buttons list
    nuxelctl buttons set bixby_short open-terminal
    nuxelctl buttons set power_short screen-toggle
    nuxelctl buttons set bixby_short app:org.nuxel.Mail
    nuxelctl action open-terminal|home|search|settings
"""
import json
import os
import sys

ZONES_FILE = "/etc/nuxel/display/statusbar-safezones.json"
BUTTONS_FILE = "/etc/nuxel/input/buttons.json"
WLFB_FIFO = "/run/nuxel-wl-fb.cmd"
BUTTONS_FIFO = "/run/nuxel-buttons.cmd"
HOST_FIFO = "/run/nuxel-pwa-host.cmd"
STATE_FILES = {
    "display": "/var/lib/nuxel/display",
    "bridge": "/run/nuxel-wl-fb.state",
    "launcher": "/run/nuxel-home.state",
    "animation": "/var/lib/nuxel/animation",
    "buttons": "/var/lib/nuxel/buttons",
    "annotate": "/run/nuxel-anim-stop.confirmed",
}

DEFAULT_ZONES = {
    "schema_version": 1,
    "zones": 10,
    "profiles": {
        "s10plus": {"portrait": [9, 10], "landscape_left": [], "landscape_right": []},
        "pixel_center": {"portrait": [5, 6], "landscape_left": [], "landscape_right": []},
        "none": {"portrait": [], "landscape_left": [], "landscape_right": []},
        "left_camera": {"portrait": [1, 2], "landscape_left": [1, 2], "landscape_right": [9, 10]},
        "right_camera": {"portrait": [9, 10], "landscape_left": [9, 10], "landscape_right": [1, 2]},
    },
    "padding_dp": 6,
    "profile": "none",
    "orientation": "portrait",
    "custom": {"portrait": [], "landscape_left": [], "landscape_right": []},
}
DEFAULT_BUTTONS = {
    "schema_version": 1,
    "bixby_short": "open-terminal",
    "bixby_long": "disabled",
    "power_short": "screen-toggle",
    "power_long": "power-menu",
    "volume_up": "volume-up",
    "volume_down": "volume-down",
}
PRESET_ALIAS = {"right": "right_camera", "center": "pixel_center", "centre": "pixel_center",
                "left": "left_camera", "s10plus": "s10plus"}


def load(path, default):
    """Never overwrite a user's customisation: an absent file yields the default,
    a present file is read as-is (unknown keys preserved)."""
    try:
        with open(path) as f:
            doc = json.load(f)
        if not isinstance(doc, dict):
            raise ValueError("not an object")
        merged = json.loads(json.dumps(default))
        merged.update(doc)
        return merged
    except FileNotFoundError:
        return json.loads(json.dumps(default))
    except Exception as e:
        print("!! %s is not readable JSON (%s) — refusing to overwrite it" % (path, e))
        sys.exit(3)


def save(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print("saved %s" % path)


def fifo(path, line):
    try:
        fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
    except FileNotFoundError:
        print("!! %s is absent: the owning service is not running" % path)
        return 1
    try:
        os.write(fd, (line + "\n").encode())
    finally:
        os.close(fd)
    print("%s <- %s" % (path, line))
    return 0


def show_status():
    for name, path in STATE_FILES.items():
        try:
            with open(path) as f:
                print("--- %s (%s) ---\n%s" % (name, path, f.read().strip()))
        except OSError:
            print("--- %s (%s) ---\n(absent)" % (name, path))
    print("--- statusbar safe zones ---")
    doc = load(ZONES_FILE, DEFAULT_ZONES)
    ori = doc.get("orientation", "portrait")
    prof = doc.get("profile", "none")
    print("profile=%s orientation=%s padding_dp=%s blocked=%s"
          % (prof, ori, doc.get("padding_dp"), blocked_zones(doc, prof, ori)))
    print("--- buttons ---")
    print(json.dumps(load(BUTTONS_FILE, DEFAULT_BUTTONS), indent=2))
    return 0


def blocked_zones(doc, profile, orientation):
    if profile == "custom":
        return doc.get("custom", {}).get(orientation, [])
    p = doc.get("profiles", {}).get(PRESET_ALIAS.get(profile, profile))
    if not p:
        return []
    return p.get(orientation, [])


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv.pop(0)

    if cmd == "status":
        return show_status()

    if cmd == "statusbar":
        if not argv:
            print(__doc__)
            return 2
        sub = argv.pop(0)
        doc = load(ZONES_FILE, DEFAULT_ZONES)
        ori = doc.get("orientation", "portrait")
        if sub == "show":
            print(json.dumps(doc, indent=2))
            return 0
        if sub == "zones":
            if not argv:
                print("usage: nuxelctl statusbar zones 1,2,3"); return 2
            zones = [] if argv[0] in ("", "none") else [int(x) for x in argv[0].split(",") if x.strip()]
            for z in zones:
                if not 1 <= z <= 10:
                    print("!! zone %d out of range 1..10" % z); return 2
            doc["profile"] = "custom"
            doc.setdefault("custom", {})[ori] = sorted(set(zones))
            save(ZONES_FILE, doc)
            print("profile=custom orientation=%s blocked=%s" % (ori, doc["custom"][ori]))
            return 0
        if sub == "preset":
            if not argv: print("usage: nuxelctl statusbar preset <name>"); return 2
            name = PRESET_ALIAS.get(argv[0], argv[0])
            if name not in doc["profiles"] and name not in ("custom", "s10plus"):
                print("!! unknown preset %s (have: %s)" % (argv[0], ", ".join(doc["profiles"]))); return 2
            doc["profile"] = name
            save(ZONES_FILE, doc)
            print("profile=%s blocked=%s" % (name, blocked_zones(doc, name, ori)))
            return 0
        if sub == "orientation":
            if not argv: print("usage: nuxelctl statusbar orientation portrait|landscape_left|landscape_right"); return 2
            if argv[0] not in ("portrait", "landscape_left", "landscape_right"):
                print("!! orientation must be portrait|landscape_left|landscape_right"); return 2
            doc["orientation"] = argv[0]
            save(ZONES_FILE, doc)
            print("orientation=%s blocked=%s" % (argv[0], blocked_zones(doc, doc.get("profile", "none"), argv[0])))
            return 0
        if sub == "padding":
            if not argv: print("usage: nuxelctl statusbar padding <dp>"); return 2
            doc["padding_dp"] = int(argv[0])
            save(ZONES_FILE, doc)
            print("padding_dp=%s" % doc["padding_dp"])
            return 0
        print("!! unknown statusbar subcommand %s" % sub)
        return 2

    if cmd == "display":
        if not argv: print("usage: nuxelctl display off|on|toggle"); return 2
        return fifo(WLFB_FIFO, {"off": "screen-off", "on": "screen-on", "toggle": "screen-toggle"}.get(argv[0], argv[0]))

    if cmd == "volume":
        if not argv: print("usage: nuxelctl volume up|down|mute"); return 2
        return fifo(BUTTONS_FIFO, {"up": "volume-up", "down": "volume-down", "mute": "volume-mute"}.get(argv[0], argv[0]))

    if cmd == "buttons":
        if not argv: print("usage: nuxelctl buttons list|set <key> <action>"); return 2
        sub = argv.pop(0)
        doc = load(BUTTONS_FILE, DEFAULT_BUTTONS)
        if sub == "list":
            print(json.dumps(doc, indent=2))
            return 0
        if sub == "reload":
            return fifo(BUTTONS_FIFO, "reload")
        if sub == "set":
            if len(argv) < 2: print("usage: nuxelctl buttons set <key> <action>"); return 2
            key, val = argv[0], argv[1]
            if key not in DEFAULT_BUTTONS:
                print("!! unknown key %s (have: %s)"
                      % (key, ", ".join(k for k in DEFAULT_BUTTONS if k != "schema_version"))); return 2
            doc[key] = val
            save(BUTTONS_FILE, doc)
            print("%s=%s (the manager reloads it within 1 s)" % (key, val))
            return 0
        print("!! unknown buttons subcommand %s" % sub)
        return 2

    if cmd == "action":
        if not argv: print("usage: nuxelctl action <name>"); return 2
        if argv[0] in ("open-terminal", "close-terminal", "home"):
            return fifo(HOST_FIFO, argv[0])
        if argv[0].startswith("app:"):
            return fifo(HOST_FIFO, "launch " + argv[0][4:])
        return fifo(BUTTONS_FIFO, "action " + argv[0])

    print("!! unknown command %s" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main())
