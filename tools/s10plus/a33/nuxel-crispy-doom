#!/bin/sh
# Run the Flathub Crispy Doom binary with Nuxel's host sdl2-compat stack.
#
# The org.freedesktop.Platform 24.08 SDL2 Wayland backend on this 4.14
# vendor kernel creates an xdg_toplevel but never attaches a buffer.  The
# host Fedora sdl2-compat build presents the same Flathub binary correctly.
# The Flatpak install remains the authoritative source.
set -eu
if [ "$(id -u)" = "0" ]; then
    exec runuser -u nuxel -- "$0" "$@"
fi

APP=/var/lib/flatpak/app/io.github.fabiangreffrath.Doom/current/active/files
RUNTIME=""
for d in /var/lib/flatpak/runtime/org.freedesktop.Platform/aarch64/24.08/*/files; do
    [ -d "$d" ] && { RUNTIME="$d"; break; }
done
[ -n "$RUNTIME" ] || { echo "Crispy Doom: Flatpak runtime not found" >&2; exit 1; }
[ -x "$APP/bin/crispy-doom" ] || { echo "Crispy Doom: Flatpak binary not found" >&2; exit 1; }

export HOME=/home/nuxel
export XDG_RUNTIME_DIR=/run/user/1000
export WAYLAND_DISPLAY=wayland-0
export XDG_SESSION_TYPE=wayland
export XDG_DATA_HOME=/home/nuxel/.var/app/io.github.fabiangreffrath.Doom/data
export XDG_CONFIG_HOME=/home/nuxel/.var/app/io.github.fabiangreffrath.Doom/config
export XDG_CACHE_HOME=/home/nuxel/.var/app/io.github.fabiangreffrath.Doom/cache
export XDG_STATE_HOME=/home/nuxel/.var/app/io.github.fabiangreffrath.Doom/.local/state
export DOOMWADDIR=/home/nuxel/doom
export PULSE_SERVER="${PULSE_SERVER:-unix:/run/nuxel-wayland/pulse/native}"
export PIPEWIRE_RUNTIME_DIR=/run/nuxel-wayland
export SDL_VIDEODRIVER=wayland
export SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=0
export LD_LIBRARY_PATH="/lib64:/usr/lib64:$RUNTIME/lib/aarch64-linux-gnu"

if [ "${1:-}" = "--setup" ]; then
    shift
    exec "$APP/bin/crispy-doom-setup" "$@"
fi

# Sound is ON by default.  Use the same session PulseAudio socket the rest of
# Nuxel uses (PipeWire provides it); no ALSA device name is hardcoded.  A user
# may still opt out explicitly with NUXEL_DOOM_SOUND=0, which is the only path
# that adds -nosound.
PULSE_SOCKET="${PULSE_SERVER#unix:}"
case "$PULSE_SOCKET" in /*) ;; *) PULSE_SOCKET=/run/nuxel-wayland/pulse/native ;; esac
i=0
while [ "$i" -lt 30 ] && [ ! -S "$PULSE_SOCKET" ]; do
    i=$((i + 1)); sleep 0.1
done
[ -S "$PULSE_SOCKET" ] || echo "Nuxel Crispy Doom: audio socket not ready; using SDL fallback" >&2
if [ "${NUXEL_DOOM_SOUND:-1}" = "0" ]; then
    exec "$APP/bin/crispy-doom" -nosound "$@"
fi
exec "$APP/bin/crispy-doom" "$@"
