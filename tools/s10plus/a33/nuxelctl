def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv.pop(0)

    # P3 subsystems: one implementation each, delegated to the shipped tool so a
    # console command and the diagnostic can never produce different answers.
    if cmd in PASSTHROUGH:
        return delegate(PASSTHROUGH[cmd], argv, ROOT)

    if cmd == "orientation":
        return cmd_orientation(argv)

    if cmd == "status":
        return show_status()

    if cmd == "verbose-boot":
        if not argv or argv[0] in ("status", "show"):
            return _verbose_status()
        if argv[0] in ("on", "enable", "true", "1"):
            rc = _verbose_set(True)
            _verbose_status()
            return rc
        if argv[0] in ("off", "disable", "false", "0"):
            rc = _verbose_set(False)
            _verbose_status()
            return rc
        if argv[0] in ("animation", "anim"):
            if len(argv) < 2:
                d = _verbose_doc()
                print("animation_mode=%s" % d.get("animation_mode", "standard (default)"))
                print("usage: nuxelctl verbose-boot animation standard|short|off")
                return 0
            rc = _verbose_animation(argv[1])
            _verbose_status()
            return rc
        if argv[0] in ("verbosity", "verbose-level", "level"):
            if len(argv) < 2:
                d = _verbose_doc()
                print("verbosity_level=%s" % d.get("verbosity_level", "1 (default)"))
                print("usage: nuxelctl verbose-boot verbosity 0|1|2|3")
                return 0
            rc = _verbose_verbosity(argv[1])
            _verbose_status()
            return rc
        if argv[0] in ("override", "bixby"):
            rc = _verbose_status()
            print("one-time Bixby-hold override: honoured only when the early boot stage "
                  "publishes bixby-hold-override=1; otherwise BOOT_UPDATE_REQUIRED "
                  "(no BOOT partition write is performed by this mission).")
            print("userspace fallback (no BOOT partition write): 'nuxelctl verbose-boot on', "
                  "the Settings -> Developer -> Boot toggle, or the Quick Settings tile.")
            return rc
        print("usage: nuxelctl verbose-boot status|on|off|animation MODE|verbosity N|override")
        return 2

    if cmd == "handoff":
        sub = argv[0] if argv else "status"
        harness = _handoff_harness()
        if sub == "status":
            return _handoff_status()
        if sub in ("simulate", "audit"):
            if not harness:
                print("!! handoff harness not installed (%s)" % HANDOFF_HARNESS)
                return 1
            args = [harness, sub] + argv[1:]
            if sub == "audit" and "--root" not in args:
                args += ["--root", ROOT or "/"]
            if harness.endswith(".py"):
                return subprocess.call([sys.executable, harness] + args)
            return subprocess.call([harness] + args)
        print("usage: nuxelctl handoff status|simulate|audit")
        return 2

    if cmd == "statusbar":
        if not argv:
            print(__doc__)
            return 2
        sub = argv.pop(0)
        doc = load(ZONES_FILE, DEFAULT_ZONES)
        ori = doc.get("orientation", "portrait")
        if sub == "show":
            print(json.dumps(doc, indent=2))
            return 0
        if sub == "zones":
            if not argv:
                print("usage: nuxelctl statusbar zones 1,2,3"); return 2
            zones = [] if argv[0] in ("", "none") else [int(x) for x in argv[0].split(",") if x.strip()]
            for z in zones:
                if not 1 <= z <= 10:
                    print("!! zone %d out of range 1..10" % z); return 2
            doc["profile"] = "custom"
            doc.setdefault("custom", {})[ori] = sorted(set(zones))
            save(ZONES_FILE, doc)
            print("profile=custom orientation=%s blocked=%s" % (ori, doc["custom"][ori]))
            return 0
        if sub == "preset":
            if not argv: print("usage: nuxelctl statusbar preset <name>"); return 2
            name = PRESET_ALIAS.get(argv[0], argv[0])
            if name not in doc["profiles"] and name not in ("custom", "s10plus"):
                print("!! unknown preset %s (have: %s)" % (argv[0], ", ".join(doc["profiles"]))); return 2
            doc["profile"] = name
            save(ZONES_FILE, doc)
            print("profile=%s blocked=%s" % (name, blocked_zones(doc, name, ori)))
            return 0
        if sub == "orientation":
            if not argv: print("usage: nuxelctl statusbar orientation portrait|landscape_left|landscape_right"); return 2
            if argv[0] not in ("portrait", "landscape_left", "landscape_right"):
                print("!! orientation must be portrait|landscape_left|landscape_right"); return 2
            doc["orientation"] = argv[0]
            save(ZONES_FILE, doc)
            print("orientation=%s blocked=%s" % (argv[0], blocked_zones(doc, doc.get("profile", "none"), argv[0])))
            return 0
        if sub == "padding":
            if not argv: print("usage: nuxelctl statusbar padding <dp>"); return 2
            doc["padding_dp"] = int(argv[0])
            save(ZONES_FILE, doc)
            print("padding_dp=%s" % doc["padding_dp"])
            return 0
        print("!! unknown statusbar subcommand %s" % sub)
        return 2

    if cmd == "display":
        if not argv: print("usage: nuxelctl display off|on|toggle"); return 2
        return fifo(WLFB_FIFO, {"off": "screen-off", "on": "screen-on", "toggle": "screen-toggle"}.get(argv[0], argv[0]))

    if cmd == "volume":
        if not argv: print("usage: nuxelctl volume up|down|mute"); return 2
        return fifo(BUTTONS_FIFO, {"up": "volume-up", "down": "volume-down", "mute": "volume-mute"}.get(argv[0], argv[0]))

    if cmd == "buttons":
        if not argv: print("usage: nuxelctl buttons list|set <key> <action>"); return 2
        sub = argv.pop(0)
        doc = load(BUTTONS_FILE, DEFAULT_BUTTONS)
        if sub == "list":
            print(json.dumps(doc, indent=2))
            return 0
        if sub == "reload":
            return fifo(BUTTONS_FIFO, "reload")
        if sub == "fsm":
            return _buttons_fsm()
        if sub == "menu":
            return _buttons_menu()
        if sub in ("gates", "gate"):
            return _buttons_gates()
        if sub == "set":
            if len(argv) < 2: print("usage: nuxelctl buttons set <key> <action>"); return 2
            key, val = argv[0], argv[1]
            if key not in DEFAULT_BUTTONS:
                print("!! unknown key %s (have: %s)"
                      % (key, ", ".join(k for k in DEFAULT_BUTTONS if k != "schema_version"))); return 2
            doc[key] = val
            save(BUTTONS_FILE, doc)
            print("%s=%s (the manager reloads it within 1 s)" % (key, val))
            return 0
        print("!! unknown buttons subcommand %s" % sub)
        return 2

    if cmd == "action":
        if not argv: print("usage: nuxelctl action <name>"); return 2
        if argv[0] in ("open-terminal", "close-terminal", "home"):
            return fifo(HOST_FIFO, argv[0])
        if argv[0].startswith("app:"):
            return fifo(HOST_FIFO, "launch " + argv[0][4:])
        return fifo(BUTTONS_FIFO, "action " + argv[0])

    print("!! unknown command %s" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main())
