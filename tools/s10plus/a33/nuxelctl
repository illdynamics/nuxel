def _buttons_gates():
    gate = _gate_doc()
    policy = None
    try:
        with open(P(REBOOT_POLICY)) as f:
            policy = json.load(f)
    except (OSError, ValueError):
        policy = None
    print("gate file: %s" % REBOOT_GATE)
    print("  enabled=%s allow_restart=%s allow_poweroff=%s min_interval_s=%s max_per_hour=%s"
          % (gate.get("enabled"), gate.get("allow_restart"), gate.get("allow_poweroff"),
             gate.get("min_interval_s"), gate.get("max_reboots_per_hour")))
    if policy is None:
        print("policy file: %s (absent — bg-09's policy is an AND condition, not an override)"
              % REBOOT_POLICY)
    else:
        print("policy file: %s allow_reboot=%s reason=%s"
              % (REBOOT_POLICY, policy.get("allow_reboot"), policy.get("reason", "-")))
    allowed = bool(gate.get("enabled")) and (bool(gate.get("allow_restart")) or
                                             bool(gate.get("allow_poweroff")))
    if policy is not None and not policy.get("allow_reboot"):
        allowed = False
    print("verdict: %s" % ("a restart/power-off MAY execute (all conditions met)" if allowed
                           else "REFUSED by default — %s" % gate.get("refusal_reason", "gate closed")))
    print("A very-long power press (>= %ss) emits reboot-request; the gate above decides."
          % (spec_very_long() / 1000.0))
    return 0


