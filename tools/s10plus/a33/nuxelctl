def sibling_script(name):
    """Locate a shipped diagnostic next to this tool (dev tree), then in the
    installed locations. Returns None when it is not installed, and the caller
    must say so instead of silently doing nothing."""
    here = os.path.dirname(os.path.abspath(__file__))
    for c in (os.path.join(here, name), "/usr/lib/nuxel/" + name, "/usr/bin/" + name,
              "/usr/local/lib/nuxel/" + name):
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    for c in (os.path.join(here, name), "/usr/lib/nuxel/" + name, "/usr/bin/" + name):
        if os.path.isfile(c):
            return c
    return None


def delegate(name, args, root=None):
    script = sibling_script(name)
    if not script:
        print("!! %s is not installed (looked next to %s, /usr/lib/nuxel, /usr/bin)"
              % (name, os.path.abspath(__file__)))
        print("   Nothing was executed. This is a missing-tool finding, not a result.")
        return 127
    argv = [script]
    if root and root not in ("/", ""):
        argv += ["--root", root]
    argv += args
    if script.endswith(".py"):
        argv = [sys.executable] + argv
    try:
        return subprocess.call(argv)
    except OSError as e:
        print("!! cannot execute %s: %s" % (script, e))
        return 126




ORIENTATIOND_CANDIDATES = (
    "/usr/libexec/nuxel/nuxel-orientationd",
