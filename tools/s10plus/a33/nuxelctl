def cmd_orientation(args):
    """Delegate to the ONE orientation policy implementation (nuxel-orientationd).

    Shares the daemon's state file with Quick Settings and Settings, so the
    console and the UI can never disagree. The daemon resolves paths through
    NUXEL_ROOT, exactly like nuxelctl itself.
    """
    script = None
    for c in ORIENTATIOND_CANDIDATES:
        if os.path.isfile(c):
            script = os.path.abspath(c)
            break
    if not script:
        print("!! nuxel-orientationd is not installed (searched %s)" %
              ", ".join(ORIENTATIOND_CANDIDATES))
        return 127
    env = dict(os.environ)
    env["NUXEL_ROOT"] = ROOT
    return subprocess.call([sys.executable, script] + args, env=env)


