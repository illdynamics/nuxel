def _verbose_consumer():
    """The consumer script that owns the decision logic (single implementation)."""
    cand = [VERBOSE_SVC, VERBOSE_SVC + ".py"]
    here = os.path.dirname(os.path.abspath(__file__))
    cand += [os.path.join(here, "nuxel-verbose-boot.py"), os.path.join(here, "nuxel-verbose-boot")]
    for c in cand:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    for c in cand:
        if os.path.isfile(c):
            return c
    return None


def _verbose_status():
    svc = _verbose_consumer()
    if not svc:
        print("!! nuxel-verbose-boot not installed")
        return 1
    try:
        out = subprocess.run([svc, "--status"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        print("!! cannot run %s: %s" % (svc, e))
        return 1
    sys.stdout.write(out.stdout)
    if out.returncode:
        sys.stderr.write(out.stderr)
    return out.returncode


ANIMATION_MODES = ("standard", "short", "off")
VERBOSITY_MIN, VERBOSITY_MAX = 0, 3


def _verbose_doc():
    """Best-effort read of the durable boot-diagnostics document (never raises)."""
    try:
        with open(P(VERBOSE_CFG)) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _verbose_write(patch):
    """Atomically MERGE `patch` into the durable boot-diagnostics document,
    preserving every key this revision does not know about.  This is the SAME
    file the Settings UI writes through NuxelHost.configSet('verbose-boot') and
    the Quick Settings tile writes through NuxelSettings, so a console command
    and a finger tap cannot diverge - and an older/newer launcher cannot clobber
    the operator's choice."""
    path = P(VERBOSE_CFG)
    doc = {}
    try:
        with open(path) as f:
            doc = json.load(f)
        if not isinstance(doc, dict):
            raise ValueError("not an object")
    except FileNotFoundError:
        doc = {"schema_version": 1}
    except ValueError as e:
        print("!! %s is not a readable JSON object (%s) - refusing to overwrite it" % (VERBOSE_CFG, e))
        return 3
    doc["schema_version"] = doc.get("schema_version", 1)
    doc.update(patch)
    doc["set_by"] = "user"
    doc["updated_at"] = int(__import__("time").time())
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print("saved %s (%s)" % (VERBOSE_CFG, ", ".join("%s=%s" % kv for kv in sorted(patch.items()))))
    return 0


def _verbose_set(value):
    """The verbose-boot control (on-glass boot log)."""
    rc = _verbose_write({"verbose_boot": bool(value)})
    if rc:
        return rc
    print("applies from the NEXT boot; the on-glass boot log is shown by the launcher, and "
          "the boot animation is shortened only while verbose boot is on "
          "(animation_mode=standard,short,off overrides that).")
    return 0


def _verbose_animation(mode):
    """The standard-animation control: standard | short | off."""
    m = (mode or "").strip().lower()
    if m not in ANIMATION_MODES:
        print("!! animation_mode must be one of: %s" % ", ".join(ANIMATION_MODES))
        return 2
    rc = _verbose_write({"animation_mode": m})
    if rc:
        return rc
    print("animation policy: standard = full 192-frame 24 fps animation with the "
          "minimum-cycle handoff; short = trade the animation for the earliest handoff; "
          "off = no animation. Precedence: off > short > verbose_boot > standard.")
    return 0


def _verbose_verbosity(level):
    """The verbosity-level control: 0 (quiet) .. 3 (debug)."""
    try:
        n = int(str(level).strip())
    except (TypeError, ValueError):
        print("!! verbosity_level must be an integer %d..%d" % (VERBOSITY_MIN, VERBOSITY_MAX))
        return 2
    if n < VERBOSITY_MIN or n > VERBOSITY_MAX:
        print("!! verbosity_level must be %d..%d (got %d) - refused, not clamped silently"
              % (VERBOSITY_MIN, VERBOSITY_MAX, n))
        return 2
    rc = _verbose_write({"verbosity_level": n})
    if rc:
        return rc
    print("how much the boot log says, not whether it is shown (that is verbose-boot on|off).")
    return 0


