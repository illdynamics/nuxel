#!/usr/bin/python3
"""Nuxel Doom Launcher - a touch-first GTK4 WAD picker for Crispy Doom.

This is the "Linux Doom Launcher" option for Nuxel: a small Python + GTK4
frontend that scans the phone for WADs, presents them as full-width touch
targets, and starts the installed Crispy Doom binary fullscreen on the current
Phoc output.  It deliberately has no non-GTK dependencies.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

# Keep the launcher on the same software path the Nuxel home surface uses.
# The vendor kernel has no usable DRM/GBM node for a GTK GL context.
