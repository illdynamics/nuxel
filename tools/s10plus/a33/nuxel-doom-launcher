    Path("/usr/share/games/doom"),
    Path("/usr/share/doom"),
    Path("/usr/local/share/doom"),
]

PRETTY_NAMES = {
    "freedoom1": "Freedoom: Phase 1",
    "freedoom2": "Freedoom: Phase 2",
    "doom": "Doom (shareware)",
    "doom1": "Doom (shareware)",
    "doom2": "Doom II",
    "tnt": "TNT: Evilution",
    "plutonia": "The Plutonia Experiment",
    "heretic": "Heretic",
    "hexen": "Hexen",
    "strife": "Strife",
}


def log(message: str) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S%z"), message))
    except OSError:
        pass


def load_config() -> dict:
    defaults = {"fullscreen": True, "sound": False, "aspect": True, "extra_wads": []}
    try:
        doc = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        if isinstance(doc, dict):
            defaults.update(doc)
    except (OSError, ValueError):
        pass
    if not isinstance(defaults.get("extra_wads"), list):
        defaults["extra_wads"] = []
    return defaults


def save_config(cfg: dict) -> None:
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CONFIG_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps(cfg, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        tmp.replace(CONFIG_PATH)
    except OSError as exc:
        log("config save failed: %s" % exc)


def human_mb(size: int) -> str:
    if size >= 1024 * 1024:
        return "%.1f MB" % (size / (1024.0 * 1024.0))
    return "%.0f KB" % (size / 1024.0)


def wad_metadata(path: Path) -> dict:
    """Read the WAD directory without loading the whole file."""
    meta = {"magic": "WAD", "tags": [], "lumps": 0}
    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            header = fh.read(12)
            if len(header) < 12:
                return meta
            magic = header[:4]
            if magic not in (b"IWAD", b"PWAD"):
                return meta
            count = int.from_bytes(header[4:8], "little")
            offset = int.from_bytes(header[8:12], "little")
            names = []
            if 0 < count <= 65535:
                fh.seek(offset)
                for _ in range(min(count, 4096)):
                    entry = fh.read(16)
                    if len(entry) < 16:
                        break
                    names.append(entry[8:16].rstrip(b"\x00").decode("ascii", "replace"))
    except OSError:
        return meta
    tags = ["IWAD" if magic == b"IWAD" else "PWAD"]
    if any(n in ("E1M1", "E2M1", "E3M1", "E4M1") for n in names):
        tags.append("Doom 1")
    if "MAP01" in names:
        tags.append("Doom 2 / Hexen")
    if any(n in ("FREEDOOM", "FREEDM") for n in names):
        tags.append("Freedoom")
    if any(n.startswith("TXT_") for n in names):
        tags.append("Hexen")
    if "S_START" in names and "E1M1" not in names and "MAP01" not in names:
        tags.append("resource")
    return {"magic": magic.decode("ascii"), "tags": tags, "lumps": count, "size": size}


def pretty_name(path: Path) -> str:
    stem = path.stem
    return PRETTY_NAMES.get(stem.lower(), stem.replace("_", " ").replace("-", " ").title())


def scan_wads(extra: list[str]) -> list[dict]:
    found: dict[str, dict] = {}
    roots = list(SEARCH_DIRS)
    for raw in extra:
        try:
            p = Path(raw).expanduser()
        except (TypeError, ValueError):
            continue
        if p.is_file():
            roots.append(p.parent)
        elif p.is_dir():
            roots.append(p)
    for root in roots:
        try:
            if not root.is_dir():
                continue
            # Keep the scan bounded: no hidden trees, no deep system walks.
            candidates = list(root.glob("*")) + list(root.glob("*/*"))
        except OSError:
            continue
        for path in candidates:
            try:
                if not path.is_file() or path.name.startswith("."):
                    continue
                if path.suffix not in WAD_SUFFIXES:
                    continue
                real = str(path.resolve())
                if real in found:
                    continue
                meta = wad_metadata(path)
                if meta.get("magic") not in ("IWAD", "PWAD"):
                    continue
                found[real] = {
                    "path": real,
                    "name": pretty_name(path),
                    "meta": meta,
                    "size": meta.get("size", 0),
                }
            except OSError:
                continue
    return sorted(found.values(), key=lambda w: (w["name"].lower(), w["path"]))


