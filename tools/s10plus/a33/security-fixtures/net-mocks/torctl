#!/usr/bin/env python3
# Offline stand-in for shell/nuxel-shell/nuxel-privacy/tor-control.py (briq-05c).
# Reads NUXEL_MOCK_NET_MODE so the wrapper tool can be tested without Tor.
import json
import os
import sys

MODE = os.environ.get("NUXEL_MOCK_NET_MODE", "off")
args = sys.argv[1:]
cmd = args[-1] if args else "circuits"
as_json = "--json" in args


def emit(doc, code=0):
    if as_json:
        print(json.dumps(doc, indent=2, sort_keys=True))
    else:
        for k, v in sorted(doc.items()):
            print("%s=%s" % (k, v))
    sys.exit(code)


if MODE == "tor-up-circuits":
    emit({"control_port_authenticated": True, "version": "0.4.8.10-mock",
          "circuits_total": 3, "circuits_built": 2,
          "circuits": [{"id": "1", "state": "BUILT", "purpose": "GENERAL"},
                       {"id": "2", "state": "BUILT", "purpose": "GENERAL"}],
          "source": "mock tor control port"})
elif MODE == "tor-up-nocircuits":
    emit({"control_port_authenticated": True, "version": "0.4.8.10-mock",
          "circuits_total": 0, "circuits_built": 0, "circuits": [],
          "source": "mock tor control port"})
else:
    emit({"control_port_authenticated": False, "circuits_built": None,
          "error": "mock: control port not reachable (mode=%s)" % MODE,
          "source": "mock tor control port (unavailable)"}, code=2)
