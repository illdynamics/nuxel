#!/bin/bash
# Offline stand-in for wg (briq-05c tests). Reads NUXEL_MOCK_NET_MODE.
MODE="${NUXEL_MOCK_NET_MODE:-off}"
cmd="${1-}"; shift || true
iface="${1-}"
shift || true
sub="${1-}"
case "$MODE" in
    vpn-up*) ;;   # tunnel present
    *) echo "Unable to access interface: No such device" >&2; exit 1 ;;
esac
case "$cmd" in
    show)
        # After consuming `show` and the interface, $1 is the subcommand.
        # Previous code tested the interface name here, so every handshake
        # lookup fell through to the interface dump and was read as "never".
        case "$sub" in
            latest-handshakes)
                if [ "$MODE" = "vpn-up-handshake" ]; then
                    printf 'ZmFrZXB1YmtleWJhc2U2NDAwMDAwMDAwMDAwMDAwMDA=\t1712345678\n'
                else
                    printf 'ZmFrZXB1YmtleWJhc2U2NDAwMDAwMDAwMDAwMDAwMDA=\t0\n'
                fi
                exit 0 ;;
            *)
                echo "interface: $iface"
                echo "  public key: ZmFrZXB1YmtleWJhc2U2NDAwMDAwMDAwMDAwMDAwMDA="
                exit 0 ;;
        esac ;;
    *) exit 0 ;;
esac
