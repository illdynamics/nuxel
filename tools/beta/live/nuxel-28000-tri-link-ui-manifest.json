          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console/app.json"
        },
        {
          "source": "pwa/nuxel-apps/console/console.css",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console/console.css"
        },
        {
          "source": "pwa/nuxel-apps/console/console.js",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console/console.js"
        },
        {
          "source": "pwa/nuxel-apps/console/icons/icon.svg",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console/icons/icon.svg"
