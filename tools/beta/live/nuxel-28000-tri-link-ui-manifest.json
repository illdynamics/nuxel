        {
          "source": "pwa/nuxel-apps/console-wifi/manifest.json",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-wifi/manifest.json"
        },
        {
          "source": "pwa/nuxel-apps/console-wifi/app.json",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-wifi/app.json"
        },
        {
          "source": "pwa/nuxel-apps/console-wifi/icons/icon.svg",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-wifi/icons/icon.svg"
        },
        {
          "source": "assets/nuxel-applications-icon-pack/05-05_live-console.png",
          "target": "/home/nuxel/nuxel/assets/nuxel-applications-icon-pack/05-05_live-console.png"
        },
        {
          "source": "assets/nuxel-applications-icon-pack/06-05_usb-connection.png",
          "target": "/home/nuxel/nuxel/assets/nuxel-applications-icon-pack/06-05_usb-connection.png"
        },
        {
          "source": "assets/nuxel-quicksettings-icon-pack/01-wifi.png",
          "target": "/home/nuxel/nuxel/assets/nuxel-quicksettings-icon-pack/01-wifi.png"
        }
      ],
      "declared_reload": "python3 -c \"import json;json.load(open('/usr/share/nuxel/pwa/nuxel-common/app-registry.json'))\""
    },
    {
      "id": "tri-link-status-api",
      "component": "nuxel-http-bridge read-only Tri-Link status endpoint",
      "priority": 2,
      "risk": "medium",
      "restart_service": "nuxel-http-bridge",
      "pre": [
        "test -x /usr/bin/nuxel-http-bridge",
        "test -d /usr/lib/nuxel/nuxel-bridge"
      ],
      "health_check": "test -s /usr/lib/nuxel/nuxel-bridge/tri_link_status.py && curl -fsS http://127.0.0.1:8080/api/v1/system/tri-link | grep -q '\"transports\"'",
      "rollback": "restore /usr/lib/nuxel/nuxel-bridge/api.py.nuxel-rollback and tri_link_status.py.nuxel-rollback (or remove a newly-created module), then `systemctl restart nuxel-http-bridge`; the serial console and sshd are not touched",
      "files": [
        {
          "source": "services/nuxel-bridge/src/api.py",
          "target": "/usr/lib/nuxel/nuxel-bridge/api.py"
        },
        {
          "source": "services/nuxel-bridge/src/tri_link_status.py",
          "target": "/usr/lib/nuxel/nuxel-bridge/tri_link_status.py"
        }
      ]
    }
  ]
