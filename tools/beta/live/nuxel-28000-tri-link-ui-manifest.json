        {
          "source": "pwa/nuxel-apps/console-usb/index.html",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-usb/index.html"
        },
        {
          "source": "pwa/nuxel-apps/console-usb/manifest.json",
