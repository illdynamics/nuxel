{
  "schema_version": 1,
  "id": "nuxel-28000-tri-link-ui",
  "device": {
    "codename": "beyond2lte",
    "model": "SM-G975F",
    "soc": "Exynos 9820",
    "os": "Nuxel (Fedora 43 ARM64, kernel 4.14.253)"
  },
  "note": "NUXEL-28000 Applications-window Tri-Link entries, unlock-to-Home fix and read-only transport status. Every file is staged, SHA-256 verified, installed atomically and rolled back by nuxel-live-deploy.py. No kernel, partition, modem or USB gadget mutation is included.",
  "target_root_map": {
    "/home/nuxel/nuxel": "/usr/share/nuxel"
  },
  "groups": [
    {
      "id": "tri-link-pwa",
      "component": "Nuxel Home + three Tri-Link PWA console entries",
      "priority": 1,
      "risk": "low",
      "restart_service": null,
      "pre": [],
      "health_check": "test \"$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/pwa/nuxel-home/index.html)\" = 200 && test \"$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/pwa/nuxel-apps/console/index.html)\" = 200 && test \"$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/pwa/nuxel-apps/console-usb/index.html)\" = 200 && test \"$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/pwa/nuxel-apps/console-wifi/index.html)\" = 200",
      "rollback": "restore every <target>.nuxel-rollback; these are static files under /usr/share/nuxel served by the running nuxel-session fallback, so no service restart is required",
      "files": [
        {
          "source": "pwa/nuxel-home/index.html",
          "target": "/home/nuxel/nuxel/pwa/nuxel-home/index.html"
        },
        {
          "source": "pwa/nuxel-home/manifest.json",
          "target": "/home/nuxel/nuxel/pwa/nuxel-home/manifest.json"
        },
        {
          "source": "pwa/nuxel-home/sw.js",
          "target": "/home/nuxel/nuxel/pwa/nuxel-home/sw.js"
        },
        {
          "source": "pwa/nuxel-home/js/app.js",
          "target": "/home/nuxel/nuxel/pwa/nuxel-home/js/app.js"
        },
        {
          "source": "pwa/nuxel-home/js/apps.js",
          "target": "/home/nuxel/nuxel/pwa/nuxel-home/js/apps.js"
        },
        {
          "source": "pwa/nuxel-common/app-registry.json",
          "target": "/home/nuxel/nuxel/pwa/nuxel-common/app-registry.json"
        },
        {
          "source": "pwa/nuxel-common/bridge.js",
          "target": "/home/nuxel/nuxel/pwa/nuxel-common/bridge.js"
        },
        {
          "source": "pwa/nuxel-apps/console/index.html",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console/index.html"
        },
        {
          "source": "pwa/nuxel-apps/console/manifest.json",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console/manifest.json"
        },
        {
