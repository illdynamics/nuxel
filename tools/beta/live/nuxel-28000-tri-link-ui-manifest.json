        {
          "source": "pwa/nuxel-apps/console-usb/app.json",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-usb/app.json"
        },
        {
          "source": "pwa/nuxel-apps/console-usb/icons/icon.svg",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-usb/icons/icon.svg"
        },
        {
          "source": "pwa/nuxel-apps/console-wifi/index.html",
          "target": "/home/nuxel/nuxel/pwa/nuxel-apps/console-wifi/index.html"
