#!/usr/bin/env python3
"""nuxel-orientationd - the ONE authoritative orientation owner.

Seven stable modes, exact owner-facing labels, one policy implementation.  The
daemon owns persistence, the compositor transform, the continuous sensor loop
for auto modes, the visible trial/rollback transaction and truthful status.

Design rules this file enforces:
  * a persisted mode is not the same thing as an applied transform;
  * manual modes work with no accelerometer;
  * a real sensor is required for an auto mode to move the screen;
  * every mode change is a bounded trial that rolls back on ``no``, a saved
    blank answer, timeout, compositor loss or daemon restart;
  * one process owns the loop.  UI clients only read status and send requests.
"""
from __future__ import annotations

