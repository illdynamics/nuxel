#!/bin/sh
# Nuxel static PWA web server.
#
# ONE canonical docroot resolution, so the same unit works on both layouts the
# repository actually uses:
#   1. $NUXEL_WEBROOT (set via /etc/nuxel/web.conf or the unit environment)
#   2. /usr/share/nuxel      — the phone rootfs (pwa/ tree staged by the builder)
#   3. /home/nuxel/nuxel     — the flash-free VM/handset deploy mirror
#
# The interpreter is overridable (NUXEL_WEB_PYTHON) so the server can be started
# unchanged by the offline test suite (tools/s10plus/a33/tests/test-web-server.py)
# on a development host whose python3 is not /usr/bin/python3. The unit does not
# set it, so the phone always uses /usr/bin/python3 from the python3 RPM.
#
# Serving from the tree ROOT (not the launcher directory) is REQUIRED: the
# launcher's index.html imports `../nuxel-common/bridge.js`, a relative ES-module
# reference enforced by pwa/nuxel-common/verify-wiring.js.  The launcher is
# therefore served at /pwa/nuxel-home/index.html.
set -eu
PORT="${NUXEL_WEB_PORT:-8000}"
BIND="${NUXEL_WEB_BIND:-127.0.0.1}"
ROOT="${NUXEL_WEBROOT:-}"
if [ -z "$ROOT" ]; then
  for cand in /usr/share/nuxel /home/nuxel/nuxel; do
    if [ -f "$cand/pwa/nuxel-home/index.html" ] || [ -f "$cand/nuxel-home/index.html" ]; then ROOT="$cand"; break; fi
  done
fi
[ -n "$ROOT" ] || { echo "nuxel-web: no docroot with a launcher index.html (set NUXEL_WEBROOT)" >&2; exit 1; }
# An explicit docroot is verified, not trusted: serving a root that has no
# launcher (measured A29b failure mode) renders a blank WebKit view with a 404
# the unit never notices, so it is a start failure here instead.
if [ ! -f "$ROOT/pwa/nuxel-home/index.html" ] && [ ! -f "$ROOT/nuxel-home/index.html" ]; then
  echo "nuxel-web: ERROR: $ROOT contains no launcher index.html (expected pwa/nuxel-home/index.html)" >&2
  exit 1
fi
[ -f "$ROOT/pwa/nuxel-common/bridge.js" ] || echo "nuxel-web: WARNING: $ROOT/pwa/nuxel-common/bridge.js missing - the launcher's ES module will 404" >&2
echo "nuxel-web: serving $ROOT on $BIND:$PORT"
PY="${NUXEL_WEB_PYTHON:-/usr/bin/python3}"

# The static server (briq-04c rev 2). `python3 -m http.server` is a development
# server: no Cache-Control, no ETag, no Service-Worker-Allowed and no threading,
# which is what made a stale service worker and slow launcher loads possible.
# nuxel-web-server.py provides the MIME/news, service-worker and cache policy the
# PWA tree needs. Resolution order (no env var needed on the phone):
#   1. $NUXEL_WEB_SERVER                       (tests / owner troubleshooting)
#   2. /usr/lib/nuxel/nuxel-web-server.py      (how the rootfs builder installs it)
#   3. <dir of this shim>/nuxel-web-server.py  (repository / deploy mirror layout)
SERVER="${NUXEL_WEB_SERVER:-}"
if [ -z "$SERVER" ]; then
  for _cand in /usr/lib/nuxel/nuxel-web-server.py "$(dirname "$0")/nuxel-web-server.py"; do
    if [ -f "$_cand" ]; then SERVER="$_cand"; break; fi
  done
fi

if [ -n "$SERVER" ] && [ -f "$SERVER" ]; then
  # The docroot was resolved AND verified above; hand the verified path to the
  # server so there is exactly one root-resolution rule in the system.
  NUXEL_WEBROOT="$ROOT" NUXEL_WEB_PORT="$PORT" NUXEL_WEB_BIND="$BIND" \
    exec "$PY" "$SERVER"
fi

echo "nuxel-web: WARNING: nuxel-web-server.py not found - falling back to 'python3 -m http.server', which serves the tree but sends NO Cache-Control, NO ETag and NO Service-Worker-Allowed header (a stale service worker is then possible)" >&2
cd "$ROOT"
exec "$PY" -m http.server "$PORT" --bind "$BIND"
