[Unit]
Description=Nuxel startup cue after confirmed boot-animation to launcher handoff
After=nuxel-wayland.service nuxel-wl-fb.service sound.target nuxel-button-manager.service nuxel-audio-route.service
Wants=nuxel-wayland.service nuxel-wl-fb.service nuxel-audio-route.service
ConditionPathExists=/usr/share/nuxel/assets/nuxel-boot-audio.mp3
# The live route state file is the honest readiness signal: the boot cue
# plays once the ABOX/amp route is applied.  The sound-cue binary records
# audibility as unverified; no physical claim is made.
ConditionPathExists=/run/nuxel-audio-route.state

[Service]
Type=oneshot
ExecStart=/usr/libexec/nuxel/nuxel-sound-cue boot
# Playback is diagnostic until the physical route is verified. It must never
# hold the boot target hostage; nuxel-sound-cue itself bounds a player attempt
# to 11 seconds and reaps its process group.
TimeoutStartSec=18
TimeoutStopSec=6
StandardOutput=journal
StandardError=journal
# Deliberately NOT Restart=always: play once, not on every bridge crash.

[Install]
# Start only after the launcher unit is active. This places the non-essential
# cue outside the multi-user critical path so Home becomes usable first.
WantedBy=nuxel-wayland.service
