[Unit]
Description=Nuxel S10+ touchscreen arming (sec_ts stop->start, then hold open)
Documentation=file:/usr/share/doc/nuxel/UTM-LAUNCHER-PORT.md
# Bounded restarts: never spin into a process storm.
StartLimitIntervalSec=300
StartLimitBurst=10
# The controller must be armed before any other reader (libinput in the
# compositor) opens the panel node, otherwise the driver's first-open
# short-circuit is the only path taken.
Before=nuxel-wayland.service nuxel-ui.service
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/lib/nuxel/nuxel-touch-arm
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
