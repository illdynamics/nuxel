#!/usr/bin/env python3
"""Nuxel Tri-Link console session registrar.

Invoked by the host-side Tri-Link launcher over an SSH PTY:

    ssh -t root@phone /usr/libexec/nuxel/nuxel-tri-link-session wlan

The wrapper registers *this* session explicitly.  The generic live-console
indicator is driven by that registration, never by the mere existence of an
sshd process, an interactive shell, a listening sshd or a maintenance SSH
command.  When the shell exits (or the connection drops) the registration is
removed immediately.

The registry contains no credentials, keys, commands or cookie data: only the
PID, process start time and transport.  Environment marker
NUXEL_TRI_LINK_CONSOLE=1 is inherited by the shell and its children so the
backend can validate ownership without trusting a PID alone.
"""
from __future__ import annotations

import json
import os
import signal
import sys
import time
from pathlib import Path

REGISTRY = Path(os.environ.get("NUXEL_TRI_LINK_REGISTRY", "/run/nuxel/tri-link-sessions"))
VALID = {"serial", "usb", "wlan"}


def start_ticks(pid: int) -> int | None:
    try:
        text = Path("/proc/%d/stat" % pid).read_text(errors="replace")
    except OSError:
        return None
    end = text.rfind(")")
    if end < 0:
        return None
    fields = text[end + 1:].strip().split()
    try:
        return int(fields[19])
    except (IndexError, ValueError):
        return None


def main(argv: list[str]) -> int:
    transport = (argv[1] if len(argv) > 1 else "wlan").strip().lower()
    if transport not in VALID:
        print("nuxel-tri-link-session: transport must be serial, usb or wlan", file=sys.stderr)
        return 2
    shell = os.environ.get("SHELL") or "/bin/bash"
    if not os.path.exists(shell):
        shell = "/bin/sh"

    REGISTRY.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(REGISTRY, 0o755)
    except OSError:
        pass

    child = os.fork()
    if child == 0:
        env = dict(os.environ)
        env["NUXEL_TRI_LINK_CONSOLE"] = "1"
        env["NUXEL_CONSOLE_SESSION"] = "1"
        env.setdefault("NUXEL_TRI_LINK_TRANSPORT", transport)
        try:
            os.execvpe(shell, [shell, "-l"], env)
        except OSError as exc:
            print("nuxel-tri-link-session: cannot exec %s: %s" % (shell, exc), file=sys.stderr)
            os._exit(127)

    record = REGISTRY / ("%d.json" % child)
    doc = {
        "schema_version": 1,
        "pid": child,
        "start_ticks": start_ticks(child),
        "transport": transport,
        "uid": os.getuid(),
        "user": os.environ.get("USER") or os.environ.get("LOGNAME") or "",
        "created": int(time.time()),
        "owner": "nuxel-tri-link-session",
    }
    try:
        tmp = str(record) + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(doc, fh, sort_keys=True)
            fh.write("\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, record)
    except OSError as exc:
        print("nuxel-tri-link-session: registration failed: %s" % exc, file=sys.stderr)

    stop = {"signal": False}

    def _term(signum, _frame):
        stop["signal"] = True
        try:
            os.kill(child, signum)
        except OSError:
            pass

    signal.signal(signal.SIGTERM, _term)
    signal.signal(signal.SIGINT, _term)
    signal.signal(signal.SIGHUP, _term)

    status = 0
    try:
        _, status = os.waitpid(child, 0)
    finally:
        try:
            record.unlink()
        except OSError:
            pass
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
