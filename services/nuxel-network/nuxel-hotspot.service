[Unit]
Description=Nuxel LTE Wi-Fi hotspot
Requires=nuxel-cellular-lock.service
After=NetworkManager.service nuxel-firewall.service nuxel-cellular-lock.service
[Service]
Type=simple
ExecStart=/usr/libexec/nuxel/nuxel-hotspot run
ExecStopPost=/usr/libexec/nuxel/nuxel-hotspot stop
TimeoutStopSec=20
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/nuxel-hotspot /run/nuxel-sharing-hotspot /run/nuxel-sharing-common /run/xtables.lock
RuntimeDirectory=nuxel-hotspot nuxel-sharing-hotspot nuxel-sharing-common
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
