[Unit]
Description=Nuxel Wi-Fi hotspot (hostapd + dnsmasq, AP on a second vif)
Documentation=file:/usr/share/doc/nuxel/hotspot.md
After=network.target nuxel-wayland.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The owner configures the AP in Settings; the persisted values live here.
EnvironmentFile=-/etc/nuxel/hotspot/hotspot.env
ExecStart=/usr/libexec/nuxel/nuxel-hotspot start --ssid "${NUXEL_HOTSPOT_SSID}" --password "${NUXEL_HOTSPOT_PASSWORD}"
ExecStop=/usr/libexec/nuxel/nuxel-hotspot stop
TimeoutStartSec=40
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
