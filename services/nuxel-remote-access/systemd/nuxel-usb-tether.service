[Unit]
Description=Nuxel USB Internet sharing on 10.100.10.0/24
Requires=nuxel-usb-net-up.service
Requires=nuxel-cellular-lock.service
After=nuxel-usb-net-up.service nuxel-firewall.service nuxel-cellular-lock.service
PartOf=nuxel-usb-net-up.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/libexec/nuxel/nuxel-usb-tether
ExecStopPost=/usr/libexec/nuxel/nuxel-usb-tether stop
Restart=no
RestartSec=10
TimeoutStartSec=45
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
