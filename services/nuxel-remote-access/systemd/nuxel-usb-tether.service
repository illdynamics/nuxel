[Unit]
Description=Nuxel USB Internet sharing on 10.100.10.0/24
Requires=nuxel-usb-net-up.service
After=nuxel-usb-net-up.service network-online.target nuxel-app-firewall.service
Wants=network-online.target
PartOf=nuxel-usb-net-up.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/nuxel/nuxel-usb-tether
ExecStop=/usr/libexec/nuxel/nuxel-usb-tether stop
Restart=on-failure
RestartSec=10
TimeoutStartSec=45
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
