#!/usr/bin/python3
"""Fixed systemd worker; never receives a shell command from the bridge."""
import json
import os
from pathlib import Path
import sys
import signal
import time
sys.path.insert(0, '/usr/lib/nuxel/nuxel-bridge')
os.environ['NUXEL_USB_TETHER_WORKER'] = '1'
import usb_tether
if sys.argv[1:] == ['stop']:
    result = usb_tether.stop(source='systemd')
else:
    try:
        pref = json.loads(Path(usb_tether.PREF_PATH).read_text())
    except (OSError, ValueError):
        pref = {}
    result = usb_tether.start(pref.get('upstream'), source='systemd')
    if not result.get('success'):
        usb_tether._write_json(usb_tether._state_path(), {'enabled': False, 'last_error': result.get('error')})
print(json.dumps(result), flush=True)
if not result.get('success'): sys.exit(1)
if sys.argv[1:] == ['stop']: sys.exit(0)
import sharing_link
from mobile_upstream import status as upstream_status
running = True
def shutdown(*_):
    global running
    running = False
signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)
try:
    while running:
        up = upstream_status()
        if not usb_tether.usb_link()['active']: up['available'] = False
        sharing_link.refresh('usb', up)
        time.sleep(3)
finally:
    usb_tether.stop(source='systemd')
