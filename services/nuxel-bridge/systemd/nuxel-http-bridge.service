[Unit]
Description=Nuxel HTTP Bridge API
After=dbus.service nuxel-bridge.service
Wants=dbus.service nuxel-bridge.service

[Service]
Type=simple
# A84: the security provider persists "locked" in /run/nuxel/security and
# fails closed when the file is missing.  /run is a tmpfs, so without this the
# state was lost on every reboot: the lock came up with NO state and every
# unlock (including swipe) was refused.  systemd now creates the directory
# (0700 root) before the bridge starts.
RuntimeDirectory=nuxel/security
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/nuxel-http-bridge
Restart=on-failure
RestartSec=3
# S10+ vendor kernel (4.14.253) ncm module denies AF_INET/AF_INET6 socket
# creation to non-root UIDs; this HTTP API binds 127.0.0.1:8080, so it must
# run as root (still sandboxed below). Documented kernel limitation, not a
# relaxed policy choice.
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The Files app and Recorder operate on the real session user home.  The
# bridge is still loopback-only, root-owned and ProtectSystem=strict; only the
# explicit home path below is writable.
ProtectHome=no
# The lockhead indicator reads sysfs and validates the console process's tty
# fd.  PrivateDevices=yes hides /dev/ttyGS0 from this process, which would make a
# real live console read as inactive through the HTTP path.  The service is still
# root-only, loopback-only and ProtectSystem=strict.
PrivateDevices=no
# Native route/interface and nl80211 status queries use netlink.
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
ReadOnlyPaths=/
ReadWritePaths=/run/nuxel /run/nuxel-orientation /var/lib/nuxel /var/log/nuxel /var/cache/nuxel /home/nuxel /sys/kernel/config/usb_gadget /sys/class/leds /etc/nuxel/remote-desktop /etc/nuxel/app-registry /etc/nuxel/notifications /etc/nuxel/privacy /etc/nuxel/security /etc/nuxel/orientation
# The session runtime dir itself must be writable: the keyring daemon writes
# its per-session control socket in /run/nuxel-wayland/keyring, which
# nuxel-session.sh creates (mode 0700) before this unit starts.
ReadWritePaths=-/run/nuxel-wayland
# Teams renderer repair: the bridge rewrites the Flatpak app.asar once per
# deployed build so upstream's UA-CH structuredClone crash and the AAD
# desktop-SSO pagination spinner do not leave Portal for Teams on the
# "Switch Edge profile" screen.  Only this app's deployment tree is writable.
ReadWritePaths=-/var/lib/flatpak/app/com.github.IsmaelMartinez.teams_for_linux
# PWNAGE-63000 / A80: the Nuxel Vault / Authenticator Secret Service provider is
# started by this process through gnome-keyring-daemon.  It only needs the
# session runtime dir writable (the daemon control socket lives in
# /run/nuxel-wayland/keyring, created by nuxel-session.sh before this unit
# starts).  Do NOT bind the keyring file directory separately: a read-only bind
# on /root/.local/share/keyrings left the daemon unable to rebind its socket, so
# every unlock after a lock failed.  /root stays read-only under
# ProtectSystem=strict; the daemon only reads the existing keyring.  The
# fingerprint enrollment record lives in /var/lib/nuxel/security (writable).
# An unopenable legacy keyring is preserved byte-exact under
# /var/lib/nuxel/security/keyring-backups before it is replaced.
# The lockhead Bluetooth indicator is a provider-state document consumed by
# both the native host and this service.  /run/nuxel already holds the
# connection-mode and USB-mode state, so it is the canonical runtime location.
LogsDirectory=nuxel
Environment=NUXEL_HTTP_BIND=127.0.0.1
Environment=NUXEL_HTTP_PORT=8080
Environment=NUXEL_HTTP_MODE=production
# Loopback is not identity. The dev bypass is double-gated (mode=dev AND
# this flag) and is deliberately absent from shipped units.
Environment=NUXEL_HTTP_DEV_LOOPBACK_BYPASS=0
Environment=NUXEL_PATHS_CONF=/etc/nuxel/paths.conf
# The HTTP bridge reads the SAME canonical app registry the PWA and the native
# shell use, so /api/v1/apps/registry cannot drift from the launcher.
Environment=NUXEL_APP_REGISTRY=/etc/nuxel/app-registry/app_registry.json
Environment=NUXEL_BRIDGE_PROTOCOL_VERSION=1
Environment=NUXEL_BRIDGE_VERSION=0.8.9-beta
Environment=NUXEL_API_ALLOW_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
Environment=NUXEL_SESSION_USER=nuxel
Environment=NUXEL_SESSION_HOME=/home/nuxel
Environment=PYTHONPATH=/usr/lib/nuxel
Environment=NUXEL_FILES_ROOT=/home/nuxel
Environment=NUXEL_THUMBNAIL_DIR=/var/cache/nuxel/thumbnails
Environment=NUXEL_LED_POLICY=/etc/nuxel/leds/leds.json
# BlueZ OBEX (org.bluez.obex) is a session-bus service on Fedora; the Nuxel
# session bus is the root-owned socket under /run/nuxel-wayland.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/nuxel-wayland/bus
Environment=XDG_RUNTIME_DIR=/run/nuxel-wayland
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
