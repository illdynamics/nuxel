[Unit]
Description=Nuxel Notification Hub
Documentation=https://nuxel.org/docs/notifications
Wants=dbus.service
After=dbus.service
# The hub is the PRODUCER for the bridge's SendNotification path, so it starts
# first (briq-04b: this direction is what removes the A33 ordering cycle).
Before=nuxel-bridge.service
# Restart-burst bound ([Unit], not [Service]).
StartLimitIntervalSec=120
StartLimitBurst=15

[Service]
Type=simple
ExecStart=/usr/bin/nuxel-notifications
Restart=on-failure
RestartSec=5
RestartMaxDelaySec=30
User=nuxel-notifications
Group=nuxel-notifications
# Persist notification history to the canonical single JSON file (briq-07).
# The resolver in notifications.py reads NUXEL_NOTIFICATIONS_FILE (env first,
# then the built-in default), so pin it explicitly to the canonical path.
Environment=NUXEL_NOTIFICATIONS_FILE=/var/lib/nuxel/notifications.json
Environment=NUXEL_NOTIFICATIONS_HISTORY_CAP=200
Environment=NUXEL_PATHS_CONF=/etc/nuxel/paths.conf
Environment=NUXEL_BRIDGE_PROTOCOL_VERSION=1
Environment=NUXEL_BRIDGE_VERSION=0.7.1-beta

# Security hardening
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes

# Needs D-Bus + data storage
ReadWritePaths=/var/lib/nuxel /var/log/nuxel
ReadOnlyPaths=/etc/dbus-1

[Install]
# NOTE: this is a SYSTEM service on the system bus; graphical-session.target is
# a USER target and enabling a system unit there is a no-op.  Fixed to the real
# target so `systemctl enable` actually starts it.
WantedBy=multi-user.target
