#!/usr/bin/env python3
"""Tiny client for nuxel-soundd (never starts a player or decoder itself)."""
from __future__ import annotations

import argparse
import json
import os
import socket
import sys
from pathlib import Path

SOCKET = Path(os.environ.get("NUXEL_SOUNDD_SOCKET", "/run/nuxel/soundd.sock"))


def request(payload: dict, timeout: float = 5.0) -> dict:
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        sock.connect(str(SOCKET))
        sock.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
        sock.close()
        return json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))
    except (OSError, ValueError) as exc:
        return {"success": False, "error": "soundd-unavailable", "detail": str(exc)}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="Nuxel sound manager client")
    ap.add_argument("--json", action="store_true", help="print the raw JSON reply")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("status")
    sub.add_parser("list")
    sub.add_parser("outputs")
    sub.add_parser("diagnostics")
    sub.add_parser("automatic")
    p = sub.add_parser("select")
    p.add_argument("id")
    p = sub.add_parser("volume")
    p.add_argument("percent", type=float)
    p = sub.add_parser("mute")
    p.add_argument("state", choices=("on", "off", "true", "false", "1", "0"))
    sub.add_parser("test")
    p = sub.add_parser("play")
    p.add_argument("action", nargs="?", default="volume")
    p.add_argument("--path")
    p.add_argument("--loop", action="store_true")
    p.add_argument("--token")
    p = sub.add_parser("stop")
    p.add_argument("--token")
    p.add_argument("--action")
    p = sub.add_parser("preview")
    p.add_argument("action", nargs="?", default="other")
    p.add_argument("--path")
    p = sub.add_parser("assign")
    p.add_argument("action")
    p.add_argument("path", nargs="?")
    p.add_argument("--gain", type=float)
    p = sub.add_parser("import")
    p.add_argument("file")
    # Accept --json before or after the subcommand.  The live operator habit
    # is `nuxel-audio-ctl outputs --json`; argparse otherwise rejects it.
    args = list(sys.argv[1:] if argv is None else argv)
    if "--json" in args:
        args = ["--json"] + [a for a in args if a != "--json"]
    opts = ap.parse_args(args)

    if opts.cmd in (None, "status", "list"):
        req = {"cmd": "state"}
    elif opts.cmd == "outputs":
        req = {"cmd": "outputs"}
    elif opts.cmd == "diagnostics":
        req = {"cmd": "diagnostics"}
    elif opts.cmd == "automatic":
        req = {"cmd": "set-routing", "mode": "automatic"}
    elif opts.cmd == "select":
        req = {"cmd": "select-output", "id": opts.id}
    elif opts.cmd == "volume":
        req = {"cmd": "set-volume", "percent": opts.percent}
    elif opts.cmd == "mute":
        req = {"cmd": "set-muted", "muted": opts.state in ("on", "true", "1")}
    elif opts.cmd == "test":
        req = {"cmd": "test-output"}
    elif opts.cmd == "play":
        req = {"cmd": "play", "action": opts.action, "path": opts.path,
               "loop": opts.loop, "token": opts.token}
    elif opts.cmd == "stop":
        req = {"cmd": "stop", "token": opts.token, "action": opts.action}
    elif opts.cmd == "preview":
        req = {"cmd": "preview", "action": opts.action, "path": opts.path}
    elif opts.cmd == "assign":
        req = {"cmd": "assign", "action": opts.action, "path": opts.path,
               "gain": opts.gain}
    elif opts.cmd == "import":
        import base64
        data = Path(opts.file).read_bytes()
        req = {"cmd": "import", "name": Path(opts.file).name,
               "data_b64": base64.b64encode(data).decode("ascii")}
    else:
        ap.error("unknown command")
    try:
        resp = request(req)
    except KeyboardInterrupt:
        return 130
    print(json.dumps(resp, indent=2, sort_keys=True) if opts.json else
          ("ok" if resp.get("success") else "error: " + str(resp.get("error") or resp)))
    return 0 if resp.get("success") else 1


if __name__ == "__main__":
    raise SystemExit(main())
