[Unit]
Description=Nuxel Wi-Fi boot bridge (owner-controlled, autoconnect only when enabled)
After=NetworkManager.service network.target
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/nuxel/nuxel-wifi-up.sh
RemainAfterExit=yes
Restart=no
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
