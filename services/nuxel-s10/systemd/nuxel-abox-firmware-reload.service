[Unit]
Description=Nuxel S10+ ABOX Calliope core-firmware reload
Documentation=https://nuxel.local/docs/pwnage-38000.md
# PWNAGE-43000: audio now lives in nuxel-audio-session.service.  The reload
# stops ONLY that unit (its own cgroup), never the compositor, so the launcher
# and display bridge remain live while the ABOX core blobs are re-downloaded.
After=nuxel-wayland.service nuxel-audio-session.service local-fs.target
Before=nuxel-boot-sound.service
Wants=local-fs.target nuxel-wayland.service nuxel-audio-session.service
ConditionPathExists=/sys/devices/platform/18c50000.abox/power/control
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/nuxel/nuxel-abox-firmware-reload-boot.sh
RemainAfterExit=yes
# Up to 4 verified PM cycles, each bounded at 60 s, plus the session stop/start.
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=nuxel-wayland.service
