[Unit]
Description=Nuxel device-node permissions (udev fallback for kernel 4.14)
After=local-fs.target
# PWNAGE-89000: the compositor and its helpers run as root and open their real
# devices directly; the user-facing launcher does not touch /dev nodes.  Keep
# this policy before the sound/Bluetooth consumers, but do not serialize the
# Wayland/lockscreen path behind the staged-apply wrapper (~0.9 s measured).
Before=nuxel-audio-route.service nuxel-bluetooth.service
ConditionPathExists=/dev

[Service]
Type=oneshot
ExecStart=/usr/lib/nuxel/nuxel-device-permissions.sh
RemainAfterExit=yes
TimeoutStartSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
