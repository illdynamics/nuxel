#!/bin/sh
# Stremio has no official aarch64 RPM.  Launch the real Flathub build only when
# unprivileged user namespaces are genuinely available.
if command -v flatpak >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; then
    exec flatpak run com.stremio.Stremio "$@"
fi
echo "Stremio's Flatpak sandbox cannot start: the running kernel advertises CONFIG_USER_NS=y but denies user-namespace creation. No setuid fallback or sandbox bypass is used." >&2
exit 2
