#!/bin/sh
# Flathub Firefox is installed.  Use it only when unprivileged user namespaces
# really work on the running kernel; otherwise fall back to the genuine Fedora
# aarch64 Firefox RPM.  Never weaken the sandbox.
if command -v flatpak >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; then
    exec flatpak run org.mozilla.firefox "$@"
fi
exec /usr/bin/firefox "$@"
