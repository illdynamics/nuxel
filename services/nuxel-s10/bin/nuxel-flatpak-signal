#!/bin/sh
# Signal Desktop has no official Fedora aarch64 RPM.  Launch the real Flathub
# build only when the kernel actually permits an unprivileged user namespace.
if command -v flatpak >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; then
    exec flatpak run org.signal.Signal "$@"
fi
echo "Signal's Flatpak sandbox cannot start: the running kernel advertises CONFIG_USER_NS=y but denies user-namespace creation (vendor LOD_SEC/root gate). No setuid fallback or sandbox bypass is used." >&2
exit 2
