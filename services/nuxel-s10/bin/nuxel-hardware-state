#!/usr/bin/env python3
"""Atomic, read-only hardware capability snapshot used by Settings/Home.

NFC is deliberately NOT inferred from a device node alone.  This helper reads
the one authoritative Nuxel NFC daemon status: if the daemon is absent, the
report says SERVICE_STOPPED; a real tag read must still happen in Settings.
"""
from __future__ import annotations

import json
import os
import sys

SOCKET = os.environ.get("NUXEL_NFC_SOCKET", "/run/nuxel/nfc/nfc.sock")
NCI_DEV = os.environ.get("NUXEL_NFC_NCI", "/dev/nfc0")
BRIDGE = os.environ.get("NUXEL_BRIDGE_DIR", "/usr/lib/nuxel/nuxel-bridge")
NFCDIR = os.environ.get("NUXEL_NFC_DIR", "/usr/lib/nuxel/nuxel-nfc")
for d in (BRIDGE, NFCDIR):
    if os.path.isdir(d) and d not in sys.path:
        sys.path.insert(0, d)


def nfc_status():
    try:
        import nfc_provider  # type: ignore
        return nfc_provider.get_provider().status()
    except Exception as exc:  # noqa: BLE001
        return {
            "success": False, "supported": os.path.exists(NCI_DEV),
            "enabled": False,
            "state": "SERVICE_STOPPED" if os.path.exists(NCI_DEV) else "BLOCKED_KERNEL",
            "error": "nfc_provider unavailable: %s" % exc,
            "controller": {"interface": NCI_DEV},
            "tag_writes_supported": True,
            "write_requires_confirmation": True,
        }


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("status", "get"):
        print(json.dumps({"schema": "nuxel.hardware-state/1",
                          "nfc": nfc_status()}, sort_keys=True, indent=2))
        return 0
    print("usage: nuxel-hardware-state status", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
