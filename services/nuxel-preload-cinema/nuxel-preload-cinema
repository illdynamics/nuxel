        "--panscan=0",
        "--background-color=#000000",
        "--keep-open=yes",
        "--idle=yes",
        "--hwdec=no",
        "--vd-lavc-threads=4",
        "--really-quiet",
        "--no-terminal",
        "--log-file=" + str(log_path),
        "--input-ipc-server=" + str(ipc_path),
        "--title=Nuxel",
        "--",
        str(asset),
    ]


def _stop_player(proc: subprocess.Popen | None, ipc: MpvIPC | None,
                 log: Logger, reason: str) -> None:
    if ipc:
        try:
            ipc.command(["quit"], timeout=0.5)
        except Exception:
            pass
    if proc is not None and proc.poll() is None:
        try:
            proc.terminate()
        except OSError:
            pass
        try:
            proc.wait(timeout=2.0)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except OSError:
                pass
            try:
                proc.wait(timeout=2.0)
            except subprocess.TimeoutExpired:
                pass
    if ipc:
        ipc.close()
    log.log("INFO", "player_stopped", reason=reason,
            pid=(proc.pid if proc is not None else None))


def _write_receipt(cfg: Config, doc: dict[str, Any]) -> None:
    base = {
        "schema_version": SCHEMA_VERSION,
        "milestone": "PWNAGE-31000",
        "controller_pid": os.getpid(),
        "boot_id": _read_text(Path("/proc/sys/kernel/random/boot_id"), 200).strip(),
        "finished_at": now_iso(),
        "unlock_actions": 0,
        "framebuffer_owner": "nuxel-wl-fb",
    }
    base.update(doc)
    _atomic_json(cfg.paths["receipt"], base)


def _write_overlay(cfg: Config, doc: dict[str, Any]) -> None:
    """Publish the pre-lockscreen cover state for the launcher.

    The launcher cannot read /run directly.  It fetches the symlinked
    preload-status.json served by nuxel-web, so this file must be written
    atomically and must never disappear while the PWA is polling it.

    States:
      starting  the controller is verifying/starting the player; keep the cover
      covered   mpv has presented its first frame; the real lockscreen may now
                be revealed underneath the video
      fallback  the video will not be presented; reveal the lockscreen
      done      playback finished; reveal the lockscreen
    """
    base = {
        "schema_version": SCHEMA_VERSION,
        "milestone": "PWNAGE-31000",
        "pid": os.getpid(),
        "boot_id": _read_text(Path("/proc/sys/kernel/random/boot_id"), 200).strip(),
        "updated_at": now_iso(),
    }
    base.update(doc)
    # /run is the authoritative diagnostic copy.  The PWA cannot read /run and
    # nuxel-web rejects symlinks that escape its docroot, so publish a second,
    # regular file under the PWA docroot for the same-origin status fetch.
    _atomic_json(cfg.paths["overlay"], base)
    status_path = cfg.paths.get("status")
    if status_path is not None:
        _atomic_json(status_path, base)


def acquire_lock(cfg: Config, log: Logger):
    lock_path = cfg.paths["lock"]
    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        fh = lock_path.open("a+")
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        fh.seek(0)
        fh.truncate(0)
        fh.write("%d\n" % os.getpid())
        fh.flush()
        return fh
    except BlockingIOError:
        log.log("WARN", "duplicate_instance", lock=str(lock_path))
        return None
    except OSError as exc:
        log.log("WARN", "lock_unavailable", lock=str(lock_path), error=str(exc))
        # A read-only runtime should not prevent the fallback-safe controller.
        return False


def _release_lock(fh) -> None:
    if fh and fh is not False:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
            fh.close()
        except OSError:
            pass


def _session_owns_overlay(cfg: Config) -> bool:
    """True when nuxel-session.sh owns this boot's pre-lockscreen overlay.

    The systemd unit is a fallback for images that do not start the phone
    session.  On the S10+ image the session always starts; if the unit also
    runs it can write the one-shot .done marker (or hold the controller lock)
    before the session controller, which suppresses the video entirely.
    """
    return (cfg.paths["session_owner"].exists() or
            cfg.paths["session_log"].exists())


def run(argv: list[str] | None = None) -> int:
    cfg = load_config(argv or sys.argv[1:])
    early = bool(cfg.get("early"))
    if early:
        # In the early session launch the launcher host has not started yet, so
        # /run/nuxel-home.state cannot carry boot=os.  The session wrapper is
        # only executed by phoc on the phone boot path, so this is safe and
        # avoids waiting for a marker that does not exist yet.
        cfg.values["require_boot_os"] = False
    log = Logger(cfg.paths["log"])
    started_wall = now_iso()
    log.log("INFO", "controller_start", config=str(cfg.paths["config"]),
            asset=str(cfg.get("asset")), enabled=cfg.get("enabled"),
            early=early)

    overlay_state = {"state": "unstarted"}

    def mark_overlay(state: str, **fields: Any) -> None:
        overlay_state["state"] = state
        _write_overlay(cfg, {"state": state, **fields})

    if not cfg.get("enabled"):
        mark_overlay("fallback", reason="config-disabled")
        _write_receipt(cfg, {"verdict": "DISABLED", "reason": "config-disabled",
                             "started_at": started_wall})
        log.log("INFO", "fallback", reason="config-disabled")
        return 0

    # The phone session owns the overlay.  Yield before taking the lock or
    # writing the one-shot marker; the early session controller will play the
    # clip above the launcher and release the PWA cover.
    if not early and _session_owns_overlay(cfg):
        _write_receipt(cfg, {"verdict": "YIELD_SESSION",
                             "reason": "nuxel-session-owns-overlay",
                             "started_at": started_wall})
        log.log("INFO", "yield_session", reason="session-owns-overlay")
        return 0

    # One presentation per boot.  /run is a tmpfs and is cleared at boot; this
    # marker means a later `systemctl start` (for example after the user has
    # unlocked the phone) cannot paint the boot clip over the desktop.
    if cfg.paths["done"].exists():
        _write_receipt(cfg, {"verdict": "ALREADY_RAN",
                             "reason": "one-shot-boot-marker-present",
                             "marker": str(cfg.paths["done"]),
                             "started_at": started_wall})
        log.log("INFO", "already_ran", marker=str(cfg.paths["done"]))
        # The session controller removes the PWA-facing status file before each
        # session start. If a later session restart sees the one-shot marker it
        # must still publish a terminal status so the launcher's opaque first-
        # frame cover releases immediately instead of polling a missing file
        # until its 40 s hard timeout (measured on the S10+ after the ABOX
        # firmware reload restarts nuxel-wayland).
        mark_overlay("done", reason="already-ran")
        return 0

    lock = acquire_lock(cfg, log)
    if lock is None:
        _write_receipt(cfg, {"verdict": "DUPLICATE", "reason": "instance-lock-held",
                             "started_at": started_wall})
        return 0

    # Re-check after taking the lock: the session may have started while this
    # fallback unit was probing.  Yield without writing .done.
    if not early and _session_owns_overlay(cfg):
        mark_overlay("fallback", reason="session-owns-overlay")
        _write_receipt(cfg, {"verdict": "YIELD_SESSION",
                             "reason": "nuxel-session-owns-overlay",
                             "started_at": started_wall})
        log.log("INFO", "yield_session", reason="session-owns-overlay-after-lock")
        return 0

    try:
        mark_overlay("starting", asset=str(cfg.get("asset")), early=early,
                     started_at=started_wall)
    except OSError as exc:
        log.log("WARN", "overlay_status_unavailable", error=exc)
    # Do NOT write the one-shot .done marker yet.  A systemd-unit start that
    # fails the display/boot-mode gate must leave the marker absent so the
    # session controller can still own the clip.

    proc: subprocess.Popen | None = None
    ipc: MpvIPC | None = None
    runtime_dir = cfg.paths["runtime_dir"]
    ipc_path = runtime_dir / "preload-cinema.sock"
    mpv_log = runtime_dir / "preload-cinema-mpv.log"
    try:
        asset = Path(str(cfg.get("asset")))
        if not asset.is_file():
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "asset-missing",
                                 "asset": str(asset), "started_at": started_wall})
            log.log("WARN", "fallback", reason="asset-missing", asset=str(asset))
            return 0
        if asset.stat().st_size <= 0:
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "asset-empty",
                                 "asset": str(asset), "started_at": started_wall})
            log.log("WARN", "fallback", reason="asset-empty", asset=str(asset))
            return 0
        if not os.access(asset, os.R_OK):
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "asset-unreadable",
                                 "asset": str(asset), "started_at": started_wall})
            log.log("WARN", "fallback", reason="asset-unreadable", asset=str(asset))
            return 0

        asset_bytes = asset.stat().st_size
        try:
            asset_hash = sha256_file(asset)
        except OSError as exc:
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "asset-hash-read-failed",
                                 "asset": str(asset), "error": str(exc),
                                 "started_at": started_wall})
            log.log("WARN", "fallback", reason="asset-hash-read-failed", error=exc)
            return 0
        expected = str(cfg.get("asset_sha256") or "").strip().lower()
        sidecar = asset.with_name(asset.name + ".sha256")
        if not expected and sidecar.is_file():
            sidecar_words = _read_text(sidecar, 4096).split()
            expected = sidecar_words[0].lower() if sidecar_words else ""
        if expected and expected != asset_hash:
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "asset-hash-mismatch",
                                 "asset": str(asset), "asset_sha256": asset_hash,
                                 "expected_sha256": expected, "started_at": started_wall})
            log.log("WARN", "fallback", reason="asset-hash-mismatch",
                    expected=expected, actual=asset_hash)
            return 0
        duration = mp4_duration_seconds(asset)
        log.log("INFO", "asset_verified", asset=str(asset), bytes=asset_bytes,
                sha256=asset_hash, duration_s=duration)

        runtime_dir.mkdir(parents=True, exist_ok=True)
        try:
            if ipc_path.exists() or ipc_path.is_symlink():
                ipc_path.unlink()
        except OSError:
            pass

        # Display and launch-mode gates.  In normal (systemd) mode the compositor
        # and display bridge must already be proven up before mpv is spawned; in
        # early mode mpv is spawned immediately from nuxel-session.sh so its
        # surface is mapped BEFORE nuxel-pwa-host constructs the lockscreen.
        # The later readiness loop still holds the overlay until the lockscreen
        # is genuinely ready (or the hard bound expires).
        if not early:
            deadline = time.monotonic() + int(cfg.get("start_timeout_ms")) / 1000.0
            initial = read_readiness(cfg, time.monotonic())
            while time.monotonic() < deadline:
                initial = read_readiness(cfg, time.monotonic())
                if initial.wlfb_ready and initial.display_on and (initial.boot_os or not cfg.get("require_boot_os")):
                    break
                time.sleep(0.1)
            if not initial.wlfb_ready or not initial.display_on:
                _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "display-not-ready",
                                     "asset": str(asset), "asset_sha256": asset_hash,
                                     "readiness": initial.as_dict(), "started_at": started_wall})
                log.log("WARN", "fallback", reason="display-not-ready",
                        readiness=json.dumps(initial.as_dict(), sort_keys=True))
                return 0
            if cfg.get("require_boot_os") and not initial.boot_os:
                _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "not-os-boot-mode",
                                     "asset": str(asset), "readiness": initial.as_dict(),
                                     "started_at": started_wall})
                log.log("WARN", "fallback", reason="not-os-boot-mode")
                return 0
        else:
            # Early mode: the PWA cover is already opaque; do not start mpv
            # until WebKit has mapped (launcher_ready), otherwise the launcher
            # maps last and hides the video.  This waits ONLY for the launcher
            # marker, never for the display bridge or a full lockscreen.
            wait_s = int(cfg.get("early_wait_launcher_ms")) / 1000.0
            wait_deadline = time.monotonic() + wait_s
            wait_started = time.monotonic()
            initial = read_readiness(cfg, wait_started)
            while (not initial.launcher_ready and
                   time.monotonic() < wait_deadline):
                time.sleep(int(cfg.get("poll_ms")) / 1000.0)
                initial = read_readiness(cfg, wait_started)
            log.log("INFO", "early_launcher_wait",
                    ready=initial.launcher_ready,
                    elapsed_s=round(time.monotonic() - wait_started, 3),
                    bound_ms=int(cfg.get("early_wait_launcher_ms")))
            # Let WebKit finish its own map/fullscreen commits.  Only worth
            # waiting when the launcher actually appeared; a missing launcher
            # must still fall through to the bounded failure paths.
            if initial.launcher_ready:
                map_delay = max(0, int(cfg.get("early_map_delay_ms"))) / 1000.0
                if map_delay:
                    time.sleep(map_delay)
                    log.log("INFO", "early_map_delay",
                            seconds=round(map_delay, 3),
                            reason="let-launcher-settle-before-mpv-maps")

            # Early mode must still wait for the display bridge to own the
            # panel before mpv starts.  The boot-animation player keeps /dev/fb0
            # until nuxel-wl-fb has taken over; starting mpv before that point
            # plays the whole clip invisibly (measured 2026-10-29: playback-time
            # 5.958 s when the bridge published its first frame, so only the
            # last ~60 ms was ever visible).  Wait for the same display gate the
            # normal mode uses, bounded by start_timeout_ms.  The launcher's
            # opaque preload cover hides the lockscreen while we wait.
            display_wait_started = time.monotonic()
            display_deadline = display_wait_started + int(cfg.get("start_timeout_ms")) / 1000.0
            initial = read_readiness(cfg, display_wait_started)
            while (not (initial.wlfb_ready and initial.display_on) and
                   time.monotonic() < display_deadline):
                time.sleep(int(cfg.get("poll_ms")) / 1000.0)
                initial = read_readiness(cfg, display_wait_started)
            log.log("INFO", "early_display_wait",
                    ready=bool(initial.wlfb_ready and initial.display_on),
                    wlfb_ready=initial.wlfb_ready,
                    display_on=initial.display_on,
                    elapsed_s=round(time.monotonic() - display_wait_started, 3),
                    bound_ms=int(cfg.get("start_timeout_ms")))
            if not initial.wlfb_ready or not initial.display_on:
                _write_receipt(cfg, {"verdict": "FALLBACK",
                                     "reason": "display-not-ready",
                                     "asset": str(asset),
                                     "readiness": initial.as_dict(),
                                     "started_at": started_wall})
                log.log("WARN", "fallback", reason="display-not-ready",
                        phase="early-display-wait")
                return 0

        if early:
            # Early mode is racing the launcher host for the first composited
            # frame, so do not spend preflight time decoding a probe frame.  The
            # real mpv spawn + IPC connect below is the authoritative failure
            # detector, and every failure path still releases to the lockscreen.
            log.log("INFO", "preflight_skipped", reason="early-session-fast-path")
            ok, why = True, "early-skip"
        else:
            ok, why = preflight(cfg, log)
        if not ok:
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": why,
                                 "asset": str(asset), "asset_sha256": asset_hash,
                                 "asset_bytes": asset_bytes, "duration_s": duration,
                                 "started_at": started_wall})
            log.log("WARN", "fallback", reason=why)
            return 0

        # Commit to presenting the clip: only now write the one-shot marker.
        # A later manual start must not paint the clip over the desktop.
        try:
            cfg.paths["done"].parent.mkdir(parents=True, exist_ok=True)
            cfg.paths["done"].write_text(
                "%s boot_id=%s pid=%d\n" % (
                    now_iso(),
                    _read_text(Path("/proc/sys/kernel/random/boot_id"), 200).strip(),
                    os.getpid()),
                encoding="utf-8")
        except OSError as exc:
            log.log("WARN", "done_marker_unavailable", error=exc)

        try:
            mpv_log.unlink()
        except OSError:
            pass
        env = dict(os.environ)
        env["XDG_RUNTIME_DIR"] = str(cfg.paths["wayland_runtime_dir"])
        env["WAYLAND_DISPLAY"] = cfg.wayland_display
        env["XDG_SESSION_TYPE"] = "wayland"
        env["LIBGL_ALWAYS_SOFTWARE"] = "1"
        cmd = player_command(cfg, ipc_path, mpv_log, asset)
        log.log("INFO", "player_starting", vo=cfg.get("video_output"),
                pid=None, asset=str(asset), duration_s=duration)
        try:
            proc = subprocess.Popen(cmd, env=env, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    start_new_session=True)
        except OSError as exc:
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "player-spawn-failed",
                                 "asset": str(asset), "error": str(exc),
                                 "started_at": started_wall})
            log.log("WARN", "fallback", reason="player-spawn-failed", error=exc)
            return 0
        log.log("INFO", "player_started", pid=proc.pid)

        ipc = MpvIPC(ipc_path)
        if not ipc.connect(time.monotonic() + 2.0):
            rc = proc.poll()
            tail = _read_text(mpv_log, 4096)[-500:].replace("\n", " ")
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "player-ipc-unavailable",
                                 "asset": str(asset), "rc": rc, "mpv_log_tail": tail,
                                 "started_at": started_wall})
            log.log("WARN", "fallback", reason="player-ipc-unavailable", rc=rc,
                    mpv_log_tail=tail)
            _stop_player(proc, ipc, log, "ipc-unavailable")
            return 0

        t0 = time.monotonic()
        eof = False
        held = False
        readiness = initial
        readiness_at: float | None = None
        last_sig = None
        stop_reason = "video-and-lockscreen-ready"
        bounded = False
        display_lost = False
        while True:
            now = time.monotonic()
            elapsed = now - t0
            if proc.poll() is not None:
                rc = proc.returncode
                tail = _read_text(mpv_log, 4096)[-500:].replace("\n", " ")
                if rc == 0 and eof:
                    log.log("INFO", "player_exited_after_eof", rc=rc)
                else:
                    _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "player-exited",
                                         "asset": str(asset), "asset_sha256": asset_hash,
                                         "asset_bytes": asset_bytes, "duration_s": duration,
                                         "rc": rc, "mpv_log_tail": tail,
                                         "elapsed_s": round(elapsed, 3),
                                         "readiness": readiness.as_dict(),
                                         "started_at": started_wall})
                    log.log("WARN", "fallback", reason="player-exited", rc=rc,
                            mpv_log_tail=tail)
                    _stop_player(proc, ipc, log, "player-exited")
                    return 0
                break

            reply = ipc.command(["get_property", "eof-reached"], timeout=0.35)
            if reply and reply.get("error") == "success":
                eof = bool(reply.get("data"))

            # Publish the first presented frame only after the display bridge
            # is genuinely scanning.  Before nuxel-wl-fb owns /dev/fb0 the
            # panel still shows the pre-boot framebuffer; releasing the cover
            # on mpv's playback-time alone produced the owner-reported
            # "one second of lockscreen" flash (measured 2026-10-28).
            readiness = read_readiness(cfg, t0)
            if overlay_state["state"] == "starting":
                pt_reply = ipc.command(["get_property", "playback-time"], timeout=0.35)
                if pt_reply and pt_reply.get("error") == "success":
                    pt = pt_reply.get("data")
                    try:
                        pt_value = float(pt) if pt is not None else 0.0
                    except (TypeError, ValueError):
                        pt_value = 0.0
                    if pt_value > 0.0 and readiness.wlfb_ready:
                        mark_overlay("covered", first_frame_s=round(pt_value, 3),
                                     elapsed_s=round(elapsed, 3),
                                     wlfb_ready=True)
                        log.log("INFO", "overlay_covered",
                                first_frame_s=round(pt_value, 3),
                                elapsed_s=round(elapsed, 3),
                                wlfb_ready=True)
            if eof and not held:
                log.log("INFO", "video_eof", elapsed_s=round(elapsed, 3))
            if eof and duration is None:
                duration = elapsed

            readiness = read_readiness(cfg, t0)
            if readiness.signature() != last_sig:
                last_sig = readiness.signature()
                log.log("INFO", "readiness", ready=readiness.ready,
                        critical=readiness.critical,
                        launcher_ready=readiness.launcher_ready,
                        boot_os=readiness.boot_os,
                        wlfb_ready=readiness.wlfb_ready,
                        display_on=readiness.display_on,
                        touch_settled=readiness.touch_settled,
                        touch_unknown=readiness.touch_unknown,
                        touch_last=readiness.detail.get("touch_last_line", ""))
            if readiness.ready and readiness_at is None:
                readiness_at = elapsed
                log.log("INFO", "lockscreen_ready", elapsed_s=round(elapsed, 3))

            if not readiness.display_on and readiness.wlfb_ready:
                display_lost = True
                stop_reason = "display-off"
                log.log("WARN", "display_off_during_playback")
                break

            max_s = int(cfg.get("max_display_ms")) / 1000.0
            hard_s = int(cfg.get("hard_timeout_ms")) / 1000.0
            if eof and readiness.ready:
                break
            if elapsed >= max_s and not held:
                # Bound the moving-video interval.  Keep the final frame (a
                # still presentation) only while a critical readiness gate is
                # still genuinely pending; release it at the hard bound.
                held = True
                bounded = True
                if not eof:
                    ipc.command(["set_property", "pause", True], timeout=0.35)
                    log.log("INFO", "video_paused_at_bound", elapsed_s=round(elapsed, 3))
                if readiness.ready:
                    break
            if elapsed >= hard_s:
                bounded = True
                stop_reason = ("hard-timeout-readiness-pending"
                               if not readiness.ready else "video-and-lockscreen-ready")
                log.log("WARN", "hard_timeout", elapsed_s=round(elapsed, 3),
                        ready=readiness.ready)
                break
            time.sleep(int(cfg.get("poll_ms")) / 1000.0)

        _stop_player(proc, ipc, log, stop_reason)
        proc = None
        ipc = None
        mark_overlay("done", reason=stop_reason, video_eof=bool(eof),
                     elapsed_s=round(time.monotonic() - t0, 3))
        _write_receipt(cfg, {
            "verdict": "PLAYED",
            "reason": stop_reason,
            "asset": str(asset),
            "asset_sha256": asset_hash,
            "asset_bytes": asset_bytes,
            "duration_s": duration,
            "started_at": started_wall,
            "elapsed_s": round(time.monotonic() - t0, 3),
            "video_eof": bool(eof),
            "video_held": bool(held),
            "bounded": bool(bounded),
            "display_lost": bool(display_lost),
            "readiness": readiness.as_dict(),
            "readiness_ready_at_s": (round(readiness_at, 3) if readiness_at is not None else None),
            "max_display_ms": int(cfg.get("max_display_ms")),
            "hard_timeout_ms": int(cfg.get("hard_timeout_ms")),
            "audio": "disabled",
            "fullscreen": True,
        })
        log.log("INFO", "controller_done", verdict="PLAYED", reason=stop_reason)
        return 0
    except Exception as exc:  # noqa: BLE001 - a presentation layer must fail open
        try:
            mark_overlay("fallback", reason="controller-exception")
            _write_receipt(cfg, {"verdict": "FALLBACK", "reason": "controller-exception",
                                 "error": "%s: %s" % (type(exc).__name__, exc),
                                 "started_at": started_wall})
            log.log("ERROR", "controller_exception", error="%s: %s" % (type(exc).__name__, exc))
        except Exception:
            pass
        return 0
    finally:
        if proc is not None or ipc is not None:
            _stop_player(proc, ipc, log, "finally")
        if overlay_state.get("state") == "starting":
            # The player never presented a frame.  Release the launcher cover
            # immediately instead of making it wait for its own timeout.
            try:
                mark_overlay("fallback", reason="exited-before-first-frame")
            except Exception:
                pass
        for path in (ipc_path, mpv_log):
            try:
                if path.exists() and path.name.endswith(".sock"):
                    path.unlink()
            except OSError:
                pass
        _release_lock(lock)


def main(argv: list[str] | None = None) -> int:
    args = list(argv if argv is not None else sys.argv[1:])
    if "--version" in args:
        print("nuxel-preload-cinema 1 (PWNAGE-31000)")
        return 0
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    if "--early" in args:
        os.environ["NUXEL_PRELOAD_EARLY"] = "1"
        args = [a for a in args if a != "--early"]
    return run(args)


if __name__ == "__main__":
    raise SystemExit(main())
