def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def _as_bool(value: Any, default: bool) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, (int, float)):
        return bool(value)
    text = str(value).strip().lower()
    if text in ("1", "true", "yes", "on"):
        return True
    if text in ("0", "false", "no", "off"):
        return False
    return default


def _as_int(value: Any, default: int, minimum: int = 0) -> int:
    try:
        out = int(value)
    except (TypeError, ValueError):
        return default
    return max(minimum, out)


def _read_text(path: Path, limit: int = 65536) -> str:
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            return fh.read(limit)
    except OSError:
        return ""


def _atomic_json(path: Path, doc: dict[str, Any]) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(path.name + ".%d.tmp" % os.getpid())
        tmp.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n",
                       encoding="utf-8")
        os.replace(tmp, path)
    except OSError:
        pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def mp4_duration_seconds(path: Path) -> float | None:
    """Read mvhd duration/timescale from an ISO-BMFF file, no external tools.

    Returns None when the container cannot be parsed.  This is only a timing
    hint; EOF from mpv remains the authority.
    """
    def boxes(fh, start: int, end: int):
        pos = start
        while pos + 8 <= end:
            fh.seek(pos)
            hdr = fh.read(8)
            if len(hdr) != 8:
                return
            size = int.from_bytes(hdr[:4], "big")
            kind = hdr[4:8]
            header = 8
            if size == 1:
                ext = fh.read(8)
                if len(ext) != 8:
                    return
                size = int.from_bytes(ext, "big")
                header = 16
            elif size == 0:
                size = end - pos
            if size < header or pos + size > end:
                return
            yield kind, pos, header, size
            pos += size

    try:
        total = path.stat().st_size
        with path.open("rb") as fh:
            for kind, pos, header, size in boxes(fh, 0, total):
                if kind != b"moov":
                    continue
                for child, cpos, cheader, csize in boxes(fh, pos + header, pos + size):
                    if child != b"mvhd":
                        continue
                    fh.seek(cpos + cheader)
                    version = fh.read(1)
                    if not version:
                        return None
                    # `version` is the first byte of the FullBox header; the
                    # payload that follows starts with the 3 flag bytes.
                    #   v0: flags(3) ctime(4) mtime(4) timescale(4) duration(4)
                    #   v1: flags(3) ctime(8) mtime(8) timescale(4) duration(8)
                    # The previous offsets were one byte late (and v1 read only
                    # 28 bytes), so a real 6.016 s asset parsed as None.
                    if version[0] == 1:
                        payload = fh.read(31)
                        if len(payload) < 31:
                            return None
                        timescale = struct.unpack(">I", payload[19:23])[0]
                        duration = struct.unpack(">Q", payload[23:31])[0]
                    else:
                        payload = fh.read(19)
                        if len(payload) < 19:
                            return None
                        timescale = struct.unpack(">I", payload[11:15])[0]
                        duration = struct.unpack(">I", payload[15:19])[0]
                    if timescale <= 0:
                        return None
                    return float(duration) / float(timescale)
    except (OSError, struct.error):
        return None
    return None


@dataclass
class Config:
    path: Path
    values: dict[str, Any]
    paths: dict[str, Path]
    wayland_display: str

    def get(self, key: str, default: Any = None) -> Any:
        return self.values.get(key, default)


def load_config(argv: list[str]) -> Config:
    config_path = Path(os.environ.get("NUXEL_PRELOAD_CONFIG", DEFAULT_CONFIG))
    raw: dict[str, Any] = {}
    if config_path.is_file():
        try:
            loaded = json.loads(config_path.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                raw = loaded
        except (OSError, ValueError):
            raw = {}
    values = dict(CONFIG_DEFAULTS)
    values.update({k: v for k, v in raw.items() if k in CONFIG_DEFAULTS})
    for key, env_name in ENV_MAP.items():
        if env_name in os.environ:
            values[key] = os.environ[env_name]
    values["enabled"] = _as_bool(values.get("enabled"), True)
    values["require_boot_os"] = _as_bool(values.get("require_boot_os"), True)
    values["early"] = _as_bool(values.get("early"), False)
    for key, default, minimum in (
        ("max_display_ms", DEFAULT_MAX_DISPLAY_MS, 100),
        ("start_timeout_ms", DEFAULT_START_TIMEOUT_MS, 100),
        ("readiness_grace_ms", DEFAULT_READINESS_GRACE_MS, 0),
        ("hard_timeout_ms", DEFAULT_HARD_TIMEOUT_MS, 100),
        ("poll_ms", DEFAULT_POLL_MS, 20),
        ("preflight_timeout_ms", DEFAULT_PREFLIGHT_TIMEOUT_MS, 100),
        ("early_wait_launcher_ms", DEFAULT_EARLY_WAIT_LAUNCHER_MS, 0),
    ):
        values[key] = _as_int(values.get(key), default, minimum)
    if values["hard_timeout_ms"] < values["max_display_ms"]:
        values["hard_timeout_ms"] = values["max_display_ms"]
    paths: dict[str, Path] = {}
    for key, (env_name, default) in PATH_ENV.items():
        paths[key] = Path(os.environ.get(env_name, default))
    # The config document itself may not be readable; the controller still uses
    # its real path for the receipt/log context.
    paths["config"] = config_path
    return Config(config_path, values, paths,
                  os.environ.get("NUXEL_PRELOAD_WAYLAND_DISPLAY", DEFAULT_WAYLAND_DISPLAY))


class Logger:
    def __init__(self, path: Path):
        self.path = path
        self._last = None

    def log(self, level: str, event: str, **fields: Any) -> None:
        line = "%s %s %s %s" % (now_iso(), TAG, level, event)
        if fields:
            pairs = []
            for key in sorted(fields):
                value = fields[key]
                if isinstance(value, bool):
                    value = "1" if value else "0"
                text = str(value).replace("\n", " ")[:300]
                pairs.append("%s=%s" % (key, text))
            line += " " + " ".join(pairs)
        self._last = event
        try:
            sys.stderr.write(line + "\n")
            sys.stderr.flush()
        except OSError:
            pass
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            with self.path.open("a", encoding="utf-8") as fh:
                fh.write(line + "\n")
        except OSError:
            pass


@dataclass
class Readiness:
    launcher_ready: bool = False
    boot_os: bool = False
    wlfb_ready: bool = False
    display_on: bool = False
    touch_settled: bool = False
    touch_unknown: bool = False
    detail: dict[str, Any] = field(default_factory=dict)

    @property
    def critical(self) -> bool:
        return self.launcher_ready and self.boot_os and self.wlfb_ready and self.display_on

    @property
    def ready(self) -> bool:
        return self.critical and (self.touch_settled or self.touch_unknown)

    def as_dict(self) -> dict[str, Any]:
        return {
            "launcher_ready": self.launcher_ready,
            "boot_os": self.boot_os,
            "wlfb_ready": self.wlfb_ready,
            "display_on": self.display_on,
            "touch_settled": self.touch_settled,
            "touch_unknown": self.touch_unknown,
            "critical": self.critical,
            "ready": self.ready,
            "detail": self.detail,
        }

    def signature(self) -> tuple:
        return (self.launcher_ready, self.boot_os, self.wlfb_ready,
                self.display_on, self.touch_settled, self.touch_unknown)


def _fresh_for_boot(path: Path) -> bool:
    """True when a persistent receipt was written during THIS boot.

    `/var/lib/nuxel/display` is persistent; `/run` is not.  A stale DISPLAY_ON
    from a previous boot must never be used as a readiness gate.  Compare its
    mtime with the kernel boot time derived from /proc/uptime.
    """
    try:
        mtime = path.stat().st_mtime
        uptime = float(_read_text(Path("/proc/uptime"), 200).split()[0])
    except (OSError, ValueError, IndexError):
        return False
    boot_time = time.time() - uptime
    return mtime >= (boot_time - 2.0)


def _display_signals(cfg: Config) -> tuple[bool, bool, dict[str, Any]]:
    """Return (bridge_ready, display_on, evidence).

    `/run/nuxel-wl-fb.state` is rewritten only when the frame state changes.
    On a static lockscreen the last line can remain `DISPLAY_SLEEP` even after
    the panel is back on (measured on the S10+ at boot: /run said display=off
    while /var/lib/nuxel/display said DISPLAY_ON and the glass was lit).  The
    persistent display receipt is therefore authoritative when it is fresh for
    this boot; the /run line is the fallback.
    """
    wl_state = _read_text(cfg.paths["wlfb_state"], 100_000)
    disp_path = cfg.paths["display_state"]
    disp_state = _read_text(disp_path, 100_000)
    disp_fresh = _fresh_for_boot(disp_path)
    wl_owner = "owner=nuxel-wl-fb" in wl_state
    disp_owner = "owner=nuxel-wl-fb" in disp_state
    frames_ok = "FRAMES_OK" in wl_state
    disp_on = bool(re.search(r"(?:^|\s)DISPLAY_ON(?:\s|$)", disp_state))
    disp_off = bool(re.search(r"(?:^|\s)DISPLAY_OFF(?:\s|$)", disp_state))
    if disp_fresh and (disp_on or disp_off):
        display_on = disp_on and not disp_off
    else:
        display_on = bool(re.search(r"(?:^|\s)display=on(?:\s|$)", wl_state))
        if re.search(r"(?:^|\s)display=off(?:\s|$)", wl_state):
            display_on = False
    bridge_ready = (wl_owner or (disp_fresh and disp_owner)) and (frames_ok or (disp_fresh and disp_on))
    return bridge_ready, display_on, {
        "wlfb_state": wl_state.strip().splitlines()[-1][:200] if wl_state.strip() else "",
        "display_state": disp_state.strip().splitlines()[0][:80] if disp_state.strip() else "",
        "display_state_fresh": disp_fresh,
        "display_state_path": str(disp_path),
    }


def read_readiness(cfg: Config, started_monotonic: float) -> Readiness:
    home = _read_text(cfg.paths["home_state"], 200_000)
    launcher_ready = False
    try:
        launcher_ready = cfg.paths["launcher_ready"].stat().st_size > 0
    except OSError:
        pass
    boot_os = (not bool(cfg.get("require_boot_os", True))) or \
        ("boot=os" in home or "NUXEL_HOME_BOOT_OWNER os_animation=1" in home)
    wlfb_ready, display_on, display_detail = _display_signals(cfg)
    touch_text = _read_text(cfg.paths["touch_state"], 100_000)
    lines = [ln.strip() for ln in touch_text.splitlines() if ln.strip()]
    # nuxel-touch-arm appends a TOUCH_POINT line for every real touch after the
    # one-shot ARMED_OK receipt.  The last *status* line is therefore the
    # readiness statement; taking the literal last line made any user touch
    # (or the preload player's own surface focus) look like "touch not armed".
    status_lines = [ln for ln in lines if "TOUCH_POINT" not in ln]
    last_touch = status_lines[-1] if status_lines else ""
    touch_settled = bool(_TOUCH_SETTLED.search(last_touch))
    elapsed_ms = (time.monotonic() - started_monotonic) * 1000.0
    touch_unknown = (not touch_settled and launcher_ready and wlfb_ready and
                     elapsed_ms >= int(cfg.get("readiness_grace_ms", DEFAULT_READINESS_GRACE_MS)))
    return Readiness(
        launcher_ready=launcher_ready,
        boot_os=boot_os,
        wlfb_ready=wlfb_ready,
        display_on=display_on,
        touch_settled=touch_settled,
        touch_unknown=touch_unknown,
        detail={
            "launcher_ready_path": str(cfg.paths["launcher_ready"]),
            "home_state_path": str(cfg.paths["home_state"]),
            "wlfb_state_path": str(cfg.paths["wlfb_state"]),
            "touch_state_path": str(cfg.paths["touch_state"]),
            "touch_last_line": last_touch[:160],
            "display_off": not display_on,
            **display_detail,
        },
    )


class MpvIPC:
    """Small newline-JSON mpv IPC client with bounded reads."""

    def __init__(self, path: Path, timeout: float = 0.5):
        self.path = path
        self.timeout = timeout
        self.sock: socket.socket | None = None
        self.buf = b""
        self.request_id = 0

    def connect(self, deadline: float) -> bool:
        while time.monotonic() < deadline:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(self.timeout)
            try:
                sock.connect(str(self.path))
                self.sock = sock
                return True
            except OSError:
                sock.close()
                time.sleep(0.05)
        return False

    def _recv_line(self, deadline: float) -> bytes | None:
        assert self.sock is not None
        while b"\n" not in self.buf:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            self.sock.settimeout(min(0.25, max(0.01, remaining)))
            try:
                chunk = self.sock.recv(4096)
            except socket.timeout:
                continue
            except OSError:
                return None
            if not chunk:
                return None
            self.buf += chunk
        line, _, self.buf = self.buf.partition(b"\n")
        return line

    def command(self, command: list[Any], timeout: float | None = None) -> dict[str, Any] | None:
        if not self.sock:
            return None
        self.request_id += 1
        rid = self.request_id
        payload = {"command": command, "request_id": rid}
        try:
            self.sock.sendall((json.dumps(payload) + "\n").encode())
        except OSError:
            return None
        deadline = time.monotonic() + (timeout if timeout is not None else self.timeout)
        while True:
            line = self._recv_line(deadline)
            if line is None:
                return None
            try:
                doc = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            if doc.get("request_id") == rid:
                return doc

    def close(self) -> None:
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None
        try:
            self.path.unlink()
        except OSError:
            pass


def _display_state(cfg: Config) -> tuple[bool, bool]:
    ready, on, _detail = _display_signals(cfg)
    return ready, on


def preflight(cfg: Config, log: Logger) -> tuple[bool, str]:
    player = Path(str(cfg.get("player")))
    asset = Path(str(cfg.get("asset")))
    if not player.is_file() or not os.access(player, os.X_OK):
        return False, "player-missing"
    cmd = [str(player), "--no-config", "--no-audio", "--mute=yes",
           "--vo=null", "--frames=1", "--really-quiet", "--no-terminal",
           "--hwdec=no", "--", str(asset)]
    timeout = int(cfg.get("preflight_timeout_ms", DEFAULT_PREFLIGHT_TIMEOUT_MS)) / 1000.0
    try:
        done = subprocess.run(cmd, stdout=subprocess.DEVNULL,
                              stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, "preflight-timeout"
    except OSError as exc:
        return False, "preflight-oserror:%s" % exc
    if done.returncode != 0:
        tail = (done.stderr or b"").decode("utf-8", "replace").strip().replace("\n", " ")[-300:]
        log.log("WARN", "decode_failed", rc=done.returncode, stderr=tail)
        return False, "decode-failed:%d" % done.returncode
    return True, "ok"


