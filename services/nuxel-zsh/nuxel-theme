#!/bin/sh
# nuxel-theme — list or select one of the four Nuxel zsh prompt themes.
set -eu

SYS=${NUXEL_ZSH_SYSTEM_CONF:-/etc/nuxel/zsh.conf}
CONF=${NUXEL_ZSH_USER_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/nuxel/zsh.conf}
SCOPE=user

usage() {
    cat <<'USAGE'
usage: nuxel-theme [1|2|3|4|list|current|reset] [--system] [--config FILE]

  1  Clean Blue Gradient with Penguin (default)
  2  Ice Diamond dual-line
  3  Standard block segments
  4  Cyber / Nuxel tech with Git branch

With no argument, shows the current theme and the available choices.
--system writes the system default (requires root); the default is per-user.
USAGE
}

get_style() {
    [ -r "$1" ] || return 1
    sed -n 's/^[[:space:]]*NUXEL_PROMPT_STYLE=\([1-4]\).*/\1/p' "$1" | tail -n 1
}

current_style() {
    s=$(get_style "$CONF" 2>/dev/null || true)
    [ -n "${s:-}" ] || s=$(get_style "$SYS" 2>/dev/null || true)
    [ -n "${s:-}" ] || s=1
    printf '%s\n' "$s"
}

show() {
    c=$(current_style)
    printf 'Nuxel zsh prompt theme: %s\n\n' "$c"
    printf '  1  Clean Blue Gradient with Penguin%s\n' "$([ "$c" = 1 ] && printf '  (current)')"
    printf '  2  Ice Diamond dual-line%s\n' "$([ "$c" = 2 ] && printf '  (current)')"
    printf '  3  Standard block segments%s\n' "$([ "$c" = 3 ] && printf '  (current)')"
    printf '  4  Cyber / Nuxel tech with Git branch%s\n' "$([ "$c" = 4 ] && printf '  (current)')"
    printf '\nChange with: nuxel-theme 1   (or 2, 3, 4)\n'
    printf 'User config: %s\nSystem config: %s\n' "$CONF" "$SYS"
}

write_style() {
    style=$1
    case $style in 1|2|3|4) ;; *) echo "nuxel-theme: invalid theme '$style' (use 1-4)" >&2; exit 2 ;; esac
    target=$CONF
    [ "$SCOPE" = system ] && target=$SYS
    dir=$(dirname "$target")
    mkdir -p "$dir"
    if [ -f "$target" ]; then
        backup="$target.bak.$(date +%Y%m%dT%H%M%S)"
        cp -p "$target" "$backup"
        # Preserve unrelated settings while replacing the style line.
        tmp=$(mktemp "${target}.XXXXXX")
        sed '/^[[:space:]]*NUXEL_PROMPT_STYLE=/d' "$target" > "$tmp"
        printf 'NUXEL_PROMPT_STYLE=%s\n' "$style" >> "$tmp"
        mv "$tmp" "$target"
        printf 'Updated %s (backup: %s)\n' "$target" "$backup"
    else
        {
            printf '# Nuxel terminal configuration\n'
            printf 'NUXEL_PROMPT_STYLE=%s\n' "$style"
            printf 'NUXEL_BANNER=1\nNUXEL_PROMPT_GIT=1\nNUXEL_PROMPT_CLOCK=1\n'
            printf 'NUXEL_PENGUIN=1\nNUXEL_COLOR=1\n'
        } > "$target"
        printf 'Created %s with theme %s\n' "$target" "$style"
    fi
    printf 'Takes effect in the next shell.\n'
}

action=${1:-show}
[ $# -gt 0 ] && shift || true
while [ $# -gt 0 ]; do
    case $1 in
        --system) SCOPE=system ;;
        --config) [ $# -ge 2 ] || { echo "nuxel-theme: --config needs a file" >&2; exit 2; }; CONF=$2; shift ;;
        --help|-h) usage; exit 0 ;;
        *) echo "nuxel-theme: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

case $action in
    show|list|current) show ;;
    reset)
        if [ -f "$CONF" ]; then
            backup="$CONF.bak.$(date +%Y%m%dT%H%M%S)"
            cp -p "$CONF" "$backup"
            rm -f "$CONF"
            printf 'Removed %s (backup: %s); theme falls back to system/default.\n' "$CONF" "$backup"
        else
            printf 'No user config at %s; already using the system/default theme.\n' "$CONF"
        fi
        ;;
    1|2|3|4) write_style "$action" ;;
    *) echo "nuxel-theme: unknown theme '$action'" >&2; usage >&2; exit 2 ;;
esac
