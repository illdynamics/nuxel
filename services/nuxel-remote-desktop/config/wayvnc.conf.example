# Nuxel VNC screen sharing example.
# Direct owner-LAN listener on TCP 5900.  The privileged controller generates
# the live file with the current WLAN IPv4 address, enable_auth=true and
# enable_pam=true; this example is never used as an unauthenticated fallback.
#
# wayvnc 0.9.1 syntax:
#   enable_auth=true requires certificate_file + private_key_file.
#   enable_pam=true uses /etc/pam.d/wayvnc for the local nuxel account.
#   rsa_private_key_file enables the RSA-AES security type.
address=127.0.0.1
port=5900
enable_auth=true
enable_pam=true
certificate_file=/etc/nuxel/remote-desktop/vnc/tls_cert.pem
private_key_file=/etc/nuxel/remote-desktop/vnc/tls_key.pem
rsa_private_key_file=/etc/nuxel/remote-desktop/vnc/rsa_key.pem
use_relative_paths=false
