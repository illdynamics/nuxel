#!/bin/sh
# Nuxel direct-LAN VNC launcher.  The patched wayvnc 0.10.2 mirrors the active
# Phoc/Wayland session, authenticates with PAM (no VNC password), and follows
# the orientation published by nuxel-orientationd.
set -eu
CONF=/etc/nuxel/remote-desktop/vnc/wayvnc.conf
[ -r "$CONF" ] || { echo "missing $CONF" >&2; exit 2; }
ADDRESS=$(sed -n 's/^address=//p' "$CONF" | head -n 1)
PORT=$(sed -n 's/^port=//p' "$CONF" | head -n 1)
case "$ADDRESS" in *[!0-9.]*|'') echo "invalid address" >&2; exit 2 ;; esac
[ "$PORT" = "5900" ] || { echo "invalid port" >&2; exit 2; }
CURRENT_WLAN=$(ip -4 -o addr show dev wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
case "$CURRENT_WLAN" in
  *[!0-9.]*|'') : ;;
  *) ADDRESS="$CURRENT_WLAN" ;;
esac
case "$ADDRESS" in ''|*[!0-9.]*) echo "invalid address" >&2; exit 2 ;; esac
# Keep the generated config current; wayvnc 0.10.2 reads address/port from it.
sed -i "s/^address=.*/address=$ADDRESS/" "$CONF"
exec env LD_LIBRARY_PATH=/opt/nuxel-wayvnc/lib64 \
    /opt/nuxel-wayvnc/bin/wayvnc -C "$CONF" \
    -S /run/nuxel-wayland/wayvncctl -L info -f 15
