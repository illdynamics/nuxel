#!/usr/bin/env python3
"""Fixed, allow-listed lifecycle helper for Nuxel GUI remote access.

Only this helper starts/stops the graphical services.  It accepts one action and
one service name; it never accepts a command, path, address or port from the
caller.  The listeners are bound to the *current trusted WLAN IPv4 address* on
the owner-requested ports:

  * XRDP: TCP 3389 (standard RDP), TLS only, PAM as the local ``nuxel``
    account, separate X11 session;
  * VNC:  TCP 5900 (standard RFB), TigerVNC Xvnc with VncAuth password
    authentication, a separate X11/Openbox session.  This is the combination
    Jump Desktop actually negotiates; wayvnc's VeNCrypt-only auth remains
    available manually but is not the default remote-desktop profile.

Binding a specific WLAN address (instead of 0.0.0.0) is the fail-closed LAN
boundary on images without a firewall engine.  The USB network path is never
touched on the recorded 4.14.253 kernel.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import secrets
import shutil
import signal
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

STATE_DIR = Path("/run/nuxel/remote-desktop")
PREF_DIR = Path("/var/lib/nuxel/remote-desktop")
VNC_DIR = Path("/etc/nuxel/remote-desktop/vnc")
VNC_CONF = VNC_DIR / "xvnc.conf"
VNC_PASS = VNC_DIR / "vnc.passwd"
VNC_PASSWORD_TXT = VNC_DIR / "password.txt"
VNC_STARTUP = Path("/home/nuxel/.vnc/xstartup")
VNC_CERT = VNC_DIR / "tls_cert.pem"
VNC_KEY = VNC_DIR / "tls_key.pem"
VNC_RSA_KEY = VNC_DIR / "rsa_key.pem"
VNC_PAM = Path("/etc/pam.d/wayvnc")
VNC_SERVICE = "nuxel-remote-vnc.service"
XRDP_CONF = Path("/etc/xrdp/xrdp.ini")
XRDP_CERT = Path("/etc/xrdp/nuxel-cert.pem")
XRDP_KEY = Path("/etc/xrdp/nuxel-key.pem")
XRDP_PAM = Path("/etc/pam.d/xrdp-sesman")
XRDP_UNITS = ("xrdp-sesman.service", "xrdp.service")
SERVICES = ("vnc", "xrdp", "scrcpy")
PORTS = {"vnc": 5900, "xrdp": 3389}
VNC_GEOMETRY_DEFAULT = "1520x720"
VNC_GEOMETRY_RE = re.compile(r"^([0-9]{3,4})x([0-9]{3,4})$")
WAYLAND_RUNTIME = Path("/run/nuxel-wayland")
WAYLAND_DISPLAY = "wayland-0"
VNC_REQUIRED_PROTOCOLS = (
    "zwlr_screencopy_manager_v1",
    "zwlr_virtual_pointer_manager_v1",
    "zwp_virtual_keyboard_manager_v1",
)

VNC_PAM_BODY = """#%PAM-1.0
# wayvnc authenticates against the local Nuxel account only.
auth       required     pam_succeed_if.so user = nuxel
account    required     pam_succeed_if.so user = nuxel
auth       include      password-auth
account    include      password-auth
"""


def _run(args: List[str], timeout: float = 15.0) -> subprocess.CompletedProcess:
    """Bounded fixed-argv command. A timeout is a real failure, never a crash."""
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(
            args, 124,
            (exc.stdout or "") if isinstance(exc.stdout, str) else "",
            "timed out after %.0fs" % timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return subprocess.CompletedProcess(args, 127, "", str(exc))


def _active(unit: str) -> bool:
    try:
        p = _run(["systemctl", "is-active", unit], timeout=3)
        return p.returncode == 0 and p.stdout.strip() == "active"
    except (OSError, subprocess.SubprocessError):
        return False


def _listeners(port: int) -> List[str]:
    """Return local listen addresses for ``port`` from ss or /proc/net/tcp."""
    found: List[str] = []
    p = _run(["ss", "-ltnH"], timeout=3)
    if p.returncode == 0 and p.stdout.strip():
        for line in p.stdout.splitlines():
            fields = line.split()
            if len(fields) < 4:
                continue
            local = fields[3]
            host, _, got = local.rpartition(":")
            if got == str(port):
                found.append(host.strip("[]"))
        return found
    # Fallback: /proc/net/tcp and tcp6, no process names.
    for name in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            lines = Path(name).read_text().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            parts = line.split()
            if len(parts) < 4 or parts[3] != "0A":
                continue
            raw = parts[1]
            host_hex, _, port_hex = raw.rpartition(":")
            if int(port_hex, 16) != port:
                continue
            if len(host_hex) == 8:
                octets = [int(host_hex[i:i + 2], 16) for i in (6, 4, 2, 0)]
                found.append(".".join(str(o) for o in octets))
            else:
                found.append("::")
    return found


def _listener(port: int, address: Optional[str] = None) -> bool:
    addrs = _listeners(port)
    if address is None:
        return bool(addrs)
    return address in addrs


def _private_ipv4(addr: str) -> bool:
    try:
        a, b, *_ = [int(part) for part in addr.split(".")]
    except (ValueError, IndexError):
        return False
    return a == 10 or (a == 172 and 16 <= b <= 31) or (a == 192 and b == 168)


def _network_from_ip() -> Optional[Dict[str, Any]]:
    p = _run(["ip", "-4", "-o", "addr", "show"], timeout=3)
    if p.returncode != 0:
        return None
    for line in p.stdout.splitlines():
        m = re.match(r"^\d+:\s+([^:\s@]+)(?:@\S+)?\s+inet\s+(\d+\.\d+\.\d+\.\d+)/(\d+)", line)
        if m and m.group(1).startswith("wlan") and _private_ipv4(m.group(2)):
            return {"interface": m.group(1), "address": m.group(2), "prefix": m.group(3)}
    return None


def _network_from_ioctl() -> Optional[Dict[str, Any]]:
    try:
        names = sorted(p.name for p in Path("/sys/class/net").iterdir())
    except OSError:
        return None
    for name in names:
        if not name.startswith("wlan"):
            continue
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            try:
                packed = struct.pack("256s", name.encode()[:15])
                addr = socket.inet_ntoa(fcntl.ioctl(sock.fileno(), 0x8915, packed)[20:24])
                try:
                    mask = socket.inet_ntoa(fcntl.ioctl(sock.fileno(), 0x891B, packed)[20:24])
                    prefix = str(sum(bin(int(p)).count("1") for p in mask.split(".")))
                except OSError:
                    prefix = "24"
            finally:
                sock.close()
        except OSError:
            continue
        if _private_ipv4(addr):
            return {"interface": name, "address": addr, "prefix": prefix}
    return None


def _network() -> Dict[str, Any]:
    """Live trusted WLAN IPv4, never a historical hard-coded address."""
    net = _network_from_ip() or _network_from_ioctl()
    return net or {"interface": None, "address": None, "prefix": None}


def _write_atomic(path: Path, text: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".nuxel-tmp")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def _state() -> Dict[str, Any]:
    try:
        doc = json.loads((STATE_DIR / "state.json").read_text())
        return doc if isinstance(doc, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _write_state(state: Dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_DIR / "state.json.tmp"
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_DIR / "state.json")


def _cert_material_ok(cert: Path, key: Path) -> Tuple[bool, str]:
    for path in (cert, key):
        if not path.is_file():
            return False, "missing %s" % path
        if path.stat().st_size == 0:
            return False, "empty %s" % path
    p = _run(["openssl", "x509", "-in", str(cert), "-noout"], timeout=4)
    if p.returncode != 0:
        return False, "invalid certificate %s: %s" % (cert, (p.stderr or p.stdout).strip()[:200])
    p = _run(["openssl", "rsa", "-in", str(key), "-noout", "-check"], timeout=4)
    if p.returncode != 0:
        return False, "invalid private key %s: %s" % (key, (p.stderr or p.stdout).strip()[:200])
    return True, "ok"


def _ensure_vnc_auth_material(address: str) -> str:
    """Create per-device TLS + RSA material and the PAM service, root-only."""
    VNC_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(VNC_DIR, 0o700)
    if not VNC_CERT.is_file() or not VNC_KEY.is_file():
        p = _run([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "825",
            "-subj", "/CN=nuxel-vnc",
            "-addext", "subjectAltName=DNS:nuxel,DNS:localhost,IP:127.0.0.1,IP:%s" % address,
            "-keyout", str(VNC_KEY), "-out", str(VNC_CERT),
        ], timeout=20)
        if p.returncode != 0:
            raise RuntimeError("VNC TLS material generation failed: %s" %
                               (p.stderr or p.stdout).strip()[:400])
    if not VNC_RSA_KEY.is_file():
        p = _run(["ssh-keygen", "-q", "-m", "pem", "-t", "rsa", "-b", "2048",
                  "-N", "", "-f", str(VNC_RSA_KEY)], timeout=20)
        if p.returncode != 0:
            p = _run(["openssl", "genrsa", "-traditional", "-out", str(VNC_RSA_KEY), "2048"],
                     timeout=20)
        if p.returncode != 0:
            raise RuntimeError("VNC RSA-AES key generation failed: %s" %
                               (p.stderr or p.stdout).strip()[:400])
    for path in (VNC_CERT, VNC_KEY, VNC_RSA_KEY):
        try:
            os.chmod(path, 0o600)
        except OSError:
            pass
    ok, why = _cert_material_ok(VNC_CERT, VNC_KEY)
    if not ok:
        raise RuntimeError("VNC TLS material invalid: " + why)
    p = _run(["openssl", "rsa", "-in", str(VNC_RSA_KEY), "-noout", "-check"], timeout=4)
    if p.returncode != 0:
        raise RuntimeError("VNC RSA-AES key invalid: %s" % (p.stderr or p.stdout).strip()[:300])
    # The PAM service is fixed content, not caller input.
    current = ""
    try:
        current = VNC_PAM.read_text()
    except OSError:
        pass
    if "pam_succeed_if.so user = nuxel" not in current:
        _write_atomic(VNC_PAM, VNC_PAM_BODY, 0o644)
    return "ok"


def _ensure_xrdp_auth_material() -> str:
    ok, why = _cert_material_ok(XRDP_CERT, XRDP_KEY)
    if not ok:
        raise RuntimeError("XRDP TLS material invalid: " + why)
    try:
        pam = XRDP_PAM.read_text()
    except OSError as exc:
        raise RuntimeError("XRDP PAM policy missing: %s" % exc)
    if "pam_succeed_if.so user = nuxel" not in pam:
        raise RuntimeError("XRDP PAM policy does not restrict login to nuxel")
    return "ok"


VNC_PASSWORD_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"


def _ensure_vnc_password() -> str:
    """Create an 8-character VNC password once; never log or return it."""
    VNC_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(VNC_DIR, 0o755)
    except OSError:
        pass
    if not VNC_PASS.is_file() or VNC_PASS.stat().st_size < 8:
        if not shutil.which("vncpasswd"):
            raise RuntimeError("vncpasswd is not installed")
        password = "".join(secrets.choice(VNC_PASSWORD_ALPHABET) for _ in range(8))
        proc = subprocess.run(["vncpasswd", "-f"], input=password,
                              capture_output=True, text=True, timeout=10)
        if proc.returncode != 0:
            raise RuntimeError("vncpasswd failed: " + (proc.stderr or "").strip())
        VNC_PASS.write_bytes(proc.stdout[:8])
        os.chmod(VNC_PASS, 0o600)
        try:
            os.chown(VNC_PASS, 1000, 1000)
        except OSError:
            pass
        # The owner can read the generated password from this mode-0600 file.
        VNC_PASSWORD_TXT.write_text(password + "\n")
        os.chmod(VNC_PASSWORD_TXT, 0o600)
        try:
            os.chown(VNC_PASSWORD_TXT, 1000, 1000)
        except OSError:
            pass
    else:
        os.chmod(VNC_PASS, 0o600)
        try:
            os.chown(VNC_PASS, 1000, 1000)
        except OSError:
            pass
    return str(VNC_PASS)


def _ensure_vnc_startup() -> None:
    VNC_STARTUP.parent.mkdir(parents=True, exist_ok=True)
    if not VNC_STARTUP.is_file():
        VNC_STARTUP.write_text("#!/bin/sh\nexec openbox-session\n")
        os.chmod(VNC_STARTUP, 0o755)
        try:
            os.chown(VNC_STARTUP, 1000, 1000)
            os.chown(VNC_STARTUP.parent, 1000, 1000)
        except OSError:
            pass


def _vnc_geometry() -> str:
    """Return a validated landscape WxH for the separate X11 session."""
    value = os.environ.get("NUXEL_VNC_GEOMETRY", VNC_GEOMETRY_DEFAULT).strip().lower()
    match = VNC_GEOMETRY_RE.match(value)
    if not match:
        raise RuntimeError("invalid VNC geometry: %r" % value)
    width, height = int(match.group(1)), int(match.group(2))
    if width < 640 or height < 360 or width > 4096 or height > 2304:
        raise RuntimeError("VNC geometry out of range")
    if width < height:
        raise RuntimeError("VNC geometry must be landscape")
    return "%dx%d" % (width, height)


def _write_vnc_config(address: str) -> None:
    """Direct-LAN RFB with a real VNC password (VncAuth)."""
    if not re.match(r"^\d{1,3}(?:\.\d{1,3}){3}$", address or ""):
        raise RuntimeError("invalid VNC bind address")
    password_file = _ensure_vnc_password()
    _ensure_vnc_startup()
    geometry = _vnc_geometry()
    text = (
        "# Nuxel - generated by nuxel-remote-desktop-ctl\n"
        "# Direct owner-LAN listener. TigerVNC VncAuth (password, 8 chars).\n"
        "address=%s\n"
        "port=%d\n"
        "password_file=%s\n"
        "security_types=VncAuth\n"
        "geometry=%s\n"
    ) % (address, PORTS["vnc"], password_file, geometry)
    _write_atomic(VNC_CONF, text, 0o644)


def _write_xrdp_config(address: str) -> None:
    """Bind the TLS-only xrdp listener to the current trusted WLAN address."""
    _ensure_xrdp_auth_material()
    try:
        original = XRDP_CONF.read_text()
    except OSError as exc:
        raise RuntimeError("xrdp.ini is missing: %s" % exc)
    lines = original.splitlines()
    out: List[str] = []
    replaced = False
    for line in lines:
        if not replaced and line.strip().startswith("port="):
            out.append("port=tcp://%s:%d" % (address, PORTS["xrdp"]))
            replaced = True
        elif line.strip().startswith("autorun="):
            out.append("autorun=Xorg")
        else:
            out.append(line)
    if not replaced:
        raise RuntimeError("xrdp.ini has no port= line")
    text = "\n".join(out) + "\n"
    for required in ("security_layer=tls", "certificate=%s" % XRDP_CERT,
                     "key_file=%s" % XRDP_KEY):
        if required not in text:
            raise RuntimeError("xrdp.ini is missing required directive: " + required)
    _write_atomic(XRDP_CONF, text, 0o644)


def _is_landscape_geometry(value: str) -> bool:
    match = VNC_GEOMETRY_RE.match(str(value or ""))
    return bool(match and int(match.group(1)) >= int(match.group(2)))


def _vnc_effective() -> Dict[str, Any]:
    """Parse the effective Xvnc config without ever returning secrets."""
    try:
        text = VNC_CONF.read_text()
    except OSError:
        text = ""
    values: Dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        values[key.strip()] = val.strip()
    password_file = values.get("password_file") or ""
    password_ok = False
    try:
        password_ok = (Path(password_file).is_file()
                       and Path(password_file).stat().st_size >= 8)
    except OSError:
        pass
    return {
        "configured": bool(values),
        "address": values.get("address"),
        "port": int(values["port"]) if values.get("port", "").isdigit() else None,
        "geometry": values.get("geometry") or VNC_GEOMETRY_DEFAULT,
        "landscape": _is_landscape_geometry(values.get("geometry") or VNC_GEOMETRY_DEFAULT),
        "enable_auth": values.get("security_types") == "VncAuth" and password_ok,
        "enable_pam": False,
        "password_file": password_file,
        "password_file_ok": password_ok,
        "tls_certificate": None,
        "tls_private_key": None,
        "rsa_private_key": None,
    }


def _xrdp_bind() -> Dict[str, Any]:
    try:
        text = XRDP_CONF.read_text()
    except OSError:
        return {"configured": False, "address": None, "port": None, "tls": False}
    m = re.search(r"^port=tcp://([^:]+):(\d+)$", text, re.M)
    return {
        "configured": bool(m),
        "address": (m.group(1) or None) if m else None,
        "port": int(m.group(2)) if m else None,
        "tls": "security_layer=tls" in text,
    }


def _wayland_ready() -> Tuple[bool, str, List[str]]:
    sock = WAYLAND_RUNTIME / WAYLAND_DISPLAY
    if not sock.exists():
        return False, "Wayland socket %s is missing" % sock, []
    info = shutil.which("wayland-info")
    if not info:
        return False, "wayland-info is missing; protocol capability cannot be proven", []
    env = dict(os.environ)
    env.update({"XDG_RUNTIME_DIR": str(WAYLAND_RUNTIME),
                "WAYLAND_DISPLAY": WAYLAND_DISPLAY,
                "XDG_SESSION_TYPE": "wayland"})
    p = _run([info], timeout=8)
    # _run has no env argument; use subprocess directly for the environment.
    try:
        p = subprocess.run([info], capture_output=True, text=True, timeout=8,
                           stdin=subprocess.DEVNULL, env=env)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, "wayland-info failed: %s" % exc, []
    if p.returncode != 0:
        return False, (p.stderr or p.stdout).strip()[:400], []
    protocols = sorted(set(re.findall(r"interface:\s+'([^']+)'", p.stdout)))
    missing = [name for name in VNC_REQUIRED_PROTOCOLS if name not in protocols]
    if missing:
        return False, "Phoc does not advertise: " + ", ".join(missing), protocols
    return True, "ok", protocols


def _usb_summary() -> Dict[str, Any]:
    """Read-only mode summary; never mutates configfs."""
    kernel = ""
    try:
        kernel = Path("/proc/sys/kernel/osrelease").read_text().strip()
    except OSError:
        pass
    base = re.sub(r"[-+].*$", "", kernel)
    funcs: List[str] = []
    try:
        for gadget in Path("/sys/kernel/config/usb_gadget").iterdir():
            froot = gadget / "functions"
            if froot.is_dir():
                funcs.extend(sorted(p.name for p in froot.iterdir()))
    except OSError:
        pass
    acm = any(name.startswith("acm.") for name in funcs)
    return {
        "kernel_release": kernel,
        "modes": {
            "ncm": {"status": "BLOCKED_KNOWN_PANIC" if base == "4.14.253" else "UNVERIFIED"},
            "rndis": {"status": "NEEDS_VALIDATION"},
            "ecm": {"status": "BLOCKED_KERNEL"},
        },
        "acm_preserved": acm,
        "gadget_functions": funcs,
        "mutated": False,
    }


def status() -> Dict[str, Any]:
    """Read-only truth for the Bridge and quickstart. No secrets, no mutation."""
    net = _network()
    vnc_cfg = _vnc_effective()
    xrdp_cfg = _xrdp_bind()
    vnc_active = _active(VNC_SERVICE)
    vnc_addrs = _listeners(PORTS["vnc"])
    vnc_listening = bool(vnc_addrs)
    xrdp_active = all(_active(u) for u in XRDP_UNITS)
    xrdp_addrs = _listeners(PORTS["xrdp"])
    xrdp_listening = bool(xrdp_addrs)

    vnc_secure = bool(vnc_active and vnc_listening and vnc_cfg.get("enable_auth"))
    if not shutil.which("Xvnc"):
        vnc_state, vnc_reason = "UNSUPPORTED", "TigerVNC Xvnc is not installed"
    elif vnc_listening and not vnc_active:
        vnc_state, vnc_reason = "ERROR", "An Xvnc listener is open but the managed unit is not active"
    elif vnc_active and vnc_listening:
        vnc_state = "WAITING_FOR_CLIENT"
        vnc_reason = "VNC password auth is active on the separate X11/Openbox session"
    else:
        vnc_state, vnc_reason = "OFF", "Service is stopped by default"

    xrdp_secure = bool(
        xrdp_active and xrdp_listening and XRDP_CONF.is_file()
        and XRDP_CERT.is_file() and XRDP_KEY.is_file())
    if not shutil.which("xrdp") or not shutil.which("Xorg"):
        xrdp_state, xrdp_reason = "UNSUPPORTED", "xrdp or Xorg is not installed"
    elif xrdp_listening and not xrdp_active:
        xrdp_state, xrdp_reason = "ERROR", "An xrdp listener is open but sesman/xrdp units are not both active"
    elif xrdp_active and xrdp_listening:
        xrdp_state = "WAITING_FOR_CLIENT"
        xrdp_reason = "TLS xrdp is listening for the owner's RDP client"
    else:
        xrdp_state, xrdp_reason = "OFF", "Service is stopped by default"

    return {
        "success": True,
        "ports": dict(PORTS),
        "services": {
            "vnc": {
                "state": vnc_state, "reason": vnc_reason,
                "active": vnc_active, "listener_verified": vnc_listening,
                "configured_bind_address": vnc_cfg.get("address"),
                "bind_address": (vnc_cfg.get("address") if vnc_active else net.get("address")),
                "listener_addresses": vnc_addrs,
                "port": PORTS["vnc"], "protocol": "tcp",
                "session_mode": "separate-x11-session",
                "transport": "wlan" if vnc_active else None,
                "authentication_mode": ("VNC password (TigerVNC VncAuth)"
                                        if vnc_cfg.get("enable_auth") else "UNAUTHENTICATED"),
                "encrypted": False,
                "vnc_password_configured": bool(vnc_cfg.get("password_file_ok")),
                "geometry": vnc_cfg.get("geometry"),
                "landscape": vnc_cfg.get("landscape"),
                "security_verified": vnc_secure,
                "input_enabled": True,
                "privacy_gate_ok": vnc_secure,
            },
            "xrdp": {
                "state": xrdp_state, "reason": xrdp_reason,
                "active": xrdp_active, "listener_verified": xrdp_listening,
                "configured_bind_address": xrdp_cfg.get("address"),
                "bind_address": (xrdp_cfg.get("address") if xrdp_active else net.get("address")),
                "listener_addresses": xrdp_addrs,
                "port": PORTS["xrdp"], "protocol": "tcp",
                "session_mode": "separate-x11-session",
                "transport": "wlan" if xrdp_active else None,
                "authentication_mode": "PAM + TLS 1.2/1.3",
                "encrypted": bool(xrdp_cfg.get("tls") and XRDP_CERT.is_file() and XRDP_KEY.is_file()),
                "security_verified": xrdp_secure,
            },
            "scrcpy": {
                "state": "NOT_APPLICABLE_NATIVE_NUXEL",
                "reason": ("scrcpy supports Android ADB targets only; this handset is "
                           "native Nuxel. Use the native screen-sharing route instead."),
                "native_mirror": {
                    "service": "vnc", "host": net.get("address"),
                    "port": PORTS["vnc"], "protocol": "tcp",
                    "direct_lan": True,
                },
            },
        },
        "network": net,
        "privacy": {"active": vnc_secure or xrdp_secure},
        "usb": _usb_summary(),
    }


def start_vnc() -> Dict[str, Any]:
    if not shutil.which("Xvnc") or not shutil.which("vncpasswd"):
        return {"success": False, "error": "TigerVNC Xvnc/vncpasswd is not installed",
                "error_code": "UNSUPPORTED"}
    net = _network()
    address = net.get("address")
    if not address:
        return {"success": False, "error": "no trusted private WLAN IPv4 address; refusing wildcard exposure",
                "error_code": "NO_TRUSTED_LAN"}
    try:
        _write_vnc_config(address)
    except (RuntimeError, OSError) as exc:
        return {"success": False, "error": str(exc), "error_code": "AUTH_MATERIAL"}
    PREF_DIR.mkdir(parents=True, exist_ok=True)
    p = _run(["systemctl", "start", "--no-block", VNC_SERVICE], timeout=10)
    if p.returncode != 0:
        return {"success": False, "error": (p.stderr or p.stdout).strip()[-800:],
                "error_code": "START_FAILED"}
    for _ in range(40):
        if _active(VNC_SERVICE) and _listener(PORTS["vnc"], address):
            st = _state()
            st["vnc"] = {"started_at": time.time(), "transport": "wlan",
                         "session": "separate-x11-session",
                         "bind_address": address, "port": PORTS["vnc"]}
            _write_state(st)
            return {"success": True, "service": "vnc", "state": "READY",
                    "transport": "wlan", "bind_address": address,
                    "port": PORTS["vnc"],
                    "authentication_mode": "VNC password (TigerVNC VncAuth)",
                    "security_verified": True}
        time.sleep(0.25)
    _run(["systemctl", "stop", VNC_SERVICE], timeout=10)
    return {"success": False,
            "error": "Xvnc did not open %s:%d with VncAuth" % (address, PORTS["vnc"]),
            "error_code": "START_TIMEOUT"}


def stop_vnc() -> Dict[str, Any]:
    _run(["systemctl", "stop", VNC_SERVICE], timeout=15)
    _run(["systemctl", "reset-failed", VNC_SERVICE], timeout=5)
    for _ in range(20):
        if not _listener(PORTS["vnc"]):
            break
        time.sleep(0.1)
    st = _state()
    st["vnc"] = {"started_at": None, "stopped_at": time.time(), "transport": None}
    _write_state(st)
    return {"success": True, "service": "vnc", "state": "OFF",
            "listener_closed": not _listener(PORTS["vnc"])}


def _clean_xrdp_stale_state() -> None:
    """Remove a stale sesman PID/socket left by an interrupted stop."""
    try:
        alive = _run(["pgrep", "-x", "xrdp-sesman"], timeout=3).returncode == 0
    except (OSError, subprocess.SubprocessError):
        alive = False
    if alive:
        return
    for path in ("/run/xrdp-sesman.pid", "/var/run/xrdp-sesman.pid",
                 "/run/xrdp/sesman.socket", "/var/run/xrdp/sesman.socket"):
        try:
            Path(path).unlink()
        except OSError:
            pass


def start_xrdp() -> Dict[str, Any]:
    if not shutil.which("xrdp") or not shutil.which("Xorg"):
        return {"success": False, "error": "xrdp or Xorg is not installed",
                "error_code": "UNSUPPORTED"}
    net = _network()
    address = net.get("address")
    if not address:
        return {"success": False, "error": "no trusted private WLAN IPv4 address; refusing wildcard exposure",
                "error_code": "NO_TRUSTED_LAN"}
    try:
        _write_xrdp_config(address)
    except RuntimeError as exc:
        return {"success": False, "error": str(exc), "error_code": "AUTH_MATERIAL"}
    _clean_xrdp_stale_state()
    for unit in XRDP_UNITS:
        p = _run(["systemctl", "start", unit], timeout=15)
        if p.returncode != 0:
            stop_xrdp()
            return {"success": False, "error": (p.stderr or p.stdout).strip()[-800:],
                    "error_code": "START_FAILED", "unit": unit}
    for _ in range(40):
        if all(_active(u) for u in XRDP_UNITS) and _listener(PORTS["xrdp"], address):
            st = _state()
            st["xrdp"] = {"started_at": time.time(), "transport": "wlan",
                          "session": "separate-x11-session",
                          "bind_address": address, "port": PORTS["xrdp"]}
            _write_state(st)
            return {"success": True, "service": "xrdp", "state": "READY",
                    "transport": "wlan", "bind_address": address,
                    "port": PORTS["xrdp"], "authentication_mode": "PAM + TLS 1.2/1.3",
                    "security_verified": True}
        time.sleep(0.25)
    stop_xrdp()
    return {"success": False,
            "error": "xrdp did not open %s:%d" % (address, PORTS["xrdp"]),
            "error_code": "START_TIMEOUT"}


def _kill_xrdp_x_servers() -> List[int]:
    killed: List[int] = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            cmd = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if "/usr/libexec/Xorg :" in cmd and "xorg-nuxel.conf" in cmd:
            try:
                os.kill(int(proc.name), signal.SIGTERM)
                killed.append(int(proc.name))
            except OSError:
                pass
    return killed


def _kill_session_processes() -> List[int]:
    """Terminate only the managed remote X11 session.

    Matches the fixed launcher, the xorg-nuxel X server and xrdp-sesexec.  It
    never matches Phoc, nuxel-wl-fb, the physical Wayland session or sshd.
    """
    killed: List[int] = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        pid = int(proc.name)
        if pid <= 1:
            continue
        try:
            cmd = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        is_x = "/usr/libexec/Xorg :" in cmd and "xorg-nuxel.conf" in cmd
        is_session = "/usr/local/bin/nuxel-xrdp-session" in cmd
        is_sesexec = cmd.startswith("xrdp-sesexec")
        if not (is_x or is_session or is_sesexec):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
            killed.append(pid)
        except OSError:
            continue
    for _ in range(20):
        if not any(Path("/proc/%d" % p).exists() for p in killed):
            break
        time.sleep(0.1)
    for pid in killed:
        if Path("/proc/%d" % pid).exists():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    return killed


def stop_xrdp() -> Dict[str, Any]:
    for unit in ("xrdp-sesman.service", "xrdp.service"):
        _run(["systemctl", "stop", "--no-block", unit], timeout=10)
    for _ in range(30):
        if not _active("xrdp.service") and not _active("xrdp-sesman.service"):
            break
        time.sleep(0.2)
    _clean_xrdp_stale_state()
    killed = _kill_session_processes()
    killed += _kill_xrdp_x_servers()
    _run(["systemctl", "reset-failed", "xrdp.service", "xrdp-sesman.service"], timeout=5)
    for _ in range(20):
        if not _listener(PORTS["xrdp"]):
            break
        time.sleep(0.1)
    st = _state()
    st["xrdp"] = {"started_at": None, "stopped_at": time.time(), "transport": None}
    _write_state(st)
    return {"success": True, "service": "xrdp", "state": "OFF",
            "listener_closed": not _listener(PORTS["xrdp"]), "killed_x_servers": killed}


def stop_all() -> Dict[str, Any]:
    results = [stop_vnc(), stop_xrdp()]
    return {"success": all(r.get("success") for r in results),
            "services": results, "state": "OFF"}


def main(argv: List[str]) -> int:
    if not argv:
        print(json.dumps({"success": False, "error": "action required"}))
        return 2
    action = argv[0]
    service = argv[1] if len(argv) > 1 else None
    if action == "status":
        result = status()
    elif action == "stop-all":
        result = stop_all()
    elif service not in SERVICES:
        print(json.dumps({"success": False, "error": "unknown service",
                          "error_code": "INVALID_SERVICE"}))
        return 2
    elif service == "scrcpy":
        print(json.dumps({"success": False,
                          "error": "scrcpy is Android-only; use the native VNC mirror route",
                          "error_code": "NOT_APPLICABLE_NATIVE_NUXEL"}))
        return 3
    elif action == "start" and service == "vnc":
        result = start_vnc()
    elif action == "stop" and service == "vnc":
        result = stop_vnc()
    elif action == "start" and service == "xrdp":
        result = start_xrdp()
    elif action == "stop" and service == "xrdp":
        result = stop_xrdp()
    else:
        print(json.dumps({"success": False, "error": "invalid action",
                          "error_code": "INVALID_ACTION"}))
        return 2
    print(json.dumps(result))
    return 0 if result.get("success") else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
