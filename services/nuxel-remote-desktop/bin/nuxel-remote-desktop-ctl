#!/usr/bin/env python3
"""Fixed, allow-listed lifecycle helper for Nuxel GUI remote access.

Only this helper starts/stops the graphical services.  It accepts one action and
one service name; it never accepts a command, path, address or port from the
caller.  All listeners are loopback-only and reached through the owner's pinned
key SSH tunnel.  The USB network path is never touched on the recorded 4.14.253
kernel.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional

STATE_DIR = Path("/run/nuxel/remote-desktop")
PREF_DIR = Path("/var/lib/nuxel/remote-desktop")
VNC_CONF = Path("/etc/nuxel/remote-desktop/vnc/wayvnc.conf")
VNC_SERVICE = "nuxel-remote-vnc.service"
XRDP_UNITS = ("xrdp-sesman.service", "xrdp.service")
SERVICES = ("vnc", "xrdp", "scrcpy")


def _run(args: List[str], timeout: float = 15.0) -> subprocess.CompletedProcess:
    """Bounded fixed-argv command. A timeout is a real failure, never a crash."""
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(
            args, 124,
            (exc.stdout or "") if isinstance(exc.stdout, str) else "",
            "timed out after %.0fs" % timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return subprocess.CompletedProcess(args, 127, "", str(exc))


def _active(unit: str) -> bool:
    try:
        p = _run(["systemctl", "is-active", unit], timeout=3)
        return p.returncode == 0 and p.stdout.strip() == "active"
    except (OSError, subprocess.SubprocessError):
        return False


def _listener(port: int) -> bool:
    try:
        p = _run(["ss", "-ltnH"], timeout=3)
    except (OSError, subprocess.SubprocessError):
        return False
    for line in p.stdout.splitlines():
        fields = line.split()
        if len(fields) >= 4 and fields[3].endswith(":%d" % port):
            return True
    return False


def _state() -> Dict[str, Any]:
    try:
        return json.loads((STATE_DIR / "state.json").read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def _write_state(state: Dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_DIR / "state.json.tmp"
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_DIR / "state.json")


def _write_vnc_config() -> None:
    """Loopback-only RFB.  Authentication/encryption is the pinned-key SSH tunnel."""
    VNC_CONF.parent.mkdir(parents=True, exist_ok=True)
    text = (
        "# Nuxel PWNAGE-47000 - generated by nuxel-remote-desktop-ctl\n"
        "# Loopback only. The owner reaches this through a pinned-key SSH local forward.\n"
        "address=127.0.0.1\n"
        "port=5900\n"
        "enable_auth=false\n"
    )
    tmp = VNC_CONF.with_suffix(".tmp")
    tmp.write_text(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, VNC_CONF)


def _network() -> Dict[str, Any]:
    try:
        p = _run(["ip", "-4", "-o", "addr", "show"], timeout=3)
    except (OSError, subprocess.SubprocessError):
        return {"interface": None, "address": None}
    for line in p.stdout.splitlines():
        m = re.match(r"^\d+:\s+([^:\s@]+)(?:@\S+)?\s+inet\s+(\d+\.\d+\.\d+\.\d+)/(\d+)", line)
        if m and m.group(1).startswith("wlan"):
            return {"interface": m.group(1), "address": m.group(2), "prefix": m.group(3)}
    return {"interface": None, "address": None}


def status() -> Dict[str, Any]:
    """Read-only truth for the quickstart.  No secrets, no mutation."""
    net = _network()
    return {
        "success": True,
        "services": {
            "vnc": {
                "state": "WAITING_FOR_CLIENT" if _active(VNC_SERVICE) and _listener(5900) else "OFF",
                "active": _active(VNC_SERVICE), "listener_verified": _listener(5900),
                "bind_address": "127.0.0.1", "port": 5900,
                "session_mode": "current-wayland-session",
                "transport": "wlan",
            },
            "xrdp": {
                "state": "READY" if _active("xrdp.service") and _active("xrdp-sesman.service") and _listener(3389) else "OFF",
                "active": _active("xrdp.service") and _active("xrdp-sesman.service"),
                "listener_verified": _listener(3389),
                "bind_address": "127.0.0.1", "port": 3389,
                "session_mode": "separate-x11-session",
                "transport": "wlan",
            },
            "scrcpy": {
                "state": "NOT_APPLICABLE_NATIVE_NUXEL",
                "reason": "scrcpy supports Android ADB targets only; use VNC for native Nuxel.",
            },
        },
        "network": net,
        "privacy": {"active": _listener(5900) or _listener(3389)},
        "usb": {"status": "BLOCKED_KERNEL_PANIC", "mutated": False},
    }


def start_vnc() -> Dict[str, Any]:
    if not shutil.which("wayvnc"):
        return {"success": False, "error": "wayvnc is not installed",
                "error_code": "UNSUPPORTED"}
    _write_vnc_config()
    PREF_DIR.mkdir(parents=True, exist_ok=True)
    p = _run(["systemctl", "start", "--no-block", VNC_SERVICE], timeout=10)
    if p.returncode != 0:
        return {"success": False, "error": (p.stderr or p.stdout).strip()[-800:],
                "error_code": "START_FAILED"}
    for _ in range(40):
        if _active(VNC_SERVICE) and _listener(5900):
            st = _state()
            st["vnc"] = {"started_at": time.time(), "transport": "wlan",
                          "session": "current-wayland-session"}
            _write_state(st)
            return {"success": True, "service": "vnc", "state": "READY",
                    "transport": "wlan", "bind_address": "127.0.0.1", "port": 5900}
        time.sleep(0.25)
    _run(["systemctl", "stop", VNC_SERVICE], timeout=10)
    return {"success": False, "error": "wayvnc did not open 127.0.0.1:5900",
            "error_code": "START_TIMEOUT"}


def stop_vnc() -> Dict[str, Any]:
    _run(["systemctl", "stop", VNC_SERVICE], timeout=15)
    _run(["systemctl", "reset-failed", VNC_SERVICE], timeout=5)
    st = _state()
    st["vnc"] = {"started_at": None, "stopped_at": time.time(), "transport": None}
    _write_state(st)
    return {"success": True, "service": "vnc", "state": "OFF",
            "listener_closed": not _listener(5900)}


def start_xrdp() -> Dict[str, Any]:
    if not shutil.which("xrdp") or not shutil.which("Xorg"):
        return {"success": False, "error": "xrdp or Xorg is not installed",
                "error_code": "UNSUPPORTED"}
    for unit in XRDP_UNITS:
        p = _run(["systemctl", "start", "--no-block", unit], timeout=10)
        if p.returncode != 0:
            return {"success": False, "error": (p.stderr or p.stdout).strip()[-800:],
                    "error_code": "START_FAILED", "unit": unit}
    for _ in range(40):
        if all(_active(u) for u in XRDP_UNITS) and _listener(3389):
            st = _state()
            st["xrdp"] = {"started_at": time.time(), "transport": "wlan",
                           "session": "separate-x11-session"}
            _write_state(st)
            return {"success": True, "service": "xrdp", "state": "READY",
                    "transport": "wlan", "bind_address": "127.0.0.1", "port": 3389}
        time.sleep(0.25)
    stop_xrdp()
    return {"success": False, "error": "xrdp did not open 127.0.0.1:3389",
            "error_code": "START_TIMEOUT"}


def _kill_xrdp_x_servers() -> List[int]:
    killed: List[int] = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            cmd = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if "/usr/libexec/Xorg :" in cmd and "xorg-nuxel.conf" in cmd:
            try:
                os.kill(int(proc.name), signal.SIGTERM)
                killed.append(int(proc.name))
            except OSError:
                pass
    return killed


def _kill_session_processes() -> List[int]:
    """Terminate the restricted X11 session after the units are stopped.

    xrdp-sesexec can outlive `systemctl stop xrdp.service` (measured: the unit
    stop timed out and left Xorg :10 running).  Kill only the fixed :10/Xorg
    pattern and processes owned by the dedicated nuxel-remote UID; never touch
    Phoc, nuxel-wl-fb or the physical session.
    """
    killed: List[int] = []
    try:
        uid = int(_run(["id", "-u", "nuxel-remote"], timeout=3).stdout.strip())
    except ValueError:
        uid = -1
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        pid = int(proc.name)
        if pid <= 1:
            continue
        try:
            cmd = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        is_x = ("/usr/libexec/Xorg :" in cmd and "xorg-nuxel.conf" in cmd)
        is_session = (uid > 0 and "/usr/local/bin/nuxel-xrdp-session" in cmd)
        is_firefox = (uid > 0 and "firefox" in cmd and "nuxel-remote" in cmd)
        is_sesexec = cmd.startswith("xrdp-sesexec")
        if not (is_x or is_session or is_firefox or is_sesexec):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
            killed.append(pid)
        except OSError:
            continue
    # Give sessions a bounded grace period, then force the stragglers.
    for _ in range(20):
        if not any(Path("/proc/%d" % p).exists() for p in killed):
            break
        time.sleep(0.1)
    for pid in killed:
        if Path("/proc/%d" % pid).exists():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    return killed


def stop_xrdp() -> Dict[str, Any]:
    # Stop the session manager first so xrdp.service is not kept alive by it.
    for unit in ("xrdp-sesman.service", "xrdp.service"):
        _run(["systemctl", "stop", "--no-block", unit], timeout=10)
    for _ in range(30):
        if not _active("xrdp.service") and not _active("xrdp-sesman.service"):
            break
        time.sleep(0.2)
    killed = _kill_session_processes()
    killed += _kill_xrdp_x_servers()
    # A forced session termination can leave the units in "failed"; clear that
    # so the app truth is OFF/inactive, not a stale red failure.
    _run(["systemctl", "reset-failed", "xrdp.service", "xrdp-sesman.service"], timeout=5)
    st = _state()
    st["xrdp"] = {"started_at": None, "stopped_at": time.time(), "transport": None}
    _write_state(st)
    return {"success": True, "service": "xrdp", "state": "OFF",
            "listener_closed": not _listener(3389), "killed_x_servers": killed}


def stop_all() -> Dict[str, Any]:
    results = [stop_vnc(), stop_xrdp()]
    return {"success": all(r.get("success") for r in results),
            "services": results, "state": "OFF"}


def main(argv: List[str]) -> int:
    if not argv:
        print(json.dumps({"success": False, "error": "action required"}))
        return 2
    action = argv[0]
    service = argv[1] if len(argv) > 1 else None
    if action == "status":
        result = status()
    elif action == "stop-all":
        result = stop_all()
    elif service not in SERVICES:
        print(json.dumps({"success": False, "error": "unknown service",
                          "error_code": "INVALID_SERVICE"}))
        return 2
    elif service == "scrcpy":
        print(json.dumps({"success": False,
                          "error": "scrcpy is Android-only and is not a service lifecycle",
                          "error_code": "NOT_APPLICABLE_NATIVE_NUXEL"}))
        return 3
    elif action == "start" and service == "vnc":
        result = start_vnc()
    elif action == "stop" and service == "vnc":
        result = stop_vnc()
    elif action == "start" and service == "xrdp":
        result = start_xrdp()
    elif action == "stop" and service == "xrdp":
        result = stop_xrdp()
    else:
        print(json.dumps({"success": False, "error": "invalid action",
                          "error_code": "INVALID_ACTION"}))
        return 2
    print(json.dumps(result))
    return 0 if result.get("success") else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
