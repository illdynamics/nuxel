[Unit]
Description=Nuxel VNC remote desktop (TigerVNC Xvnc, VncAuth, direct LAN)
Documentation=file:///usr/share/doc/nuxel/remote-desktop/README.md
# Enabled at boot and also startable by nuxel-remote-desktop-ctl.  It is a
# separate X11/Openbox session, matching the RDP model; it does not touch the
# physical Phoc/Wayland session or /dev/fb0.
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target NetworkManager-wait-online.service

[Service]
Type=simple
User=nuxel
Group=nuxel
Environment=HOME=/home/nuxel
Environment=XDG_SESSION_TYPE=x11
# The wrapper validates geometry (landscape only) and falls back to the
# current wlan0 IPv4 if the generated address is stale after a DHCP
# change.  It never binds a wildcard address.
ExecStart=/usr/libexec/nuxel/nuxel-vnc-x11
Restart=no
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nuxel/.vnc /run /tmp
TimeoutStopFailureMode=abort

[Install]
WantedBy=multi-user.target
