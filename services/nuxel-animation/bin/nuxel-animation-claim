#!/bin/sh
# nuxel-animation-claim — ExecCondition for nuxel-animation.service.
#
# This is the RECEIPT part of the animation handoff: it answers "may this unit
# become the framebuffer owner?" by inspecting real process state, never by
# waiting a fixed time.
#
#   exit 0  -> no other owner: systemd runs nuxel-anim-player.
#   exit 1  -> another owner already has the panel: the unit is SKIPPED.
#
# The owners we must never race:
#   nuxel-anim-player  the initramfs MP4 player (the shipped owner)
#   nuxel-wl-fb        the A31/A32 Wayland->framebuffer bridge
#   nuxel-ui           the A27 framebuffer UI (fallback path)
#   nuxel-fb-phone     the freestanding first-light diagnostic
#
# Bash-free (/bin/sh) because the rootfs may be reduced; no external tools beyond
# /proc and the shell builtins.
count_owner() {
  [ -d /proc ] || return 1
  for d in /proc/[0-9]*; do
    [ -r "$d/comm" ] || continue
    comm="$(cat "$d/comm" 2>/dev/null)"
    case "$comm" in
      nuxel-anim-player|nuxel-anim|nuxel-wl-fb|nuxel-ui|nuxel-fb-phone)
        return 0 ;;
    esac
  done
  return 1
}

if count_owner; then
  echo "nuxel-animation-claim: another framebuffer owner is live; staying out" >&2
  exit 1
fi
exit 0
