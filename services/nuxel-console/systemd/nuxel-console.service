[Unit]
Description=Nuxel live serial console (one systemd owner)
After=systemd-tmpfiles-setup.service nuxel-console-restore.service
Before=sshd.service nuxel-usb-ssh.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/nuxel-console --no-gadget /
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
