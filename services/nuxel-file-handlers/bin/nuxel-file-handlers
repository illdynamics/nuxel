#!/usr/bin/env python3
"""Command-line maintenance surface for Nuxel File Handlers (PWNAGE-97000)."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


def _load():
    here = Path(__file__).resolve()
    candidates = [
        Path("/usr/lib/nuxel"),
        here.parents[2] / "src",
        here.parents[1] / "src",
    ]
    for base in candidates:
        if (base / "nuxel_file_handlers.py").is_file():
            sys.path.insert(0, str(base))
            break
    import nuxel_file_handlers as fh  # noqa: E402
    return fh


def main(argv=None) -> int:
    fh = _load()
    ap = argparse.ArgumentParser(prog="nuxel-file-handlers")
    sub = ap.add_subparsers(dest="command", required=True)

    sub.add_parser("status")
    sub.add_parser("get")
    sub.add_parser("inventory")
    sub.add_parser("ensure-defaults")
    sub.add_parser("reset")

    setp = sub.add_parser("set")
    setp.add_argument("--file", default="")
    setp.add_argument("--json", default="")

    mime = sub.add_parser("mime-default")
    mime.add_argument("mime")
    mime.add_argument("desktop_id")
    mime_unset = sub.add_parser("mime-remove")
    mime_unset.add_argument("mime")

    test = sub.add_parser("test-picker")
    test.add_argument("--options", default="")
    test.add_argument("--timeout", type=float, default=180.0)
    test.add_argument("--sample", action="store_true")

    init = sub.add_parser("init")
    init.add_argument("--mimeapps", action="store_true")

    args = ap.parse_args(argv)
    try:
        if args.command == "status":
            print(json.dumps(fh.portal_status(), indent=2, sort_keys=True))
        elif args.command == "get":
            print(json.dumps(fh.settings_view(fh.load_settings()), indent=2, sort_keys=True))
        elif args.command == "inventory":
            print(json.dumps({"apps": fh.app_inventory(),
                              "mime": fh._mime_catalog()}, indent=2, sort_keys=True))
        elif args.command == "ensure-defaults":
            print(json.dumps(fh.ensure_default_handlers(), indent=2, sort_keys=True))
        elif args.command == "reset":
            print(json.dumps(fh.reset_settings(), indent=2, sort_keys=True))
        elif args.command == "set":
            if args.file:
                raw = json.loads(Path(args.file).read_text(encoding="utf-8"))
            elif args.json:
                raw = json.loads(args.json)
            else:
                raw = json.load(sys.stdin)
            print(json.dumps(fh.apply_settings(raw), indent=2, sort_keys=True))
        elif args.command == "mime-default":
            print(json.dumps(fh.set_mime_default(args.mime, args.desktop_id),
                             indent=2, sort_keys=True))
        elif args.command == "mime-remove":
            print(json.dumps(fh.remove_mime_default(args.mime), indent=2, sort_keys=True))
        elif args.command == "init":
            if args.mimeapps:
                print(json.dumps(fh.ensure_default_handlers(), indent=2, sort_keys=True))
            else:
                fh.save_settings(fh.load_settings())
                print(json.dumps({"success": True, "path": fh.settings_path()},
                                 indent=2, sort_keys=True))
        elif args.command == "test-picker":
            options = json.loads(args.options) if args.options else {
                "multiple": False,
                "filters": [["All files", [[0, "*"]]]],
            }
            if args.sample:
                options.setdefault("current_folder", fh.os.fsencode(os.path.dirname(fh.harness_test_document())))
            result = fh.frontend_picker_request(options, timeout=args.timeout)
            # Machine-readable one-line JSON: the HTTP bridge parses this stdout.
            print(json.dumps(result, sort_keys=True))
            return 0 if result.get("success") or result.get("cancelled") else 1
        return 0
    except fh.FileHandlerError as exc:
        print(json.dumps({"success": False, "error": str(exc), "code": exc.code},
                         indent=2, sort_keys=True))
        return 2
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"success": False, "error": "%s: %s" % (type(exc).__name__, exc)},
                         indent=2, sort_keys=True))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
