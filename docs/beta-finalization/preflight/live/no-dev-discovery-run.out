# (3) POST-FIX fail-closed behaviour for a genuinely missing device (same loop, globs that match nothing):
#     the exit-1 diagnostic must be REACHED (not an abort with no output).
$ bash -c 'set -euo pipefail; DEV=""; for n in /dev/cu.usbmodem-none* /dev/ttyACM-none*; do [ -e "$n" ] && { DEV="$n"; break; }; done; [ -n "$DEV" ] || { echo "no CDC-ACM console node ..." >&2; exit 1; }'
