{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuxel.invalid/schemas/DEVICE-CAPABILITY-MANIFEST.schema.json",
  "title": "Nuxel beta device capability manifest",
  "description": "Per-subsystem capability status for the Galaxy S10+ beta candidate. Every entry names the work-queue record that authorises it; the validator refuse entry whose verdict is stronger than the record's recorded verdict or declared ceiling.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "tool",
    "version",
    "device",
    "verdict_vocabulary",
    "evidence_sources",
    "subsystems"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$" },
    "tool": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "minLength": 3 },
    "git_head": { "type": "string" },
    "verdict_vocabulary": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "string",
        "enum": [
          "VERIFIED_ON_S10PLUS",
          "VERIFIED_IN_VM_ONLY",
          "OFFLINE_TESTED",
          "DEPLOYED_UNVERIFIED",
          "IMPLEMENTED_NOT_DEPLOYED",
          "BLOCKED_KERNEL",
          "BLOCKED_FIRMWARE",
          "BLOCKED_HARDWARE",
          "BLOCKED_EXTERNAL_RESOURCE",
          "NEEDS_OWNER_TEST",
          "FAILED",
          "DEFERRED",
          "NOT_SUPPORTED_ON_DEVICE"
        ]
      }
    },
    "device": {
      "type": "object",
      "required": ["model", "codename", "soc"],
      "properties": {
        "model": { "type": "string", "minLength": 3 },
        "codename": { "type": "string", "minLength": 3 },
        "soc": { "type": "string", "minLength": 3 },
        "kernel": { "type": "string" },
        "distro": { "type": "string" },
        "boot_mode": { "type": "string" },
        "display": { "type": "string" },
        "storage": { "type": "string" },
        "memory": { "type": "string" }
      }
    },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "record",
          "record_state",
          "verdict",
          "hardware_present",
          "evidence",
          "notes"
        ],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "title": { "type": "string", "minLength": 3 },
          "record": { "type": "string", "pattern": "^briq-[0-9]{2}[a-z]-[a-z0-9-]+$" },
          "record_state": {
            "type": "string",
            "enum": ["pending", "in_progress", "implemented", "blocked", "deferred", "failed"]
          },
          "record_verdict": {
            "type": ["string", "null"],
            "enum": [
              "VERIFIED_ON_S10PLUS",
              "VERIFIED_IN_VM_ONLY",
              "OFFLINE_TESTED",
              "DEPLOYED_UNVERIFIED",
              "IMPLEMENTED_NOT_DEPLOYED",
              "BLOCKED_KERNEL",
              "BLOCKED_FIRMWARE",
              "BLOCKED_HARDWARE",
              "BLOCKED_EXTERNAL_RESOURCE",
              "NEEDS_OWNER_TEST",
              "FAILED",
              "DEFERRED",
              "NOT_SUPPORTED_ON_DEVICE",
              null
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "VERIFIED_ON_S10PLUS",
              "VERIFIED_IN_VM_ONLY",
              "OFFLINE_TESTED",
              "DEPLOYED_UNVERIFIED",
              "IMPLEMENTED_NOT_DEPLOYED",
              "BLOCKED_KERNEL",
              "BLOCKED_FIRMWARE",
              "BLOCKED_HARDWARE",
              "BLOCKED_EXTERNAL_RESOURCE",
              "NEEDS_OWNER_TEST",
              "FAILED",
              "DEFERRED",
              "NOT_SUPPORTED_ON_DEVICE"
            ]
          },
          "hardware_present": { "type": "boolean" },
          "blocked_by": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "hardware_evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 3 }
          },
          "owner_action": { "type": ["string", "null"] },
          "notes": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
