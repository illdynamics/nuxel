[Unit]
Description=Nuxel NetworkManager udev compatibility seed for S10+ Wi-Fi
Documentation=file:/usr/share/doc/nuxel/
After=local-fs.target
# Deliberately no .device dependency: systemd-udevd is masked on this kernel,
# so sys-subsystem-net-devices-wlan0.device never appears and used to delay
# NetworkManager (and Wi-Fi autoconnect) by the full 50 s device timeout.
Before=NetworkManager.service
ConditionPathExists=/sys/class/net

[Service]
Type=oneshot
ExecStart=/usr/libexec/nuxel/nuxel-network-udev-seed

[Install]
RequiredBy=NetworkManager.service
