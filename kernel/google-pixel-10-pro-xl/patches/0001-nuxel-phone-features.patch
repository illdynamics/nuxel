From: Nuxel Project <nuxel@nuxel.org>
Date: Tue, 11 Aug 2026 00:00:00 +0000
Subject: [PATCH] nuxel: add Nuxel phone OS kernel support

Introduce the Nuxel phone OS kernel support as a self-contained,
vendor-agnostic driver staged under drivers/nuxel/:

  - drivers/nuxel/Kconfig with menuconfig NUXEL and subordinate
    CONFIG_NUXEL_PHONE / CONFIG_NUXEL_BOOT_PARAM symbols.
  - drivers/nuxel/Makefile that builds nuxel-core.o when CONFIG_NUXEL=y.
  - drivers/nuxel/nuxel-core.c: parses the nuxel.boot=1 and
    nuxel.device=mustang kernel command-line parameters and exposes a
    /proc/nuxel/version interface.

Wire the new directory into the top-level drivers/Kconfig (source
drivers/nuxel/Kconfig) and drivers/Makefile (obj-$(CONFIG_NUXEL) += nuxel/).

This is intentionally minimal and independent of any vendor-only driver.
The mustang device defconfig opts in via CONFIG_NUXEL=y /
CONFIG_NUXEL_PHONE=y / CONFIG_NUXEL_BOOT_PARAM=y.

Signed-off-by: Nuxel Project <nuxel@nuxel.org>
---


diff --git a/drivers/Kconfig b/drivers/Kconfig
index 7bdad836f..0f7d06b7c 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -227,6 +227,8 @@ source "drivers/mux/Kconfig"
 
 source "drivers/opp/Kconfig"
 
+source "drivers/nuxel/Kconfig"
+
 source "drivers/siox/Kconfig"
 
 source "drivers/slimbus/Kconfig"
diff --git a/drivers/Makefile b/drivers/Makefile
index 45d1c3e63..0d0378261 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -193,5 +193,6 @@ obj-$(CONFIG_HTE)		+= hte/
 obj-$(CONFIG_DRM_ACCEL)		+= accel/
 obj-$(CONFIG_CDX_BUS)		+= cdx/
 obj-$(CONFIG_DPLL)		+= dpll/
+obj-$(CONFIG_NUXEL)		+= nuxel/
 
 obj-$(CONFIG_S390)		+= s390/
diff --git a/drivers/nuxel/Kconfig b/drivers/nuxel/Kconfig
new file mode 100644
index 000000000..74888595a
--- /dev/null
+++ b/drivers/nuxel/Kconfig
@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Nuxel phone OS kernel support
+#
+# These symbols are specific to the Nuxel phone OS (see
+# https://nuxel.org). They are intentionally minimal and do not
+# depend on any vendor-only driver.
+
+menuconfig NUXEL
+	bool "Nuxel phone OS support"
+	default y
+	help
+	  Enable Nuxel-specific kernel features for the Nuxel phone OS.
+
+	  This provides the kernel-side support code for Nuxel boot
+	  parameter parsing and device identification used by the Nuxel
+	  userspace (see CONFIG_NUXEL_PHONE and CONFIG_NUXEL_BOOT_PARAM).
+
+if NUXEL
+
+config NUXEL_PHONE
+	bool "Nuxel phone mode"
+	default y
+	help
+	  Enable phone-mode features for the Nuxel phone OS.
+
+	  When enabled, Nuxel exposes phone-oriented kernel services
+	  such as device identification and the /proc/nuxel interface.
+
+config NUXEL_BOOT_PARAM
+	bool "Nuxel boot parameter parsing"
+	default y
+	help
+	  Parse the nuxel.boot=1 and nuxel.device=mustang kernel command
+	  line parameters and expose them through /proc/nuxel/version.
+
+endif # NUXEL
diff --git a/drivers/nuxel/Makefile b/drivers/nuxel/Makefile
new file mode 100644
index 000000000..77200d80c
--- /dev/null
+++ b/drivers/nuxel/Makefile
@@ -0,0 +1,5 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Nuxel phone OS core driver
+#
+obj-$(CONFIG_NUXEL) += nuxel-core.o
diff --git a/drivers/nuxel/nuxel-core.c b/drivers/nuxel/nuxel-core.c
new file mode 100644
index 000000000..3e4d1d3d4
--- /dev/null
+++ b/drivers/nuxel/nuxel-core.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Nuxel phone OS core support — mustang (Pixel 10 Pro XL / Tensor G5)
+ *
+ * Provides:
+ *   - Kernel command line parsing for nuxel.boot= and nuxel.device=
+ *   - A /proc/nuxel/version interface exposing Nuxel device identification
+ *
+ * This is the kernel-side anchor for the Nuxel userspace. It deliberately
+ * does not depend on any vendor-only driver; all hardware bring-up modules
+ * are out of tree / loaded by userspace.
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/fs.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+
+#define NUXEL_VERSION	"1.0"
+
+static bool nuxel_boot_enabled;
+static char nuxel_device[32];
+
+static void nuxel_parse_cmdline(void)
+{
+	const char *p;
+	size_t len;
+
+	/* /proc/cmdline is not yet available at early init; parse the
+	 * static cmd_line exported by init/do_mounts.c. */
+	char *cmdline = saved_command_line;
+
+	p = strstr(cmdline, "nuxel.boot=");
+	if (p) {
+		unsigned int v = 0;
+		p += strlen("nuxel.boot=");
+		while (*p >= '0' && *p <= '9')
+			v = v * 10 + (*p++ - '0');
+		nuxel_boot_enabled = v != 0;
+	}
+
+	p = strstr(cmdline, "nuxel.device=");
+	if (p) {
+		p += strlen("nuxel.device=");
+		len = 0;
+		while (p[len] && p[len] != ' ' && p[len] != '\n' &&
+		       len < sizeof(nuxel_device) - 1)
+			len++;
+		memcpy(nuxel_device, p, len);
+		nuxel_device[len] = '\0';
+	}
+}
+
+static int nuxel_version_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "nuxel-os version: %s\n", NUXEL_VERSION);
+	seq_printf(m, "nuxel.boot: %s\n",
+		   nuxel_boot_enabled ? "1" : "0");
+	seq_printf(m, "nuxel.device: %s\n",
+		   nuxel_device[0] ? nuxel_device : "unknown");
+	return 0;
+}
+
+static int nuxel_version_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, nuxel_version_show, NULL);
+}
+
+static const struct proc_ops nuxel_version_ops = {
+	.proc_open	= nuxel_version_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static int __init nuxel_core_init(void)
+{
+	struct proc_dir_entry *dir;
+	struct proc_dir_entry *version;
+
+	nuxel_parse_cmdline();
+
+	pr_info("nuxel: Nuxel phone OS core %s (boot=%d device=%s)\n",
+		NUXEL_VERSION, nuxel_boot_enabled,
+		nuxel_device[0] ? nuxel_device : "unknown");
+
+	dir = proc_mkdir("nuxel", NULL);
+	if (!dir)
+		return -ENOMEM;
+
+	version = proc_create("version", 0444, dir, &nuxel_version_ops);
+	if (!version) {
+		proc_remove(dir);
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+module_init(nuxel_core_init);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Nuxel Project <nuxel@nuxel.org>");
+MODULE_DESCRIPTION("Nuxel phone OS core support for mustang");
+MODULE_VERSION(NUXEL_VERSION);
