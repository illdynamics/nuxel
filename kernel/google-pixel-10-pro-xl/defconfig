# =============================================================================
# Nuxel kernel configuration additions for Google Pixel 10 Pro XL (mustang)
# =============================================================================
# Target SoC : Google Tensor G5 (gs501) / Exynos 5500 modem
# Kernel base : Linux 6.12 LTS — Android GKI "android16-6.12" common kernel
#               (branch android16-6.12.90_r00, commit d1864f15a2f3f77472b5214f15a4f61d1a354179)
# Build file  : arch/arm64/configs/gki_defconfig
#
# IMPORTANT — config file role / build flow (briq-03 alignment)
# ----------------------------------
# The AUTHORITATIVE mustang build target is the Google vendor kernel branch
# `android-gs-mustang-6.12`, which ships `arch/arm64/configs/gs501_defconfig`.
# In that vendor tree the build step is:
#
#     CROSS_COMPILE=aarch64-linux-gnu- ARCH=arm64 make gs501_defconfig
#
# and these Nuxel values are layered on top of the stock `gs501_defconfig`
# via scripts/kconfig/merge_config.sh (see kernel/build-kernel.sh --vendor).
#
# The Google vendor device defconfigs and the closed-source SoC/modem/radio
# driver modules live in PRIVATE vendor trees. They are NOT publicly readable
# (https://android.googlesource.com/kernel/google-modules/gs returns
# "Repository is not found" for anonymous access), so this sandbox cannot run
# `make gs501_defconfig`. Consequently the ACTUAL build performed here layers
# this file on the closest publicly-bootable 6.12 baseline, the GKI
# `arch/arm64/configs/gki_defconfig` in the android16-6.12 common kernel.
# kernel/build-kernel.sh therefore runs the SAME merge_config.sh flow against
# gki_defconfig by default and switches to the authoritative gs501_defconfig
# merge with --vendor when the vendor tree is reachable.
#
# The values below were AUDITED line-by-line against the real android16-6.12
# Kconfig tree (1820 Kconfig files). Every "keep" entry corresponds to a real
# upstream Kconfig symbol. Every absent/aspirational driver symbol has been
# moved to the clearly-marked "# ASPIRATIONAL" section at the bottom (commented
# out) with the reason "(no upstream driver in android16-6.12)".
# =============================================================================

# Nuxel-specific features (provided by kernel/patches/0001 ... drivers/nuxel/)
CONFIG_NUXEL=y
CONFIG_NUXEL_PHONE=y
