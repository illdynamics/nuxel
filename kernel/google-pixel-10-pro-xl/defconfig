# Use the portable genksyms module-versioning implementation. The Android GKI
# default gendwarfksyms host tool requires elfutils/libdw, which cannot be
# built when cross-compiling on macOS; genksyms builds from source with no
# host DWARF libraries.
CONFIG_GENKSYMS=y
# CONFIG_GENDWARFKSYMS is not set



# ---- Host-build feasibility for Phase-0 native/macOS verification ------------
# These settings keep the merged .config buildable with a *bare-metal* cross
# toolchain (aarch64-elf-) on a host that lacks glibc-host helpers (pahole,
# elfutils/libdw, libbfd shipped as host dev packages). They do NOT alter the
# target feature set of the Nuxel kernel itself.
#
#   * # CONFIG_DEBUG_INFO_BTF is not set
#       BTF generation requires the host `pahole` utility plus DWARF tooling.
#       Homebrew/Homebrew does not package pahole; without it `make vmlinux`
#       fails ("BTF: .tmp_vmlinux.btf: pahole (pahole) is not available"). The
#       GKI baseline would enable BTF, so we disable it explicitly for a
#       reproducible host build. Re-enable (and install pahole, e.g. in the
#       Linux/container build) for the production kernel.
#   * CONFIG_GENKSYMS=y / # CONFIG_GENDWARFKSYMS is not set
#       Already set above; gendwarfksyms needs elfutils/libdw host libs.
#
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_DEBUG_INFO_BTF_DEFINED is not set

