# Nuxel S10+ - DRM core + kbase GPU acceleration.
#
# CONFIG_DRM is enabled so Mesa and wlroots see a DRM-capable kernel build and
# can use DMA-BUF.  The pinned 4.14 tree's Exynos7 DECON DRM driver is NOT the
# Exynos 9820 DPU20 display driver and, when enabled, registers the same
# "exynos-decon" platform driver name as the working vendor fbdev driver.  It
# wins that registration and removes /dev/fb0, leaving the panel dark.  Keep it
# off; the panel continues to be driven by EXYNOS_DPU20 (fbdev) while the Mali
# GPU is driven through ARM kbase (/dev/mali0).
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_EXYNOS=n
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y

# Buffer sharing: Mesa panfrost <-> kbase <-> wlroots udmabuf allocator.
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y

# Vendor Mali-G76 (Bifrost) kbase, unchanged from the working image.
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_BIFROST_R26P0=y
CONFIG_MALI_REAL_HW=y
CONFIG_MALI_DEBUG_SYS=y

# Panel/fbdev path that must keep owning the AMOLED.
CONFIG_FB=y
CONFIG_EXYNOS_DPU20=y
CONFIG_EXYNOS_MIPI_DSIM=y
CONFIG_ION=y
CONFIG_ION_EXYNOS=y

# Flatpak / Bubblewrap: unprivileged user namespaces and the namespace/
# seccomp/cgroup prerequisites.  This is necessary but NOT sufficient on this
# Samsung 4.14 tree: create_user_ns() also carries a CONFIG_LOD_SEC runtime gate
# and a current_chrooted() check.  The live status is decided by
# `unshare -Ur true` and a real Flatpak launch, never by this fragment alone.
CONFIG_MULTIUSER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y

# NFC: the actual SM-G975F controller on hsi2c@108E0000 (I2C 7-0027) is the
# Samsung S3NRN82, an S3FWRN5-compatible NCI part (same firmware container
# format: 0x201812270318 header, 0x80-byte signature, 0x25x4KiB image).
# Nuxel uses the upstream Linux NCI path (s3fwrn5_i2c -> nfc/nci -> nfc0),
# not the legacy raw sec-nfc chardev.  NFC_S3FWRN5_I2C requires NFC_NCI and
# supplies the proper NCI class/device that the old path lacked.  The
# sec_nfc transport stays compiled for the secured/ese build, but its
# compatible entry is disabled when S3FWRN5_I2C is enabled (patch 0007).
# DO NOT enable NFC_PN5xx / ST / NXP drivers on this board: no such chip is
# present on any beyond2lte DTS revision.
CONFIG_NFC=y
CONFIG_NFC_DIGITAL=y
CONFIG_NFC_NCI=y
CONFIG_NFC_S3FWRN5_I2C=y
CONFIG_SAMSUNG_NFC=y
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_LOGGER=y

# ---------------------------------------------------------------------------
# MFC hardware video decode (PWNAGE-61000).
#
# Exynos 9820 MFC (DT mfc@188D0000, ip_ver 0x1300), vendor driver at
# drivers/media/platform/exynos/mfc/.  This is a decoder/encoder block, not the
# camera ISP.  Keep MEDIA_CONTROLLER off, camera capture disabled and the
# GStreamer V4L2 guard in place.  The driver requests /lib/firmware/mfc_fw.bin;
# the PWNAGE-61000 patch switches that request to request_firmware_direct() so
# a missing blob fails immediately instead of waiting for the 60 s udev
# fallback.
# ---------------------------------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_DMA_SG=y
CONFIG_VIDEO_EXYNOS=y
CONFIG_VIDEO_EXYNOS_MFC=y
CONFIG_EXYNOS_IOMMU=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_API=y
CONFIG_IOMMU_DMA=y
CONFIG_IOMMU_IOVA=y

# ---------------------------------------------------------------------------
# USB networking / tethering (PWNAGE-92000 USBNET completion).
#
# CDC-NCM is the PRIMARY data plane: macOS 15 on Apple Silicon ships the
# native com.apple.driver.AppleUSBDeviceNCM driver and has NO built-in CDC-ECM
# driver, so ECM would leave the Mac with no network interface.  The 4.14.253
# NCM teardown panic (misc_deregister in the Samsung mirrorlink cleanup) is
# fixed by patches/0011-nuxel-usb-ncm-idempotent-misc-deregister.patch and
# patches/0011-nuxel-usb-ncm-lifecycle.patch, which also exposes the
# /sys/class/misc/usb_ncm/nuxel_fix build marker that userspace gates on.
#
# ECM / ECM-subset / EEM remain compiled for Linux/Windows hosts and for
# diagnostics, but they are not the macOS path.  RNDIS stays compiled for
# Linux hosts only (macOS has no native RNDIS driver).
# ---------------------------------------------------------------------------
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_EEM=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_GADGET_VBUS_DRAW=900

# Enable NAT/masquerade + IP forwarding prerequisites for USB tethering.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# ---------------------------------------------------------------------------
# PWNAGE-SSP / per-app firewalling (2026-11-13)
#
# Two capabilities were CLAIMED but not actually usable by the live image:
#
# 1. USERNS.  CONFIG_USER_NS=y was set, but kernel/user_namespace.c in the
#    build tree carried an unconditional `ret = -EPERM` in create_user_ns(),
#    so every namespace request failed.  That edit is reverted (upstream
#    current_chrooted() check restored); tools/s10plus/verify-kernel-userns.py
#    is the regression gate.  kernel/sysctl.c now exposes the standard
#    `kernel.unprivileged_userns_clone` knob (default 0 = vendor gate kept) so
#    the policy can be flipped at runtime by services/nuxel-firewall instead
#    of being frozen at build time.
# 2. nf_tables.  /usr/local/bin/nuxel-firewall.sh (per-app egress policy) and
#    Fedora's nftables service need the nftables backend.  Only iptables was
#    enabled, so every `nft add table/chain/rule` failed with ENOTSUPP.
#
# Everything is =y (not =m): the S10+ has no usable initramfs module
# dependency chain for netfilter, and the image must enforce policy from the
# first boot after switch_root.
# ---------------------------------------------------------------------------
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=y
# `nft -c -f` on the real policy: every match expression the app ruleset uses
# (udp/tcp dport, icmp type, iif/oif) needs NFT_PAYLOAD, and meta mark/iifname
# needs NFT_META.  Without these the ruleset parses but the kernel rejects
# each rule with ENOENT ("Could not process rule: No such file or directory"),
# which is exactly what the live check showed before this line.
CONFIG_NFT_PAYLOAD=y
CONFIG_NFT_META=y
CONFIG_NFT_EXTHDR=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
# nft "masquerade" inside an inet-family table needs the per-family
# expression; NFT_MASQ alone leaves `table inet ... masquerade` unusable.
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_MASQ_IPV4=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_SET_HASH=y
CONFIG_NFT_SET_RBTREE=y
CONFIG_NFT_SET_BITMAP=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_HASH=y
# Per-cgroup packet marking (net_cls) is the native Linux-4.14 way to mark
# traffic per app group.  (No Landlock on 4.14; nftables + cgroups is the
# documented Nuxel model.)
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
# ============================================================================
# Nuxel S10+ — native camera V4L2/media framework enablement (Strategy B).
#
# The 4.14.253 Samsung downstream kernel ALREADY ships the complete mainline
# V4L2/media framework (drivers/media/v4l2-core, drivers/media/media-*, and all
# include/media headers), but the beyond2lte defconfig leaves the camera-facing
# parts disabled because the vendor FIMC-IS2 driver does not use them. Enable
# them so a native standard-V4L2 camera driver (port of s10-linux
# s10-camera-v4l2) can bind sensors to the Exynos9820 MIPI CSIS and produce
# RAW10 Bayer via videobuf2 DMA-contig, exactly as upstream embedded cameras do.
#
# These are the ONLY missing framework pieces (verified in-tree):
#   - media controller core + entity/devnode (guarded by CONFIG_MEDIA_CONTROLLER)
#   - V4L2 sub-device pad/state API (guarded by CONFIG_VIDEO_V4L2_SUBDEV_API)
#   - V4L2 fwnode endpoint parsing (v4l2-fwnode.c, CONFIG_V4L2_FWNODE)
#   - videobuf2 DMA-contig allocator (videobuf2-dma-contig.c)
#
# videobuf2-core + videobuf2-v4l2 are ALREADY built (CONFIG_VIDEOBUF2_CORE=y);
# there is no separate CONFIG_VIDEOBUF2_V4L2 symbol in this 4.14 tree.
#
# The vendor FIMC-IS2 driver is preserved untouched as a rollback; it does not
# depend on these symbols and will keep working when they are re-disabled.
# ============================================================================
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_DMA_SG=y

# The driver selects these; assert them so external-module and full-tree
# builds resolve v4l2_fwnode_* and videobuf2-dma-contig unconditionally.

# Native standard-V4L2 camera driver (port of s10-linux s10-camera-v4l2).
CONFIG_VIDEO_S10_CAMERA=m
