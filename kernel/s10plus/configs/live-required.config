# =============================================================================
# Nuxel S10+ — kernel capabilities the LIVE handset actually runs
#
# These are not aspirations: each line was read back from the running phone
# (`zcat /proc/config.gz`) on 2026-11-01 and is enforced by
# tools/s10plus/verify-kernel-config.py, which the release workflow runs after
# the kernel build.  A CI kernel that drops any of them is not the image the
# owner runs and must not publish.
#
# Uncommented lines are required set (=y).  A leading '!' means required unset.
# =============================================================================

# GPU / buffer sharing (Mali-G76 kbase + wlroots + WebKit GPU-SHM profile)
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_EXYNOS=n
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_BIFROST_R26P0=y
CONFIG_MALI_REAL_HW=y
CONFIG_MALI_DEBUG_SYS=y

# Panel path that must keep owning the AMOLED (/dev/fb0)
CONFIG_FB=y
CONFIG_EXYNOS_DPU20=y
CONFIG_EXYNOS_MIPI_DSIM=y
CONFIG_ION=y
CONFIG_ION_EXYNOS=y

# Flatpak / bubblewrap unprivileged user namespaces
CONFIG_MULTIUSER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y

# NFC (PWNAGE-53000): controller, firmware path and the vendor driver set
CONFIG_NFC=y
CONFIG_NFC_DIGITAL=y
CONFIG_NFC_NCI=y
CONFIG_SAMSUNG_NFC=y
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_LOGGER=y

# The kbase ABI boundary is explicit: there is no DRM/GBM render node, which is
# why WebKit DMA-BUF presentation is BLOCKED_KERNEL_ABI on this kernel.  Keep it
# that way and prove it, instead of silently drifting.
CONFIG_DRM_VGEM=n
