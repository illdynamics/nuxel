			cam_detect_conn_setting: cam_detect_conn_setting {
				samsung,pins = "gpm18-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			amp_int: amp-int {
				samsung,pins = "gpm24-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};
		};
	};

	fragment@83 {
		target = <&hsi2c_38>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			clock-frequency = <0x61a80>;
			pinctrl-names = "default";
			pinctrl-0 = <&hsi2c38_bus>, <&spk_amp_rst_n>, <&rcv_amp_rst_n>, <&amp_int>;

			cs35l40_r: cs35l40@40 {
				#sound-dai-cells = <0x01>;
				compatible = "cirrus,cs35l40";
				reg = <0x40>;
				interrupt-parent = <&gpm24>;
				interrupts = <0x00 0x00 0x00>;
				reset-gpios = <&gph1>, <0x01 0x00>;
				cirrus,right-channel-amp;
				cirrus,dsp-part-name = "cs35l40-bot";
				cirrus,asp-sdout-hiz = <0x03>;
				cirrus,dsp-noise-gate-enable;
				cirrus,dsp-noise-gate-delay = <0x02>;
				cirrus,dsp-noise-gate-threshold = <0x06>;
				cirrus,hw-noise-gate-select = <0x3f>;
				cirrus,hw-noise-gate-delay = <0x02>;
				cirrus,hw-noise-gate-threshold = <0x06>;
				cirrus,boost-peak-milliamp = <0x1004>;
				cirrus,classh-internal-algo {
					cirrus,classh-headroom = <0x0b>;
					cirrus,classh-release-rate = <0x04>;
					cirrus,classh-mem-depth = <0x05>;
					cirrus,classh-wk-fet-delay = <0x04>;
					cirrus,classh-wk-fet-thld = <0x01>;
				};

				cirrus,gpio-config2 {
					cirrus,gpio-src-select = <0x04>;
					cirrus,gpio-output-enable;
				};

				cirrus,pwr-params {
					cirrus,pwr-target-temp = <0xe74>;
					cirrus,pwr-exit-temp = <0xe10>;
				};
			};

			cs35l40_l: cs35l40@41 {
				#sound-dai-cells = <0x01>;
				compatible = "cirrus,cs35l40";
				reg = <0x41>;
				interrupt-parent = <&gpm24>;
				interrupts = <0x00 0x00 0x00>;
				reset-gpios = <&gph1>, <0x02 0x00>;
				cirrus,dsp-part-name = "cs35l40-rcv";
				cirrus,asp-sdout-hiz = <0x03>;
				cirrus,dsp-noise-gate-enable;
				cirrus,dsp-noise-gate-delay = <0x02>;
				cirrus,dsp-noise-gate-threshold = <0x06>;
				cirrus,hw-noise-gate-select = <0x3f>;
				cirrus,hw-noise-gate-delay = <0x02>;
				cirrus,hw-noise-gate-threshold = <0x06>;
				cirrus,boost-peak-milliamp = <0x1004>;
				cirrus,classh-internal-algo {
					cirrus,classh-headroom = <0x0b>;
					cirrus,classh-release-rate = <0x04>;
					cirrus,classh-mem-depth = <0x05>;
					cirrus,classh-wk-fet-delay = <0x04>;
					cirrus,classh-wk-fet-thld = <0x01>;
				};

				cirrus,gpio-config2 {
					cirrus,gpio-src-select = <0x04>;
					cirrus,gpio-output-enable;
				};

				cirrus,pwr-params {
					cirrus,pwr-target-temp = <0xf3c>;
					cirrus,pwr-exit-temp = <0xed8>;
				};
			};
		};
	};

	fragment@84 {
		target = <&hsi2c_42>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mpb03_pmic@56 {
				compatible = "samsung,s2mpb03pmic";
				reg = <0x56>;
				s2mpb03,wakeup;

				regulators {

					__ldo1_reg: s2mpb03-ldo1 {
						regulator-name = "VDDD_1.0V_CAM";
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
					};

					__ldo2_reg: s2mpb03-ldo2 {
						regulator-name = "VDDQ_1.1V_CAM";
						regulator-min-microvolt = <0x10c8e0>;
						regulator-max-microvolt = <0x10c8e0>;
					};

					__ldo3_reg: s2mpb03-ldo3 {
						regulator-name = "VDDIO_1.8V_CAM";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					__ldo4_reg: s2mpb03-ldo4 {
						regulator-name = "VDDD_RET_1.0V_CAM";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0xfa3e8>;
					};

					__ldo5_reg: s2mpb03-ldo5 {
						regulator-name = "VDDA_2.4V_CAM";
						regulator-min-microvolt = <0x249f00>;
						regulator-max-microvolt = <0x249f00>;
					};

					__ldo6_reg: s2mpb03-ldo6 {
						regulator-name = "VDDA_2.8V_CAM";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
					};

					__ldo7_reg: s2mpb03-ldo7 {
						regulator-name = "VDD_VM_2.8V_OIS";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
					};
				};
			};
		};
	};

	fragment@85 {
		target = <&hsi2c_44>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2dos05_pmic@60 {
				compatible = "samsung,s2dos05pmic";
				reg = <0x60>;
				s2dos05,wakeup;
				pinctrl-names = "default";
				pinctrl-0 = <&dp_pmic_irq>;
				s2dos05,s2dos05_int = <&gpa1>, <0x04 0x00>;
				adc_mode = <0x02>;
				adc_sync_mode = <0x02>;

				regulators {

					dp_buck: s2dos05-buck1 {
						regulator-name = "vdd1";
						regulator-min-microvolt = <0x16e360>;
						regulator-max-microvolt = <0x186a00>;
					};

					dp_ldo1: s2dos05-ldo1 {
						regulator-name = "vdd2";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					dp_ldo4: s2dos05-ldo4 {
						regulator-name = "vdd5";
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
					};

					dp_elvss: s2dos05-elvss {
						regulator-name = "elvss";
					};
				};
			};
		};
	};

	fragment@86 {
