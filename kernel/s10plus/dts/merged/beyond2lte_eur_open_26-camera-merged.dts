			exynos_pm_dvs {
				compatible = "samsung,exynos-pm-dvs";

				vdd_lldo1 {
					regulator_name = "m_vdd_buck9";
					suspend_volt = "", "\f5";
					init_volt = <0xcf850>;
					volt_range_step = <0xf424>;
				};

				vdd_lldo2 {
					regulator_name = "m_vdd_buck10";
					suspend_volt = <0x100590>;
					init_volt = <0x10c8e0>;
					volt_range_step = <0xf424>;
				};

				vdd_lldo3 {
					regulator_name = "m_vdd_buck11";
					suspend_volt = <0x1312d0>;
					init_volt = <0x13d620>;
					volt_range_step = <0xf424>;
				};

				vdd_mldo {
					regulator_name = "m_vdd_buck12";
					suspend_volt = <0x1c9c38>;
					init_volt = <0x1e8480>;
					volt_range_step = <0x30d4>;
				};
			};

			pinctrl@15850000 {

				hall_irq: hall-irq {
					samsung,pins = "gpa3-6";
					samsung,pin-function = <0x0f>;
					samsung,pin-pud = <0x00>;
					samsung,pin-drv = <0x00>;
				};

				certify_hall_irq: certify-hall-irq {
					samsung,pins = "gpa0-2";
					samsung,pin-function = <0x0f>;
					samsung,pin-pud = <0x00>;
					samsung,pin-drv = <0x00>;
				};

				bt_hostwake: bt-hostwake {
					samsung,pins = "gpa2-3";
					samsung,pin-function = <0x00>;
					samsung,pin-pud = <0x01>;
				};
			};

			sec_detect_conn {
				compatible = "samsung,sec_detect_conn";
				sec,det_conn_gpios = <&gpm23>, <0x00 0x00>, <&gpm18>, <0x00 0x00>;
				sec,det_conn_name = "UB_CONNECT", "CAM_CONNECT";
				sec,det_conn_irq_type = <0x03 0x03>;
				pinctrl-names = "default";
				pinctrl-0 = <&ub_detect_conn_setting>, <&cam_detect_conn_setting>;
			};

			wlan {
				compatible = "samsung,brcm-wlan";
				gpios = <&gpg0>, <0x05 0x01>, <&gpa0>, <0x07 0x01>;
				pinctrl-names = "default";
				pinctrl-0 = <&cfg_wlanen>, <&wlan_host_wake>;
				status = "okay";
			};

			hall {
				status = "okay";
				compatible = "hall";
				pinctrl-names = "default";
				pinctrl-0 = <&hall_irq>;
				hall,gpio_flip_cover = <&gpa3>, <0x06 0x00>;
			};

			certify_hall {
				status = "okay";
				compatible = "certify_hall";
				pinctrl-names = "default";
				pinctrl-0 = <&certify_hall_irq>;
				certify_hall,gpio_certify_cover = <&gpa0>, <0x02 0x00>;
			};

			sec_thermistor@0 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-ap-thermistor";
				id = <0x00>;
				adc_array = <0xfb 0x13a 0x173 0x1b5 0x209 0x24f 0x2be 0x335 0x3c5 0x46f 0x52c 0x5ed 0x6be 0x79b 0x882 0x96f 0xa59 0xb41 0xbff 0xcc0 0xd4e 0xdbc 0xe31>;
				temp_array = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
				io-channels = <&exynos_adc>, <0x00>;
				io-channel-names = "adc-ap-temp";
				io-channel-ranges;
			};

			sec_thermistor@2 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-wf-thermistor";
				id = <0x01>;
				adc_array = <0xfb 0x13a 0x173 0x1b5 0x209 0x24f 0x2be 0x335 0x3c5 0x46f 0x52c 0x5ed 0x6be 0x79b 0x882 0x96f 0xa59 0xb41 0xbff 0xcc0 0xd4e 0xdbc 0xe31>;
				temp_array = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
				io-channels = <&exynos_adc>, <0x02>;
				io-channel-names = "adc-wf-temp";
				io-channel-ranges;
			};

			sec_thermistor@7 {
				compatible = "samsung,sec-thermistor";
				status = "okay";
				thermistor_name = "sec-pa-thermistor";
				id = <0x02>;
				adc_array = <0x176 0x1d8 0x260 0x2f3 0x3b1 0x47a 0x55b 0x64a 0x747 0x834 0x91e 0x9ee 0xabd 0xb77 0xc1b 0xcb9 0xd31 0xda2 0xde7 0xe3a 0xe7e 0xeb7 0xeea>;
				temp_array = <0xffffff38 0xffffff6a 0xffffff9c 0xffffffce 0x00 0x32 0x64 0x96 0xc8 0xfa 0x12c 0x15e 0x190 0x1c2 0x1f4 0x226 0x258 0x28a 0x2bc 0x2ee 0x320 0x352 0x384>;
				io-channels = <&exynos_adc>, <0x07>;
				io-channel-names = "adc-pa-temp";
				io-channel-ranges;
			};

			secgpio_dvs {
				compatible = "samsung,exynos9820-secgpio-dvs";
				status = "okay";
			};

			dev_ril_bridge_pdata {
				compatible = "samsung,dev_ril_bridge_pdata";
				status = "okay";
			};

			sec_abc {
				compatible = "samsung,sec_abc";
				status = "okay";

				gpu {
					gpu,label = "GPU fault";
					gpu,threshold_count = <0x14>;
					gpu,threshold_time = <0x4b0>;
				};

				aicl {
					aicl,label = "battery aicl";
					aicl,threshold_count = <0x05>;
					aicl,threshold_time = <0x12c>;
				};
			};

			abc_hub {
				compatible = "samsung,abc_hub";
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&ub_detect_conn_setting>, <&cam_detect_conn_setting>;

				cond {
					cond,det_conn_gpios = <&gpm23>, <0x00 0x00>, <&gpm18>, <0x00 0x00>;
					cond,name = "ub_cond", "cam_cond";
					cond,det_conn_irq_type = <0x03 0x03>;
				};

				bootc {
					bootc,time_spec_user = <0x9c40>;
					bootc,time_spec_eng = <0x15f90>;
					bootc,time_spec_fac = <0x7530>;
				};
			};

			nad_balancer {
				compatible = "samsung,sec_nad_balancer";
				status = "okay";
				nad_balancer,timeout = <0x190>;

				qos {

					cl0 {
						qos,label = "LIT";
						qos,delay_time = <0x09>;
						qos,table_size = <0x0d>;
						qos,table = <0x1dc130 0x1c2af0 0x1a94b0 0x183350 0x163780 0x13d620 0x11a788 0x101148 0xe7b08 0xc4c70 0x9eb10 0x854d0 0x6be90>;
					};

					cl1 {
						qos,label = "MID";
						qos,delay_time = <0x08>;
						qos,table_size = <0x11>;
						qos,table = <0x234f10 0x21b8d0 0x202290 0x1e8c50 0x1cf610 0x1b5fd0 0x19c990 0x183350 0x1702a0 0x156c60 0x12a570 0x104410 0xeadd0 0xce4c8 0xb8150 0x9eb10 0x7bc78>;
					};

					cl2 {
						qos,label = "BIG";
						qos,delay_time = <0x07>;
						qos,table_size = <0x14>;
						qos,table = <0x29a810 0x27ac40 0x25b070 0x23b4a0 0x221e60 0x1fbd00 0x1e26c0 0x1bc560 0x196400 0x17cdc0 0x163780 0x1506d0 0x130b00 0x1174c0 0xfde80 0xe4840 0xc7f38 0xb1bc0 0x98580 0x7ef40>;
					};

					mif {
						qos,label = "MIF";
						qos,delay_time = <0x0a>;
						qos,table_size = <0x0a>;
						qos,table = <0x1ff3b0 0x1fefc8 0x1b5fd0 0x177bb8 0x14a140 0xf78f0 0xce4c8 0xa50a0 0x854d0 0x66c88>;
					};
				};

				sleep {
					sleep,suspend_threshold = <0x3e8>;
					sleep,resume_threshold = <0x3e8>;
				};
			};

			argos {
				compatible = "samsung,argos";
				#address-cells = <0x01>;

				boot_device@1 {
					net_boost,label = "IPC";
					net_boost,node = "rmnet0 rmnet1 rmnet2 rmnet3 rmnet4 rmnet5 rmnet6 rmnet7 umts_dm0";
					net_boost,table_size = <0x04>;
					net_boost,table = <0x64 0x00 0x00 0x00 0x00 0x101148 0x00 0xce4c8 0x00 0x00 0x00 0x00 0x96 0x00 0x00 0x00 0x00 0x13d620 0x00 0xf78f0 0x00 0x00 0x00 0x00 0xc8 0x00 0x00 0x14a140 0x00 0x1a94b0 0x00 0x1b5fd0 0x00 0x00 0x00 0x00 0xfa 0x00 0x00 0x1cf610 0x00 0x1a94b0 0x00 0x1fefc8 0x00 0x00 0x00 0x00>;
				};

				boot_device@2 {
					net_boost,label = "CLAT";
					net_boost,node = "clat clat4 v4-rmnet0 v4-rmnet1 v4-rmnet2 v4-rmnet3 v4-rmnet4 v4-rmnet5 v4-rmnet6 v4-rmnet7";
					net_boost,table_size = <0x03>;
					net_boost,table = <0x64 0xfde80 0x00 0x00 0x00 0x00 0x00 0xf78f0 0x00 0x00 0x00 0x00 0x96 0x130b00 0x00 0x00 0x00 0x00 0x00 0x14a140 0x00 0x00 0x00 0x00 0xc8 0x163780 0x00 0x00 0x00 0x00 0x00 0x1fefc8 0x00 0x00 0x00 0x00>;
				};

				boot_device@3 {
					net_boost,label = "UFS";
					net_boost,node = [00];
					net_boost,sysnode = "/sys/class/scsi_host/host0/transferred_cnt";
					net_boost,table_size = <0x02>;
					net_boost,table = <0x70 0x00 0x00 0x00 0x00 0x163780 0x00 0x14a140 0x00 0x00 0x00 0x00 0x320 0x00 0x00 0x104410 0x00 0x163780 0x00 0x177bb8 0x00 0x00 0x00 0x01>;
				};

				boot_device@4 {
					net_boost,label = "WIFI";
					net_boost,node = "wlan0";
					net_boost,table_size = <0x03>;
					net_boost,table = <0x96 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc8 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x01 0x01 0x12c 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x01 0x01>;
				};

				boot_device@5 {
					net_boost,label = "WIFI TX";
					net_boost,node = "wlan0";
					net_boost,table_size = <0x04>;
					net_boost,table = <0x3c 0x00 0x00 0x166a48 0x00 0x163780 0x00 0x00 0x00 0x00 0x00 0x00 0x96 0x00 0x00 0x19c990 0x00 0x19c990 0x00 0x00 0x00 0x00 0x00 0x00 0xc8 0x00 0x00 0x1d5ba0 0x00 0x1b5fd0 0x00 0x14a140 0x61a80 0x01 0x01 0x01 0x12c 0x00 0x00 0x1e8c50 0x00 0x1b5fd0 0x00 0x1b5fd0 0x825f0 0x01 0x01 0x01>;
				};

				boot_device@6 {
					net_boost,label = "WIFI RX";
					net_boost,node = "wlan0";
					net_boost,table_size = <0x04>;
					net_boost,table = <0x64 0x00 0x00 0x11da50 0x00 0x101148 0x00 0x00 0x00 0x00 0x00 0x00 0x96 0x00 0x00 0x166a48 0x00 0x130b00 0x00 0x00 0x00 0x00 0x00 0x00 0xc8 0x00 0x00 0x19c990 0x00 0x130b00 0x00 0xce4c8 0x61a80 0x01 0x01 0x01 0x12c 0x00 0x00 0x1d5ba0 0x00 0x163780 0x00 0x14a140 0x825f0 0x01 0x01 0x01>;
				};

				boot_device@7 {
					net_boost,label = "P2P";
					net_boost,node = "p2p-wlan0-0";
					net_boost,table_size = <0x03>;
					net_boost,table = <0x1e 0x00 0x00 0x1174c0 0x00 0x11da50 0x00 0x00 0x00 0x00 0x00 0x00 0x5a 0x00 0x00 0x1c9080 0x00 0x183350 0x00 0x00 0x3e418 0x00 0x00 0x00 0x12c 0x00 0x00 0x1fbd00 0x00 0x183350 0x00 0x854d0 0x3e418 0x01 0x01 0x01>;
				};

				boot_device@8 {
					net_boost,label = "NAN";
					net_boost,node = "aware_data0";
					net_boost,table_size = <0x03>;
					net_boost,table = <0x1e 0x00 0x00 0x1174c0 0x00 0x11da50 0x00 0x00 0x00 0x00 0x00 0x00 0x5a 0x00 0x00 0x1c9080 0x00 0x183350 0x00 0x00 0x3e418 0x00 0x00 0x00 0x12c 0x00 0x00 0x1fbd00 0x00 0x183350 0x00 0x854d0 0x3e418 0x01 0x01 0x01>;
				};

				boot_device@9 {
					net_boost,label = "USB";
					net_boost,node = "rndis0";
					net_boost,table_size = <0x03>;
					net_boost,table = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0xc8 0x00 0x00 0x00 0x00 0x163780 0x00 0x177fa0 0x00 0x00 0x01 0x00 0x12c 0x00 0x00 0x00 0x00 0x19c990 0x00 0x1b5fd0 0x825f0 0x00 0x01 0x00>;
				};
			};

			qbt2000 {
				compatible = "qcom,qbt2000";
				qcom,ipc-gpio = <&gpa1>, <0x03 0x00>;
				qcom,wuhb-gpio = <&gpa1>, <0x01 0x00>;
				qcom,ldo-gpio = <&gph1>, <0x00 0x00>;
				qcom,position = "13.77,0.00,9.00,4.00,14.80,14.80,13.00,13.00,5.00";
				qcom,modelinfo = "G97X";
				pinctrl-names = "default", "pins_poweron", "pins_poweroff";
				pinctrl-0 = <&btp_ipc>, <&btp_wuhb>, <&btp_ldo>;
				pinctrl-1 = <&spi1_bus>, <&spi1_cs_func_high>;
				pinctrl-2 = <&spi1_bus_sleep>, <&spi1_cs>;
			};

			pinctrl@10430000 {

				bt_btwake: bt-btwake {
					samsung,pins = "gpg2-0";
					samsung,pin-function = <0x01>;
					samsung,pin-pud = <0x00>;
					samsung,pin-con-pdn = <0x03>;
					samsung,pin-pud-pdn = <0x00>;
				};
			};

			pinctrl@15C30000 {

				bt_en: bt-en {
					samsung,pins = "gpm8-0";
					samsung,pin-function = <0x01>;
					samsung,pin-pud = <0x00>;
					samsung,pin-con-pdn = <0x03>;
					samsung,pin-pud-pdn = <0x00>;
				};
			};

			bluetooth {
				compatible = "samsung,bcm43xx";
				gpios = <&gpm8>, <0x00 0x00>, <&gpg2>, <0x00 0x00>, <&gpa2>, <0x03 0x0f>;
				pinctrl-names = "default";
				pinctrl-0 = <&bt_hostwake>, <&bt_btwake>, <&bt_en>;
				status = "okay";
			};
		};
	};

	fragment@camera {
		target-path = "/";

		__overlay__ {

			fimc_is_sensor_2l4: fimc-is_sensor_2l4@20 {
				compatible = "samsung,sensor-module-2l4";
				pinctrl-names = "pin0", "pin1", "pin2", "release";
				pinctrl-0;
				pinctrl-1 = <&sensor_mclk0_out>;
				pinctrl-2 = <&sensor_mclk0_fn>;
				pinctrl-3;
				position = <0x00>;
				id = <0x00>;
				mclk_ch = <0x00>;
				use_mclk_share;
				sensor_i2c_ch = <0x00>;
				rom_type = <0x02>;
				rom_id = <0x00>;
				rom_cal_index = <0x00>;
				gpio_mclk = <&gpc1>, <0x04 0x01>;
				gpio_reset = <&gpg2>, <0x06 0x01>;
				gpio_ois_reset = <&gpg0>, <0x06 0x01>;
				status = "okay";
				af {
					product_name = <0x12>;
					i2c_ch = <0x01>;
				};

				flash {
					product_name = <0x0b>;
				};

				ois {
					product_name = <0x64>;
				};

				mcu {
					product_name = <0x01>;
					i2c_addr = <0x51>;
					i2c_ch = <0x01>;
				};

				aperture {
					product_name = <0x64>;
				};
			};

			fimc_is_sensor_3m3: fimc-is_sensor_3m3@5A {
				compatible = "samsung,sensor-module-3m3";
				pinctrl-names = "pin0", "pin1", "pin2", "release";
				pinctrl-0;
				pinctrl-1 = <&sensor_mclk0_out>;
				pinctrl-2 = <&sensor_mclk0_fn>;
				pinctrl-3;
				position = <0x02>;
				id = <0x02>;
				mclk_ch = <0x00>;
				use_mclk_share;
				sensor_i2c_ch = <0x02>;
				rom_type = <0x02>;
