				acpm-ipc-channel = <0x02>;
				acpm-speedy-channel = <0x00>;
				i2c-speedy-address;
				s2mps19,wakeup = "enabled";
				s2mps19,irq-gpio = <&gpa0>, <0x01 0x00>;
				reg = <0x00>;
				interrupts = <0x02 0x00 0x00>;
				interrupt-parent = <&gpa0>;
				pinctrl-names = "default";
				pinctrl-0 = <&m_pmic_irq>, <&smpl_warn>;
				gpios = <&gpp3>, <0x04 0x00>;
				smpl_warn_en = <0x00>;
				smpl_warn_dev2 = <0x00>;
				smpl_warn_vth = <0xa0>;
				smpl_warn_hys = <0x00>;
				ocp_warn1_en = <0x01>;
				ocp_warn1_cnt = <0x00>;
				ocp_warn1_dvs_mask = <0x00>;
				ocp_warn1_lv = <0x00>;
				ocp_warn2_en = <0x00>;
				ocp_warn2_cnt = <0x00>;
				ocp_warn2_dvs_mask = <0x00>;
				ocp_warn2_lv = <0x00>;
				adc_mode = <0x01>;
				adc_sync_mode = <0x02>;
				wtsr_en = "enabled";
				smpl_en = "enabled";
				wtsr_timer_val = <0x03>;
				smpl_timer_val = <0x02>;
				sub_smpl_en = "enabled";
				check_jigon = <0x00>;
				init_time,sec = <0x00>;
				init_time,min = <0x00>;
				init_time,hour = <0x0c>;
				init_time,mday = <0x01>;
				init_time,mon = <0x00>;
				init_time,year = <0x77>;
				init_time,wday = <0x02>;

				regulators {

					buck1_reg: BUCK1M {
						regulator-name = "m_vdd_buck1";
