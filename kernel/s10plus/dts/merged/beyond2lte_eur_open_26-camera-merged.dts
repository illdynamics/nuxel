						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x03>;
					};

					ldo22_reg: LDO22M {
						regulator-name = "VDD_NFC_1P8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x02>;
					};

					ldo23_reg: LDO23M {
						regulator-name = "VDDD_1.2V_FRONTSUB";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x03>;
					};

					ldo24_reg: LDO24M {
						regulator-name = "VDDA_2.8V_FRONTSUB";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x03>;
					};

					ldo25_reg: LDO25M {
						regulator-name = "VDDIO_1.8V_FRONTSUB";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x03>;
					};

					ldo28_reg: LDO28M {
						regulator-name = "VDD_ESE_1P8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x02>;
					};
				};
			};
		};
	};

	fragment@74 {
		target = <&speedy1>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mps20mfd@00 {
				compatible = "samsung,s2mps20mfd";
				acpm-ipc-channel = <0x02>;
				acpm-speedy-channel = <0x01>;
				i2c-speedy-address;
				s2mps20,wakeup = "enabled";
				s2mps20,irq-gpio = <&gpa2>, <0x05 0x00>;
				reg = <0x00>;
				interrupts = <0x01 0x00 0x00>;
				interrupt-parent = <&gpa2>;
				pinctrl-names = "default";
				pinctrl-0 = <&s_pmic_irq>;
				adc_mode = <0x01>;
				adc_sync_mode = <0x02>;
				ocp_warn3_en = <0x00>;
				ocp_warn3_cnt = <0x00>;
				ocp_warn3_dvs_mask = <0x00>;
				ocp_warn3_lv = <0x00>;

				regulators {

					s_buck1_reg: BUCK1S {
						regulator-name = "s_vdd_buck1";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-always-on;
						regulator-ramp-delay = <0x1770>;
						regulator-initial-mode = <0x02>;
					};

					s_buck2_reg: BUCK2S {
						regulator-name = "s_vdd_buck2";
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-ramp-delay = <0x1770>;
						regulator-initial-mode = <0x03>;
					};

					s_ldo1_reg: LDO1S {
						regulator-name = "s_vdd_ldo1";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-always-on;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x01>;
					};

					s_ldo2_reg: LDO2S {
						regulator-name = "s_vdd_ldo2";
						regulator-min-microvolt = <0x186a00>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-always-on;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x03>;
					};
				};
			};
		};
	};

	fragment@75 {
		target = <&hsi2c_24>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mpb02_pmic@59 {
				compatible = "s2mpb02,s2mpb02mfd";
				reg = <0x59>;
				s2mpb02,wakeup;
				pinctrl-names = "default";
				pinctrl-0 = <&sub_pmic_irq>;

				regulators {

					_buck1_reg: s2mpb02-buck1 {
						regulator-name = "S2MPB02_BUCK1";
						regulator-min-microvolt = <0x13d620>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-boot-on;
					};

					_buck2_reg: s2mpb02-buck2 {
						regulator-name = "VDD_EXT_1P3_PB02";
						regulator-min-microvolt = <0x13d620>;
						regulator-max-microvolt = <0x13d620>;
					};

					_buckboost_reg: s2mpb02-bb {
						regulator-name = "S2MPB02_BB";
						regulator-min-microvolt = <0x27ac40>;
						regulator-max-microvolt = "", "=\t";
						regulator-always-on;
						regulator-boot-on;
					};

					_ldo3_reg: s2mpb02-ldo3 {
						regulator-name = "VDDD_1.05V_SUB";
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
					};

					_ldo4_reg: s2mpb02-ldo4 {
						regulator-name = "VDDD_1.05V_WIDESUB";
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
					};

					_ldo5_reg: s2mpb02-ldo5 {
						regulator-name = "VDDD_1.05V_VT";
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
					};

					_ldo6_reg: s2mpb02-ldo6 {
						regulator-name = "VDDIO_1.8V_VT";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					_ldo7_reg: s2mpb02-ldo7 {
						regulator-name = "VDDIO_1.8V_SUB";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					_ldo8_reg: s2mpb02-ldo8 {
						regulator-name = "VDDIO_1.8V_WIDESUB";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					_ldo10_reg: s2mpb02-ldo10 {
						regulator-name = "VDDD_1.8V_OIS";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					_ldo11_reg: s2mpb02-ldo11 {
						regulator-name = "VDDA_2.8V_SUB";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
					};

					_ldo12_reg: s2mpb02-ldo12 {
						regulator-name = "VDDAF_2.8V_SUB";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
					};

					_ldo13_reg: s2mpb02-ldo13 {
						regulator-name = "VDDA_2.95V_VT";
						regulator-min-microvolt = <0x2d0370>;
						regulator-max-microvolt = <0x2d0370>;
					};

					_ldo14_reg: s2mpb02-ldo14 {
						regulator-name = "VDDAF_COMMON_CAM";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
					};

					_ldo15_reg: s2mpb02-ldo15 {
						regulator-name = "VDDA_2.8V_WIDESUB";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
					};

					_ldo16_reg: s2mpb02-ldo16 {
						regulator-name = "VDDAF_2.8V_VT";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
					};

					_ldo17_reg: s2mpb02-ldo17 {
						regulator-name = "VDD_GRIP_3P3";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-always-on;
						regulator-boot-on;
					};

					_ldo18_reg: s2mpb02-ldo18 {
						regulator-name = "S2MPB02_LDO18";
						regulator-min-microvolt = <0x33e140>;
						regulator-max-microvolt = <0x350638>;
					};
				};

				torch {
					torch1-gpio = <&gpg2>, <0x04 0x01>;
					flash1-gpio = <&gpg3>, <0x06 0x01>;
					status = "okay";

					leds1 {
						ledname = "leds-sec1";
						id = <0x00>;
						brightness = <0x0c>;
						timeout = <0x07>;
						torch_table_enable = <0x00>;
					};

					leds2 {
						ledname = "torch-sec1";
						id = <0x01>;
						brightness = <0x0c>;
						timeout = <0x0f>;
						torch_table_enable = <0x01>;
						torch_table = <0x02 0x04 0x04 0x05 0x06 0x08 0x09 0x0a 0x0a 0x0c>;
					};
				};
			};
		};
	};

	fragment@76 {
		target = <&abox_gic>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@77 {
		target = <&abox>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@78 {
		target = <&pinctrl_0>;

		__overlay__ {

			codec_irq: codec-irq {
				samsung,pins = "gpa2-2";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};
		};
	};

	fragment@79 {
		target = <&pinctrl_5>;

		__overlay__ {

			codec_reset: codec-reset {
				samsung,pins = "gpg1-0";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};

			spi2_cs_func: spi2-cs-func {
				samsung,pins = "gpp0-7";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x03>;
				samsung,pin-drv = <0x00>;
			};
		};
	};

	fragment@80 {
		target = <&spi_2>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&spi2_bus>, <&spi2_cs_func>;

			cs47l93: cs47l93@0 {
				compatible = "cirrus,cs47l93";
				reg = <0x00>;
				spi-max-frequency = <0x17d7840>;
				interrupts = <0x02 0x00 0x00>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupt-parent = <&gpa2>;
				gpio-controller;
				#gpio-cells = <0x02>;
				#sound-dai-cells = <0x01>;
				AVDD-supply = <&ldo17_reg>;
				DBVDD1-supply = <&ldo17_reg>;
				CPVDD1-supply = <&ldo17_reg>;
				CPVDD2-supply = <&ldo18_reg>;
				DCVDD-supply = <&ldo18_reg>;
				reset-gpios = <&gpg1>, <0x00 0x00>;
				cirrus,dmic-ref = <0x00 0x00 0x01 0x01>;
				cirrus,inmode = <0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x01>;
				cirrus,out-mono = <0x00 0x00 0x00 0x01 0x00 0x00>;
				cirrus,auxpdm-falling-edge;
				pinctrl-names = "probe", "active";
				pinctrl-0 = <&codec_reset>, <&codec_irq>;
				pinctrl-1 = <&cs47l93_defaults>;
				cirrus,gpsw = <0x03 0x00>;
				madera_pinctrl: madera-pinctrl {
					compatible = "cirrus,madera-pinctrl";
					cs47l93_defaults: cs47l93-gpio-defaults {
						aif1 {
							groups = "aif1";
							function = "aif1";
							bias-bus-hold;
						};

						gpio9 {
							groups = "gpio9";
							function = "io";
							bias-disable;
							drive-strength = <0x08>;
						};

						gpio10 {
							groups = "gpio10";
							function = "io";
							bias-disable;
							drive-strength = <0x08>;
						};

						aif3 {
							groups = "aif3";
							function = "aif3";
							bias-bus-hold;
						};
					};
				};

				micvdd {
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x2dc6c0>;
				};

				MICBIAS1 {
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					cirrus,ext-cap = <0x01>;
				};

				MICBIAS1A {
					regulator-active-discharge = <0x01>;
				};

				MICBIAS1B {
					regulator-active-discharge = <0x01>;
				};

				MICBIAS1C {
					regulator-active-discharge = <0x01>;
				};

				MICBIAS1D {
					regulator-active-discharge = <0x01>;
				};

				MICBIAS2 {
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					cirrus,ext-cap = <0x01>;
					regulator-soft-start;
				};

				MICBIAS2A {
					regulator-active-discharge = <0x01>;
				};

				cirrus,accdet {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					acc@1 {
						reg = <0x02>;
						cirrus,micd-bias-start-time = <0x01>;
						cirrus,micd-rate = <0x07>;
						cirrus,micd-detect-debounce-ms = <0x12c>;
						cirrus,micd-clamp-mode = <0x08>;
						cirrus,jd-use-jd2;
						cirrus,hs-mic = <0x01>;
						cirrus,init-delay-ms = <0x1e>;
						cirrus,micd-dbtime = <0x01>;
						cirrus,micd-timeout-ms = <0x3e8>;
						cirrus,micd-force-micbias;
						cirrus,hpdet-short-circuit-imp = <0x02>;
						cirrus,hpdet-ext-res = <0xce4>;
						cirrus,micd-ranges = <0x74 0xe2 0xad 0x246 0x141 0x73 0x2f0 0x72 0x4e9 0xd9>;
						cirrus,micd-software-compare;
						cirrus,micd-open-circuit-declare = <0x01>;
						cirrus,jd-wake-time = <0x1388>;
						cirrus,moisture-pin = <0x07>;
						cirrus,moisture-imp = <0x7d0>;
						cirrus,moisture-debounce = <0x64>;
						cirrus,micd-configs = <0x00 0x01 0x04 0x00 0x01>;
						cirrus,hpd-pins = <0x02 0x05 0x00 0x00>;
					};
				};

				adsps {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					adsp@0FFE00 {
						reg = <0xffe00>;

						firmware {

							TRACE {
								cirrus,full-name;
								cirrus,wmfw-file = "cs47l93-dsp1-trace.wmfw";
								cirrus,bin-file = "None";
								cirrus,compr-caps = <0x01 0x08 0x04 0x01 0x1f40 0x3e80 0x5dc0 0x7d00 0xbb80>;
							};
						};
					};
				};

				controller-data {
					samsung,spi-feedback-delay = <0x01>;
					samsung,spi-chip-select-mode = <0x00>;
				};
			};
		};
	};

	fragment@81 {
		target = <&pinctrl_6>;

		__overlay__ {

			hsi2c38_bus: hsi2c38-bus {
				samsung,pins = "gph0-6", "gph0-7";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				samsung,pin-pud-pdn = <0x00>;
			};

			spk_amp_rst_n: spk-amp-rst-n {
				samsung,pins = "gph1-1";
				samsung,pin-function = <0x01>;
				samsung,pin-val = <0x00>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};

			rcv_amp_rst_n: rcv-amp-rst-n {
				samsung,pins = "gph1-2";
				samsung,pin-function = <0x01>;
				samsung,pin-val = <0x00>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};
		};
	};

	fragment@82 {
		target = <&pinctrl_2>;

		__overlay__ {

			ub_detect_conn_setting: ub_detect_conn_setting {
				samsung,pins = "gpm23-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
