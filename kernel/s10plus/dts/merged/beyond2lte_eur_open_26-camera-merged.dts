	fragment@3 {
		target = <&pinctrl_0>;

		__overlay__ {

			wpc_int: wpc-int {
				samsung,pins = "gpa3-1";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};

			wpc_det: wpc-det {
				samsung,pins = "gpa2-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x01>;
			};
		};
	};

	fragment@4 {
		target = <&pinctrl_5>;

		__overlay__ {

			jig_gpio: jig-gpio {
				samsung,pins = "gpg0-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};
		};
	};

	fragment@5 {
		target = <&hsi2c_46>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			samsung,stop-after-trans;
			samsung,stand-mode;
			clock-frequency = <0x186a0>;

			mfc-charger@3b {
				compatible = "idt,mfc-charger";
				reg = <0x3b>;
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&wpc_int>, <&wpc_det>;
				battery,wpc_int = <&gpa3>, <0x01 0x00>;
				battery,wpc_det = <&gpa2>, <0x00 0x00>;
				battery,mst_pwr_en = <&gpg3>, <0x05 0x00>;
				battery,charger_name = "max77705-charger";
				battery,fuelgauge_name = "max77705-fuelgauge";
				battery,wireless_charger_name = "mfc-charger";
				battery,fod_data = <0x96 0x34 0x8e 0x2c 0x96 0x1e 0x96 0x16 0x9b 0x09 0x9c 0x07>;
				battery,fod_data_cv = <0x96 0x52 0x8e 0x4a 0x96 0x3c 0x96 0x34 0x9b 0x27 0x9c 0x25>;
				battery,fod_hero_5v_data = <0x96 0x02 0x8e 0xfffffffa 0x96 0xffffffec 0x96 0xffffffe4 0xa5 0xb9 0x9c 0xffffffd9>;
				battery,fod_dream_data = <0x96 0x34 0x8e 0x2c 0x96 0xffffffce 0x96 0x16 0x9b 0xffffffbe 0x9c 0x07>;
				battery,fod_dream_cv_data = <0x96 0x52 0x8e 0x4a 0x96 0xffffffec 0x96 0x34 0x9b 0xffffffdc 0x9c 0x25>;
				battery,wc_cover_rpp = <0x44>;
				battery,oc_fod1 = <0x44c>;
				battery,tx_gear_min_op_freq_delay = <0xfa0>;
				battery,wireless20_vout_list = <0x08>;
				battery,wireless20_vrect_list = <0x0a>;
				battery,wireless20_max_power_list = <0x02>;
			};
		};
	};

	fragment@6 {
		target = <&pinctrl_5>;

		__overlay__ {

			wpc_en: wpc-en {
				samsung,pins = "gpg0-1";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};
		};
	};

	fragment@haptic {
		target-path = "/";

		__overlay__ {

			haptic {
				status = "okay";
				haptic,max_timeout = <0x2710>;
				haptic,multi_frequency = <0x07>;
				haptic,duty = <0x8f0d 0xbebc 0x9896 0x7270 0x7f27 0x90f4 0x90f4>;
				haptic,period = <0xbebc 0xfe50 0xcb73 0x9896 0xa98a 0x9896 0x9896>;
				haptic,reg2 = <0x82>;
				haptic,pwm_id = <0x01>;
				haptic,regulator_name = "VDD_MOTOR_3P3";
				haptic,normal_ratio = <0x4b>;
				haptic,overdrive_ratio = <0x5f>;
				haptic,type = "LINEAR_1040";
			};
		};
	};

	fragment@7 {
		target = <&pinctrl_0>;

		__overlay__ {

			max77705_irq: max77705-irq {
				samsung,pins = "gpa1-6";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};
		};
	};

	fragment@8 {
		target = <&pinctrl_2>;

		__overlay__ {

			uart_ctrl: uart-ctrl {
				samsung,pins = "gpm26-0";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
			};
		};
	};

	fragment@9 {
		target = <&pinctrl_5>;

		__overlay__ {

			vib_pwm: vib-pwm {
				samsung,pins = "gpp3-1";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x01>;
				samsung,pin-drv = <0x00>;
			};

			motor_boost_en: motor-boost-en {
				samsung,pins = "gpg1-7";
				samsung,pin-function = <0x01>;
				samsung,pin-val = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x00>;
				samsung,pin-pud-pdn = <0x00>;
			};

			motor_boost_en_sleep: motor-boost-en-sleep {
				samsung,pins = "gpg1-7";
				samsung,pin-con-pdn = <0x00>;
				samsung,pin-pud-pdn = <0x00>;
			};
		};
	};

	fragment@muic {
		target-path = "/";

		__overlay__ {

			muic {
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&uart_ctrl>;
				muic,support-list = "TA", "USB", "CDP", "JIG UART OFF", "JIG UART OFF/VB", "JIG UART ON", "JIG UART ON/VB", "JIG USB OFF", "JIG USB ON", "OTG", "Unofficial TA", "DCD Timeout", "AFC Charger";
				uart_ctrl = <&gpm26>, <0x00 0x00>;
			};
		};
	};

	fragment@10 {
		target = <&hsi2c_45>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			max77705@66 {
				compatible = "maxim,max77705";
				pinctrl-names = "default";
				pinctrl-0 = <&max77705_irq>, <&vib_pwm>, <&motor_boost_en>;
				pinctrl-1 = <&motor_boost_en_sleep>;
				reg = <0x66>;
				max77705,irq-gpio = <&gpa1>, <0x06 0x01>;
				max77705,wakeup;
				max77705,fw_product_id = <0x02>;
				support_pd_role_swap;
				max77705,support-audio;

				regulators {

					ESAFEOUT1 {
						regulator-compatible = "safeout1";
						regulator-name = "safeout1_range";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x4ac4a0>;
						regulator-boot-on;
					};

					ESAFEOUT2 {
						regulator-compatible = "safeout2";
						regulator-name = "safeout2_range";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x4ac4a0>;
					};
				};
			};
		};
	};

	fragment@model {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			model = "Samsung BEYOND2LTE EUR OPEN 26 board based on EXYNOS9820";

			sec-mst {
				compatible = "sec-mst";
				sec-mst,mst-pwr-gpio = <&gpg3>, <0x05 0x00>;
				sec-mst,mst-en-gpio = <&gpp4>, <0x05 0x00>;
				sec-mst,mst-data-gpio = <&gpp4>, <0x04 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&mst_pwr_en>, <&mst_en>, <&mst_data>;
			};

			gpio_keys {
				status = "okay";
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_wink>, <&key_voldown>, <&key_volup>, <&key_power>;

				button@1 {
					label = "gpio-keys: KEY_WINK";
					linux,code = <0x2bf>;
					gpios = <&gpa0>, <0x06 0x0f>;
					gpio-key,wakeup = <0x01>;
					debounce-interval = <0x0a>;
				};

				button@2 {
					label = "gpio-keys: KEY_VOLUMEDOWN";
					linux,code = <0x72>;
					gpios = <&gpa0>, <0x04 0x0f>;
					debounce-interval = <0x0a>;
				};

				button@3 {
					label = "gpio-keys: KEY_VOLUMEUP";
					linux,code = <0x73>;
					gpios = <&gpa0>, <0x03 0x0f>;
					debounce-interval = <0x0a>;
				};

				button@4 {
					label = "gpio-keys: KEY_POWER";
					linux,code = <0x74>;
					gpios = <&gpa2>, <0x04 0x0f>;
					gpio-key,wakeup = <0x01>;
					debounce-interval = <0x0a>;
				};
			};

			fixed-rate-clocks {

