	fragment@113 {
		target = <&spi_7>;

		__overlay__ {
			status = "okay";
			pinctrl-names = "ese_active", "ese_suspend";
			pinctrl-0 = <&spi7_bus>, <&spi7_cs>;
			pinctrl-1 = <&spi7_bus_suspend>, <&spi7_cs_suspend>;

			ese_spi@0 {
				compatible = "ese_p3";
				reg = <0x00>;
				spi-max-frequency = <0xc65d40>;
				gpio-controller;
				#gpio-cells = <0x02>;
				p3-vdd-1p8 = "VDD_ESE_1P8";
				clocks = <&clock>, <0x22c>, <&clock>, <0x23e>;
				clock-names = "pclk", "sclk";
				ese_p3,cs-gpio = <&gpp4>, <0x03 0x00>;

				controller-data {
					samsung,spi-feedback-delay = <0x00>;
					samsung,spi-chip-select-mode = <0x00>;
				};
			};
		};
	};

	fragment@114 {
