				rom_id = <0x02>;
				rom_cal_index = <0x00>;
				rom_dualcal_id = <0x00>;
				rom_dualcal_index = <0x00>;
				gpio_mclk = <&gpc1>, <0x07 0x01>;
				gpio_reset = <&gpg0>, <0x03 0x01>;
				status = "okay";
				af {
					product_name = <0x64>;
				};

				flash {
					product_name = <0x0b>;
				};

				preprocessor {
					product_name = <0x64>;
				};

				ois {
