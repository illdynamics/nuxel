	fragment@89 {
		target = <&pcie_1>;

		__overlay__ {
			status = "disabled";
			use-sysmmu = "false";
			use-cache-coherency = "true";
			use-msi = "false";
		};
	};

	fragment@90 {
		target = <&panel_0>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			ranges;

			gpios {

				disp-reset {
					gpios = <&gpa3>, <0x04 0x01>;
					dir = <0x00>;
					irq-type = <0x00>;
				};

				disp-det {
					gpios = <&gpg2>, <0x02 0x01>;
					dir = <0x01>;
					irq-type = <0x02>;

					irq-pend {
						reg = <0x00 0x10430a18 0x04>;
						bit = <0x02>;
					};
				};

				conn-det {
					gpios = <&gpm23>, <0x00 0x00>;
					dir = <0x01>;
					irq-type = <0x03>;
				};
			};

			regulators {

				ddi-3p0 {
					regulator = <&dp_ldo4>;
					def-voltage = <0x2dc6c0>;
					lpm-voltage = <0x2dc6c0>;
				};

				ddi-1p8 {
					regulator = <&dp_ldo1>;
					def-voltage = <0x1b7740>;
					lpm-voltage = <0x1b7740>;
				};

				ddr-1p6 {
					regulator = <&dp_buck>;
					def-voltage = <0x186a00>;
					lpm-voltage = <0x16e360>;
				};

				short-detect {
					regulator = <&dp_elvss>;
					def-current = <0x7d0>;
					lpm-current = <0x1f40>;
				};
			};

			panel-lookup {
				panel-name = "s6e3ha9_beyond2_a3_s0_default", "s6e3ha9_beyond2_a3_s0_utype", "s6e3ha9_beyond2_a3_s0_preliminary";
				panel-ddi-info = <&s6e3ha9_beyond2>, <&s6e3ha9_beyond1_1440x2960>;
				panel-lut = <0x00 0x300000 0x02 0x01 0x100000 0x300000 0x02 0x00 0x00 0xf0000 0x01 0x00 0x00 0x00 0x00 0x00>;
			};
		};
	};

	fragment@91 {
		target = <&hsi2c_14>;

		__overlay__ {
			gpios = <&gpp2>, <0x04 0x00>, <&gpp2>, <0x05 0x00>;
			clock-frequency = <0x61a80>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sx9330-i2c@28 {
				compatible = "sx9330";
				reg = <0x28>;
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&grip_irq>;
				interrupt-parent = <&gpa3>;
				interrupts = <0x00 0x00 0x00>;
				sx9330,nirq-gpio = <&gpa3>, <0x00 0x00>;
				sx9330,scanperiod_reg = <0x32>;
				sx9330,gnrlctrl2_reg = <0xff0002>;
				sx9330,afeparamsph0_reg = <0x21f>;
				sx9330,afephph0_reg = <0x3fbb8548>;
				sx9330,adcfiltph0_reg = <0x510101d>;
				sx9330,afeparamsph1_reg = <0x1e07>;
				sx9330,adcfiltph1_reg = <0x104d15>;
				sx9330,avgbfilt_reg = "``\f";
				sx9330,avgafilt_reg = <0x00>;
				sx9330,advdig3_reg = <0x00>;
				sx9330,advdig4_reg = <0x00>;
				sx9330,refcorra_reg = <0x00>;
			};
		};
	};

	fragment@92 {
		target = <&reserved_memory>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;

			secure_camera {
				compatible = "exynos9820-ion";
				ion,heapname = "secure_camera_heap";
				reg = <0x00 0x96000000 0x2200000>;
				ion,secure;
				ion,protection_id = <0x0b>;
				ion,alignment = <0x10000>;
