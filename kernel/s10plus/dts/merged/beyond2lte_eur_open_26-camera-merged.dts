					ldo5_reg: LDO5M {
						regulator-name = "m_vdd_ldo5";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x10c8e0>;
						regulator-always-on;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x01>;
					};

					ldo6_reg: LDO6M {
						regulator-name = "m_vdd_ldo6";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-always-on;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x01>;
					};

					ldo7_reg: LDO7M {
						regulator-name = "m_vdd_ldo7";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x10c8e0>;
						regulator-always-on;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x01>;
