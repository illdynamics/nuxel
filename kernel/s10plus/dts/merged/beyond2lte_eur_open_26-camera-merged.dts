				rom_cal_index = <0x01>;
				rom_dualcal_id = <0x00>;
				rom_dualcal_index = <0x01>;
				gpio_mclk = <&gpc1>, <0x04 0x01>;
				gpio_reset = <&gpg3>, <0x00 0x01>;
				gpio_ois_reset = <&gpg0>, <0x06 0x01>;
				gpio_subcam_sel = <&gpg4>, <0x03 0x01>;
				power_seq_id = <0x01>;
				status = "okay";
				af {
					product_name = <0x12>;
					i2c_ch = <0x03>;
				};

				flash {
					product_name = <0x0b>;
				};

				preprocessor {
					product_name = <0x64>;
				};

				ois {
					product_name = <0x64>;
				};

				mcu {
					product_name = <0x01>;
					i2c_addr = <0x51>;
					i2c_ch = <0x03>;
				};
			};

			fimc_is_sensor_3p9: fimc-is_sensor_3p9@2D {
