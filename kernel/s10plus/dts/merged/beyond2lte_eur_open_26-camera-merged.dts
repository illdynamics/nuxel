	fragment@88 {
		target = <&pcie_0>;

		__overlay__ {
			pinctrl-names = "default", "idle";
			pinctrl-0 = <&pcie0_clkreq>, <&pcie0_perst>, <&pcie_wake>, <&cfg_wlanen>, <&wlan_host_wake>;
			pinctrl-1 = <&pcie0_perst>, <&pcie_wake>, <&cfg_wlanen>, <&wlan_host_wake>;
			status = "okay";
			use-sysmmu = "true";
			use-cache-coherency = "true";
			use-msi = "false";
			ep-device-type = <0x01>;
		};
