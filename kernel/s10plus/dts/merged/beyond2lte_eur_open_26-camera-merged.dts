	fragment@36 {
		target = <&reserved_memory>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;

			modem_if {
				compatible = "exynos,modem_if";
				reg = <0x00 0xf0000000 0xb900000>;
			};

			cp_ram_logging {
				compatible = "exynos,cp_ram_logging";
				reg = <0x00 0xfb900000 0x2000000>;
			};

			modem_spare {
				compatible = "exynos,modem_spare";
				reg = <0x00 0xd0000000 0x1600000>;
			};
		};
	};

	fragment@modemif {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;

			mif_pdata: mif_pdata {
				reg = <0x00 0x10000 0x00 0x00 0x1a2a0000 0x10000 0x00 0x1a220000 0x2000>;
				reg-names = "offset", "dit", "sysreg_busc";
				compatible = "sec_modem,modem_pdata";
				status = "okay";
				gpios = <&gpg3>, <0x04 0x00>, <&gpg3>, <0x03 0x00>, <&gpg3>, <0x02 0x00>, <&gpg3>, <0x01 0x00>, <&gpg1>, <0x05 0x00>, <&gpg1>, <0x04 0x00>, <&gpg1>, <0x03 0x00>, <&gpg1>, <0x02 0x00>;
				pinctrl-names = "default";
				interrupts = <0x00 0x177 0x00 0x00 0x44 0x00 0x00 0x43 0x00 0x00 0x42 0x00>;
				interrupt-names = "CP2AP_WAKEUP", "DIT_BUS_ERR", "DIT_RX_DONE", "DIT_TX_DONE";
				ap2cp_cfg_addr = <0x15020000>;
				mif,name = "s5000ap";
				mif,modem_net = <0x00>;
				mif,modem_type = <0x0b>;
				mif,use_handover = <0x00>;
				mif,ipc_version = <0x32>;
				mif,link_types = <0x200>;
