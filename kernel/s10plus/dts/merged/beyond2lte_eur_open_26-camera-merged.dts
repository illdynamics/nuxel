					};

					buck9_reg: BUCK9M {
						regulator-name = "m_vdd_buck9";
						regulator-min-microvolt = <0xb71b0>;
						regulator-max-microvolt = <0x118c30>;
						regulator-always-on;
						regulator-ramp-delay = <0x1770>;
						regulator-initial-mode = <0x03>;
					};

					buck10_reg: BUCK10M {
						regulator-name = "m_vdd_buck10";
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-ramp-delay = <0x1770>;
						regulator-initial-mode = <0x03>;
					};

					buck11_reg: BUCK11M {
						regulator-name = "m_vdd_buck11";
						regulator-min-microvolt = <0x10c8e0>;
						regulator-max-microvolt = <0x16e360>;
						regulator-always-on;
						regulator-ramp-delay = <0x1770>;
						regulator-initial-mode = <0x03>;
					};

					buck12_reg: BUCK12M {
						regulator-name = "m_vdd_buck12";
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x20ce70>;
						regulator-always-on;
						regulator-ramp-delay = <0x1770>;
						regulator-initial-mode = <0x03>;
					};

					ldo1_reg: LDO1M {
						regulator-name = "m_vdd_ldo1";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-always-on;
						regulator-ramp-delay = <0x2ee0>;
						regulator-initial-mode = <0x03>;
					};

					ldo2_reg: LDO2M {
