/dts-v1/;
/plugin/;

/ {
	compatible = "samsung,BEYOND2LTE EUR OPEN 26", "samsung,EXYNOS9820";
	dtbo-hw_rev = <0x1a>;
	dtbo-hw_rev_end = <0xff>;

	fragment@0 {
		target = <&pinctrl_0>;

		__overlay__ {

			ssp_batch_wake_irq: ssp-batch-wake-irq {
				samsung,pins = "gpa0-5";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x01>;
				samsung,pin-pud-pdn = <0x00>;
			};

			ssp_host_req: ssp-host-req {
				samsung,pins = "gpa1-7";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x01>;
				samsung,pin-drv = <0x03>;
			};

			ssp_shub_int: ssp-shub-int {
				samsung,pins = "gpa4-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x03>;
			};
		};
	};

	fragment@1 {
		target = <&pinctrl_5>;

		__overlay__ {

			ssp_gps_pwr_en: ssp-gps-pwr-en {
				samsung,pins = "gpg0-2";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x01>;
				samsung,pin-drv = <0x03>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};

			ssp_mcu_resp: ssp-mcu-resp {
				samsung,pins = "gpg4-2";
				samsung,pin-function = <0x00>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x03>;
				samsung,pin-con-pdn = <0x02>;
				samsung,pin-pud-pdn = <0x00>;
			};

			ssp_mcu_req: ssp-mcu-req {
				samsung,pins = "gpg4-1";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x03>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
			};
		};
	};

	fragment@2 {
		target = <&spi_17>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <&spi17_bus>, <&spi17_cs_func>;
			status = "okay";

			BCM4773@0 {
				compatible = "ssp,BCM4773";
				reg = <0x00>;
				spi-max-frequency = <0x17d7840>;
				spi-cpol;
				spi-cpha;
				pinctrl-names = "default";
				pinctrl-0 = <&ssp_host_req>, <&ssp_mcu_req>, <&ssp_mcu_resp>, <&ssp_batch_wake_irq>, <&ssp_shub_int>, <&ssp_gps_pwr_en>;
				gpio-controller;
				#gpio-cells = <0x02>;
				ssp-gps-pwr-en = <&gpg0>, <0x02 0x00>;
				ssp-host-req = <&gpa1>, <0x07 0x00>;
				ssp-mcu-req = <&gpg4>, <0x01 0x00>;
				ssp-mcu-resp = <&gpg4>, <0x02 0x00>;
				ssp-batch-wake-irq = <&gpa0>, <0x05 0x00>;
				ssp-shub-int = <&gpa4>, <0x00 0x00>;
				ssp-ap-rev = <0x01>;
				ssp-sns-combination = <0x00>;
				ssp-glass-type = <0x00>;
				ssp-mag-type = <0x01>;
				ssp-vdd-mcu-1p8 = "vdd_mcu_1p8";

				controller-data {
					cs-gpio = <&gph0>, <0x03 0x00>;
					samsung,spi-feedback-delay = <0x00>;
				};
			};
		};
	};

	fragment@mipi_freq {
		target-path = "/";

		__overlay__ {

			freq_897: freq_897 {
				hs-clk = <0x381>;
				pmsk = <0x02 0x8a 0x02 0x00 0x0d 0x03 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				cmd_underrun_lp_ref = <0xb3d 0x149e 0x1b52>;
			};

			freq_903_5: freq_903_5 {
				hs-clk = <0x387>;
				pmsk = <0x02 0x8b 0x02 0x00 0x0d 0x03 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				cmd_underrun_lp_ref = <0xb70 0x14d6 0x1b86>;
			};

			freq_910: freq_910 {
				hs-clk = <0x38e>;
				pmsk = <0x02 0x8c 0x02 0x00 0x0d 0x03 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				cmd_underrun_lp_ref = <0xbad 0x150e 0x1bc2>;
			};

			freq_929_5: freq_929_5 {
				hs-clk = <0x3a1>;
				pmsk = <0x02 0x8f 0x02 0x00 0x0d 0x03 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				escape-clk = <0x14>;
				cmd_underrun_lp_ref = <0xc63 0x15c3 0x1c78>;
			};

			freq_1143: freq_1143 {
				hs-clk = <0x477>;
				pmsk = <0x02 0xb0 0x02 0xd89e 0x0d 0x04 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				escape-clk = <0x14>;
				cmd_underrun_lp_ref = <0x57f>;
			};

			freq_1150: freq_1150 {
				hs-clk = <0x47e>;
				pmsk = <0x02 0xb1 0x02 0xec4f 0x0d 0x04 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				escape-clk = <0x14>;
				cmd_underrun_lp_ref = <0x5c0>;
			};

			freq_1157: freq_1157 {
				hs-clk = <0x485>;
				pmsk = <0x02 0xb2 0x02 0x00 0x0d 0x04 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				escape-clk = <0x14>;
				cmd_underrun_lp_ref = <0x601>;
			};

			freq_1176: freq_1176 {
				hs-clk = <0x498>;
				pmsk = <0x02 0xb5 0x02 0x00 0x0d 0x04 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				escape-clk = <0x14>;
				cmd_underrun_lp_ref = <0x6bc>;
			};
		};
	};

