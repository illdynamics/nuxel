 static int ncm_function_init(void)
 {
 	struct ncm_dev *dev;
+	unsigned long flags;
 	int ret = 0;
 
-	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
-	if (!dev)
-		return -ENOMEM;
+	/* Later instances only take a reference to the existing singleton. */
+	spin_lock_irqsave(&mirrorlink_lock, flags);
+	if (mirrorlink_users) {
+		mirrorlink_users++;
+		spin_unlock_irqrestore(&mirrorlink_lock, flags);
+		return 0;
+	}
+	mirrorlink_users = 1;
+	spin_unlock_irqrestore(&mirrorlink_lock, flags);
 
+	mutex_lock(&mirrorlink_txn);
+	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	if (!dev) {
