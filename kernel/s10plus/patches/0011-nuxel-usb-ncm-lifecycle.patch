 static bool ncm_connect;
+
+/*
+ * Nuxel: the mirrorlink misc device and its notification work are one global
+ * singleton shared by every live NCM function instance, but the vendor code
+ * registered it from ncm_alloc() (which runs again for every bind) and tore it
+ * down from ncm_free_inst() unconditionally.  Ownership is therefore:
+ *
+ *   mirrorlink_users    number of NCM function instances that took a
+ *                       reference from ncm_function_init(); incremented under
+ *                       mirrorlink_lock before anything is registered.
+ *   mirrorlink_active   the singleton device/work has been registered and is
+ *                       not yet deregistered.  Set under the lock.
+ *   mirrorlink_refs     number of ncm_alloc()/ncm_free() callers that can still
+ *                       reach the singleton work (set_ncm_ready() requires a
+ *                       bound instance).  Teardown waits for this to drain.
+ *
+ * misc_register()/misc_deregister() are called WITHOUT the spinlock held:
+ * they sleep, and ncm_work() takes the same lock from a workqueue context.
+ * All register/deregister transitions run under mirrorlink_txn, which makes
+ * "registered" and "active" change together for other lock users.
+ */
+static DEFINE_SPINLOCK(mirrorlink_lock);
+static DEFINE_MUTEX(mirrorlink_txn);
+static unsigned int mirrorlink_users;
+static unsigned int mirrorlink_refs;
+static bool mirrorlink_active;
+/* Lifecycle-fix build marker (see tools/beta/live/nuxel-usb-net.py). */
+static const char nuxel_ncm_lifecycle_fix[] = "nuxel-ncm-lifecycle-fix-v2";
+
+static ssize_t nuxel_fix_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%s\n", nuxel_ncm_lifecycle_fix);
+}
+/*
+ * Nuxel: a second, always-present copy of the marker.  The misc attribute only
+ * exists while an NCM function is registered; this one lets build/CI tooling
+ * prove the RUNNING image carries the fix without creating a gadget first.
+ */
+const char nuxel_ncm_lifecycle_marker[] = "nuxel-ncm-lifecycle-fix-v2";
+EXPORT_SYMBOL_GPL(nuxel_ncm_lifecycle_marker);
+static DEVICE_ATTR_RO(nuxel_fix);
 
