+				__func__);
+
+	spin_lock_irqsave(&mirrorlink_lock, flags);
+	_ncm_dev = dev;
+	mirrorlink_active = true;
+	spin_unlock_irqrestore(&mirrorlink_lock, flags);
+	mutex_unlock(&mirrorlink_txn);
 	return 0;
+
+drop_user:
+	spin_lock_irqsave(&mirrorlink_lock, flags);
+	mirrorlink_users = 0;
+	spin_unlock_irqrestore(&mirrorlink_lock, flags);
+	mutex_unlock(&mirrorlink_txn);
+	return ret;
 }
 
 static void ncm_function_cleanup(void)
 {
-	misc_deregister(&mirrorlink_device);
-	kfree(_ncm_dev);
+	struct ncm_dev *dev = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&mirrorlink_lock, flags);
+	if (!mirrorlink_users) {
+		spin_unlock_irqrestore(&mirrorlink_lock, flags);
+		return;
+	}
+	if (--mirrorlink_users) {
+		spin_unlock_irqrestore(&mirrorlink_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&mirrorlink_lock, flags);
+
+	/*
+	 * No live instance can schedule work now (set_ncm_ready() needs a
+	 * bound function).  Wait for in-flight ncm_alloc()/ncm_free() callers,
+	 * then detach the singleton under the transaction mutex so exactly one
+	 * misc_deregister() pairs with the successful misc_register() above.
+	 */
+	mutex_lock(&mirrorlink_txn);
+	spin_lock_irqsave(&mirrorlink_lock, flags);
+	mirrorlink_active = false;
+	dev = _ncm_dev;
 	_ncm_dev = NULL;
+	spin_unlock_irqrestore(&mirrorlink_lock, flags);
+
+	while (READ_ONCE(mirrorlink_refs))
+		usleep_range(1000, 5000);
+
+	if (dev)
+		cancel_work_sync(&dev->work);
+	if (dev && mirrorlink_device.this_device)
+		device_remove_file(mirrorlink_device.this_device,
+				   &dev_attr_nuxel_fix);
+	misc_deregister(&mirrorlink_device);
+	kfree(dev);
+	mutex_unlock(&mirrorlink_txn);
 }
+
+static void ncm_function_ref_get(void)
+{
+	spin_lock_irq(&mirrorlink_lock);
+	mirrorlink_refs++;
+	spin_unlock_irq(&mirrorlink_lock);
+}
+
+static void ncm_function_ref_put(void)
+{
+	spin_lock_irq(&mirrorlink_lock);
+	if (mirrorlink_refs)
+		mirrorlink_refs--;
+	spin_unlock_irq(&mirrorlink_lock);
+}
+
+/*
+ * Module exit (or a failed module init) must not leave the vendor singleton
+ * registered after the function can no longer be created.
+ */
+static void ncm_function_shutdown(void)
+{
+	unsigned long flags;
+	unsigned int users;
+
+	/*
+	 * Leftover instances keep their own references; force the count to one
+	 * so the single call below performs the final teardown even though the
+	 * function is no longer creatable.
+	 */
+	spin_lock_irqsave(&mirrorlink_lock, flags);
+	users = mirrorlink_users;
+	mirrorlink_users = users ? 1 : 0;
+	spin_unlock_irqrestore(&mirrorlink_lock, flags);
+	ncm_function_cleanup();
+}
