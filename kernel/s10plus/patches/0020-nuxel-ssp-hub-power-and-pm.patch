From: Nuxel <nuxel@localhost>
Subject: [PATCH 0020] sensorhub/spi: hub rail reference + SPI hw re-init after runtime suspend

Found by measuring the live S10+ while bringing up the BCM47752 SSP sensor hub
natively (no vendor lhd):

- ssp_dev.c: vdd_mcu_1p8 is regulator_get() but never regulator_enable();
  the rail was only on because the bootloader left it (num_users == 0), and
  the hub never actually started.
- ssp_sysfs.c: set_mcu_power() skipped the enable when is_enabled() was true,
  so it never took a reference either.
- spi-s3c64xx.c: runtime suspend gates the clocks and drops the FIFO/mode
  config; set sci->need_hw_init so the next transfer re-initialises the
  controller, and re-run the init in the DOMAIN_TOP runtime resume.

Signed-off-by: Nuxel <nuxel@localhost>
---
diff --git a/drivers/sensorhub/brcm/ssp_dev.c b/drivers/sensorhub/brcm/ssp_dev.c
index db65af462..d9c0a7405 100644
--- a/drivers/sensorhub/brcm/ssp_dev.c
+++ b/drivers/sensorhub/brcm/ssp_dev.c
@@ -206,7 +206,13 @@ static void initialize_variable(struct ssp_data *data)
 	data->uIrqCnt = 0;
 
 	data->bFirstRef = true;
-	data->bSspShutdown = true;
+	/*
+	 * Nuxel: keep the hub enabled after probe.  Upstream leaves this true
+	 * and only the Android vendor lhd daemon clears it via ESW:READY; the
+	 * hub has already answered its chip-ID over SPI by this point, so a
+	 * native BBD peer must be able to reach it without that daemon.
+	 */
+	data->bSspShutdown = false;
 	data->bProximityRawEnabled = false;
 	data->bGeomagneticRawEnabled = false;
 	data->bBarcodeEnabled = false;
@@ -466,6 +472,19 @@ static int ssp_parse_dt(struct device *dev, struct ssp_data *data)
 		if (IS_ERR(data->regulator_vdd_mcu_1p8)) {
 			pr_err("[SSP]: failed to get reulator %s ret: %ld\n",
 					data->vdd_mcu_1p8_name, PTR_ERR(data->regulator_vdd_mcu_1p8));
+		} else {
+			/*
+			 * Nuxel: hold the hub's 1.8 V rail with a real reference.
+			 * The vendor stack (lhd) owns this enable; the upstream
+			 * driver only regulator_get()s it, so the rail happened to
+			 * be on from the bootloader (num_users=0) and the BCM47752
+			 * never came up: every SPI read returned 0xFF and the hub
+			 * looked dead.  Keep it on for the lifetime of the device;
+			 * set_mcu_power()/bring-up can still cycle it.
+			 */
+			int en = regulator_enable(data->regulator_vdd_mcu_1p8);
+			pr_info("[SSP] vdd_mcu_1p8 enable -> %d (enabled=%d)\n",
+				en, regulator_is_enabled(data->regulator_vdd_mcu_1p8));
 		}
 	}
 
@@ -1048,6 +1067,14 @@ static int ssp_probe(struct spi_device *spi)
 
 	enable_debug_timer(data);
 	data->bProbeIsDone = true;
+	/*
+	 * Nuxel PWNAGE-SSP: register the device for the native bring-up path as
+	 * soon as probe succeeds.  On Android this pointer is installed by the
+	 * BBD callbacks, but those only run once lhd drives the stream; without
+	 * this assignment a fully probed hub looks "not registered" to
+	 * nuxel_ssp_bringup_hw() forever.
+	 */
+	nuxel_ssp_register_data(data);
 	iRet = 0;
 	mutex_init(&shutdown_lock);
 	set_ssp_data_info(data);
diff --git a/drivers/sensorhub/brcm/ssp_sysfs.c b/drivers/sensorhub/brcm/ssp_sysfs.c
index b2c0dd043..154134ae5 100644
--- a/drivers/sensorhub/brcm/ssp_sysfs.c
+++ b/drivers/sensorhub/brcm/ssp_sysfs.c
@@ -569,8 +569,13 @@ static ssize_t set_mcu_power(struct device *dev,
 				ret = regulator_disable(data->regulator_vdd_mcu_1p8);
 			break;
 		case 1:
-			if (!regulator_is_enabled(data->regulator_vdd_mcu_1p8))
-				ret = regulator_enable(data->regulator_vdd_mcu_1p8);
+			/*
+			 * Nuxel: always regulator_enable() so a reference is taken.
+			 * regulator_is_enabled() may be true purely because the
+			 * bootloader left the rail on (num_users == 0); skipping the
+			 * enable then left the hub unpowered on any PMIC rebalance.
+			 */
+			ret = regulator_enable(data->regulator_vdd_mcu_1p8);
 			if (ret)
 				pr_err("[SSP] %s:failed to enable vdd_mcu_1p8(%d)\n", __func__, ret);
 			break;
@@ -1033,6 +1038,129 @@ static DEVICE_ATTR(sensor_dump, 0664,
 static DEVICE_ATTR(bcm_minidump, 0440, bcm_minidump_show, NULL);
 static DEVICE_ATTR(reset_info, 0440, reset_info_show, NULL);
 static DEVICE_ATTR(sensor_state, 0444, show_sensor_state, NULL);
+/* Nuxel PWNAGE-SSP: transport truth for the native BBD bridge. */
+static ssize_t show_nuxel_hub_diag(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct ssp_data *data = dev_get_drvdata(dev);
+	int n;
+
+	/* Keep the one-line transport truth in the kernel log as well. */
+	nuxel_ssp_bcm_diag();
+
+	n = snprintf(buf, PAGE_SIZE,
+		"mcu_probe=%d shutdown=%d resetting=%d sensor_state=0x%llx "
+		"enable=0x%llx shub_irq=%d\n",
+		!!data->bProbeIsDone, data->bSspShutdown, data->resetting,
+		(unsigned long long)data->uSensorState,
+		(unsigned long long)atomic64_read(&data->aSensorEnable),
+		data->irq_shub_int);
+	return n;
+}
+static DEVICE_ATTR(nuxel_hub_diag, 0444, show_nuxel_hub_diag, NULL);
+
+/*
+ * Nuxel PWNAGE-SSP: exact return code of a userspace-requested hub bring-up.
+ * Writing 1 runs nuxel_ssp_bringup_hw() in this (sleeping) context; the write
+ * returns 0 only when the hub answered initialize_mcu().  The daemon reads it
+ * back so a failed bring-up is never mistaken for a running hub.
+ */
+static ssize_t set_nuxel_bringup(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t size)
+{
+	int ret;
+
+	if (kstrtoint(buf, 10, &ret) < 0)
+		return -EINVAL;
+	if (ret != 1)
+		return size;
+
+	ret = nuxel_ssp_bringup_hw();
+	if (ret < 0) {
+		pr_err("[SSPBBD] Nuxel bring-up via sysfs failed: %d\n", ret);
+		return ret;
+	}
+
+	return size;
+}
+static DEVICE_ATTR(nuxel_bringup, 0200, NULL, set_nuxel_bringup);
+
+/*
+ * Nuxel PWNAGE-SSP: ask the kernel to start the accel+gyro stream after a
+ * successful bring-up.  Writing 1 returns 0 only when both sensors were
+ * actually added (their enable bits are set); anything else is the kernel's
+ * real error and the daemon must not claim auto-rotation capability.
+ */
+/*
+ * Nuxel PWNAGE-SSP: start the continuous accelerometer + gyroscope stream the
+ * same way an Android consumer does, but from the kernel.  initialize_mcu()
+ * only identifies the MCU and syncs calibration; the hub sends no sensor data
+ * until the AP adds the sensors with MSG2SSP_INST_BYPASS_SENSOR_ADD.  Without
+ * this, a healthy hub still leaves accelerometer_sensor/raw_data at 0,0,0.
+ *
+ * It grows aSensorEnable bit by bit and lets the normal enable_sensor() path
+ * run the vendor calibration hooks for each sensor, so the stream matches the
+ * sysfs "enable" write exactly.  Also unmasks the shub-int line, which
+ * ssp_probe() leaves disabled.
+ */
+static int nuxel_ssp_start_stream(struct ssp_data *data)
+{
+	const int sensors[] = { ACCELEROMETER_SENSOR, GYROSCOPE_SENSOR };
+	u64 bits = 0;
+	int i, ret;
+
+	if (!data || !data->bProbeIsDone)
+		return -ENODEV;
+
+	/* Both sensors must have been reported by the hub's scanning info. */
+	if (!(data->uSensorState & ((1ULL << ACCELEROMETER_SENSOR) |
+				    (1ULL << GYROSCOPE_SENSOR)))) {
+		pr_err("[SSPBBD] Nuxel stream: hub reports accel/gyro missing (0x%llx)\n",
+		       data->uSensorState);
+		return -ENODEV;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(sensors); i++) {
+		int type = sensors[i];
+
+		bits |= (1ULL << type);
+		mutex_lock(&data->enable_mutex);
+		atomic64_set(&data->aSensorEnable, bits);
+		data->aiCheckStatus[type] = ADD_SENSOR_STATE;
+		enable_sensor(data, type, data->adDelayBuf[type]);
+		mutex_unlock(&data->enable_mutex);
+		usleep_range(2000, 5000);
+	}
+
+	/* Leave shub-int armed for the hub's asynchronous data packets. */
+	enable_irq(data->irq_shub_int);
+
+	ret = ((atomic64_read(&data->aSensorEnable) & (1ULL << ACCELEROMETER_SENSOR)) &&
+	       (atomic64_read(&data->aSensorEnable) & (1ULL << GYROSCOPE_SENSOR))) ? 0 : -EIO;
+	pr_info("[SSPBBD] Nuxel stream: accel+gyro -> %d (enable=0x%llx)\n", ret,
+		(unsigned long long)atomic64_read(&data->aSensorEnable));
+	return ret;
+}
+
+static ssize_t set_nuxel_stream(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t size)
+{
+	int ret;
+
+	if (kstrtoint(buf, 10, &ret) < 0)
+		return -EINVAL;
+	if (ret != 1)
+		return size;
+
+	ret = nuxel_ssp_start_stream(dev_get_drvdata(dev));
+	if (ret < 0) {
+		pr_err("[SSPBBD] Nuxel stream start via sysfs failed: %d\n", ret);
+		return ret;
+	}
+
+	return size;
+}
+static DEVICE_ATTR(nuxel_stream, 0200, NULL, set_nuxel_stream);
 static DEVICE_ATTR(mcu_power, 0664, show_mcu_power, set_mcu_power);
 
 static DEVICE_ATTR(thermistor_channel_0, 0444, show_thermistor_channel0, NULL);
@@ -1051,6 +1179,9 @@ static struct device_attribute *mcu_attrs[] = {
 	&dev_attr_ssp_flush,
 	&dev_attr_data_injection_enable,
 	&dev_attr_sensor_state,
+	&dev_attr_nuxel_hub_diag,
+	&dev_attr_nuxel_bringup,
+	&dev_attr_nuxel_stream,
 	&dev_attr_ssp_control,
 	&dev_attr_sensor_dump,
 #if defined(CONFIG_SSP_REGISTER_RW)
diff --git a/drivers/spi/spi-s3c64xx.c b/drivers/spi/spi-s3c64xx.c
index 44be84ecc..b6f6034ba 100644
--- a/drivers/spi/spi-s3c64xx.c
+++ b/drivers/spi/spi-s3c64xx.c
@@ -1931,7 +1931,18 @@ static int s3c64xx_spi_runtime_suspend(struct device *dev)
 
 	s3c64xx_spi_pin_ctrl(dev, 0);
 
+	/*
+	 * Nuxel: a runtime suspend gates the clocks and the controller loses
+	 * its FIFO/mode configuration.  Mark it for re-initialisation so the
+	 * next transfer_one_message() re-runs s3c64xx_spi_hwinit() exactly as
+	 * the system-resume path already does.  Without this the GPS/SSP SPI
+	 * (spi17, 10970000.spi) reads 0xFF after the first idle and the
+	 * BCM47752 sensor hub appears dead.
+	 */
+	if (sci->domain == DOMAIN_TOP)
+		sci->need_hw_init = 1;
+
 	return 0;
 }
 
