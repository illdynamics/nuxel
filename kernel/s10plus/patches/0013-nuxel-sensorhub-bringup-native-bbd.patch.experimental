 	struct bcm_rxtx_work rx_work;
diff --git a/drivers/sensorhub/brcm/bbdpl/nuxel_ssp_variant_ctl.h b/drivers/sensorhub/brcm/bbdpl/nuxel_ssp_variant_ctl.h
new file mode 100644
index 000000000..918e1ebcc
--- /dev/null
+++ b/drivers/sensorhub/brcm/bbdpl/nuxel_ssp_variant_ctl.h
@@ -0,0 +1,18 @@
+/*
+ * Nuxel PWNAGE-SSP — kernel debug counters for the BBD/SSI transport.
+ *
+ * Read-only diagnostics: the userspace bridge prints these once per session
+ * so a silent hub is attributed to the right layer (transport work queue,
+ * transfer completion, or the MCU stream itself).
+ */
+#ifndef NUXEL_SSP_VARIANT_CTL_H
+#define NUXEL_SSP_VARIANT_CTL_H
+
+/* Incremented for every SPI message the ttyBCM work queue sends (SSI frames). */
+extern unsigned long ssp_bcm_spi_tx;
+/* Incremented for every SPI message the ttyBCM work queue receives. */
+extern unsigned long ssp_bcm_spi_rx;
+/* IRQ enable/disable imbalance attempts on the shared host-req line. */
+extern unsigned long ssp_bcm_irq_count;
+
+#endif
diff --git a/drivers/sensorhub/brcm/factory/gyro_lsm6dsl.c b/drivers/sensorhub/brcm/factory/gyro_lsm6dsl.c
index cdbf5eaf9..bd0bf36c8 100644
--- a/drivers/sensorhub/brcm/factory/gyro_lsm6dsl.c
+++ b/drivers/sensorhub/brcm/factory/gyro_lsm6dsl.c
@@ -672,6 +672,27 @@ static DEVICE_ATTR(selftest_dps, 0660,
 static DEVICE_ATTR(calibration_info, 0440, gyro_calibration_info_show, NULL);
 static DEVICE_ATTR(selftest_revised, 0440, selftest_revised_show, NULL);
 
+/*
+ * Nuxel PWNAGE-SSP: expose the live gyroscope sample through sysfs, matching
+ * accelerometer_sensor/raw_data.  Before this there was no readable live gyro
+ * value at all on the sensor class node.  Values are raw int32 LSBs from the
+ * hub stream (LSM6DSO, 2000 dps range); zero means "not streaming", which is
+ * exactly what an honest consumer must see.
+ */
+static ssize_t gyro_raw_data_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct ssp_data *data = dev_get_drvdata(dev);
+	struct sensor_value value;
+
+	memset(&value, 0, sizeof(value));
+	/* buf[] is updated by the SSP packet worker; copy once, atomically. */
+	value = data->buf[GYROSCOPE_SENSOR];
+
+	return sprintf(buf, "%d,%d,%d\n", value.gyro.x, value.gyro.y, value.gyro.z);
+}
+static DEVICE_ATTR(raw_data, 0444, gyro_raw_data_show, NULL);
+
 static struct device_attribute *gyro_attrs[] = {
 	&dev_attr_name,
 	&dev_attr_vendor,
@@ -682,6 +703,7 @@ static struct device_attribute *gyro_attrs[] = {
 	&dev_attr_selftest_dps,
 	&dev_attr_calibration_info,
 	&dev_attr_selftest_revised,
+	&dev_attr_raw_data,
 	NULL,
 };
 
diff --git a/drivers/sensorhub/brcm/ssp.h b/drivers/sensorhub/brcm/ssp.h
index 220961390..0ed3cbffd 100644
--- a/drivers/sensorhub/brcm/ssp.h
+++ b/drivers/sensorhub/brcm/ssp.h
@@ -1052,6 +1052,15 @@ extern void bcm4773_debug_info(void);
 void clean_pending_list(struct ssp_data *data);
 void toggle_mcu_reset(struct ssp_data *data);
 int initialize_mcu(struct ssp_data *data);
+
+/* Nuxel PWNAGE-SSP: native (non-lhd) sensor-hub bring-up. */
+void nuxel_ssp_register_data(struct ssp_data *data);
+int nuxel_ssp_bringup_hw(void);
+int bbd_nuxel_peer_open(void);
+int bbd_nuxel_peer_release(void);
+int bbd_nuxel_peer_active(void);
+ssize_t bbd_nuxel_peer_rx(const u8 *buf, size_t size);
+void nuxel_ssp_bcm_diag(void);
 int initialize_input_dev(struct ssp_data *data);
 int initialize_sysfs(struct ssp_data *data);
 void initialize_function_pointer(struct ssp_data *data);
diff --git a/drivers/sensorhub/brcm/ssp_bbd.c b/drivers/sensorhub/brcm/ssp_bbd.c
index 8987fc69f..770988883 100644
--- a/drivers/sensorhub/brcm/ssp_bbd.c
+++ b/drivers/sensorhub/brcm/ssp_bbd.c
@@ -47,6 +47,139 @@ enum packet_state_e {
 	WAITFOR_PKT_COMPLETE
 };
 
+/*
+ * Nuxel PWNAGE-SSP: honest debug counters for the native BBD bridge.
+ * They are printed once per session; a zero transfer count with a live MCU
+ * stream means the ttyBCM work queue is not being kicked by the hub IRQ.
+ */
+unsigned long ssp_bcm_spi_tx;
+unsigned long ssp_bcm_spi_rx;
+unsigned long ssp_bcm_irq_count;
+
+static struct ssp_data *nuxel_ssp_data;
+
+/* Nuxel PWNAGE-SSP: native BBD peer (see definition below). */
+int callback_bbd_on_packet(void *ssh_data, const char *buf, size_t size);
+int bbd_nuxel_peer_open(void);
+int bbd_nuxel_peer_release(void);
+int bbd_nuxel_peer_active(void);
+ssize_t bbd_nuxel_peer_rx(const u8 *buf, size_t size);
+ssize_t bbd_on_read_nuxel_peer(const unsigned char *buf, size_t size);
+
+/*
+ * Nuxel PWNAGE-SSP: install the SSP device for the native bring-up path.
+ * Called once from ssp_probe() after bProbeIsDone is set.  The vendor path
+ * learns the pointer from BBD callbacks (lhd-driven); the native path has no
+ * such driver, so probe success is the right place.
+ */
+void nuxel_ssp_register_data(struct ssp_data *data)
+{
+	if (!data)
+		return;
+	nuxel_ssp_data = data;
+	pr_info("[SSPBBD] Nuxel bring-up target registered (%s probe=%d)\n",
+		"ssp", !!data->bProbeIsDone);
+}
+EXPORT_SYMBOL_GPL(nuxel_ssp_register_data);
+
+/*
+ * Bring the sensor hub out of the post-probe shutdown state without the
+ * Android vendor lhd daemon.  This performs only the kernel's own documented
+ * bring-up sequence (enable + initialize_mcu).  It returns the real result of
+ * initialize_mcu(); it never reports success for a silent hub.
+ */
+int nuxel_ssp_bringup_hw(void)
+{
+	struct ssp_data *data = nuxel_ssp_data;
+	int ret;
+
+	if (!data) {
+		pr_err("[SSPBBD] Nuxel bring-up: SSP device not registered\n");
+		return -ENODEV;
+	}
+	if (!data->bProbeIsDone) {
+		pr_err("[SSPBBD] Nuxel bring-up: probe not complete\n");
+		return -EAGAIN;
+	}
+	if (data->resetting) {
+		pr_err("[SSPBBD] Nuxel bring-up: MCU is already resetting\n");
+		return -EBUSY;
+	}
+
+	clean_pending_list(data);
+	/*
+	 * Bring-up is an explicit recovery point: force the transport up even
+	 * if a previous failed attempt left bSspShutdown set, otherwise every
+	 * later message is refused with "ssp_down == true" and the retry loop
+	 * can never recover.  Also clear the reset flag the failed handshake
+	 * raises (bbd_mcu_reset -> callback_bbd_on_mcu_reset).
+	 */
+	data->resetting = false;
+	/*
+	 * Keep the cached shutdown state truthful and let ssp_enable() own the
+	 * shub-int line exactly once.  (Forcing bSspShutdown=true here caused a
+	 * second, unbalanced enable_irq("Unbalanced enable for IRQ 443").)
+	 */
+	if (data->bSspShutdown)
+		ssp_enable(data, true);
+
+	/*
+	 * The AP->MCU frames are delivered asynchronously to /dev/bbd_sensor.
+	 * Give the attached peer a moment to start its read loop so the first
+	 * WHOAMI is not queued before anyone can consume it (a userspace peer
+	 * cannot be scheduled from inside this syscall).
+	 */
+	if (bbd_nuxel_peer_active())
+		msleep(150);
+
+	ret = initialize_mcu(data);
+	pr_err("[SSPBBD] Nuxel bring-up: initialize_mcu -> %d\n", ret);
+	if (ret == SUCCESS) {
+		sync_sensor_state(data);
+		ssp_sensorhub_report_notice(data, MSG2SSP_AP_STATUS_RESET);
+		return 0;
+	}
+
+	/*
+	 * The hub did not complete the AP handshake.  The most common cause on
+	 * this board is that a previous failed attempt (or the vendor reset
+	 * request the BBD transport still raises) left the MCU halted, so it
+	 * stops answering even its MCU_REQ line.  A full rail power-cycle is the
+	 * documented recovery for a halted BCM4775x: drop vdd_mcu_1p8, wait for
+	 * the rail to actually fall, bring it back and let the MCU boot again.
+	 * Only attempt this when we own the rail; otherwise report the honest
+	 * error and let userspace retry.
+	 */
+	if (data->regulator_vdd_mcu_1p8 &&
+	    !IS_ERR(data->regulator_vdd_mcu_1p8)) {
+		pr_err("[SSPBBD] Nuxel bring-up: retrying after MCU power-cycle\n");
+		if (regulator_is_enabled(data->regulator_vdd_mcu_1p8))
+			regulator_disable(data->regulator_vdd_mcu_1p8);
+		msleep(120);
+		ret = regulator_enable(data->regulator_vdd_mcu_1p8);
+		pr_info("[SSPBBD] Nuxel bring-up: vdd_mcu_1p8 re-enabled -> %d (enabled=%d)\n",
+			ret, regulator_is_enabled(data->regulator_vdd_mcu_1p8));
+		msleep(300);	/* MCU boot time after rail settle */
+
+		clean_pending_list(data);
+		data->resetting = false;
+		if (data->bSspShutdown)
+			ssp_enable(data, true);
+		ret = initialize_mcu(data);
+		pr_err("[SSPBBD] Nuxel bring-up: initialize_mcu after power-cycle -> %d\n",
+		       ret);
+		if (ret == SUCCESS) {
+			sync_sensor_state(data);
+			ssp_sensorhub_report_notice(data, MSG2SSP_AP_STATUS_RESET);
+			return 0;
+		}
+	}
+
+	data->resetting = false;
+	ssp_enable(data, false);
+	return -EIO;
+}
