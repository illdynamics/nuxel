diff --git a/drivers/sensorhub/brcm/bbdpl/bbd.c b/drivers/sensorhub/brcm/bbdpl/bbd.c
index 0b607aa87..337baefbb 100644
--- a/drivers/sensorhub/brcm/bbdpl/bbd.c
+++ b/drivers/sensorhub/brcm/bbdpl/bbd.c
@@ -31,6 +31,7 @@
 #include <linux/of.h>
 #include <linux/string.h>
 #include <linux/sched/signal.h>	/* For send_sig(), same_thread_group(), etc. */
+#include "../ssp.h"
 #include "bbd.h"
 
 #ifdef CONFIG_SENSORS_SSP
@@ -372,6 +373,16 @@ EXPORT_SYMBOL(bbd_register);
  * @size: size of sensor packet
  * @return: pushed data length = success
  */
+/*
+ * Nuxel PWNAGE-SSP: push a pre-framed packet ([u16 size][bytes]) into
+ * /dev/bbd_sensor for the attached native peer.
+ */
+ssize_t bbd_on_read_nuxel_peer(const unsigned char *buf, size_t size)
+{
+	return bbd_on_read(BBD_MINOR_SENSOR, buf, size);
+}
+EXPORT_SYMBOL_GPL(bbd_on_read_nuxel_peer);
+
 ssize_t bbd_send_packet(unsigned char *buf, size_t size)
 {
 	struct sensor_pkt {
@@ -385,6 +396,15 @@ ssize_t bbd_send_packet(unsigned char *buf, size_t size)
 #ifdef DEBUG_1HZ_STAT
 	bbd_update_stat(STAT_TX_SSP, size);
 #endif
+	/*
+	 * Nuxel PWNAGE-SSP: with a native peer attached the payload travels in
+	 * the same frame (nuxel_bbd_peer_send), so do not also queue the bare
+	 * header in ttyBCM's read buffer.  That buffer belongs to the SSI
+	 * stream, not to the userspace peer.
+	 */
+	if (bbd_nuxel_peer_active())
+		return size;
+
 	return bbd_on_read(BBD_MINOR_SENSOR, (unsigned char *)&pkt, size + 2); /* +2 for pkt.size */
 }
 EXPORT_SYMBOL(bbd_send_packet);
@@ -605,6 +625,8 @@ int bbd_common_open(struct inode *inode, struct file *filp)
 		bbd.lk.lhd = current;
 		bbd.lk.resetting = false;
 		spin_unlock(&bbd.lk.lock);
+		/* Nuxel PWNAGE-SSP: a native peer now owns the AP<->MCU frames. */
+		bbd_nuxel_peer_open();
 	}
 	return 0;
 }
@@ -624,6 +646,7 @@ static int bbd_common_release(struct inode *inode, struct file *filp)
 		spin_lock(&bbd.lk.lock);
 		bbd.lk.lhd = NULL;
 		spin_unlock(&bbd.lk.lock);
+		bbd_nuxel_peer_release();
 	}
 	pr_info("%s[%s]--\n", __func__, bbd.priv[minor].name);
 	return 0;
@@ -691,6 +714,15 @@ static ssize_t bbd_common_write(struct file *filp, const char __user *buf, size_
 #ifdef DEBUG_1HZ_STAT
 	bbd_update_stat(STAT_TX_LHD, size);
 #endif
+	/*
+	 * Nuxel PWNAGE-SSP: with the native peer attached, writes to
+	 * /dev/bbd_sensor are MCU->AP frames (what lhd used to unwrap from its
+	 * RPC and hand to bbd_sensor_write()).  Deliver them to the SSP state
+	 * machine now, exactly once.
+	 */
+	if (minor == BBD_MINOR_SENSOR && bbd_nuxel_peer_active())
+		return bbd_nuxel_peer_rx(bbd.priv[minor].write_buf, size);
+
 	return size;
 }
 
@@ -1201,7 +1233,12 @@ static const struct file_operations bbd_fops[BBD_DEVICE_INDEX] = {
 		.open		=  bbd_common_open,
 		.release	=  bbd_common_release,
 		.read		=  bbd_common_read,
-		.write		=  NULL,
+		/*
+		 * Nuxel: the native peer injects MCU->AP frames here (what lhd
+		 * used to pass to bbd_sensor_write()).  Without this the node is
+		 * not writable at all and the bridge gets -EAGAIN.
+		 */
+		.write		=  bbd_common_write,
 		.poll		=  bbd_common_poll,
 	},
 	/* bbd control file operations */
