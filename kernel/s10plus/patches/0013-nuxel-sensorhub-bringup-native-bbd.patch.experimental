+++ b/drivers/sensorhub/brcm/bbdpl/bcm_gps_mem.c
@@ -202,12 +202,7 @@ void bcm_failsafe_mem_read(struct bcm_spi_priv *priv)
 
 	atomic_set(&priv->suspending, 0);
 
-	/* Enable irq */
-	spin_lock_irqsave(&priv->irq_lock, flags);
-	if (!atomic_xchg(&priv->irq_enabled, 1))
-		enable_irq(priv->spi->irq);
-
-	spin_unlock_irqrestore(&priv->irq_lock, flags);     
+	/* Nuxel: leave the shared host-req IRQ at its surviving depth. */
 
 	pr_info("[SSPBBD]: %s --\n", __func__);
 }    
diff --git a/drivers/sensorhub/brcm/bbdpl/bcm_gps_spi.c b/drivers/sensorhub/brcm/bbdpl/bcm_gps_spi.c
index a202ec60e..ef1771c11 100644
--- a/drivers/sensorhub/brcm/bbdpl/bcm_gps_spi.c
+++ b/drivers/sensorhub/brcm/bbdpl/bcm_gps_spi.c
@@ -43,8 +43,13 @@
 
 #include "bbd.h"
 #include "bcm_gps_spi.h"
+#include "nuxel_ssp_variant_ctl.h"
+#include "../ssp.h"
 
 
+struct bcm_spi_priv;
+static void bcm477x_bye(struct bcm_spi_priv *priv);
+
 #ifdef CONFIG_SENSORS_SSP_BBD
 extern void bbd_parse_asic_data(unsigned char *pucData, unsigned short usLen,
 		void (*to_gpsd)(unsigned char *packet, unsigned short len, void *priv), void *priv);
@@ -234,14 +239,13 @@ static int bcm_spi_open(struct inode *inode, struct file *filp)
 
 	priv->packet_received = 0;
 
-	/* Enable irq */
-	spin_lock_irqsave(&priv->irq_lock, flags);
-	if (!atomic_xchg(&priv->irq_enabled, 1))
-		enable_irq(priv->spi->irq);
-
-	spin_unlock_irqrestore(&priv->irq_lock, flags);
-
-	enable_irq_wake(priv->spi->irq);
+	/*
+	 * Nuxel: probe leaves the shared host-req IRQ at disable depth 1
+	 * (disabled_irq).  Take exactly one more reference so the line is armed
+	 * for this open session; do not assume any extra nesting.
+	 */
+	atomic_set(&priv->irq_enabled, 1);
+	enable_irq(priv->spi->irq);
 
 	filp->private_data = priv;
 #ifdef DEBUG_1HZ_STAT
@@ -348,14 +352,16 @@ static int bcm_spi_release(struct inode *inode, struct file *filp)
 #ifdef DEBUG_1HZ_STAT
 	bbd_disable_stat();
 #endif
-	/* Disable irq */
-	spin_lock_irqsave(&priv->irq_lock, flags);
+	/*
+	 * Nuxel: drop the single reference taken by open and leave the line at
+	 * the probe-time disabled depth (disabled_irq).  Use the synchronous
+	 * variant so a handler in flight cannot run after release.
+	 */
 	if (atomic_xchg(&priv->irq_enabled, 0))
-		disable_irq_nosync(priv->spi->irq);
-
-	spin_unlock_irqrestore(&priv->irq_lock, flags);
+		disable_irq(priv->spi->irq);
 
-	disable_irq_wake(priv->spi->irq);
+	/* Let the hub sleep again once no peer owns the SSI stream. */
+	bcm477x_bye(priv);
 
 	pr_info("%s--\n", __func__);
 	return 0;
@@ -643,6 +649,10 @@ int bcm_spi_sync(struct bcm_spi_priv *priv, void *tx_buf, void *rx_buf, int len,
 	/* Sync */
 	pk_log("w", (unsigned char *)xfer.tx_buf, len);
 	ret = spi_sync(msg.spi, &msg);
+	if (tx_buf == priv->tx_buf)
+		ssp_bcm_spi_tx++;
+	else
+		ssp_bcm_spi_rx++;
 	pk_log("r", (unsigned char *)xfer.rx_buf, len);
 
 	if (ret)
@@ -858,6 +868,18 @@ void bcm_on_packet_received(void *_priv, unsigned char *data, unsigned int size)
 	struct circ_buf *rd_circ = &priv->read_buf;
 	size_t written = 0, avail = size;
 
+	/*
+	 * Nuxel PWNAGE-SSP: with a native BBD peer attached, the SSI reply is a
+	 * direct AP<->MCU exchange.  Hand it to the SSP state machine right away
+	 * instead of queueing it in ttyBCM's read buffer: the peer is waiting
+	 * for it inside its own read, and both paths would otherwise consume
+	 * (or stall) the same bytes.
+	 */
+	if (bbd_nuxel_peer_active()) {
+		bbd_nuxel_peer_rx(data, size);
+		return;
+	}
+
 	//pr_info("[SSPBBD]: %s ++\n", __func__);
 	/* Copy into circ buffer */
 	mutex_lock(&priv->rlock);
@@ -881,6 +903,34 @@ void bcm_on_packet_received(void *_priv, unsigned char *data, unsigned int size)
 	//pr_info("[SSPBBD]: %s received -- (%d bytes)\n", __func__, size);
 }
 
+/*
+ * Nuxel PWNAGE-SSP: one-line transport truth.  Prints the MCU handshake pins,
+ * IRQ state/counts and real SSI transfer counts so a stopped stream can be
+ * attributed to the hub, the IRQ or the SPI bus instead of guessed.
+ */
+void nuxel_ssp_bcm_diag(void)
+{
+	int irq_enabled = -1, irq_count = -1;
+	int pin_host = -1, pin_req = -1, pin_resp = -1;
+
+	if (g_bcm_gps) {
+		irq_enabled = atomic_read(&g_bcm_gps->irq_enabled);
+		irq_count = kstat_irqs_cpu(g_bcm_gps->spi->irq, 0);
+		pin_host = gpio_get_value(g_bcm_gps->host_req);
+		pin_req = gpio_get_value(g_bcm_gps->mcu_req);
+		pin_resp = gpio_get_value(g_bcm_gps->mcu_resp);
+	}
+	pr_info("[SSPBBD] nuxel diag: host_req=%d mcu_req=%d mcu_resp=%d irq_en=%d irq_cnt=%d tx=%lu rx=%lu\n",
+		pin_host, pin_req, pin_resp, irq_enabled, irq_count,
+		ssp_bcm_spi_tx, ssp_bcm_spi_rx);
+}
+EXPORT_SYMBOL_GPL(nuxel_ssp_bcm_diag);
+
+/* Nuxel: rate-limited reset bookkeeping for the hello-timeout path. */
+#define NUXEL_HELLO_RESET_INTERVAL	(30 * HZ)
+static unsigned int nuxel_hello_reset_requested;
+static unsigned long nuxel_hello_reset_refused;
+
 static void bcm_rxtx_work_func(struct work_struct *work)
 {
 #ifdef DEBUG_1HZ_STAT
@@ -894,10 +944,26 @@ static void bcm_rxtx_work_func(struct work_struct *work)
 	unsigned short rx_pckt_len = priv->rx_strm.pckt_len;
 
 	if (!bcm477x_hello(priv)) {
-		pr_err("[SSPBBD]: %s[%s] timeout!!\n", __func__,
-				bcm_work->type == WORK_TYPE_RX ? "RX WORK" : "TX WORK");
+		/*
+		 * Nuxel: the hub did not answer MCU_REQ.  On the Android stack lhd
+		 * reboots the whole MCU here, which is why the vendor code raises a
+		 * reset on every failed work run.  Under the native bridge that turns
+		 * an unresponsive hub into a reset loop: every bring-up attempt
+		 * re-triggers a reset before it can report a truthful result.
+		 * Rate-limit the reset and always keep the diagnostic line, so the
+		 * caller sees "hub not responding" instead of a busy reset.
+		 */
+		pr_err("[SSPBBD]: %s[%s] timeout!! (reset requested=%u, refused=%lu)\n", __func__,
+				bcm_work->type == WORK_TYPE_RX ? "RX WORK" : "TX WORK",
+				nuxel_hello_reset_requested, nuxel_hello_reset_refused);
 		bcm4773_debug_info();
-		bbd_mcu_reset(true);
+		if (time_after(jiffies, priv->nuxel_last_reset_jiffies + NUXEL_HELLO_RESET_INTERVAL)) {
+			priv->nuxel_last_reset_jiffies = jiffies;
+			nuxel_hello_reset_requested++;
+			bbd_mcu_reset(true);
+		} else {
+			nuxel_hello_reset_refused++;
+		}
 		return;
 	}
 
@@ -1176,8 +1242,14 @@ static int bcm_spi_probe(struct spi_device *spi)
 		goto err_exit;
 	}
 
-	/* Check IRQ# */
+	/*
+	 * Nuxel PWNAGE-SSP: this SPI node is bound to the SSP/GNSS host-request
+	 * line.  Never trust an inherited or probe-time-only SPI IRQ number
+	 * (the DT `interrupts` cell is 0 on this board); derive the *host_req*
+	 * GPIO IRQ dynamically.  The i2c fallback is compiled out for this port.
+	 */
 	spi->irq = gpio_to_irq(host_req);
+	pr_info("[SSPBBD] Nuxel: ttyBCM IRQ = gpio_to_irq(%d) = %d\n", host_req, spi->irq);
 	if (spi->irq < 0) {
 		pr_err("[SSPBBD]: irq=%d for host_req=%d not correct\n", spi->irq, host_req);
 		goto err_exit;
@@ -1312,6 +1384,9 @@ static int bcm_spi_probe(struct spi_device *spi)
 	priv->mcu_req  = mcu_req;
 	priv->mcu_resp = mcu_resp;
 
+	/* Nuxel: allow the first hello timeout to request a reset immediately. */
+	priv->nuxel_last_reset_jiffies = jiffies - NUXEL_HELLO_RESET_INTERVAL;
+
 	/* Init - etc */
 	wake_lock_init(&priv->bcm_wake_lock, WAKE_LOCK_SUSPEND, "bcm_spi_wake_lock");
 
@@ -1351,12 +1426,12 @@ static int bcm_spi_remove(struct spi_device *spi)
 
 	atomic_set(&priv->suspending, 1);
 
-	/* Disable irq */
-	spin_lock_irqsave(&priv->irq_lock, flags);
+	/*
+	 * Nuxel: the line is at the probe-time disabled depth already when no
+	 * user owns it; only drop the extra depth taken by an open session.
+	 */
 	if (atomic_xchg(&priv->irq_enabled, 0))
-		disable_irq_nosync(spi->irq);
-
-	spin_unlock_irqrestore(&priv->irq_lock, flags);
+		disable_irq(spi->irq);
 
 	/* Flush work */
 	flush_workqueue(priv->serial_wq);
diff --git a/drivers/sensorhub/brcm/bbdpl/bcm_gps_spi.h b/drivers/sensorhub/brcm/bbdpl/bcm_gps_spi.h
index 4fb8ab7b9..a87c294ca 100644
