diff --git a/fs/stat.c b/fs/stat.c
index 873785dae..d092f055f 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -20,6 +20,7 @@
 
 #include <linux/uaccess.h>
 #include <asm/unistd.h>
+#include "mount.h"
 
 /**
  * generic_fillattr - Fill in the basic attributes from the inode struct
@@ -73,13 +74,28 @@ int vfs_getattr_nosec(const struct path *path, struct kstat *stat,
 
 	memset(stat, 0, sizeof(*stat));
 	stat->result_mask |= STATX_BASIC_STATS;
-	request_mask &= STATX_ALL;
+	request_mask &= STATX_ALL | STATX_MNT_ID | STATX_MNT_ID_UNIQUE;
 	query_flags &= KSTAT_QUERY_FLAGS;
-	if (inode->i_op->getattr)
-		return inode->i_op->getattr(path, stat, request_mask,
-					    query_flags);
-
-	generic_fillattr(inode, stat);
+	if (inode->i_op->getattr) {
+		int err = inode->i_op->getattr(path, stat, request_mask,
+					       query_flags);
+		if (err)
+			return err;
+	} else {
+		generic_fillattr(inode, stat);
+	}
+	/*
+	 * NUXEL: 4.14's statx predates STATX_MNT_ID.  Flatpak 1.16 and modern
+	 * bubblewrap require the mount id to distinguish bind mounts, and fail
+	 * with "statx didn't return all required fields" without it.  The
+	 * namespace already assigns a unique mnt_id for /proc/self/mountinfo;
+	 * expose that same id here (and satisfy the newer UNIQUE request bit).
+	 */
+	if (request_mask & (STATX_MNT_ID | STATX_MNT_ID_UNIQUE)) {
+		stat->mnt_id = real_mount(path->mnt)->mnt_id;
+		stat->result_mask |= request_mask &
+			(STATX_MNT_ID | STATX_MNT_ID_UNIQUE);
+	}
 	return 0;
 }
 EXPORT_SYMBOL(vfs_getattr_nosec);
@@ -530,6 +546,7 @@ cp_statx(const struct kstat *stat, struct statx __user *buffer)
 	tmp.stx_size = stat->size;
 	tmp.stx_blocks = stat->blocks;
 	tmp.stx_attributes_mask = stat->attributes_mask;
+	tmp.stx_mnt_id = stat->mnt_id;
 	tmp.stx_atime.tv_sec = stat->atime.tv_sec;
 	tmp.stx_atime.tv_nsec = stat->atime.tv_nsec;
 	tmp.stx_btime.tv_sec = stat->btime.tv_sec;
diff --git a/include/linux/stat.h b/include/linux/stat.h
index 22484e445..46bffe282 100644
--- a/include/linux/stat.h
+++ b/include/linux/stat.h
@@ -46,6 +46,7 @@ struct kstat {
 	struct timespec	ctime;
 	struct timespec	btime;			/* File creation time */
 	u64		blocks;
+	u64		mnt_id;
 };
 
 #endif
diff --git a/include/uapi/linux/stat.h b/include/uapi/linux/stat.h
index 7b35e98d3..2e74fa788 100644
--- a/include/uapi/linux/stat.h
+++ b/include/uapi/linux/stat.h
@@ -123,7 +123,8 @@ struct statx {
 	__u32	stx_dev_major;	/* ID of device containing file [uncond] */
 	__u32	stx_dev_minor;
 	/* 0x90 */
-	__u64	__spare2[14];	/* Spare space for future expansion */
+	__u64	stx_mnt_id;	/* Mount ID */
+	__u64	__spare2[13];	/* Spare space for future expansion */
 	/* 0x100 */
 };
 
@@ -148,6 +149,8 @@ struct statx {
 #define STATX_BLOCKS		0x00000400U	/* Want/got stx_blocks */
 #define STATX_BASIC_STATS	0x000007ffU	/* The stuff in the normal stat struct */
 #define STATX_BTIME		0x00000800U	/* Want/got stx_btime */
+#define STATX_MNT_ID		0x00001000U	/* Want/got stx_mnt_id */
+#define STATX_MNT_ID_UNIQUE	0x00004000U	/* Want/got unique stx_mnt_id */
 #define STATX_ALL		0x00000fffU	/* All currently supported flags */
 #define STATX__RESERVED		0x80000000U	/* Reserved for future struct statx expansion */
 
