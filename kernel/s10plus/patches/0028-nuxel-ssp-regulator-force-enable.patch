index f1b7b7c1c422..c35d052f3ad0 100644
--- a/drivers/sensorhub/brcm/ssp_sysfs.c
+++ b/drivers/sensorhub/brcm/ssp_sysfs.c
@@ -593,7 +593,7 @@ static ssize_t set_mcu_power(struct device *dev,
 			 * symmetric regulator_force_enable() to physically re-raise
