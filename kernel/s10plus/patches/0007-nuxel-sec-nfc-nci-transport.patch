+ * (sec_nfc) instead of leaving a dead nfc0 registered.
+ */
+struct s3fwrn5_bootinfo {
+	u8 hw_version[4];
+	u32 sector_size;
+	u16 page_size;
+	u16 frame_max_size;
+	u8 reserved0;
+	u8 reserved1[4];
+	u32 hw_buffer_size;
+	u8 reserved2[4];
