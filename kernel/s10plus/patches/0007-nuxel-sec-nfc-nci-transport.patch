+	u8 body[sizeof(*info)];
+	size_t want;
+	int ret;
+
+	ret = i2c_master_recv(phy->i2c_dev, (u8 *)&rsp, sizeof(rsp));
+	if (ret != sizeof(rsp))
+		return ret < 0 ? ret : -EBADMSG;
