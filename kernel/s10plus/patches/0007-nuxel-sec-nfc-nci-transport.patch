+	/*
+	 * The RSP type carries the alternating parity bit, exactly the same
+	 * convention as the command frames (bit 7 toggles per message).  Only
+	 * the low 7 bits identify the message class.
+	 */
+	if ((rsp.type & 0x7f) != S3FWRN5_FW_MSG_RSP)
+		return -EPROTO;
+	if (rsp.len > sizeof(body) || rsp.len < sizeof(u32))
+		return -EPROTO;
+
+	want = rsp.len;
+	memset(body, 0, sizeof(body));
+	if (want) {
+		ret = i2c_master_recv(phy->i2c_dev, body, want);
+		if (ret != (int)want)
+			return ret < 0 ? ret : -EBADMSG;
+	}
