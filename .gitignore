# =============================================================================
# Nuxel Phone OS — .gitignore
#
# This repository is SOURCE-ONLY. Commit sources, scripts, configs, docs and
# the canonical single-source media assets. Everything that is generated by a
# build, pulled from a device, or produced by a VM run is ignored here.
#
#   images/build.sh      -> build/{out,output,boot-artifact}/ + boot/boot.img/
#   kernel/build-kernel.sh -> kernel/*/.build/ (shallow clone + compiled tree)
#   firmware/*/install-firmware.sh --*pull -> firmware/*/blobs/vendor-*/
#   vm/nuxel-vm-bootstrap.sh -> artifacts/, *.qcow2, VM logs/screenshots
# =============================================================================

# --- Tooling / OS / editor junk ---------------------------------------------
.codeseeq/
.DS_Store
**/.DS_Store
Thumbs.db
._*
__pycache__/
*.py[cod]
*.pyo
.env
.env.*
.qq
.qq/**

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
*.egg-info/

# Temp / backup / editor files
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# --- Build tree (fully regenerable) -----------------------------------------
# dist/ is produced by tools/package-release.sh (release asset staging).
dist/
# build/out/<device>/, build/output/, build/boot-artifact/ (Image.gz +
# initramfs.cpio.gz) and build/native-shell/ are all produced by a build.
build/

# --- Boot artifacts (produced by images/build.sh) ---------------------------
# boot/boot.img/ is the packaged boot-artifact directory: the kernel Image.gz,
# the device trees, the unpacked kernel modules and the initramfs. Regenerable.
boot/boot.img/Image.gz
boot/boot.img/Image
boot/boot.img/boot.img
boot/boot.img/initramfs.cpio.gz
boot/boot.img/all.dtb
boot/boot.img/*.dtb
boot/boot.img/*.img
boot/boot.img/modules/
boot/initramfs/*.cpio.gz

# G7 Power lk2nd boot window: shallow clone + downloaded/prebuilt images.
boot/g7power/lk2nd/.build/
boot/g7power/lk2nd/*.img

# Any stray initramfs image anywhere in the tree.
**/*.cpio.gz

# --- Kernel build trees (shallow clones + compiled output) ------------------
# Wildcarded per device: kernel/<device>/.build/. Kept out of the index (a
# gitlink there previously broke "git add -A" with a submodule-mapping error).
kernel/.build/
kernel/.build-log/
kernel/*/.build/
kernel/*/.build-log/

# --- VM / UTM artifacts (large and/or regenerable) --------------------------
# VM disk images, UTM bundles, EFI blobs and the generated cloud-init ISO.
artifacts/
vm/logs/
vm/screenshots/
vm/utm/
*.qcow2
*.qcow
*.fd
*.iso
*.img

# --- Vendor firmware blobs (device-proprietary, pulled via adb) -------------
# Keeps blobs/README.md + .gitkeep; ignores the pulled blob trees.
firmware/*/blobs/vendor-firmware/
firmware/*/blobs/vendor-firmware-mnt/
firmware/*/blobs/vendor-modules/
firmware/*/blobs/vendor-etc-firmware/
firmware/*/blobs/system-lib64/

# --- Scratch / working output ----------------------------------------------
# finish2/ is a working dir of unpacked initramfs trees; the images and the
# tree/ copies are regenerable.
finish2/*.cpio.gz
finish2/tree*/
finish2/mods/

# Kernel modules (compiled) and logs.
*.ko
*.log
trace.log

# --- Single-source PWA assets (briq-23 / briq-as1) --------------------------
# The canonical media lives once in assets/. The boot animation
# (nuxel-boot-animation.mp4) IS checked in (canonical + per-app copies — see
# the note in assets/). The wallpaper is copied into each app at build time by
# tools/dedupe-assets.sh, so those per-app copies are NEVER committed.
pwa/**/assets/nuxel-background.png
