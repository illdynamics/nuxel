--- /dev/null
+++ b/heimdall/source/NuxelExitCodes.h
@@ -0,0 +1,58 @@
+/* Nuxel additions to Heimdall v2.2.2 -- see NUXEL-README.md
+ *
+ * Stable exit codes so the Nuxel wrapper (and CI) can act on the *class* of
+ * failure instead of grepping English error text. Upstream Heimdall only ever
+ * returns 0 or 1 for `flash`.
+ */
+#ifndef NUXELEXITCODES_H
+#define NUXELEXITCODES_H
+
+#include "NuxelSession.h"
+
+namespace Heimdall
+{
+	enum
+	{
+		kNuxelExitSuccess                  = 0,
+		kNuxelExitGenericFailure           = 1,
+
+		kNuxelExitNoDevice                 = 10,
+		kNuxelExitInitialiseFailed         = 11,
+		kNuxelExitBeginSessionFailed       = 12,
+
+		kNuxelExitEndSessionSendFailed     = 13,
+		kNuxelExitEndSessionTimeout        = 14,
+		kNuxelExitEndSessionDisconnect     = 15,
+		kNuxelExitEndSessionMalformed      = 16,
+		kNuxelExitEndSessionRejected       = 17,
+		kNuxelExitEndSessionTransportError = 18,
+		kNuxelExitRebootTimeout            = 19,
+		kNuxelExitRebootDisconnect         = 20,
+		kNuxelExitStillInDownloadMode      = 21,
+
+		kNuxelExitFlashStepFailed          = 22,
+		kNuxelExitInternalError            = 23
+	};
+
+	inline int NuxelExitCodeForFailure(SessionFailure failure)
+	{
+		switch (failure)
+		{
+			case kSessionFailureNone:                 return (kNuxelExitSuccess);
+			case kSessionFailureSendFailed:           return (kNuxelExitEndSessionSendFailed);
+			case kSessionFailureTimeout:              return (kNuxelExitEndSessionTimeout);
+			case kSessionFailureDisconnected:         return (kNuxelExitEndSessionDisconnect);
+			case kSessionFailureMalformedPacket:      return (kNuxelExitEndSessionMalformed);
+			case kSessionFailureUnexpectedResponse:   return (kNuxelExitEndSessionRejected);
+			case kSessionFailureTransportError:       return (kNuxelExitEndSessionTransportError);
+			case kSessionFailureRebootTimeout:        return (kNuxelExitRebootTimeout);
+			case kSessionFailureRebootDisconnected:   return (kNuxelExitRebootDisconnect);
+			case kSessionFailureStillInDownloadMode:  return (kNuxelExitStillInDownloadMode);
+			case kSessionFailureInternal:             return (kNuxelExitInternalError);
+		}
+
+		return (kNuxelExitGenericFailure);
+	}
+}
+
+#endif
