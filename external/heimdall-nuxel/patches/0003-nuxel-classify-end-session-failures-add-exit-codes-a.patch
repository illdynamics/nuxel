+static const char *NuxelEmptyTransferName(int flags)
+{
+	if (flags == kNuxelEmptyTransferNone)
+		return ("none");
+
+	if (flags == kNuxelEmptyTransferBefore)
+		return ("before");
+
+	if (flags == kNuxelEmptyTransferAfter)
+		return ("after");
+
+	return ("both");
+}
+
+static int NuxelReadTimeout(const Arguments& arguments, const char *name, int fallback, bool *valid)
+{
+	const StringArgument *argument = static_cast<const StringArgument *>(arguments.GetArgument(name));
+
+	if (!argument)
+		return (fallback);
+
+	unsigned int value = 0;
+
+	if (Utility::ParseUnsignedInt(value, argument->GetValue().c_str()) != kNumberParsingStatusSuccess ||
+	    value < 50 || value > 600000)
+	{
+		Interface::PrintError("Invalid value for --%s: %s (expected 50..600000 ms)\n",
+			name, argument->GetValue().c_str());
+		*valid = false;
+
+		return (fallback);
+	}
+
+	return (static_cast<int>(value));
+}
