 		closeFiles(partitionFiles, pitFile);
 		delete bridgeManager;
 
-		return (1);
+		return (kNuxelExitGenericFailure);
 	}
 
 	bool success = sendTotalTransferSize(bridgeManager, partitionFiles, pitFile, repartition);
@@ -623,12 +752,85 @@ int FlashAction::Execute(int argc, char **argv)
 		delete pitData;
 	}
 
-	if (!bridgeManager->EndSession(reboot))
-		success = false;
+	// Always perform the end-session handshake. It is the only host-side step
+	// that can distinguish "the phone accepted the session" from "the phone is
+	// still sitting in Download Mode". It is never skipped, and a missing
+	// acknowledgement is never success.
+	SessionReport sessionReport;
+	bool sessionOk = bridgeManager->EndSessionEx(reboot, &sessionReport);
+
+	// Conservative post-session verification: if we asked the phone to reboot
+	// and it positively acknowledged, it must actually leave Download Mode.
+	int presence = -1;
+
+	if (sessionOk && reboot && nuxelPresenceCheck)
+	{
+		Interface::Print("Verifying the device left Download Mode...\n");
+
+		for (int waited = 0; waited <= nuxelPresenceTimeout; waited += 250)
+		{
+			presence = BridgeManager::DownloadModeDevicePresence();
+
+			if (presence != 1)
+				break;
+
+			Sleep(250);
+		}
+
+		sessionReport.devicePresenceChecked = true;
+
+		if (presence == 1)
+		{
+			sessionReport.deviceStillPresent = true;
+			sessionReport.failure = kSessionFailureStillInDownloadMode;
+			sessionOk = false;
+
+			Interface::PrintError("The phone still reports a Download Mode device after the reboot request.\n");
+			Interface::PrintError("The transfer completed but the flash is NOT confirmed. Do not reflash blindly.\n");
+		}
+		else if (presence == 0)
+		{
+			Interface::Print("The device is no longer present in Download Mode (rebooted).\n");
+		}
+		else
+		{
+			Interface::PrintWarning("Could not determine device presence after the session.\n");
+		}
+	}
 
 	delete bridgeManager;
 
 	closeFiles(partitionFiles, pitFile);
 
-	return (success ? 0 : 1);
+	// Machine-readable session summary. The wrapper and CI parse these lines
+	// instead of matching English error strings.
+	Interface::Print("[nuxel] NUXEL_SESSION_RESULT=%s\n", sessionReport.ResultToken());
+	Interface::Print("[nuxel] NUXEL_FAILURE_CLASS=%s\n", sessionReport.FailureName());
+	Interface::Print("[nuxel] NUXEL_END_SESSION_ACK_RECEIVED=%d\n", sessionReport.endSessionAckReceived ? 1 : 0);
+	Interface::Print("[nuxel] NUXEL_ACK_RESPONSE_TYPE=0x%02x\n", sessionReport.ackResponseType & 0xFF);
+	Interface::Print("[nuxel] NUXEL_ACK_BYTES=%d\n", sessionReport.ackBytesTransferred);
+	Interface::Print("[nuxel] NUXEL_ACK_ATTEMPTS=%d\n", sessionReport.ackAttempts);
+	Interface::Print("[nuxel] NUXEL_ACK_ELAPSED_MS=%ld\n", sessionReport.ackElapsedMs);
+	Interface::Print("[nuxel] NUXEL_LAST_LIBUSB_ERROR=%d\n", sessionReport.lastLibusbError);
+	Interface::Print("[nuxel] NUXEL_REBOOT_ACK_RECEIVED=%d\n", sessionReport.rebootAckReceived ? 1 : 0);
+	Interface::Print("[nuxel] NUXEL_DEVICE_STILL_PRESENT=%d\n", sessionReport.deviceStillPresent ? 1 : (presence < 0 ? -1 : 0));
+
+	int exitCode;
+
+	if (!success)
+		exitCode = kNuxelExitFlashStepFailed;
+	else if (!sessionOk)
+		exitCode = NuxelExitCodeForFailure(sessionReport.failure);
+	else
+		exitCode = kNuxelExitSuccess;
+
+	Interface::Print("[nuxel] NUXEL_EXIT_CODE=%d\n", exitCode);
+
+	if (exitCode == kNuxelExitSuccess)
+	{
+		Interface::Print("[nuxel] End-session handshake acknowledged AND the device left Download Mode.\n");
+		Interface::Print("[nuxel] This still does not prove the flashed image is bootable; verify kernel/boot logs next.\n");
+	}
+
+	return (exitCode);
 }
