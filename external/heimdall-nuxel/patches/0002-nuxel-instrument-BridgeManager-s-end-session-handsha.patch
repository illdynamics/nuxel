+namespace
+{
+	// Adapts BridgeManager's libusb bulk transfers to the testable session
+	// state machine in NuxelSession.h.
+	class BridgePacketTransport : public IPacketTransport
+	{
+		public:
+
+			explicit BridgePacketTransport(const BridgeManager *bridge)
+			{
+				this->bridge = bridge;
+			}
+
+			int SendRaw(const unsigned char *data, int length, int timeoutMs)
+			{
+				return (bridge->SendRawPacket(data, length, timeoutMs));
+			}
+
+			int ReceiveRaw(unsigned char *data, int length, int timeoutMs)
+			{
+				return (bridge->ReceiveRawPacket(data, length, timeoutMs));
+			}
+
+			void TraceTx(const unsigned char *data, int length)
+			{
+				bridge->TracePacket("TX", data, length);
+			}
+
+			void TraceRx(const unsigned char *data, int length)
+			{
+				bridge->TracePacket("RX", data, length);
+			}
+
+			void TraceNote(const char *message)
+			{
+				bridge->TraceNote(message);
+			}
+
+		private:
+
+			const BridgeManager *bridge;
+	};
+}
+
+static int NuxelClampTimeout(int timeoutMs)
+{
+	if (timeoutMs < 50)
+		return (50);
+
+	if (timeoutMs > 600000)
+		return (600000);
+
+	return (timeoutMs);
+}
+
+void BridgeManager::SetNuxelSendTimeout(int timeoutMs)
+{
+	nuxelSendTimeout = NuxelClampTimeout(timeoutMs);
+}
+
+void BridgeManager::SetNuxelReceiveTimeout(int timeoutMs)
+{
+	nuxelReceiveTimeout = NuxelClampTimeout(timeoutMs);
+}
+
+void BridgeManager::SetNuxelRebootReceiveTimeout(int timeoutMs)
+{
+	nuxelRebootReceiveTimeout = NuxelClampTimeout(timeoutMs);
+}
+
+void BridgeManager::SetNuxelEmptyTransferFlags(int flags)
+{
+	nuxelEmptyTransferFlags = flags;
+}
+
+void BridgeManager::SetNuxelTracePackets(bool enabled)
+{
+	nuxelTracePackets = enabled;
+}
+
+int BridgeManager::SendRawPacket(const unsigned char *data, int length, int timeout) const
+{
+	int dataTransferred = 0;
+	int result = libusb_bulk_transfer(deviceHandle, outEndpoint,
+		const_cast<unsigned char *>(data), length, &dataTransferred, timeout);
+
+	if (result != LIBUSB_SUCCESS)
+		return (result);
+
+	return (dataTransferred);
+}
+
+int BridgeManager::ReceiveRawPacket(unsigned char *data, int length, int timeout) const
+{
+	// Same zero-length quirk as ReceiveBulkTransfer(): WinUSB ignores
+	// zero-length reads, so substitute a one-byte buffer.
+	static unsigned char dummyData;
+
+	unsigned char *buffer = data;
+	int bufferLength = length;
+
+	if (buffer == nullptr)
+	{
+		buffer = &dummyData;
+		bufferLength = 1;
+	}
+
+	int dataTransferred = 0;
+	int result = libusb_bulk_transfer(deviceHandle, inEndpoint, buffer, bufferLength,
+		&dataTransferred, timeout);
+
+	if (result != LIBUSB_SUCCESS)
+		return (result);
+
+	return (dataTransferred);
+}
+
+void BridgeManager::TracePacket(const char *direction, const unsigned char *data, int length) const
+{
+	if (!nuxelTracePackets)
+		return;
+
+	if (length < 0)
+		length = 0;
+
+	char hex[3 * 16 + 1];
+	int shown = (length < 16) ? length : 16;
+	int position = 0;
+
+	for (int i = 0; i < shown; i++)
+		position += snprintf(hex + position, sizeof(hex) - position, "%02x", data[i]);
+
+	hex[position] = '\0';
+
+	unsigned int type = 0;
+	bool haveType = (data != nullptr && length >= 4);
+
+	if (haveType)
+	{
+		type = static_cast<unsigned int>(data[0]) |
+		       (static_cast<unsigned int>(data[1]) << 8) |
+		       (static_cast<unsigned int>(data[2]) << 16) |
+		       (static_cast<unsigned int>(data[3]) << 24);
+	}
+
+	Interface::Print("    [nuxel] %s len=%d type=0x%02x hex=%s%s\n",
+		direction, length, haveType ? (type & 0xFF) : 0, hex,
+		(length > shown) ? "..." : "");
+}
+
+void BridgeManager::TraceNote(const char *message) const
+{
+	if (!nuxelTracePackets)
+		return;
+
+	Interface::Print("    [nuxel] %s\n", message ? message : "");
+}
+
+bool BridgeManager::EndSessionEx(bool reboot, SessionReport *report)
+{
+	Interface::Print("Ending session...\n");
+
+	BridgePacketTransport transport(this);
+
+	bool success = NuxelRunEndSession(transport, reboot,
+		nuxelSendTimeout, nuxelReceiveTimeout, nuxelRebootReceiveTimeout,
+		nuxelEmptyTransferFlags, verbose, report);
+
+	if (!success)
+	{
+		Interface::PrintError("Failed to receive session end confirmation!\n");
+
+		if (report != nullptr)
+		{
+			Interface::PrintError("Session failure class: %s (%s)\n",
+				report->FailureName(), report->ResultToken());
+		}
+	}
+
+	return (success);
+}
+
+int BridgeManager::DownloadModeDevicePresence(void)
+{
+	libusb_context *context = nullptr;
+
+	if (libusb_init(&context) != LIBUSB_SUCCESS)
+		return (-1);
+
+	libusb_device **devices = nullptr;
+	ssize_t deviceCount = libusb_get_device_list(context, &devices);
+	int found = 0;
+
+	if (deviceCount >= 0)
+	{
+		for (ssize_t deviceIndex = 0; deviceIndex < deviceCount && !found; deviceIndex++)
+		{
+			libusb_device_descriptor descriptor;
+
+			if (libusb_get_device_descriptor(devices[deviceIndex], &descriptor) != LIBUSB_SUCCESS)
+				continue;
+
+			for (unsigned int i = 0; i < BridgeManager::kSupportedDeviceCount; i++)
+			{
+				if (descriptor.idVendor == supportedDevices[i].vendorId &&
+				    descriptor.idProduct == supportedDevices[i].productId)
+				{
+					found = 1;
+					break;
+				}
+			}
+		}
+
+		libusb_free_device_list(devices, 1);
+	}
+
+	libusb_exit(context);
+
+	return (found);
+}
