+/*
+ * Nuxel PWNAGE-SSP: userspace BBD peer (the native nuxel-ssp-bridge).
+ *
+ * The vendor transport is symmetric and daemon-driven:
+ *   AP  -> MCU : bbd_send_packet()   pushes [u16 len][ssp_msg] into
+ *                 /dev/bbd_sensor for lhd; lhd wraps it in RPC and writes
+ *                 the SSI bytes to the hub.
+ *   MCU -> AP  : lhd unwraps the RPC reply and calls bbd_sensor_write(),
+ *                 which drives callback_bbd_on_packet().
+ *
+ * When a native peer holds /dev/bbd_sensor open we mirror that exactly, but
+ * without RPC: the same [u16 len][ssp_msg] frames are delivered to the peer,
+ * and the peer's replies are accepted from a write to the same node.  With no
+ * peer, the kernel keeps BBD's own legacy path untouched.
+ */
+static atomic_t nuxel_bbd_peer_open = ATOMIC_INIT(0);
+static atomic_t nuxel_shub_irq_armed = ATOMIC_INIT(0);
+
+
+int bbd_nuxel_peer_open(void)
+{
+	atomic_set(&nuxel_bbd_peer_open, 1);
+	/*
+	 * ttyBCM keeps its own host-req line disabled until bcm_spi_open(); the
+	 * *shub-int* GPIO is the hub's data-ready line and ssp_probe() leaves it
+	 * disabled too.  With a peer attached nothing else unmasks it, so arm it
+	 * here once; the SSP IRQ handler only feeds diagnostic accounting.
+	 */
+	/*
+	 * shub-int is left disabled by ssp_probe(); with a peer attached arm it
+	 * exactly once.  Track it so repeated attach/release cycles cannot
+	 * unbalance the IRQ depth (the 4.14 core WARNs and ignores the second
+	 * enable, leaving the line stuck disabled).
+	 */
+	if (nuxel_ssp_data && nuxel_ssp_data->irq_shub_int > 0 &&
+	    atomic_xchg(&nuxel_shub_irq_armed, 1) == 0)
+		enable_irq(nuxel_ssp_data->irq_shub_int);
+	pr_info("[SSPBBD] Nuxel BBD peer attached (userspace bridge)\n");
+	return 0;
+}
+
+int bbd_nuxel_peer_release(void)
+{
+	atomic_set(&nuxel_bbd_peer_open, 0);
+	pr_info("[SSPBBD] Nuxel BBD peer detached\n");
+	return 0;
+}
+
+int bbd_nuxel_peer_active(void)
+{
+	return atomic_read(&nuxel_bbd_peer_open);
+}
+
+/* MCU -> AP frames written by the native peer, same path lhd used. */
+ssize_t bbd_nuxel_peer_rx(const u8 *buf, size_t size)
+{
+	if (!nuxel_ssp_data)
+		return -ENODEV;
+	pr_info("[SSPBBD] Nuxel peer rx %zu bytes: %*ph\n", size,
+		(int)min(size, (size_t)8), buf);
+	return callback_bbd_on_packet(nuxel_ssp_data, (const char *)buf, size);
+}
+EXPORT_SYMBOL_GPL(bbd_nuxel_peer_rx);
+
+/*
+ * Deliver one AP->MCU message to the native peer as
+ *     [u16 size][packed struct ssp_msg (9 bytes)][payload...]
+ * where size counts the ssp_msg header plus payload.  This is the same
+ * information lhd received through bbd_send_packet() plus the payload it
+ * fetched from the ssp_msg it was handed.
+ */
+static ssize_t nuxel_bbd_peer_send(const u8 *hdr, size_t hdr_len,
+				   const u8 *payload, size_t payload_len)
+{
+	u8 frame[1024];
+	u8 header[9];
+	u16 total;
+
+	if (hdr_len > sizeof(header) || hdr_len + payload_len > sizeof(frame) - 2)
+		return -EINVAL;
+	total = (u16)(hdr_len + payload_len);
+	/*
+	 * struct ssp_msg carries a `data` word whose meaning is a kernel
+	 * pointer for write commands.  The peer only needs cmd/length/options
+	 * and the payload bytes, so never hand a kernel address to userspace.
