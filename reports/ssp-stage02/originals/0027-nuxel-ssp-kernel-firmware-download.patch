+/*
+ * Nuxel: expose the embedded RAM patch (the F0..F5 record container) and its
+ * byte size to the kernel-coordinated firmware downloader, so it can parse the
+ * records and dispatch per-record MemoryWrite RPCs without a userspace
+ * /dev/bbd_patch round-trip.  Returns the selected blob and its size, or NULL.
+ */
+const unsigned char *nuxel_bbd_patch_bytes(int ap_type, int hw_rev, size_t *size)
+{
+	int patch_ver = get_patch_version(ap_type, hw_rev);
+	const unsigned char *blob;
+	size_t sz;
+
+	if (patch_ver == bbd_current) {
+		blob = bbd_patch; sz = sizeof(bbd_patch);
+	} else if (patch_ver == bbd_new_old) {
+		blob = bbd_patch_new_old; sz = sizeof(bbd_patch_new_old);
+	} else {
+		blob = bbd_patch_old; sz = sizeof(bbd_patch_old);
+	}
+	if (!blob || sz == 0)
+		return NULL;
+	if (size)
+		*size = sz;
+	return blob;
+}
+EXPORT_SYMBOL_GPL(nuxel_bbd_patch_bytes);
