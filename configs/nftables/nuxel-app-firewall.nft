#!/usr/sbin/nft -f
# ============================================================================
# Nuxel app firewall - DEVICE ruleset (Linux 4.14.253, S10+ / beyond2lte)
# ============================================================================
# Per-app network isolation for Nuxel.
#
# WHY THIS FILE LOOKS THE WAY IT DOES (measured, not assumed):
#   * The device kernel is Samsung Linux 4.14.253. nftables' per-cgroup socket
#     match in cgroupv2 form (`socket cgroupv2 level 2 "app-x"`) requires Linux
#     >= 5.13 and CANNOT work here. The 4.14-compatible equivalent is the
#     cgroup v1 net_cls classid match: `meta cgroup 0x...`. nuxel-sandbox
#     assigns each app a deterministic classid (see nuxel-permd.py
#     _classid_for / sandbox.c) and this ruleset matches exactly that value.
#   * The cgroupv2 variant is kept next to this file as
#     nuxel-app-firewall-cgroupv2.nft for the VM/future path. The loader
#     (tools/s10plus/a33/nuxel-firewall.sh) picks the right one from the
#     measured kernel and never pretends the other one is in effect.
#   * Console safety: the guard table (nuxel-console-guard.nft) is loaded by the
#     loader AFTER this file - necessarily, because this file starts with
#     `flush ruleset`, which would otherwise delete it. Its chains sit at
#     priority -200, i.e. before every chain in this table (-100 / -90), so the
#     guard always wins. It is deliberately NOT `include`d here: an include
#     inside a file that begins with `flush ruleset` is exactly the ordering bug
#     this layout avoids.
#
# Default posture: DROP. An app gets network only if an ACCEPT rule for its
# classid exists. Root and processes outside any app classid are NOT constrained
# by this table (documented limitation - see docs/beta-finalization/security/FIREWALL.md).

flush ruleset

table inet nuxel_app_firewall {
    # ---------------------------------------------------------------- input --
    chain input {
        type filter hook input priority -100; policy drop;

        ct state established,related accept
        iif lo accept

        # Rate-limited ICMP: enough for path-MTU discovery and liveness, not
        # enough for a flood.
        icmp type { echo-request, echo-reply, destination-unreachable,
                    time-exceeded, parameter-problem } limit rate 10/second accept
        icmpv6 type { echo-request, echo-reply, destination-unreachable,
                      time-exceeded, parameter-problem,
                      neighbor-solicit, neighbor-advertise,
                      router-solicit, router-advertise } accept

        # Inbound is denied by policy for apps; only system services that
        # explicitly bind (D-Bus is a unix socket, not TCP) get through.
        log prefix "NUXXEL-INPUT-DROP: " limit rate 10/minute
    }

    # -------------------------------------------------------------- forward --
    chain forward {
        type filter hook forward priority -100; policy drop;
        # No routing between interfaces by default. The VPN path (tun0) is
        # allowed only when the kill switch is explicitly enabled by the tool.
        log prefix "NUXXEL-FWD-DROP: " limit rate 10/minute
    }

    # --------------------------------------------------------------- output --
    # Per-app network control. Everything is dropped unless:
    #   * it belongs to an established flow,
    #   * it is loopback / DHCP / DNS / ICMP,
    #   * it matches an app classid ACCEPT rule injected by nuxel-sandbox or
    #     nuxel-firewall.sh app-allow <app-id>,
    #   * or it is system traffic (classid 0) - see the honest note below.
    chain output {
        type filter hook output priority -100; policy drop;

        ct state established,related accept
        oif lo accept

        # DHCP client (system + gadget link)
        udp sport 68 udp dport 67 accept

        # DNS: resolved/stubby must be reachable for every app that is allowed
        # any network at all. The resolver itself decides who may query it.
        udp dport 53 accept
        tcp dport 53 accept

        icmp type { echo-request, echo-reply, destination-unreachable,
                    time-exceeded, parameter-problem } accept
        icmpv6 type { echo-request, echo-reply, destination-unreachable,
                      time-exceeded, parameter-problem,
                      neighbor-solicit, neighbor-advertise } accept

        # --- per-app ACCEPT rules (injected at runtime) ---------------------
        # Deterministic classid per app, e.g.:
        #   meta cgroup 0x01030001 accept      # nuxel-dialer
        #   meta cgroup 0x01030005 accept      # nuxel-messages
        # nuxel-sandbox writes the child PID into the app cgroup; the kernel
        # stamps its sockets with that classid, so these rules govern the app's
        # real traffic. nftables.sh adds/removes them; verify with:
        #   nft list chain inet nuxel_app_firewall output

        # --- unclassified (system) traffic ----------------------------------
        # HONEST RESIDUAL RISK: net_cls classid 0 means "not assigned to an app
        # classid". NetworkManager, ModemManager, resolved, journald uploads and
        # every process the sandbox did not launch fall in here. Dropping them
        # would break the phone; allowing them means an app that manages to run
        # OUTSIDE the sandbox is treated as system traffic. Mitigations, in
        # order of strength:
        #   1. every app launch goes through nuxel-sandbox, which always assigns
        #      a classid (--cgroup <app-id>) before exec;
        #   2. a systemd unit drop-in (configs/nftables/systemd/) puts daemons in
        #      their own classid so the set of classid-0 processes stays small;
        #   3. this rule logs new unclassified outbound connections so the
        #      residual set is observable instead of assumed.
        meta cgroup 0 ct state new log prefix "NUXXEL-UNCLASSIFIED-OUT: " limit rate 20/minute
        meta cgroup 0 accept

        # VPN kill switch (added/removed by nuxel-firewall.sh vpn-on/vpn-off):
        #   oifname != "tun0" meta cgroup != 0 drop
        # While the kill switch is armed, app classids may only leave through
        # the tunnel; system traffic is unaffected so the console/DNS keep
        # working (a kill switch that kills the console is not acceptable).

        log prefix "NUXXEL-OUTPUT-DROP: " limit rate 10/minute
    }

    # ------------------------------------------------------------------ nat --
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
    }

    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        # Only the tunnel interface masquerades; no NAT on the primary link
        # (the phone is a client, not a router).
        oifname "tun0" masquerade
    }

    # Debug anchors: nuxel-firewall.sh app-list reads these to report which
    # apps are currently permitted, without parsing log files.
    chain app_allowed {
        # (per-app ACCEPT rules are injected into `output`)
    }

    chain app_denied {
        # Default drop policy does the work; no rules are needed here.
    }
}

# ---------------------------------------------------------------------------
# Raw hardening: drop invalid and obviously spoofed packets before anything
# else looks at them.
# ---------------------------------------------------------------------------
table inet nuxel_raw {
    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        ct state invalid drop
        iif lo ip daddr != 127.0.0.0/8 drop
        iif lo ip6 daddr != ::1/128 drop
    }
}

# ---------------------------------------------------------------------------
# System traffic: daemons that must reach the network and are not app-scoped.
# Kept as a separate table so its existence (and its size) is auditable.
# ---------------------------------------------------------------------------
table inet nuxel_system {
    chain output {
        type filter hook output priority -90; policy accept;
        # Intentionally unrestricted for classid-0 traffic; the residual risk is
        # documented above and logged by the rule in nuxel_app_firewall.
    }
}

# ---------------------------------------------------------------------------
# Rate-limited logging hook for evidence collection.
# ---------------------------------------------------------------------------
table inet nuxel_log {
    chain posthook {
        type filter hook input priority -50; policy accept;
        log prefix "NUXXEL-FW: " limit rate 5/minute
    }
}
