#!/usr/sbin/nft -f
# ============================================================================
# Nuxel app firewall - cgroupv2 variant (Linux >= 5.13 only: VM and future)
# ============================================================================
# This is the SAME policy as nuxel-app-firewall.nft, expressed with the modern
# per-cgroup socket match. It MUST NOT be loaded on the S10+ (4.14.253), where
# `socket cgroupv2` does not exist; tools/s10plus/a33/nuxel-firewall.sh refuses
# to load it when the running kernel is older than 5.13 and says so.
#
# Difference from the device variant:
#   * per-app allow rules look like
#         socket cgroupv2 level 2 "app-nuxel-dialer" accept
#     which matches the cgroup path /sys/fs/cgroup/nuxel/app-<id> created by
#     nuxel-sandbox, with no classid arithmetic at all;
#   * the "unclassified traffic" hole of the classid scheme disappears: a
#     cgroupv2 match is a path match, so an app cannot become "system" by
#     failing to be classified.

flush ruleset

table inet nuxel_app_firewall {
    chain input {
        type filter hook input priority -100; policy drop;
        ct state established,related accept
        iif lo accept
        iifname "zt*" ip daddr 10.11.12.99 tcp dport { 22, 3389, 5900 } accept
        iifname "usb0" ip saddr 10.100.10.0/24 ip daddr 10.100.10.1 tcp dport 2022 accept
        udp dport 9993 accept
        icmp type { echo-request, echo-reply, destination-unreachable,
                    time-exceeded, parameter-problem } limit rate 10/second accept
        icmpv6 type { echo-request, echo-reply, destination-unreachable,
                      time-exceeded, parameter-problem,
                      nd-neighbor-solicit, nd-neighbor-advert,
                      nd-router-solicit, nd-router-advert } accept
        # v0.8.5 LIVE FIX: owner console SSH (key-only; sshd also enforces its
        # own AllowUsers CIDRs).  Without this the drop policy black-holes SSH.
        ip saddr { 10.20.30.0/24, 10.100.10.0/24, 192.168.0.0/16,
                   172.16.0.0/12, 10.0.0.0/8 } tcp dport 22 accept
        ip6 saddr { fd00::/8, fe80::/10 } tcp dport 22 accept
        limit rate 10/minute log prefix "NUXXEL-INPUT-DROP: "
    }

    chain forward {
        type filter hook forward priority -100; policy drop;
        # v0.8.5 TETHERING/HOTSPOT: everything forwarded here is traffic the
        # owner explicitly asked to share (USB tethering 10.100.10.0/24, the
        # Wi-Fi hotspot 10.42.0.0/24, and the older 10.20.30.0/24 dev link).
        # Without these ACCEPTs this chain's `policy drop` ran FIRST (priority
        # -100) so the dedicated tether/hotspot chains at -50/-49 never saw
        # the packet: a tethered host could ping the phone but no forwarded
        # packet ever left it.  Masquerade stays in nuxel_tether / NUXEL_TETHER;
        # this only permits the flows.
        iifname { "usb0", "usb1", "rndis0", "ncm0", "eth0" } accept
        oifname { "usb0", "usb1", "rndis0", "ncm0", "eth0" } ct state established,related accept
        iifname { "wlan1", "p2p0" } accept
        oifname { "wlan1", "p2p0" } ct state established,related accept
        ip saddr { 10.100.10.0/24, 10.42.0.0/24, 10.20.30.0/24 } accept
        ip daddr { 10.100.10.0/24, 10.42.0.0/24, 10.20.30.0/24 } ct state established,related accept
        # Anything else is a forward the owner did not ask for.
        limit rate 10/minute log prefix "NUXXEL-FWD-DROP: "
    }

    chain output {
        type filter hook output priority -100; policy drop;
        ct state established,related accept
        oif lo accept
        udp sport 68 udp dport 67 accept
        udp dport 53 accept
        tcp dport 53 accept
        icmp type { echo-request, echo-reply, destination-unreachable,
                    time-exceeded, parameter-problem } accept
        icmpv6 type { echo-request, echo-reply, destination-unreachable,
                      time-exceeded, parameter-problem,
                      nd-neighbor-solicit, nd-neighbor-advert } accept

        # Per-app rules injected by nuxel-sandbox / nftables.sh, e.g.:
        #   socket cgroupv2 level 2 "app-nuxel-dialer" accept

        # App cgroups that are NOT permitted: logged so the posture is visible.
        socket cgroupv2 level 2 "app-" ct state new \
            limit rate 20/minute log prefix "NUXXEL-APP-DROP: "

        limit rate 10/minute log prefix "NUXXEL-OUTPUT-DROP: "
    }

# v0.8.5: the renderer strips this NAT section on kernels without NAT-chain
# support.  Its marker boundary is written by nuxel-firewall.sh, so the
# stripped result no longer contains a dangling 'chain prerouting' opening
# stub (which had made the rendered ruleset invalid on the S10+).
# __NUXEL_NAT_BEGIN__
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
    }

    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        oifname "tun0" masquerade
    }

# __NUXEL_NAT_END__

    chain app_allowed {
    }

    chain app_denied {
    }
}

# v0.8.5 LIVE FIX: no `ct state invalid drop` here.  On the live 4.14.253
# kernel every inbound Wi-Fi packet is classified invalid at the prerouting
# hook and was silently dropped before the input hook, so ICMP and SSH never
# reached sshd even though the input chain accepts them.  The input chain's
# default drop policy still fails closed.  See nuxel-app-firewall.nft.
table inet nuxel_raw {
    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        iif lo ip daddr != 127.0.0.0/8 drop
        iif lo ip6 daddr != ::1/128 drop
    }
}

table inet nuxel_system {
    chain output {
        type filter hook output priority -90; policy accept;
    }
}

table inet nuxel_log {
    chain posthook {
        type filter hook input priority -50; policy accept;
        limit rate 5/minute log prefix "NUXXEL-FW: "
    }
}
