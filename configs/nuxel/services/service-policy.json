{
  "schema_version": 1,
  "description": "Nuxel Settings -> Services control policy. The bridge only accepts unit names present in allowlist; essential units cannot be stopped or disabled from the GUI and their restart/reload requires confirmation. Keep in sync with the live unit list during image build.",
  "allowlist": [
    "nuxel-wayland",
    "nuxel-wl-fb",
    "nuxel-button-manager",
    "nuxel-touch-arm",
    "nuxel-bridge",
    "nuxel-http-bridge",
    "nuxel-web",
    "nuxel-soundd",
    "nuxel-clockd",
    "nuxel-orientationd",
    "nuxel-device-permissions",
    "nuxel-audio-route",
    "nuxel-audio-route-retry",
    "nuxel-audio-session",
    "nuxel-mic-route",
    "nuxel-boot-sound",
    "nuxel-bootcap",
    "nuxel-bootmode-guard",
    "nuxel-bootmode-oneshot",
    "nuxel-app-prewarm",
    "nuxel-bluetooth",
    "nuxel-charger-mode-recovery",
    "nuxel-fallback",
    "nuxel-fuse-access",
    "nuxel-geoclue-agent",
    "nuxel-haptics",
    "nuxel-interface-state",
    "nuxel-mtp",
    "nuxel-network-udev-seed",
    "nuxel-nfcd",
    "nuxel-notifications",
    "nuxel-portal",
    "nuxel-power-mode",
    "nuxel-usb-mode-monitor",
    "nuxel-usb-mode-restore",
    "nuxel-watchdog-keep",
    "nuxel-wifi",
    "seatd",
    "sshd"
  ],
  "essential": [
    "nuxel-wayland",
    "nuxel-wl-fb",
    "nuxel-button-manager",
    "nuxel-touch-arm",
    "nuxel-bridge",
    "nuxel-http-bridge",
    "nuxel-web",
    "nuxel-soundd",
    "nuxel-clockd",
    "nuxel-orientationd",
    "nuxel-device-permissions",
    "nuxel-audio-route",
    "nuxel-audio-session",
    "seatd",
    "nuxel-usb-mode-restore",
    "nuxel-wifi"
  ],
  "mutable_verbs": ["start", "stop", "restart", "reload", "enable", "disable"],
  "daemon_verbs": ["daemon-reload", "daemon-reexec"]
}
