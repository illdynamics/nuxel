  "schema_version": 1,
  "comment": "Consolidated capability manifest for the Priority 7b hardware subsystems (build group bg-08). 'expected_on_s10plus' is the SHIPPED HARDWARE from the beyond2lte DTS / S10+ specification and is NOT an observation. 'state'/'verdict' are what the repository can actually prove offline; everything that needs a human (ear, finger, eyes, SIM, microSD, peer device, tag, sky view) is NEEDS_OWNER_TEST and is never auto-promoted. A registered kernel driver is not proof of working hardware, and a writable node is not proof of a felt buzz, visible light or audible sound. No subsystem here claims VERIFIED_ON_S10PLUS.",
  "device": {"model": "Samsung Galaxy S10+ SM-G975F", "codename": "beyond2lte", "soc": "Exynos 9820"},
  "evidence_rule": {
    "offline_proves": ["config validity", "enumeration logic", "verdict chains", "refusal/safety paths", "capability reporting"],
    "offline_cannot_prove": ["felt haptics", "visible light", "paired Bluetooth", "an NFC tag read", "a GNSS fix", "physically induced motion", "a captured frame", "a mounted physical card", "audible sound", "a cellular bearer"],
    "allowed_terminal_states": ["VERIFIED_ON_S10PLUS", "VERIFIED_IN_VM_ONLY", "OFFLINE_TESTED", "DEPLOYED_UNVERIFIED", "IMPLEMENTED_NOT_DEPLOYED", "BLOCKED_KERNEL", "BLOCKED_FIRMWARE", "BLOCKED_HARDWARE", "BLOCKED_EXTERNAL_RESOURCE", "NEEDS_OWNER_TEST", "FAILED", "DEFERRED", "NOT_SUPPORTED_ON_DEVICE"]
  },
