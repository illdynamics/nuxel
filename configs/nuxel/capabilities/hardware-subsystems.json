    "modem":      {"tool": "tools/s10plus/a33/nuxel-modem-diag.sh", "config": "configs/nuxel/modem/modem.json", "manual": "docs/beta-finalization/manual-proof/16-sim-mobile-data.md", "offline_state": "OFFLINE_TESTED", "owner_state": "NEEDS_OWNER_TEST", "owner_needs": "insert a nano-SIM; cellular service itself is BLOCKED_FIRMWARE / NOT_SUPPORTED_ON_DEVICE (no upstream ModemManager plugin for Samsung Shannon LTE)", "never_claims": ["signal", "operator", "registration", "data", "SMS", "calls"]},
