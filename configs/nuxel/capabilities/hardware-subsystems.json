    "leds":       {"tool": "tools/s10plus/a33/nuxel-led-diag.sh", "config": "configs/nuxel/leds/leds.json", "manual": "docs/beta-finalization/manual-proof/09-flashlight.md", "offline_state": "OFFLINE_TESTED", "owner_state": "NEEDS_OWNER_TEST", "owner_needs": "visible torch/notification light; absent classes reported NOT_SUPPORTED_ON_DEVICE; edge lighting is a display effect, not a hardware LED"},
    "bluetooth":  {"tool": "tools/s10plus/a33/nuxel-bluetooth-diag.sh", "config": "configs/nuxel/bluetooth/bluetooth.json", "manual": "docs/beta-finalization/manual-proof/11-bluetooth.md", "offline_state": "OFFLINE_TESTED", "owner_state": "NEEDS_OWNER_TEST", "owner_needs": "a peer device to pair with; radio presence/firmware reported, never assumed"},
    "nfc":        {"tool": "tools/s10plus/a33/nuxel-nfc-diag.sh", "config": "configs/nuxel/nfc/nfc.json", "manual": "docs/beta-finalization/manual-proof/12-nfc.md", "offline_state": "OFFLINE_TESTED", "owner_state": "NEEDS_OWNER_TEST", "owner_needs": "a physical tag; controller presence/firmware staged, never claimed from config"},
    "gnss":       {"tool": "tools/s10plus/a33/nuxel-gnss-diag.sh", "config": "configs/nuxel/gnss/gnss.json", "manual": "docs/beta-finalization/manual-proof/13-gps.md", "offline_state": "OFFLINE_TESTED", "owner_state": "NEEDS_OWNER_TEST", "owner_needs": "outdoors with sky view for a real fix; no fabricated fix"},
    "sensors":    {"tool": "tools/s10plus/a33/nuxel-sensors-diag.sh", "config": "configs/nuxel/sensors/sensors.json", "manual": "docs/beta-finalization/manual-proof/14-sensors.md", "offline_state": "OFFLINE_TESTED", "owner_state": "NEEDS_OWNER_TEST", "owner_needs": "physically induced motion; per-class states include NOT_SUPPORTED_ON_DEVICE and PRESENT_UNREADABLE"},
