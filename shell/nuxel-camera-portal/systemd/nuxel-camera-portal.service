# Nuxel Camera Portal backend
#
# Minimal org.freedesktop.portal.Camera backend that publishes a PipeWire
# camera node (synthetic color bars on the VM, real v4l2src on mustang).
#
# Install (VM / Fedora systemd) - this is a USER-manager unit:
#   install -Dm0644 shell/nuxel-camera-portal/systemd/nuxel-camera-portal.service \
#       ~/.config/systemd/user/nuxel-camera-portal.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now nuxel-camera-portal
#
# It is session-scoped on purpose: it has to sit in the same user D-Bus
# namespace as PipeWire and xdg-desktop-portal, which is why it carries
# WantedBy=graphical-session.target. Installing it into the SYSTEM manager
# (/etc/systemd/system + `systemctl enable`) is a NO-OP for that target; the
# handset rootfs builder never installs it (it builds no VM camera surface), and
# tools/s10plus/a33/verify-service-graph.py records that as an explicit warning
# instead of silently "passing" a unit that could never start. Phone camera work
# is tracked separately (see docs/beta-finalization/manual-proof/15-camera.md).
#
# mustang / Alpine pmOS runs the OpenRC wrapper at boot; see docs.

[Unit]
Description=Nuxel Camera Portal (xdg-desktop-portal Camera backend)
Documentation=file:///docs/camera-geolocation-design.md
# Start after the graphics / pipewire session is available. We are session-scoped,
# so keep it alongside the user bus where PipeWire and xdg-desktop-portal live.
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# Unit is installed in the user manager (graphical-session.target), so it runs
# in the current graphical session user's D-Bus namespace. No User= directive
# here: in the user manager, User= would require the root template with "%I"
# (which expands empty in a non-instantiated unit) or an explicit name. Relying
# on the user manager avoids the empty/root User= trap.
ExecStart=/usr/bin/python3 /opt/nuxel/camera-portal/nuxel_camera_portal.py
Restart=on-failure
RestartSec=2
# The portal should never escape its own slice.
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
