{
    "app_id": "nuxel-dialer",
    "name": "Phone Dialer",
    "category": "native",
    "flags": ["network", "audio", "call", "sms", "contacts"],
    "capabilities": ["network", "audio", "call", "sms", "contacts"],
    "network_class": "public",
    "data_dir": "/var/app/nuxel-dialer/data",
    "cgroup_name": "app-nuxel-dialer",
    "cgroup_classid": 16973825,
    "allowed_ro_paths": ["/usr", "/etc", "/usr/share"],
    "allowed_rw_paths": ["/var/app/nuxel-dialer/data"],
    "dbus_access": [
        "org.freedesktop.ModemManager1",
        "org.nuxel.Bridge"
    ],
    "devices": ["/dev/snd/"]
}
