{
    "app_id": "nuxel-home",
    "name": "Nuxel Home (launcher PWA)",
    "category": "pwa",
    "flags": [],
    "capabilities": ["notifications", "phone_status"],
    "network_class": "isolated",
    "data_dir": "/var/app/nuxel-home/data",
    "cgroup_name": "app-nuxel-home",
    "allowed_ro_paths": ["/usr", "/usr/share"],
    "allowed_rw_paths": ["/var/app/nuxel-home/data", "/run/nuxel"],
    "dbus_access": ["org.nuxel.Bridge", "org.nuxel.Portal"],
    "devices": [],
    "seccomp_profile": "pwa-strict",
    "landlock_rules": {
        "read_only": ["/usr", "/usr/share", "/etc/fonts"],
        "read_write": ["/var/app/nuxel-home/data", "/run/nuxel"],
        "deny": ["/dev", "/sys", "/proc/*/mem"],
        "kernel_note": "INTENT ONLY: Landlock requires Linux >= 5.13; the S10+ runs 4.14.253."
    },
    "network_policy": {
        "default": "deny",
        "allow_dns": false,
        "allow_tcp_outbound": false,
        "allow_udp_outbound": false,
        "allow_inbound": false,
        "kernel_note": "The launcher renders local assets and talks to the bridge over D-Bus/loopback; it does not need egress."
    },
    "enforcement": {
        "attacker_privilege_class": "unprivileged-app",
        "root_note": "Nothing here constrains uid 0.",
        "apparmor": "configs/apparmor.d/usr.bin.nuxel-home; effective only if AppArmor is enabled",
        "landlock": "unavailable on Linux 4.14",
        "seccomp": "pwa-strict BPF allow-list with no_new_privs",
        "note": "phone_status is read from the bridge; with no modem it must report 'no modem' instead of inventing a signal strength."
    }
}
