{
    "app_id": "nuxel-settings",
    "name": "Settings",
    "category": "native",
    "flags": ["network", "storage"],
    "capabilities": ["network", "storage", "bluetooth", "usb"],
    "network_class": "public",
    "data_dir": "/var/app/nuxel-settings/data",
    "cgroup_name": "app-nuxel-settings",
    "cgroup_classid": 16973828,
    "allowed_ro_paths": ["/usr", "/etc"],
    "allowed_rw_paths": ["/var/app/nuxel-settings/data", "/run/nuxel"],
    "dbus_access": [
        "org.freedesktop.NetworkManager",
        "org.freedesktop.UPower",
        "org.freedesktop.ModemManager1",
        "org.gnome.SettingsDaemon"
    ],
    "devices": [],
    "seccomp_profile": "native-standard",
    "landlock_rules": {
        "read_only": ["/usr", "/etc/fonts", "/etc/gtk-4.0"],
        "read_write": ["/var/app/nuxel-settings/data", "/run/nuxel"],
        "deny": ["/sys", "/proc/*/mem", "/var/app/"],
        "kernel_note": "INTENT ONLY: Landlock requires Linux >= 5.13; this device runs 4.14.253."
    },
    "network_policy": {
        "default": "deny_per_cgroup",
        "allow_dns": true,
        "allow_tcp_outbound": true,
        "allow_udp_outbound": true,
        "allow_inbound": false,
        "kernel_note": "cgroup v1 net_cls classid 16973828 = 0x01030004 on Linux 4.14."
    },
    "enforcement": {
        "attacker_privilege_class": "unprivileged-app",
        "root_note": "Nothing here constrains uid 0.",
        "apparmor": "profile configs/apparmor.d/usr.bin.nuxel-settings; only effective if AppArmor is enabled",
        "landlock": "unavailable on Linux 4.14",
        "seccomp": "BPF allow-list with no_new_privs",
        "note": "Settings toggles are UX entry points. They must display the enforcement truth from shell/nuxel-shell/nuxel-permissions/capabilities.json and must never claim a stronger guarantee than that registry states."
    }
}
