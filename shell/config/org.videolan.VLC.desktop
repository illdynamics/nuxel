[Desktop Entry]
Type=Application
Name=VLC media player
Comment=Nuxel installed media player (Fedora aarch64 RPM; Flatpak is blocked by CONFIG_USER_NS=n)
Exec=/usr/bin/vlc --started-from-file %U
Icon=vlc
Terminal=false
Categories=AudioVideo;Player;Video;
MimeType=video/mp4;video/x-matroska;audio/mpeg;audio/flac;
StartupNotify=true
