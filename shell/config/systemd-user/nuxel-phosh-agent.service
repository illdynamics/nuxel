[Unit]
Description=Nuxel Phosh Agent — user-session D-Bus permission portal + signal-driven notification relay
Documentation=file:/usr/share/doc/nuxel/BETA-FINALIZATION/system/SERVICE-GRAPH.md
# USER-manager unit (the agent owns org.nuxel.PhoshAgent on the SESSION bus,
# which is what nuxel-portal asks for consent through). Installed into
# ~/.config/systemd/user by the VM/dev bootstrap; the handset rootfs builder does
# not install it, because no systemd user session is proven on this 4.14 tree
# (systemd-userdbd/udevd are masked by the A26 containment and `systemd --user`
# is affected by the same kernel limitations - see SERVICE-GRAPH.md §4/§6).
# Consequence: on the handset the portal's consent dialog is NOT available in
# this revision; that is recorded, not implied away.
After=default.target

# The agent is registered under org.nuxel.PhoshAgent on the SESSION bus.
# Use Type=dbus so systemd tracks the name; fall back to Restart=always if
# the bus name claim is not strictly a one-shot activation.

[Service]
Type=dbus
BusName=org.nuxel.PhoshAgent
ExecStart=/usr/local/bin/nuxel-phosh-agent
Restart=always
RestartSec=5
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=%t
# Ensure the session bus address is available when D-Bus activates this unit.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=default.target
