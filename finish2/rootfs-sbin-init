#!/bin/sh
# Nuxel G7 Power Phase-1 bring-up init (static toybox).  MUST NOT exit as PID 1.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /sys/kernel/config
mount -t devpts devpts /dev/pts 2>/dev/null

# --- best-effort USB CDC-ACM console (DWC3 is peripheral mode, built-in) ---
mount -t configfs none /sys/kernel/config 2>/dev/null
modprobe phy-qcom-qusb2 2>/dev/null
i=0; while [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; do i=$((i+1)); [ $i -gt 8 ] && break; sleep 1; done
G=/sys/kernel/config/usb_gadget/g1
if [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && mkdir -p "$G" 2>/dev/null; then
    echo 0x1d6b > "$G/idVendor"; echo 0x0104 > "$G/idProduct"
    mkdir -p "$G/strings/0x409"
    echo "Nuxel"        > "$G/strings/0x409/manufacturer"
    echo "G7Power Nuxel"> "$G/strings/0x409/product"
    echo "ZY326RGXCM"   > "$G/strings/0x409/serialnumber"
    mkdir -p "$G/configs/c.1/strings/0x409"
    echo "ACM" > "$G/configs/c.1/strings/0x409/configuration"
    mkdir -p "$G/functions/acm.gs0"; ln -sf "$G/functions/acm.gs0" "$G/configs/c.1/" 2>/dev/null
    echo "$(ls /sys/class/udc | head -1)" > "$G/UDC" 2>/dev/null
    i=0; while [ ! -c /dev/ttyGS0 ]; do i=$((i+1)); [ $i -gt 8 ] && break; sleep 1; done
fi
CON=/dev/console
[ -c /dev/ttyGS0 ] && CON=/dev/ttyGS0

{
    echo
    echo "=== Nuxel Phase-1 rootfs on Moto G7 Power (ocean, SDM632) ==="
    uname -a
    echo "module tree: $(ls /lib/modules 2>/dev/null)"
    echo "usb udc: [$(ls /sys/class/udc 2>/dev/null)]  console: $CON"
    echo "Try: dmesg | grep -iE 'msm|drm|ili210x|wcn36xx|wcd9335'"
    echo "     ls /sys/class/drm ; cat /proc/asound/cards ; ip link"
} >"$CON" 2>&1
echo "<6>nuxel: rootfs init up, console=$CON" > /dev/kmsg 2>/dev/null

# interactive shell if someone is on the console; never return from PID 1
sh -i <"$CON" >"$CON" 2>&1
while true; do echo "nuxel: rootfs init idle" >"$CON" 2>/dev/null; sleep 3600; done
