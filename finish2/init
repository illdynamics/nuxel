#!/bin/sh
# =============================================================================
# Nuxel initramfs init — g7power (Moto G7 Power / ocean, SDM632) bring-up.
#
# FIX (2026-10-13): the previous revision resolved `root=`/probed ONLY under
# /dev/block/bootdevice/by-name/... which is an Android `ueventd` convenience
# path.  Mainline Linux with devtmpfs does NOT create that directory; it
# creates the raw GPT nodes /dev/mmcblk0pN (1-based, so boot_a=p41,
# system_a=p62, system_b=p63, userdata=p64).  Result: root never mounted and
# PID 1 rebooted in a loop ("flashing screen every few seconds").
#
# This revision:
#   1. waits (bounded) for the eMMC to enumerate,
#   2. accepts root= only if it is a real block device that holds a Nuxel root,
#   3. otherwise SCANS by ext4 label `nuxel-ocean` and by expected GPT numbers,
#      then brute-forces every /dev/mmcblk0pN,
#   4. loads ramoops early so a failure panic is captured in pstore
#      (read back via lk2nd `fastboot oem ramoops raw`),
#   5. on total failure logs a full diagnostic to /dev/kmsg, persists it to the
#      unused `logs` partition, then panics (instead of a silent reboot loop).
# =============================================================================
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

# --- essential pseudo filesystems --------------------------------------------
mount -t proc  -o noexec,nosuid,nodev none /proc 2>/dev/null
mount -t sysfs -o noexec,nosuid,nodev none /sys  2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
mkdir -p /dev/pts /dev/mapper /dev/disk/by-partlabel /run /tmp
mount -t devpts none /dev/pts 2>/dev/null

log() { echo "nuxel-init: $*"; }
err() { echo "nuxel-init: [ERROR] $*"; }
kw()  { echo "<6>nuxel-init: $*" > /dev/kmsg 2>/dev/null || true; }

# --- command provider (toybox applet symlinks) --------------------------------
if [ ! -e /bin/sh ] && [ -x /bin/toybox ]; then
    ln -sf toybox /bin/sh
    for cmd in mount umount switch_root modprobe mknod mkswap mkfs.ext4 \
               tar gzip ls cat printf echo sed grep awk find sleep date ps \
               df du sh sync reboot poweroff dd cp mv rm mkdir ln chown \
               chmod dmesg blkid losetup head tail tr cut wc uname; do
        ln -sf toybox "/bin/${cmd}" 2>/dev/null
    done
fi

# --- parse kernel cmdline -----------------------------------------------------
CMDLINE="$(cat /proc/cmdline 2>/dev/null)"
SLOT=a; DEVICE=""; ROOT_SPEC=""; ROOT_FSTYPE=""
for param in ${CMDLINE}; do
    case "${param}" in
        nuxel.slot=*)       SLOT="${param#nuxel.slot=}" ;;
        nuxel.device=*)     DEVICE="${param#nuxel.device=}" ;;
        root=*)             ROOT_SPEC="${param#root=}" ;;
        rootfstype=*)       ROOT_FSTYPE="${param#rootfstype=}" ;;
    esac
done
log "cmdline: ${CMDLINE}"
log "device=${DEVICE:-unknown} slot=${SLOT} root_spec=${ROOT_SPEC:-<none>}"

# --- load ramoops early (best effort) so a failure panic is captured ----------
if [ -d /lib/modules ]; then
    if modprobe ramoops 2>/dev/null; then log "ramoops loaded (pstore active)"; else log "ramoops not loaded"; fi
fi

FS_TYPE="${ROOT_FSTYPE:-ext4}"
ROOT_MNT=/newroot
mkdir -p "${ROOT_MNT}"

is_nuxel_root() {
    [ -d "$1/etc/nuxel" ] && return 0
    [ -f "$1/sbin/init" ] && [ -f "$1/bin/toybox" ] && return 0
    return 1
}

# --- wait (bounded) for the eMMC to enumerate ---------------------------------
i=0
while [ "$i" -lt 30 ]; do
    ls /dev/mmcblk0p* >/dev/null 2>&1 && break
    log "waiting for eMMC block devices (${i}s)"
    sleep 1
    i=$((i+1))
done
log "block devices now:"; ls -l /dev/mmcblk* 2>/dev/null
log "by-partlabel:"; ls -l /dev/disk/by-partlabel/ 2>/dev/null

ROOT_DEV=""
CANDS=""

# 1) explicit root= (only if present and a real block device)
if [ -n "${ROOT_SPEC}" ] && [ -b "${ROOT_SPEC}" ]; then
    CANDS="${ROOT_SPEC}"
fi

# 2) label scan for the Nuxel ext4 (volume name `nuxel-ocean`)
for d in /dev/mmcblk0p* /dev/mmcblk1p*; do
    [ -b "$d" ] || continue
    L="$(blkid -s LABEL -o value "$d" 2>/dev/null | head -1)"
    [ "${L}" = "nuxel-ocean" ] && CANDS="${CANDS} ${d}"
done

# 3) expected Linux GPT numbering: system_b=63, system_a=62, userdata=64
CANDS="${CANDS} /dev/mmcblk0p63 /dev/mmcblk0p64 /dev/mmcblk0p62"

# 4) brute force every eMMC partition (last resort)
for d in /dev/mmcblk0p*; do [ -b "$d" ] && CANDS="${CANDS} ${d}"; done

try_mount() {
    mount -t "${FS_TYPE}" -o ro "$1" "${ROOT_MNT}" 2>/tmp/mnt.err || return 1
    if is_nuxel_root "${ROOT_MNT}"; then return 0; fi
    umount "${ROOT_MNT}" 2>/dev/null
    return 1
}

SEEN=""
for c in ${CANDS}; do
    case " ${SEEN} " in *" ${c} "*) continue ;; esac
    SEEN="${SEEN} ${c}"
    log "trying root candidate ${c}"
    if try_mount "${c}"; then ROOT_DEV="${c}"; break; fi
done

if [ -n "${ROOT_DEV}" ]; then
    log "root found: ${ROOT_DEV}"
    if ! mount -o remount,rw "${ROOT_MNT}" 2>/dev/null; then
        umount "${ROOT_MNT}" 2>/dev/null
        mount -t "${FS_TYPE}" -o rw "${ROOT_DEV}" "${ROOT_MNT}" 2>/dev/null || true
    fi
    kw "NUXEL_STATUS: ROOT_OK dev=${ROOT_DEV} label=$(blkid -s LABEL -o value ${ROOT_DEV} 2>/dev/null)"
    echo "nuxel-init: root mounted: ${ROOT_DEV} (${FS_TYPE})"
    uname -a
    for m in sys proc dev; do mount --move "/${m}" "${ROOT_MNT}/${m}" 2>/dev/null; done
    log "switch_root -> ${ROOT_MNT}"
    if [ -x "${ROOT_MNT}/sbin/init" ]; then exec switch_root "${ROOT_MNT}" /sbin/init; fi
    if [ -x "${ROOT_MNT}/init" ];       then exec switch_root "${ROOT_MNT}" /init; fi
    exec switch_root "${ROOT_MNT}" /bin/sh
fi

# --- FAILURE: capture + panic -------------------------------------------------
err "NUXEL_STATUS: ROOT_FAIL (no bootable Nuxel root found)"
{
    echo "=== NUXEL G7POWER INITRAMFS DIAG ==="
    echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
    echo "candidates:${CANDS}"
    echo "--- uname ---"; uname -a 2>&1
    echo "--- ls /dev/mmcblk* ---"; ls -l /dev/mmcblk* 2>&1
    echo "--- ls /dev/disk/by-partlabel ---"; ls -l /dev/disk/by-partlabel/ 2>&1
    echo "--- ls /dev/block ---"; ls -lR /dev/block 2>&1 | head -40
    echo "--- /proc/filesystems ---"; cat /proc/filesystems 2>&1
    echo "--- dmesg tail ---"; dmesg 2>&1 | tail -160
} > /tmp/nuxel-diag.txt 2>&1
cat /tmp/nuxel-diag.txt
kw "NUXEL_DIAG_BEGIN"
while read -r line; do kw "$line"; done < /tmp/nuxel-diag.txt
kw "NUXEL_DIAG_END"
# persist for offline retrieval (logs partition = mmcblk0p48)
dd if=/tmp/nuxel-diag.txt of=/dev/mmcblk0p48 bs=512 conv=sync 2>/dev/null
sync
echo "nuxel-init: panicking so pstore/ramoops captures dmesg"
echo c > /proc/sysrq-trigger 2>/dev/null
sleep 8
reboot -f 2>/dev/null || true
exec sh -i
