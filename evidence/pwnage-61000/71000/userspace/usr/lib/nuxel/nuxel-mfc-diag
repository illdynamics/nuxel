def print_inventory(st: dict) -> None:
    print("Nuxel MFC inventory (read-only; no device node opened)")
    print("  device        : %s (%s, %s)" % (st["device"], st["device_model"], st["soc"]))
    print("  kernel        : %s" % (st["kernel_release"] or "<unknown>"))
    print("  boot id       : %s" % (st["boot_id"] or "<unknown>"))
    print("  decoder node  : %s" % (st["decoder_node"] or "<unresolved>"))
    print("  sysfs name    : %s" % (st["decoder_sysfs_name"] or "<none>"))
    print("  platform      : %s" % (st["platform_device"] or "<none>"))
    print("  driver        : %s" % (st["driver"] or "<none>"))
    print("  compatible    : %s" % (st["compatible"] or "<none>"))
    print("  ip_ver        : %s" % (st["ip_ver"] or "<none>"))
    print("  firmware      : %s" % st["firmware"]["state"])
    if st["firmware"].get("found"):
        for f in st["firmware"]["found"]:
            print("    %s size=%s sha256=%s" % (f.get("path"), f.get("size"), f.get("sha256")))
    print("  kernel config : %s" % ("PASS" if st["kernel_config"]["required_ok"] else "FAIL"))
    print("  guard         : v4l2_disabled=%s guard_present=%s" % (
        st["guard"]["v4l2_plugins_disabled"], st["guard"]["guard_present"]))
    print("  wireplumber   : video_capture_disabled=%s audio=%s bluetooth=%s" % (
        st["wireplumber"]["video_capture_disabled"],
        st["wireplumber"]["audio_required"],
        st["wireplumber"]["bluetooth_required"]))
    print("  state         : %s — %s" % (st["state"], st["reason"]))
    print("  safe open     : %s" % ("YES" if st["safe_open_allowed"] else "NO"))


def print_status(st: dict) -> None:
    print("schema        : %s" % st["schema"])
    print("state         : %s" % st["state"])
    print("reason        : %s" % st["reason"])
    print("source_commit : %s" % st["source_commit"])
    print("kernel        : %s" % (st["kernel_release"] or "<unknown>"))
    print("device        : %s" % st["device"])
    print("node          : %s" % (st["decoder_node"] or "<unresolved>"))
    print("firmware      : %s" % st["firmware"]["state"])
    print("receipt       : %s" % ("present" if st["safety_receipt"]["present"] else "missing"))
    print("safe open     : %s" % ("YES" if st["safe_open_allowed"] else "NO"))
    print("capabilities  : %s" % (", ".join(st["capabilities"]) if st["capabilities"] else "<none verified>"))


def _emit(data: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        print_status(data)


def run_decode_test(args, receipt: dict) -> int:
    helper = args.decode_helper or "/usr/lib/nuxel/nuxel-mfc-decode"
    if not os.path.isfile(helper):
        print("nuxel-mfc-diag: decode helper not installed: %s" % helper, file=sys.stderr)
        return 2
    cmd = [helper, "--device", args.device, "--input", args.decode_test,
           "--allow-hardware-open", "--receipt", args.receipt]
    if args.output:
        cmd += ["--output", args.output]
    if args.width:
        cmd += ["--width", str(args.width)]
    if args.height:
        cmd += ["--height", str(args.height)]
    if args.max_frames:
        cmd += ["--max-frames", str(args.max_frames)]
    print("nuxel-mfc-diag: running exactly one vendor-ABI decode test:", " ".join(cmd))
    try:
        completed = subprocess.run(cmd, timeout=args.timeout, check=False)
    except subprocess.TimeoutExpired:
        print("nuxel-mfc-diag: decode helper timed out; do NOT retry in a loop", file=sys.stderr)
        return 124
    return completed.returncode


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="nuxel-mfc-diag",
        description="Safe Exynos 9820 MFC inventory / status / opt-in probe (PWNAGE-61000)",
    )
    ap.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--inventory", action="store_true", help="read sysfs only; never opens a node (default)")
    mode.add_argument("--status", action="store_true", help="print nuxel.mfc.status/1 (read-only)")
    mode.add_argument("--self-test", action="store_true", help="run offline unit checks; no device access")
    mode.add_argument("--query-only", action="store_true", help="open the approved node and run QUERYCAP/ENUM_FMT")
    mode.add_argument("--decode-test", metavar="FILE", help="run the vendor-ABI decode helper on FILE")
    ap.add_argument("--device", help="exact decoder node, e.g. /dev/video6")
    ap.add_argument("--allow-hardware-open", action="store_true",
                    help="required for --query-only/--decode-test; never implied")
    ap.add_argument("--receipt", default=DEFAULT_RECEIPT, help="owner-approved safety receipt JSON")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--write-status", action="store_true", help="write status JSON to --status-file")
    ap.add_argument("--status-file", default=DEFAULT_STATUS)
    ap.add_argument("--log-dir", default=DEFAULT_LOG_DIR)
    ap.add_argument("--sysfs-root", default="/sys", help=argparse.SUPPRESS)
    ap.add_argument("--dev-root", default="/dev", help=argparse.SUPPRESS)
    ap.add_argument("--firmware-dir", action="append", default=None,
                    help="override firmware search dir (repeatable)")
    ap.add_argument("--config", help="override kernel config path (default /proc/config.gz)")
    ap.add_argument("--decode-helper", help="override nuxel-mfc-decode path")
    ap.add_argument("--output", help="decode helper raw-frame output path")
    ap.add_argument("--width", type=int)
    ap.add_argument("--height", type=int)
    ap.add_argument("--max-frames", type=int)
    ap.add_argument("--timeout", type=int, default=120)
    ap.add_argument("--repeat", type=int, default=1, help="query-only: repeat open/query/close N times (max 100)")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()

    status = build_status(
        sysfs_root=args.sysfs_root,
        dev_root=args.dev_root,
        firmware_dirs=args.firmware_dir,
        config_path=args.config,
        receipt_path=args.receipt,
        root="/",
    )

    if args.write_status:
        write_json_atomic(args.status_file, status)

    active = bool(args.query_only or args.decode_test)
    if active:
        if not args.allow_hardware_open:
            print("nuxel-mfc-diag: REFUSED — active mode requires --allow-hardware-open", file=sys.stderr)
            return 2
        if not args.device:
            print("nuxel-mfc-diag: REFUSED — active mode requires --device /dev/videoN", file=sys.stderr)
            return 2
        receipt, rerr = load_receipt(args.receipt)
        if receipt is None:
            print("nuxel-mfc-diag: REFUSED — %s" % rerr, file=sys.stderr)
            return 2
        receipt, gerr = require_active_gate(status, args.device, receipt)
        if receipt is None:
            print("nuxel-mfc-diag: REFUSED — %s" % gerr, file=sys.stderr)
            return 2
        print("nuxel-mfc-diag: opening %s because it matched %s/%s/%s on %s ip_ver %s" % (
            args.device, DECODER_SYSFS_NAME, EXPECTED_DRIVER, EXPECTED_COMPATIBLE,
            EXPECTED_PLATFORM, EXPECTED_IP_VER))
        if args.query_only:
            repeat = max(1, min(args.repeat, 100))
            results = []
            for i in range(repeat):
                try:
                    result = v4l2_query(args.device, alarm_seconds=min(HARDWARE_OPEN_ALARM_SECONDS, args.timeout))
                except (OSError, DiagError) as exc:
                    print("nuxel-mfc-diag: query %d/%d failed: %s" % (i + 1, repeat, exc),
                          file=sys.stderr)
                    return 1
                results.append(result)
            result = results[-1]
            result["schema"] = SCHEMA
            result["status_state"] = status["state"]
            result["firmware_sha256"] = FIRMWARE_SHA256
            result["source_commit"] = SOURCE_COMMIT
            result["open_close_repetitions"] = repeat
            log = write_log(args.log_dir, "query", result)
            result["log"] = log
            print(json.dumps(result, indent=2, sort_keys=True) if args.json else
                  "QUERYCAP driver=%s card=%s caps=%s device_caps=%s\n"
                  "formats output=%d capture=%d\nopen/close repetitions=%d\nlog=%s" % (
                      result["driver"], result["card"], result["capabilities"],
                      result["device_caps"], len(result["formats"]["output_mplane"]),
                      len(result["formats"]["capture_mplane"]), repeat, log))
            return 0
        return run_decode_test(args, receipt)

    if args.status:
        _emit(status, args.json)
    else:
        # Default is inventory.  It never opens a device node.
        if args.json:
            print(json.dumps(status, indent=2, sort_keys=True))
        else:
            print_inventory(status)
    return 0


if __name__ == "__main__":
    sys.exit(main())
