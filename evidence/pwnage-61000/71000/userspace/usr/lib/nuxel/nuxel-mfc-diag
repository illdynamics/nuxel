VERSION = "1.0.0"
SCHEMA = "nuxel.mfc.status/1"
RECEIPT_SCHEMA = "nuxel.mfc.safety-receipt/1"

DEVICE = "beyond2lte"
DEVICE_MODEL = "SM-G975F"
SOC = "exynos9820"
SOURCE_COMMIT = "f7194c1d15eded1c2a1a4dc63825b26103435cc0"
EXPECTED_DRIVER = "s5p-mfc"
EXPECTED_COMPATIBLE = "samsung,exynos-mfc"
EXPECTED_IP_VER = "0x1300"
EXPECTED_PLATFORM = "188d0000.mfc"
DECODER_SYSFS_NAME = "s5p-mfc-dec0"
DECODER_DEFAULT_NODE = "/dev/video6"
FIRMWARE_NAME = "mfc_fw.bin"
FIRMWARE_SHA256 = "f3802d34524f5919c16505c03b4cbfe184963f98787feed6232b643bda68b55f"
FIRMWARE_SIZE = 685832
KERNEL_PATCH = "0008-mfc-firmware-fail-closed.patch"

DEFAULT_RECEIPT = "/etc/nuxel/mfc/safety-receipt.json"
DEFAULT_STATUS = "/run/nuxel/mfc/status.json"
DEFAULT_LOG_DIR = "/var/log/nuxel/mfc"

# V4L2 ioctl numbers (aarch64, system UAPI headers).
VIDIOC_QUERYCAP = 0x80685600       # _IOR('V', 0, struct v4l2_capability) = 104 bytes
VIDIOC_ENUM_FMT = 0xC0405602      # _IOWR('V', 2, struct v4l2_fmtdesc) = 64 bytes
V4L2_CAP_VIDEO_CAPTURE = 0x00000001
V4L2_CAP_VIDEO_OUTPUT = 0x00000002
V4L2_CAP_VIDEO_CAPTURE_MPLANE = 0x00001000
V4L2_CAP_VIDEO_OUTPUT_MPLANE = 0x00002000
V4L2_CAP_STREAMING = 0x04000000
V4L2_CAP_DEVICE_CAPS = 0x80000000
V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE = 0x00000009
V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE = 0x0000000A

HARDWARE_OPEN_ALARM_SECONDS = 20


class DiagError(RuntimeError):
    pass


def _read(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip("\x00 \t\r\n")
    except OSError:
        return None


def _read_bytes(path: Path) -> bytes | None:
    try:
        return path.read_bytes()
    except OSError:
        return None


def _dt_u32(path: Path) -> int | None:
    """Read a device-tree u32 cell (big-endian, as stored in the DTB)."""
    raw = _read_bytes(path)
    if not raw or len(raw) < 4:
        return None
    return struct.unpack(">I", raw[:4])[0]


def _dt_string(path: Path) -> str | None:
    raw = _read_bytes(path)
    if raw is None:
        return None
    # Device-tree strings are NUL-separated.  The compatible property can hold
    # several entries; the first is the most specific one.
    parts = [p.decode("ascii", "replace") for p in raw.split(b"\x00") if p]
    return parts[0] if parts else None


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _platform_device_from_path(device_path: str) -> str:
    # /sys/devices/platform/188d0000.mfc -> 188d0000.mfc
    return os.path.basename(os.path.realpath(device_path)) if device_path else ""


def scan_video_nodes(sysfs_root: str = "/sys") -> list[dict]:
    """Return video-node metadata using sysfs only.  Never opens a device node."""
    base = Path(sysfs_root) / "class" / "video4linux"
    out: list[dict] = []
    if not base.is_dir():
        return out
    for entry in sorted(base.glob("video*")):
        if not entry.is_dir():
            continue
        name = _read(entry / "name") or ""
        index = _read(entry / "index") or ""
        dev = _read(entry / "dev") or ""
        device_link = entry / "device"
        device_real = os.path.realpath(device_link) if device_link.exists() else ""
        platform = _platform_device_from_path(device_real)
        driver = ""
        drv_link = Path(device_real) / "driver" if device_real else None
        if drv_link and drv_link.exists():
            driver = os.path.basename(os.path.realpath(drv_link))
        compatible = None
        ip_ver = None
        of_node = Path(device_real) / "of_node" if device_real else None
        if of_node and of_node.exists():
            compatible = _dt_string(of_node / "compatible")
            iv = _dt_u32(of_node / "ip_ver")
            if iv is not None:
                ip_ver = "0x%04x" % iv
        out.append({
            "sysfs": str(entry),
            "name": name,
            "index": index,
            "dev": dev,
            "device": device_real,
            "platform_device": platform,
            "driver": driver,
            "compatible": compatible,
            "ip_ver": ip_ver,
        })
    return out


def classify_node(node: dict) -> str:
    """Exact allow-list classification.  A number in /dev/videoN is irrelevant."""
    if (
        node.get("name") == DECODER_SYSFS_NAME
        and node.get("driver") == EXPECTED_DRIVER
        and node.get("compatible") == EXPECTED_COMPATIBLE
        and node.get("ip_ver") == EXPECTED_IP_VER
        and node.get("platform_device") == EXPECTED_PLATFORM
    ):
        return "MFC_DECODER"
    if node.get("driver") == EXPECTED_DRIVER or node.get("compatible") == EXPECTED_COMPATIBLE:
        return "MFC_OTHER"
    return "NOT_MFC"


def find_decoder(nodes: list[dict]) -> tuple[dict | None, str]:
    matches = [n for n in nodes if classify_node(n) == "MFC_DECODER"]
    if len(matches) == 1:
        return matches[0], ""
    if not matches:
        return None, "no node matches the exact MFC decoder allow-list"
    return None, "ambiguous MFC decoder identity (%d matches)" % len(matches)


def firmware_status(firmware_dirs: list[str] | None = None) -> dict:
    dirs = firmware_dirs or ["/lib/firmware", "/vendor/firmware"]
    found = []
    for d in dirs:
        p = Path(d) / FIRMWARE_NAME
        if not p.is_file():
            continue
        try:
            size = p.stat().st_size
            digest = sha256_file(p)
        except OSError as exc:
            found.append({"path": str(p), "error": str(exc)})
            continue
        found.append({"path": str(p), "size": size, "sha256": digest})
    if not found:
        return {
            "state": "MISSING",
            "request_name": FIRMWARE_NAME,
            "expected_sha256": FIRMWARE_SHA256,
            "expected_size": FIRMWARE_SIZE,
            "paths": [str(Path(d) / FIRMWARE_NAME) for d in dirs],
        }
    good = [f for f in found if f.get("sha256") == FIRMWARE_SHA256 and f.get("size") == FIRMWARE_SIZE]
    if good:
        return {
            "state": "PRESENT_OK",
            "request_name": FIRMWARE_NAME,
            "expected_sha256": FIRMWARE_SHA256,
            "expected_size": FIRMWARE_SIZE,
            "paths": [g["path"] for g in good],
            "found": found,
        }
    return {
        "state": "MISMATCH",
        "request_name": FIRMWARE_NAME,
        "expected_sha256": FIRMWARE_SHA256,
        "expected_size": FIRMWARE_SIZE,
        "found": found,
    }


def live_kernel_release() -> str:
    return _read(Path("/proc/sys/kernel/osrelease")) or ""


def live_boot_id() -> str:
    return _read(Path("/proc/sys/kernel/random/boot_id")) or ""


def kernel_config(config_path: str | None = None) -> dict:
    """Read the running kernel config read-only.  Does not open any video node."""
    path = Path(config_path) if config_path else Path("/proc/config.gz")
    text = ""
    if path.is_file():
        try:
            if path.suffix == ".gz" or path.name.endswith(".gz"):
                with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
                    text = f.read()
            else:
                text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
    values = {}
    for line in text.splitlines():
        m = re.match(r"^(CONFIG_[A-Za-z0-9_]+)=(.*)$", line.strip())
        if m:
            values[m.group(1)] = m.group(2)
        m = re.match(r"^# (CONFIG_[A-Za-z0-9_]+) is not set$", line.strip())
        if m:
            values[m.group(1)] = "n"
    required = {
        "CONFIG_VIDEO_EXYNOS_MFC": "y",
        "CONFIG_VIDEOBUF2_DMA_SG": "y",
        "CONFIG_EXYNOS_IOMMU": "y",
        "CONFIG_V4L2_MEM2MEM_DEV": "y",
    }
    ok = all(values.get(k) == v for k, v in required.items())
    return {
        "path": str(path),
        "present": bool(text),
        "mfc_driver": values.get("CONFIG_VIDEO_EXYNOS_MFC"),
        "iommu": values.get("CONFIG_EXYNOS_IOMMU"),
        "required_ok": ok,
        "values": {k: values.get(k) for k in required},
    }

# ---------------------------------------------------------------------------
# Safety receipt
# ---------------------------------------------------------------------------

RECEIPT_REQUIRED = (
    "owner_approved",
    "source_commit",
    "device",
    "decoder_node",
    "platform_device",
    "driver",
    "compatible",
    "ip_ver",
    "firmware_name",
    "firmware_sha256",
    "kernel_patch",
    "kernel_patch_applied",
    "missing_firmware_test",
)


def load_receipt(path: str = DEFAULT_RECEIPT) -> tuple[dict | None, str]:
    p = Path(path)
    if not p.is_file():
        return None, "safety receipt missing: %s" % p
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return None, "safety receipt unreadable: %s" % exc
    if not isinstance(data, dict):
        return None, "safety receipt is not a JSON object"
    if data.get("schema") != RECEIPT_SCHEMA:
        return None, "safety receipt schema must be %s" % RECEIPT_SCHEMA
    for key in RECEIPT_REQUIRED:
        if key not in data:
            return None, "safety receipt missing field: %s" % key
    if data.get("owner_approved") is not True:
        return None, "safety receipt does not record explicit owner approval"
    if data.get("source_commit") != SOURCE_COMMIT:
        return None, "safety receipt source_commit does not match the pinned kernel"
    if data.get("device") != DEVICE:
        return None, "safety receipt device is not %s" % DEVICE
    if data.get("platform_device") != EXPECTED_PLATFORM:
        return None, "safety receipt platform_device is not %s" % EXPECTED_PLATFORM
    if data.get("driver") != EXPECTED_DRIVER:
        return None, "safety receipt driver is not %s" % EXPECTED_DRIVER
    if data.get("compatible") != EXPECTED_COMPATIBLE:
        return None, "safety receipt compatible is not %s" % EXPECTED_COMPATIBLE
    if str(data.get("ip_ver")).lower() != EXPECTED_IP_VER:
        return None, "safety receipt ip_ver is not %s" % EXPECTED_IP_VER
    if data.get("firmware_name") != FIRMWARE_NAME:
        return None, "safety receipt firmware_name is not %s" % FIRMWARE_NAME
    if data.get("firmware_sha256") != FIRMWARE_SHA256:
        return None, "safety receipt firmware_sha256 does not match the verified blob"
    if data.get("kernel_patch") != KERNEL_PATCH:
        return None, "safety receipt kernel_patch is not %s" % KERNEL_PATCH
    if data.get("kernel_patch_applied") is not True:
        return None, "safety receipt says the kernel safety patch is NOT applied"
    if data.get("missing_firmware_test") not in ("PASS", "SOURCE_PASS"):
        return None, "safety receipt missing-firmware test did not pass"
    return data, ""


