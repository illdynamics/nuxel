def guard_status(root: str = "/") -> dict:
    base = Path(root) / "usr/lib64/gstreamer-1.0"
    names = ["libgstvideo4linux2.so", "libgstv4l2codecs.so", "libgstkms.so", "libgstopengl.so"]
    rows = []
    for n in names:
        active = (base / n).exists()
        disabled = (base / (n + ".nuxel-disabled")).exists()
        rows.append({"plugin": n, "active": active, "disabled": disabled})
    return {
        "guard_present": (Path(root) / "usr/lib/nuxel/nuxel-gstreamer-guard.sh").exists(),
        "plugins": rows,
        "v4l2_plugins_disabled": all((not r["active"]) and r["disabled"] for r in rows if r["plugin"].startswith("libgstvideo4linux2") or r["plugin"].startswith("libgstv4l2codecs")),
    }


def wireplumber_status(root: str = "/") -> dict:
    p = Path(root) / "etc/wireplumber/wireplumber.conf.d/99-nuxel-no-v4l2.conf"
    text = _read(p) or ""
    return {
        "config": str(p),
        "video_capture_disabled": "hardware.video-capture = disabled" in text,
        "audio_required": "hardware.audio = required" in text,
        "bluetooth_required": "hardware.bluetooth = required" in text,
    }


def preload_policy_status(root: str = "/") -> dict:
    candidates = [
        Path(root) / "usr/lib/nuxel/nuxel-preload-cinema.sh",
        Path(root) / "usr/lib/nuxel/nuxel-session.sh",
        Path(root) / "usr/lib/nuxel/nuxel-preload-cinema",
    ]
    hits = []
    for p in candidates:
        t = _read(p)
        if t and "--hwdec=no" in t:
            hits.append(str(p))
    return {"software_safe_hwdec_no": bool(hits), "files": hits}


def build_status(
    *,
    sysfs_root: str = "/sys",
    dev_root: str = "/dev",
    firmware_dirs: list[str] | None = None,
    config_path: str | None = None,
    receipt_path: str = DEFAULT_RECEIPT,
    root: str = "/",
) -> dict:
    nodes = scan_video_nodes(sysfs_root)
    decoder, decoder_err = find_decoder(nodes)
    fw = firmware_status(firmware_dirs)
    kc = kernel_config(config_path)
    receipt, receipt_err = load_receipt(receipt_path)

    state = "NOT_TESTED_ON_DEVICE"
    reason = ""
    device_node = None
    if decoder is None:
        mfc_other = [n for n in nodes if classify_node(n) == "MFC_OTHER"]
        if mfc_other:
            state = "UNIDENTIFIED_VIDEO_NODE"
            reason = decoder_err
        else:
            state = "NOT_PRESENT"
            reason = "no Exynos MFC video node is registered"
    else:
        device_node = str(Path(dev_root) / os.path.basename(decoder["sysfs"]))
        if not kc["required_ok"]:
            state = "BLOCKED_DRIVER_MISSING"
            reason = "kernel config lacks the MFC driver/buffer/IOMMU set"
        elif fw["state"] == "MISSING":
            state = "BLOCKED_FIRMWARE_MISSING"
            reason = "%s is absent; hardware decode stays blocked" % FIRMWARE_NAME
        elif fw["state"] == "MISMATCH":
            state = "BLOCKED_FIRMWARE_HASH"
            reason = "%s does not match the verified size/SHA-256" % FIRMWARE_NAME
        elif receipt is None:
            state = "BLOCKED_DRIVER_UNSAFE"
            reason = receipt_err
        elif receipt.get("decode_verified") is True:
            evidence = receipt.get("decode_evidence")
            if isinstance(evidence, dict) and evidence.get("firmware_sha256") == FIRMWARE_SHA256:
                state = "AVAILABLE_HARDWARE_DECODE"
                reason = "a recorded on-device decode test used this exact firmware"
            else:
                state = "AVAILABLE_PROBE_ONLY"
                reason = "receipt claims decode_verified but has no matching evidence"
        else:
            state = "AVAILABLE_PROBE_ONLY"
            reason = "identity, firmware and safety receipt verified; no decode proof yet"

    safe_open_allowed = state in ("AVAILABLE_PROBE_ONLY", "AVAILABLE_HARDWARE_DECODE")
    capabilities = []
    if receipt and receipt.get("decode_verified") is True:
        caps = receipt.get("capabilities")
        if isinstance(caps, list):
            capabilities = caps

    return {
        "schema": SCHEMA,
        "state": state,
        "reason": reason,
        "source_commit": SOURCE_COMMIT,
        "kernel_release": live_kernel_release(),
        "boot_id": live_boot_id(),
        "device": DEVICE,
        "device_model": DEVICE_MODEL,
        "soc": SOC,
        "decoder_node": device_node,
        "decoder_sysfs_name": decoder["name"] if decoder else None,
        "platform_device": decoder["platform_device"] if decoder else None,
        "driver": decoder["driver"] if decoder else None,
        "compatible": decoder["compatible"] if decoder else None,
        "ip_ver": decoder["ip_ver"] if decoder else None,
        "firmware": fw,
        "kernel_config": kc,
        "safety_receipt": {
            "path": receipt_path,
            "present": receipt is not None,
            "error": receipt_err,
            "owner_approved": bool(receipt and receipt.get("owner_approved")),
            "kernel_patch_applied": bool(receipt and receipt.get("kernel_patch_applied")),
            "decode_verified": bool(receipt and receipt.get("decode_verified")),
        },
        "safe_open_allowed": safe_open_allowed,
        "capabilities": capabilities,
        "guard": guard_status(root),
        "wireplumber": wireplumber_status(root),
        "preload": preload_policy_status(root),
        "last_test_time": (receipt or {}).get("decode_verified_at"),
        "node_count": len(nodes),
        "nodes": nodes,
    }


# ---------------------------------------------------------------------------
# V4L2 query (active mode only; requires explicit owner-approved gate)
# ---------------------------------------------------------------------------

def _fourcc(value: int) -> str:
    return struct.pack("<I", value).decode("latin1", "replace")


def _alarm_handler(_signum, _frame):
    raise DiagError("MFC open/query watchdog expired; if the task is in D state, userspace cannot fix it")


def v4l2_query(device: str, alarm_seconds: int = HARDWARE_OPEN_ALARM_SECONDS) -> dict:
    """Open exactly one explicitly named node and run QUERYCAP + ENUM_FMT.

    This function is only called after the CLI safety gate.  It is not a
    substitute for the kernel fix: SIGALRM cannot interrupt uninterruptible
    kernel state.
    """
    old_handler = signal.signal(signal.SIGALRM, _alarm_handler)
    signal.alarm(alarm_seconds)
    fd = None
    try:
        fd = os.open(device, os.O_RDWR | os.O_NONBLOCK)
        cap_buf = bytearray(104)
        fcntl.ioctl(fd, VIDIOC_QUERYCAP, cap_buf, True)
        driver, card, bus_info, version, caps, device_caps = struct.unpack_from(
            "<16s32s32sIII", cap_buf, 0
        )
        result = {
            "device": device,
            "driver": driver.split(b"\x00", 1)[0].decode("latin1", "replace"),
            "card": card.split(b"\x00", 1)[0].decode("latin1", "replace"),
            "bus_info": bus_info.split(b"\x00", 1)[0].decode("latin1", "replace"),
            "version": version,
            "capabilities": "0x%08x" % caps,
            "device_caps": "0x%08x" % device_caps,
            "has_output_mplane": bool(device_caps & V4L2_CAP_VIDEO_OUTPUT_MPLANE),
            "has_capture_mplane": bool(device_caps & V4L2_CAP_VIDEO_CAPTURE_MPLANE),
            "has_streaming": bool(device_caps & V4L2_CAP_STREAMING),
            "formats": {},
        }
        for label, buf_type in (
            ("output_mplane", V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE),
            ("capture_mplane", V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE),
        ):
            formats = []
            for index in range(64):
                fbuf = bytearray(64)
                struct.pack_into("<III", fbuf, 0, index, buf_type, 0)
                try:
                    fcntl.ioctl(fd, VIDIOC_ENUM_FMT, fbuf, True)
                except OSError as exc:
                    if exc.errno in (errno.EINVAL, errno.ENOTTY):
                        break
                    raise
                desc = fbuf[12:44].split(b"\x00", 1)[0].decode("latin1", "replace")
                pixfmt = struct.unpack_from("<I", fbuf, 44)[0]
                formats.append({
                    "index": index,
                    "description": desc,
                    "pixelformat": _fourcc(pixfmt),
                    "pixelformat_hex": "0x%08x" % pixfmt,
                })
            result["formats"][label] = formats
        return result
    finally:
        if fd is not None:
            os.close(fd)
        signal.alarm(0)
        signal.signal(signal.SIGALRM, old_handler)


def require_active_gate(status: dict, device: str, receipt: dict | None) -> tuple[dict | None, str]:
    if receipt is None:
        return None, "active mode refused: matching safety receipt required"
    if status["decoder_node"] is None:
        return None, "active mode refused: decoder identity not resolved"
    if os.path.realpath(device) != os.path.realpath(status["decoder_node"]):
        return None, "active mode refused: device is not the allow-listed decoder node"
    receipt_node = receipt.get("decoder_node")
    if os.path.realpath(str(receipt_node)) != os.path.realpath(device):
        return None, "active mode refused: receipt was approved for a different node"
    if not status["safe_open_allowed"]:
        return None, "active mode refused: state is %s (%s)" % (status["state"], status["reason"])
    return receipt, ""


def write_json_atomic(path: str, data: dict) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, p)


def write_log(log_dir: str, name: str, data: dict) -> str:
    d = Path(log_dir)
    d.mkdir(parents=True, exist_ok=True)
    path = d / (name + "-" + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + ".json")
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(path, 0o644)
    return str(path)

# ---------------------------------------------------------------------------
# Self-test (never touches real /dev/video*)
# ---------------------------------------------------------------------------

def _fake_video_node(tmp: Path, sysfs_root: Path, video: str, name: str, platform: str, driver: str,
                     compatible: str | None, ip_ver: int | None) -> None:
    node = sysfs_root / "class" / "video4linux" / video
    node.mkdir(parents=True, exist_ok=True)
    (node / "name").write_text(name + "\n")
    (node / "index").write_text("0\n")
    (node / "dev").write_text("81:0\n")
    devdir = sysfs_root / "devices" / "platform" / platform
    devdir.mkdir(parents=True, exist_ok=True)
    drv = sysfs_root / "bus" / "platform" / "drivers" / driver
    drv.mkdir(parents=True, exist_ok=True)
    try:
        (devdir / "driver").symlink_to(drv)
    except FileExistsError:
        pass
    if compatible is not None:
        of = devdir / "of_node"
        of.mkdir(exist_ok=True)
        (of / "compatible").write_bytes(compatible.encode() + b"\x00")
        if ip_ver is not None:
            (of / "ip_ver").write_bytes(struct.pack(">I", ip_ver))
    try:
        (node / "device").symlink_to(devdir)
    except FileExistsError:
        pass


def self_test() -> int:
    import tempfile
    checks = 0
    failures = []

    def check(name, cond):
        nonlocal checks
        checks += 1
        if not cond:
            failures.append(name)

    # Exact identity allow-list.
    good = {"name": DECODER_SYSFS_NAME, "driver": EXPECTED_DRIVER,
            "compatible": EXPECTED_COMPATIBLE, "ip_ver": EXPECTED_IP_VER,
            "platform_device": EXPECTED_PLATFORM}
    check("good decoder classified", classify_node(good) == "MFC_DECODER")
    bad = dict(good, ip_ver="0x1200")
    check("wrong ip_ver rejected", classify_node(bad) != "MFC_DECODER")
    bad = dict(good, driver="exynos-fimc-is")
    check("camera driver rejected", classify_node(bad) != "MFC_DECODER")
    camera = {"name": "exynos-fimc-is-30c", "driver": "exynos-fimc-is",
              "compatible": "samsung,exynos5-fimc-is", "ip_ver": None,
              "platform_device": "170e0000.fimc_is"}
    check("camera node is not MFC", classify_node(camera) == "NOT_MFC")
    check("fourcc decode", _fourcc(0x34363248) == "H264")

    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        sysfs = root / "sys"
        _fake_video_node(root, sysfs, "video6", DECODER_SYSFS_NAME,
                         EXPECTED_PLATFORM, EXPECTED_DRIVER, EXPECTED_COMPATIBLE, 0x1300)
        _fake_video_node(root, sysfs, "video111", "exynos-fimc-is-30c",
                         "170e0000.fimc_is", "exynos-fimc-is",
                         "samsung,exynos5-fimc-is", None)
        nodes = scan_video_nodes(str(sysfs))
        dec, err = find_decoder(nodes)
        check("fake decoder found", dec is not None and not err)
        check("fake node count", len(nodes) == 2)
        check("camera not selected", dec is not None and dec["name"] == DECODER_SYSFS_NAME)

        # Missing firmware must be a blocked state, and inventory must not open.
        cfg = root / "config"
        cfg.write_text("CONFIG_VIDEO_EXYNOS_MFC=y\nCONFIG_VIDEOBUF2_DMA_SG=y\n"
                       "CONFIG_EXYNOS_IOMMU=y\nCONFIG_V4L2_MEM2MEM_DEV=y\n")
        fwdir = root / "fw"
        fwdir.mkdir()
        st = build_status(sysfs_root=str(sysfs), dev_root=str(root / "dev"),
                          firmware_dirs=[str(fwdir)], config_path=str(cfg),
                          receipt_path=str(root / "no-receipt.json"), root=str(root))
        check("missing firmware blocked", st["state"] == "BLOCKED_FIRMWARE_MISSING")
        check("missing firmware not openable", st["safe_open_allowed"] is False)
        check("inventory did not create dev node", not (root / "dev").exists())

        # Wrong firmware hash is a distinct blocked state.
        (fwdir / FIRMWARE_NAME).write_bytes(b"not the firmware")
        st = build_status(sysfs_root=str(sysfs), dev_root=str(root / "dev"),
                          firmware_dirs=[str(fwdir)], config_path=str(cfg),
                          receipt_path=str(root / "no-receipt.json"), root=str(root))
        check("wrong firmware hash blocked", st["state"] == "BLOCKED_FIRMWARE_HASH")

        # Receipt validation.
        receipt = {
            "schema": RECEIPT_SCHEMA, "owner_approved": True,
            "source_commit": SOURCE_COMMIT, "device": DEVICE,
            "decoder_node": DECODER_DEFAULT_NODE,
            "platform_device": EXPECTED_PLATFORM, "driver": EXPECTED_DRIVER,
            "compatible": EXPECTED_COMPATIBLE, "ip_ver": EXPECTED_IP_VER,
            "firmware_name": FIRMWARE_NAME, "firmware_sha256": FIRMWARE_SHA256,
            "kernel_patch": KERNEL_PATCH, "kernel_patch_applied": True,
            "missing_firmware_test": "SOURCE_PASS",
        }
        rp = root / "receipt.json"
        rp.write_text(json.dumps(receipt))
        loaded, rerr = load_receipt(str(rp))
        check("valid receipt loads", loaded is not None and not rerr)
        receipt_bad = dict(receipt, owner_approved=False)
        rp.write_text(json.dumps(receipt_bad))
        loaded, rerr = load_receipt(str(rp))
        check("unapproved receipt rejected", loaded is None and bool(rerr))

        # Gate refusal.
        st_allowed = {"decoder_node": DECODER_DEFAULT_NODE, "safe_open_allowed": True,
                      "state": "AVAILABLE_PROBE_ONLY", "reason": ""}
        _, gerr = require_active_gate(st_allowed, "/dev/video111", loaded)
        check("wrong node refused", bool(gerr))
        st_blocked = {"decoder_node": DECODER_DEFAULT_NODE, "safe_open_allowed": False,
                      "state": "BLOCKED_FIRMWARE_MISSING", "reason": "missing"}
        _, gerr = require_active_gate(st_blocked, DECODER_DEFAULT_NODE, receipt)
        check("blocked state refused", bool(gerr))

        # Kernel config check.
        kc = kernel_config(str(cfg))
        check("kernel config required set", kc["required_ok"] is True)

    if failures:
        print("SELF-TEST FAIL: %d/%d checks failed" % (len(failures), checks))
        for f in failures:
            print("  FAIL", f)
        return 1
    print("SELF-TEST PASS: %d checks" % checks)
    return 0


