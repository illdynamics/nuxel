#!/bin/sh
S="$SIM"
cmd=$1; shift
case "$cmd" in
  -4)
    sub=$1; shift
    case "$sub" in
      -o)
        echo "1: lo    inet 127.0.0.1/8 scope host lo"
        for f in "$S/sys/class/net"/*; do
          [ -d "$f" ] || continue
          [ -s "$f/inet" ] && echo "2: ${f##*/}    inet $(cat "$f/inet") scope global ${f##*/}"
        done ;;
      route)
        for f in "$S/sys/class/net"/*; do
          [ -s "$f/inet" ] || continue
          python3 -c 'import sys,ipaddress; print(ipaddress.ip_interface(sys.argv[1]).network)' "$(cat "$f/inet")" 2>/dev/null | sed "s/$/ dev ${f##*/} scope link/"
        done ;;
    esac ;;
  link) exit 0 ;;
  addr)
    op=$1; shift
    cfg=""; dev=""
    while [ $# -gt 0 ]; do
      case "$1" in dev) dev=$2; shift 2 ;; *) cfg=$1; shift ;; esac
    done
    [ -n "$dev" ] || exit 1
    if [ "$op" = add ]; then echo "$cfg" > "$S/sys/class/net/$dev/inet"; else : > "$S/sys/class/net/$dev/inet"; fi ;;
esac
exit 0
